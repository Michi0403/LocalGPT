{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "LocalGPT.dll"
          ],
          "src": "input"
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "disableGitFeatures": true,
      "namespaceLayout": "nested",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "guide/**/*.md",
          "guide/**/toc.yml",
          "architecture/**/*.md",
          "architecture/**/toc.yml",
          "engineering/**/*.md",
          "engineering/**/toc.yml",
          "reference/**/*.md",
          "reference/**/toc.yml",
          "api/**/*.yml",
          "api/**/*.md",
          "pdf/toc.yml"
        ],
        "exclude": [
          "_site/**",
          "input/**",
          ".tools/**",
          "internal-notes/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "media/**",
          "styles/**",
          "pdf-cover.html",
          "LocalGPT-*.pdf"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/localgpt"
    ],
    "globalMetadata": {
      "_appName": "LocalGPT",
      "_appTitle": "LocalGPT Documentation",
      "_appFooter": "LocalGPT 2.3.2 Â· generated documentation",
      "_enableSearch": true,
      "_disableContribution": true,
      "_disableTocFilter": false,
      "_disableNextArticle": false,
      "_lang": "en",
      "localgptVersion": "2.3.2"
    }
  }
}




