<Project>
  <!--
    Direct Windows/Visual Studio builds must not bypass the monotonic logging baseline.
    The guard is Windows PowerShell 5.1 compatible. Release/development scripts run
    the same guard once and set SkipLoggingIntegrityGuard for nested MSBuild calls.
  -->
  <PropertyGroup>
    <LoggingIntegrityScript>$(MSBuildThisFileDirectory)build\Assert-LoggingIntegrity.ps1</LoggingIntegrityScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptLoggingIntegrity"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipLoggingIntegrityGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(LoggingIntegrityScript)')"
           Text="Logging integrity guard script is missing: $(LoggingIntegrityScript)" />
    <Exec Condition="Exists('$(LoggingIntegrityScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(LoggingIntegrityScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <PropertyGroup>
    <OneWireArchitectureScript>$(MSBuildThisFileDirectory)build\Assert-OneWireArchitecture.ps1</OneWireArchitectureScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptOneWireArchitecture"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipOneWireArchitectureGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(OneWireArchitectureScript)')"
           Text="1-Wire architecture guard script is missing: $(OneWireArchitectureScript)" />
    <Exec Condition="Exists('$(OneWireArchitectureScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(OneWireArchitectureScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>


  <PropertyGroup>
    <ProtectedRepositoryFilesScript>$(MSBuildThisFileDirectory)build\Assert-ProtectedRepositoryFiles.ps1</ProtectedRepositoryFilesScript>
    <SecurityRulePreservationScript>$(MSBuildThisFileDirectory)build\Assert-SecurityRulePreservation.ps1</SecurityRulePreservationScript>
    <RuntimeValueOwnershipScript>$(MSBuildThisFileDirectory)build\Assert-RuntimeValueOwnership.ps1</RuntimeValueOwnershipScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptProtectedRepositoryFiles"
          BeforeTargets="BeforeBuild"
          AfterTargets="AssertLocalGptOneWireArchitecture"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipProtectedRepositoryFilesGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(ProtectedRepositoryFilesScript)')" Text="Protected repository-file guard script is missing: $(ProtectedRepositoryFilesScript)" />
    <Exec Condition="Exists('$(ProtectedRepositoryFilesScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProtectedRepositoryFilesScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertLocalGptSecurityRulePreservation"
          BeforeTargets="BeforeBuild"
          AfterTargets="AssertLocalGptProtectedRepositoryFiles"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipSecurityRulePreservationGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(SecurityRulePreservationScript)')" Text="Security-rule preservation script is missing: $(SecurityRulePreservationScript)" />
    <Exec Condition="Exists('$(SecurityRulePreservationScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SecurityRulePreservationScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertLocalGptRuntimeValueOwnership"
          BeforeTargets="BeforeBuild"
          AfterTargets="AssertLocalGptSecurityRulePreservation"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipRuntimeValueOwnershipGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(RuntimeValueOwnershipScript)')" Text="Runtime-value ownership script is missing: $(RuntimeValueOwnershipScript)" />
    <Exec Condition="Exists('$(RuntimeValueOwnershipScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(RuntimeValueOwnershipScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <PropertyGroup>
    <LocalizationIntegrityScript>$(MSBuildThisFileDirectory)build\Assert-LocalizationIntegrity.ps1</LocalizationIntegrityScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptLocalizationIntegrity"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipLocalizationIntegrityGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(LocalizationIntegrityScript)')"
           Text="Localization integrity guard script is missing: $(LocalizationIntegrityScript)" />
    <Exec Condition="Exists('$(LocalizationIntegrityScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(LocalizationIntegrityScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <PropertyGroup>
    <ProjectMaintenanceArchitectureScript>$(MSBuildThisFileDirectory)build\Assert-ProjectMaintenanceArchitecture.ps1</ProjectMaintenanceArchitectureScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptProjectMaintenanceArchitecture"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipProjectMaintenanceArchitectureGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(ProjectMaintenanceArchitectureScript)')"
           Text="Project maintenance architecture guard script is missing: $(ProjectMaintenanceArchitectureScript)" />
    <Exec Condition="Exists('$(ProjectMaintenanceArchitectureScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectMaintenanceArchitectureScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <PropertyGroup>
    <GitSourceVisibilityScript>$(MSBuildThisFileDirectory)build\Assert-GitSourceVisibility.ps1</GitSourceVisibilityScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptGitSourceVisibility"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipGitSourceVisibilityGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(GitSourceVisibilityScript)')"
           Text="Git source visibility guard script is missing: $(GitSourceVisibilityScript)" />
    <Exec Condition="Exists('$(GitSourceVisibilityScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(GitSourceVisibilityScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>


  <PropertyGroup>
    <OperationalDiagnosticsScript>$(MSBuildThisFileDirectory)build\Assert-OperationalDiagnostics.ps1</OperationalDiagnosticsScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptOperationalDiagnostics"
          BeforeTargets="BeforeBuild"
          AfterTargets="AssertLocalGptLoggingIntegrity"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipOperationalDiagnosticsGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(OperationalDiagnosticsScript)')"
           Text="Operational diagnostics guard script is missing: $(OperationalDiagnosticsScript)" />
    <Exec Condition="Exists('$(OperationalDiagnosticsScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(OperationalDiagnosticsScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <PropertyGroup>
    <InteractiveServerRenderModeScript>$(MSBuildThisFileDirectory)build\Assert-InteractiveServerRenderModes.ps1</InteractiveServerRenderModeScript>
    <AsyncContinuationScript>$(MSBuildThisFileDirectory)build\Assert-AsyncContinuationPolicy.ps1</AsyncContinuationScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptInteractiveServerRenderModes"
          BeforeTargets="BeforeBuild"
          AfterTargets="AssertLocalGptOperationalDiagnostics"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipInteractiveServerRenderModeGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(InteractiveServerRenderModeScript)')"
           Text="InteractiveServer render-mode guard script is missing: $(InteractiveServerRenderModeScript)" />
    <Exec Condition="Exists('$(InteractiveServerRenderModeScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(InteractiveServerRenderModeScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertLocalGptAsyncContinuationPolicy"
          BeforeTargets="BeforeBuild"
          AfterTargets="AssertLocalGptInteractiveServerRenderModes"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipAsyncContinuationGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(AsyncContinuationScript)')"
           Text="Async continuation guard script is missing: $(AsyncContinuationScript)" />
    <Exec Condition="Exists('$(AsyncContinuationScript)')"
          Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(AsyncContinuationScript)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>

  <PropertyGroup>
    <MethodDiagnosticsPolicyScript>$(MSBuildThisFileDirectory)build\Assert-MethodDiagnostics.ps1</MethodDiagnosticsPolicyScript>
    <ApplicationStaticPolicyScript>$(MSBuildThisFileDirectory)build\Assert-ApplicationStaticPolicy.ps1</ApplicationStaticPolicyScript>
    <TextServiceOwnershipScript>$(MSBuildThisFileDirectory)build\Assert-TextServiceOwnership.ps1</TextServiceOwnershipScript>
    <IteratorExceptionPolicyScript>$(MSBuildThisFileDirectory)build\Assert-IteratorExceptionPolicy.ps1</IteratorExceptionPolicyScript>
    <SystemVariableInitializationScript>$(MSBuildThisFileDirectory)build\Assert-SystemVariableInitialization.ps1</SystemVariableInitializationScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptMethodDiagnosticsPolicy"
          BeforeTargets="BeforeBuild" AfterTargets="AssertLocalGptAsyncContinuationPolicy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipMethodDiagnosticsPolicyGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(MethodDiagnosticsPolicyScript)')" Text="Method diagnostics policy script is missing: $(MethodDiagnosticsPolicyScript)" />
    <Exec Condition="Exists('$(MethodDiagnosticsPolicyScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MethodDiagnosticsPolicyScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertLocalGptApplicationStaticPolicy"
          BeforeTargets="BeforeBuild" AfterTargets="AssertLocalGptMethodDiagnosticsPolicy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipApplicationStaticPolicyGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(ApplicationStaticPolicyScript)')" Text="Application static policy script is missing: $(ApplicationStaticPolicyScript)" />
    <Exec Condition="Exists('$(ApplicationStaticPolicyScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ApplicationStaticPolicyScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertLocalGptTextServiceOwnership"
          BeforeTargets="BeforeBuild" AfterTargets="AssertLocalGptApplicationStaticPolicy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipTextServiceOwnershipGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(TextServiceOwnershipScript)')" Text="Text-service ownership script is missing: $(TextServiceOwnershipScript)" />
    <Exec Condition="Exists('$(TextServiceOwnershipScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(TextServiceOwnershipScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertLocalGptIteratorExceptionPolicy"
          BeforeTargets="BeforeBuild" AfterTargets="AssertLocalGptTextServiceOwnership"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipIteratorExceptionPolicyGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(IteratorExceptionPolicyScript)')" Text="Iterator exception policy script is missing: $(IteratorExceptionPolicyScript)" />
    <Exec Condition="Exists('$(IteratorExceptionPolicyScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(IteratorExceptionPolicyScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertLocalGptSystemVariableInitialization"
          BeforeTargets="BeforeBuild" AfterTargets="AssertLocalGptIteratorExceptionPolicy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipSystemVariableInitializationGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(SystemVariableInitializationScript)')" Text="System-variable initialization script is missing: $(SystemVariableInitializationScript)" />
    <Exec Condition="Exists('$(SystemVariableInitializationScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SystemVariableInitializationScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>


  <PropertyGroup>
    <JavaScriptDiagnosticsScript>$(MSBuildThisFileDirectory)build\Assert-JavaScriptDiagnostics.ps1</JavaScriptDiagnosticsScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptJavaScriptDiagnostics"
          BeforeTargets="BeforeBuild" AfterTargets="AssertLocalGptSystemVariableInitialization"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipJavaScriptDiagnosticsGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(JavaScriptDiagnosticsScript)')" Text="JavaScript diagnostics guard script is missing: $(JavaScriptDiagnosticsScript)" />
    <Exec Condition="Exists('$(JavaScriptDiagnosticsScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(JavaScriptDiagnosticsScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <PropertyGroup>
    <PublishConfigurationScript>$(MSBuildThisFileDirectory)build\Assert-PublishConfiguration.ps1</PublishConfigurationScript>
    <InstallerWorkflowScript>$(MSBuildThisFileDirectory)build\Assert-InstallerWorkflow.ps1</InstallerWorkflowScript>
  </PropertyGroup>

  <Target Name="AssertLocalGptPublishConfiguration"
          BeforeTargets="BeforeBuild" AfterTargets="AssertLocalGptJavaScriptDiagnostics"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipPublishConfigurationGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(PublishConfigurationScript)')" Text="Publish configuration guard script is missing: $(PublishConfigurationScript)" />
    <Exec Condition="Exists('$(PublishConfigurationScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(PublishConfigurationScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

  <Target Name="AssertLocalGptInstallerWorkflow"
          BeforeTargets="BeforeBuild" AfterTargets="AssertLocalGptPublishConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipInstallerWorkflowGuard)' != 'true' and '$(MSBuildProjectName)' == 'LocalGPT' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(InstallerWorkflowScript)')" Text="Installer workflow guard script is missing: $(InstallerWorkflowScript)" />
    <Exec Condition="Exists('$(InstallerWorkflowScript)')" Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(InstallerWorkflowScript)&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="High" StandardErrorImportance="High" />
  </Target>

</Project>
