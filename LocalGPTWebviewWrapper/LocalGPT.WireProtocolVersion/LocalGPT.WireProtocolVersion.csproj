<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalGPT.WireProtocolVersion</AssemblyName>
    <RootNamespace>LocalGPT.WireProtocol</RootNamespace>
    <Version>2.0.0</Version>
    <Description>Versioned, bidirectional LocalGPT organic 1-Wire protocol contracts shared by LocalGPT and organic plugin systems.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>LocalGPT.WireProtocolVersion</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <Authors>Michi0403 / LocalGPT</Authors>
    <PackageTags>LocalGPT;OneWire;OrganicAI;Protocol</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\release\protocol</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
