<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalGPT.WireProtocolVersion</AssemblyName>
    <RootNamespace>LocalGPT.WireProtocol</RootNamespace>
    <Version>1.3.0</Version>
    <Description>Versioned, bidirectional LocalGPT organic 1-Wire protocol contracts shared by LocalGPT and organic plugin systems.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
