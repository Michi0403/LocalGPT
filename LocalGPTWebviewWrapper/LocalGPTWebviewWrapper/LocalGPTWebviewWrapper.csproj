<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Globals">
    <WebView2UseWinRT>False</WebView2UseWinRT>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	  <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
	  <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
	  <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>LocalGPTWebviewWrapper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>false</PublishSelfContained>
    <UseWinUI>true</UseWinUI>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x86</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'arm64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU' or '$(Platform)' == ''">
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />
	  <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />

	  <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
	<!-- Copy the runtime static-web-assets manifest to bin so the loader can find it -->
	<Target Name="CopyStaticWebAssetsManifest" AfterTargets="Build">
		<ItemGroup>
			<_Swa Include="$(IntermediateOutputPath)$(AssemblyName).staticwebassets.runtime.json" />
		</ItemGroup>
		<Copy
		  SourceFiles="@(_Swa)"
		  DestinationFolder="$(OutputPath)"
		  SkipUnchangedFiles="true"
		  Condition="Exists('%(FullPath)')" />
	</Target>
	<Target Name="EnsureWindowsAppSdkRuntimeFolders"
			BeforeTargets="CopyFilesToOutputDirectory;_CopyFilesMarkedCopyLocal">
		<MakeDir Directories="$(OutDir)runtimes\win-x64\native" />
		<MakeDir Directories="$(OutDir)runtimes\win-arm64\native" />
		<MakeDir Directories="$(OutDir)runtimes\win-arm64ec\native" />
	</Target>
	<!-- Copy any generated CSS isolation bundles (e.g., LocalGPT.styles.css) to bin -->
	<ItemGroup>

		<Content Include="$(IntermediateOutputPath)**\*.styles.css">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<!-- Include the server's wwwroot files in the package/output -->
		<!--<Content Include="..\LocalGPT\wwwroot\**\*">
			<Link>LocalGPTWebviewWrapper\wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
