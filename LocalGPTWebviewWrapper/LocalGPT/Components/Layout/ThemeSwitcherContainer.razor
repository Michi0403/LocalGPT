@inject ThemeService Themes
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@implements IThemeLoadNotifier
@inject ILogger<ThemeSwitcherContainer> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<div class="themeswitcher-container shadow @StateCssClass">
    <ToastWrapper Name="@toastName" />
    @if(IsLoaded) {
        <div class="blazor-themes blazor-scroll-view">
            <div class="list-group list-group-flush">
                @foreach(var themeSet in Themes.ThemeSets) {
                    <span class="themeswitcher-group card-header list-group-item">@themeSet.Title</span>
                    @foreach(var theme in themeSet.Themes) {
                        <ThemeSwitcherItem Theme="@theme" Click="ThemeSwitcherItem_Click"/>
                    }
                }
            </div>
        </div>
    }
</div>

@code {


    string toastName { get; set; } = "ThemeSwitcherContainerToasts";
    [Parameter]
    public bool Shown { get; set; }
    [Parameter]
    public EventCallback<bool> ShownChanged { get; set; }
    [Parameter]
    public string? ThemeName { get; set; }
    [Parameter]
    public EventCallback<string> ThemeNameChanged { get; set; }

    string StateCssClass { get { return IsLoaded ? ((Shown? "themeswitcher-container-shown" : "themeswitcher-container-hidden")) : ""; } }
    bool IsLoaded { get; set; }

    protected override void OnInitialized()
    {
        try
        {
            base.OnInitialized();
            Themes.ThemeLoadNotifier = this;
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            Logger.LogError(ex, "Unable to initialize the theme switcher.");
        }
    }

    async Task ThemeSwitcherItem_Click(Theme theme) {
        try
        {
            if (Themes.ThemeChangeRequestDispatcher is null)
                throw new InvalidOperationException("The theme change dispatcher is not ready yet.");

            await Themes.ThemeChangeRequestDispatcher.RequestThemeChangeAsync(theme);
            await ToggleThemeSwitcherPanel(false);
        }
        catch (OperationCanceledException)
        { /* ignored – user navigated */
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
        }

    }

    public async Task NotifyThemeLoadedAsync(Theme theme) {
        try
        {
            await InvokeAsync(async () =>
            {
                Themes.SetActiveTheme(theme);
                ThemeName = theme.Name;
                await ThemeNameChanged.InvokeAsync(ThemeName);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        { /* ignored – user navigated */
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
        }

    }

    async Task ToggleThemeSwitcherPanel(bool shown) {
        try
        {
            await InvokeAsync(async () =>
            {
                if (shown == Shown)
                    return;
                Shown = shown;
                await ShownChanged.InvokeAsync(shown);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        { /* ignored – user navigated */
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
        }
    }

    void IDisposable.Dispose()
    {
        if (disposedValue)
            return;

        if (ReferenceEquals(Themes.ThemeLoadNotifier, this))
            Themes.ThemeLoadNotifier = null;

        disposedValue = true;
        GC.SuppressFinalize(this);
    }

    private bool disposedValue;



    protected override void OnAfterRender(bool firstRender) 
    {
        try
        {
            if (firstRender)
            {
                IsLoaded = true;

                if (Shown)

                    StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        { /* ignored – user navigated */
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Theme state restoration failed; persisted theme details were omitted from logs.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcherContainer), "RestoreThemeState", ex);
            Notifier.ShowWarning(toastName, "The saved theme state could not be restored. LocalGPT kept the current theme.", "Theme warning");
        }
       
    }

}
