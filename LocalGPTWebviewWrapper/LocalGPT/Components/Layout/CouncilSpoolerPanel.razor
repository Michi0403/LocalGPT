@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject ICouncilSpoolerService Spooler
@inject ILogger<CouncilSpoolerPanel> Logger

<button type="button" data-localgpt-command="open-spooler"
        class="council-spooler-launcher" @onclick="Toggle" title="Rejoin a running or recent AI Council session">
    <span>Council spooler</span>
    @if (RunningCount > 0) { <b>@RunningCount</b> }
</button>

@if (_open)
{
    <aside class="council-spooler-panel" data-localgpt-overlay="spooler" aria-label="AI Council spooler and live run restore">
        <header>
            <div><strong>AI Council spooler</strong><small>Rejoin live runs and inspect recent checkpoints without stopping model work.</small></div>
            <button type="button" @onclick="Toggle">×</button>
        </header>
        <div class="council-spooler-toolbar">
            <select value="@SelectedValue" @onchange="SelectRun">
                @foreach (var run in _runs)
                {
                    <option value="@run.RunId">@run.Status · @run.StartedAtUtc.ToLocalTime().ToString("g") · round @run.CurrentRound · @run.Phase</option>
                }
            </select>
            <button type="button" @onclick="Refresh">Refresh</button>
        </div>
        @if (Selected is null)
        {
            <p>No Council run checkpoint is available.</p>
        }
        else
        {
            <section class="council-spooler-summary">
                <strong>@Selected.Status · @Selected.CouncilTeamKey</strong>
                <span>@string.Join(", ", Selected.ModelNames)</span>
                <p>@Selected.Prompt</p>
            </section>
            <div class="council-spooler-steps">
                @foreach (var step in Selected.Steps.OrderBy(item => item.SortOrder))
                {
                    <details open="@(step.SortOrder == Selected.Steps.Max(item => item.SortOrder))">
                        <summary>Round @step.Round · @step.Phase · @step.ModelName <small>@step.HardwareLane @step.EffectiveLoadPercent%</small></summary>
                        @if (!string.IsNullOrWhiteSpace(step.Error)) { <p class="text-danger">@step.Error</p> }
                        <pre>@step.VisibleContent</pre>
                    </details>
                }
                @if (Selected.Steps.Count == 0) { <p>The run has started; no completed member step is available yet.</p> }
            </div>
            @if (!string.IsNullOrWhiteSpace(Selected.FinalAnswer))
            {
                <details class="council-spooler-final" open><summary>Current final answer</summary><pre>@Selected.FinalAnswer</pre></details>
            }
        }
    </aside>
}

@code {
    private bool _open;
    private List<CouncilSpoolerSnapshot> _runs = [];
    private Guid? _selectedRunId;
    private int RunningCount => _runs.Count(item => item.Status == CouncilSpoolerStatuses.Running);
    private CouncilSpoolerSnapshot? Selected => _selectedRunId is Guid id ? _runs.FirstOrDefault(item => item.RunId == id) : _runs.FirstOrDefault();
    private string SelectedValue => (_selectedRunId ?? _runs.FirstOrDefault()?.RunId)?.ToString() ?? string.Empty;

    protected override void OnInitialized()
    {
        Spooler.Changed += OnSpoolerChanged;
        Refresh();
    }

    private void Toggle() { _open = !_open; if (_open) Refresh(); }
    private void Refresh()
    {
        _runs = Spooler.GetSnapshots(includeCompleted: true, take: 30).ToList();
        if (_selectedRunId is null || _runs.All(item => item.RunId != _selectedRunId)) _selectedRunId = _runs.FirstOrDefault()?.RunId;
    }
    private void SelectRun(ChangeEventArgs args)
    {
        _selectedRunId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        Refresh();
    }
    private void OnSpoolerChanged()
    {
        _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    }
    public void Dispose() => Spooler.Changed -= OnSpoolerChanged;
}
