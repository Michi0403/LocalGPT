@inherits LayoutComponentBase
@using LocalGPT.Services;
@inject NavigationUrlService NavigationUrls
@inject NavigationManager NavigationManager
@namespace LocalGPT.Components.Layout
@inject ILogger<MainLayout> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<div class="page" data-testid="main-layout">
    <Drawer DrawerHeader="drawerHeader" DrawerFooter="drawerFooter">
        <DrawerBody>
            <div class="w-100">
                <MenuIsland></MenuIsland>
                <NavMenu>
                </NavMenu>
            </div>
        </DrawerBody>
        <DrawerTarget>
    
            <article id="current-main-window" class="p-4 full-height" data-testid="main-content">
                <div class="nav-buttons-container drawer-target">

                    <NavLink href="@NavigationUrls.GetUrl(new Uri(NavigationManager.Uri).LocalPath, !ToggledSidebar)">
                        <DxButton RenderStyle="@ButtonRenderStyle.Dark" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button" IconCssClass="icon icon-menu"></DxButton>
                    </NavLink>
                    @if (new Uri(NavigationManager.Uri).LocalPath != "/")
                    {
                        <NavLink href="@NavigationUrls.GetUrl("/", ToggledSidebar)" class="button-link hidden">
                            <DxButton RenderStyle="@ButtonRenderStyle.Dark" Text="Back to Home" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button-nav" IconCssClass="icon icon-back"></DxButton>
                        </NavLink>
                    }
                    <div class="language-switcher" aria-label="Language">
                        <a href="@CultureUrl("en-US")" lang="en">EN</a>
                        <a href="@CultureUrl("de-DE")" lang="de">DE</a>
                    </div>
                </div>
                <SafeErrorBoundary @key="NavigationManager.Uri" Area="MainLayout" ToastName="ComponentSafetyToasts">
                    @Body
                </SafeErrorBoundary>
            </article>
        </DrawerTarget>
    </Drawer>

    <HumanCollaborationInbox />
    <CouncilSpoolerPanel />
</div>

@code {
    [SupplyParameterFromQuery(Name = NavigationUrlService.ToggleSidebarName)]
    public bool ToggledSidebar { get; set; }

    protected override void OnParametersSet()
    {
        try
        {
            Logger.LogDebug("Applying MainLayout parameters for {Path}.", new Uri(NavigationManager.Uri).LocalPath);
            ComponentActivity.RecordInformation(nameof(MainLayout), "LayoutState", ToggledSidebar ? "Navigation drawer is open." : "Navigation drawer is closed.", NavigationManager.Uri);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "MainLayout parameter handling failed.");
            ComponentActivity.RecordFailure(nameof(MainLayout), nameof(OnParametersSet), ex);
            Notifier.ShowError("ComponentSafetyToasts", "The layout could not apply its navigation state. See local logs for details.", "Layout error");
        }
    }
    private string CultureUrl(string culture)
    {
        try
        {
            var returnUrl = new Uri(NavigationManager.Uri).PathAndQuery;
            Logger.LogDebug("Created a localization navigation URL for culture {Culture}.", culture);
            return $"api/localization/select?culture={Uri.EscapeDataString(culture)}&returnUrl={Uri.EscapeDataString(returnUrl)}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not create the localization navigation URL for culture {Culture}.", culture);
            ComponentActivity.RecordFailure(nameof(MainLayout), nameof(CultureUrl), ex);
            Notifier.ShowError("ComponentSafetyToasts", "The language switch link could not be created. See local logs for details.", "Language switch error");
            return "/";
        }
    }

    private RenderFragment drawerHeader => @<div class="navigation-drawer-header">
        <img class="logo" src="images/TacosLogos.svg" alt="LocalGPT logo" />
        <NavLink href="@NavigationUrls.GetUrl(new Uri(NavigationManager.Uri).LocalPath, !ToggledSidebar)">
            <DxButton RenderStyle="@ButtonRenderStyle.Light" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button-nav" IconCssClass="@(ToggledSidebar ? "icon icon-close" : "icon icon-menu")"></DxButton>
        </NavLink>
    </div>;

    private RenderFragment drawerFooter => @<div>
    <NavLink href="https://github.com/Michi0403/LocalGPT" class="button-link">
            <DxButton Text="Github" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="footer-button" RenderStyle="@ButtonRenderStyle.Light" IconCssClass="icon docs-icon"></DxButton>
        </NavLink>
    </div>
    ;
}
