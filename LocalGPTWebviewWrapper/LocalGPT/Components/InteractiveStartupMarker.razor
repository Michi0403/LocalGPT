@inject IJSRuntime JS
@inject ILogger<InteractiveStartupMarker> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

@code {

    string toastName = "interactiveMarkerToasts";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await JS.InvokeVoidAsync("localGptReady.markInteractive");
                ComponentActivity.RecordInformation(nameof(InteractiveStartupMarker), "InteractiveReady", "The Blazor interactive circuit attached successfully.");
                Logger.LogInformation("LocalGPT interactive UI attached successfully.");
            }
        }
        catch (JSDisconnectedException)
        {
            // The application window closed before the optional ready marker completed.
        }
        catch (OperationCanceledException)
        {
            // Normal during circuit shutdown.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The optional interactive-ready marker could not be published.");
            ComponentActivity.RecordWarning(nameof(InteractiveStartupMarker), "InteractiveReady", "The optional interactive-ready marker could not be published.");
        }
    }
}
