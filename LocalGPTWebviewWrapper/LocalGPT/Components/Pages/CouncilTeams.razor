@rendermode InteractiveServer
@page "/council-teams"
@inject ICouncilTeamConfigurationService TeamConfigurations
@inject ICouncilRuntimeClassService RuntimeClasses
@inject IDxAiFunctionCatalogService FunctionCatalog
@inject ILogger<CouncilTeams> Logger
@inject CouncilTextService CouncilText
@inject IComponentActivityService ComponentActivity
@inject INotificationService Notifier

<PageTitle>AI Council Teams</PageTitle>

<main class="council-team-page localgpt-surface">
    <header class="council-team-header">
        <div>
            <h1>AI Council social structures</h1>
            <p>The supplied LocalGPT council remains available as the default. Create or duplicate a team to define any role set and any workflow from one round up to the technical run limit.</p>
        </div>
        <button type="button" class="btn btn-secondary" @onclick="ReloadAsync" disabled="@_busy">Reload</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert @(_hasError ? "alert-danger" : "alert-info")" role="status">@_status</div>
    }

    <section class="council-team-grid">
        <aside class="council-team-list">
            <label>
                <span>Team</span>
                <select class="form-select" value="@_selectedKey" @onchange="OnTeamChanged">
                    @foreach (var team in _teams)
                    {
                        <option value="@team.Key">@team.DisplayName (@team.Key)</option>
                    }
                </select>
            </label>
            @foreach (var team in _teams)
            {
                <button type="button" class="council-team-list-item @(team.Key == _selectedKey ? "active" : string.Empty)" @onclick="() => SelectTeam(team)">
                    <strong>@team.DisplayName</strong>
                    <small>@team.Key · @(team.IsEnabled ? "enabled" : "disabled") · @WorkflowLabel(team)</small>
                    <span>@team.Purpose</span>
                </button>
            }
            <div class="council-team-list-actions">
                <button type="button" class="btn btn-outline-primary" @onclick="CreateTeam">Create empty structure</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="DuplicateTeam" disabled="@(_teams.Count == 0)">Duplicate selected</button>
            </div>
        </aside>

        <section class="council-team-editor">
            <div class="council-structure-mode @(UsesDefaultWorkflow(_editor) ? "default-mode" : "custom-mode")">
                <strong>@WorkflowLabel(_editor)</strong>
                <span>Untouched supplied teams use the established LocalGPT orchestration. Saving any edit creates a user-owned literal workflow; duplicating keeps the supplied default untouched.</span>
            </div>

            <div class="council-team-fields">
                <label><span>Key</span><input class="form-control" @bind="_editor.Key" /></label>
                <label><span>Display name</span><input class="form-control" @bind="_editor.DisplayName" /></label>
                <label class="wide"><span>Purpose</span><textarea class="form-control" rows="3" @bind="_editor.Purpose"></textarea></label>
            </div>

            <details class="council-best-use-functions">
                <summary>Best-use DXFunctions (@_editor.PreferredCapabilities.Count selected)</summary>
                <p class="hint">Select the functions this team should prefer. The list is grouped by function namespace; entries recommended by assigned runtime classes are marked.</p>
                @foreach (var group in AvailableDxFunctions.GroupBy(FunctionNamespace).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                {
                    <fieldset class="council-runtime-class-group">
                        <legend>@group.Key</legend>
                        @foreach (var entry in group.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                        {
                            var recommended = RecommendedRuntimeFunctions.Contains(entry.FunctionName);
                            <label class="form-check council-runtime-class-option">
                                <input class="form-check-input" type="checkbox"
                                       checked="@_editor.PreferredCapabilities.Contains(entry.FunctionName, StringComparer.OrdinalIgnoreCase)"
                                       @onchange="args => TogglePreferredCapability(entry.FunctionName, args)" />
                                <span><strong>@entry.DisplayName</strong> <small>@entry.FunctionName@(recommended ? " · runtime-class recommendation" : string.Empty)</small></span>
                            </label>
                        }
                    </fieldset>
                }
            </details>

            <section class="council-structure-section">
                <header>
                    <div>
                        <h2>Roles</h2>
                        <p>Roles are free-form social responsibilities. They do not need to match LocalGPT's supplied role names.</p>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddRole">Add role</button>
                </header>
                @if (_editor.Roles.Count == 0)
                {
                    <div class="council-empty-structure">No roles are defined. The workflow can still run, but named roles make the structure easier to understand.</div>
                }
                @for (var index = 0; index < _editor.Roles.Count; index++)
                {
                    var roleIndex = index;
                    var role = _editor.Roles[roleIndex];
                    <article class="council-role-card" @key="role">
                        <header class="council-role-card-header wide">
                            <strong>@(string.IsNullOrWhiteSpace(role.Role) ? $"Role {roleIndex + 1}" : role.Role)</strong>
                            <div class="council-role-badges">
                                <span class="council-role-badge ai">@RoleAiBadge(role)</span>
                                <span class="@($"council-role-badge {RoleHumanBadgeClass(role)}")">@RoleHumanBadge(role)</span>
                                <span class="council-role-badge performance">@RolePerformanceBadge(role)</span>
                                <span class="council-role-badge boundary">@RoleBoundaryBadge(role)</span>
                                <span class="council-role-badge language">@RoleLanguageBadge(role)</span>
                                @if (!string.IsNullOrWhiteSpace(role.PairedRole))
                                {
                                    <span class="council-role-badge pairing">Paired with @role.PairedRole</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(role.DistinctAiAssignmentGroup))
                                {
                                    <span class="council-role-badge distinct">Distinct group @role.DistinctAiAssignmentGroup</span>
                                }
                            </div>
                        </header>
                        <label><span>Role name</span><input class="form-control" @bind="role.Role" /></label>
                        <label><span>Expertise or viewpoint</span><input class="form-control" @bind="role.Expertise" /></label>
                        <label class="wide"><span>Responsibility</span><textarea class="form-control" rows="2" @bind="role.Responsibility"></textarea></label>
                        <div class="wide council-role-policy-grid">
                            <label>
                                <span>AI assignment</span>
                                <select class="form-select" @bind="role.AiSelectionMode" disabled="@(role.HumanParticipationMode == HumanParticipationMode.HumanOnly)">
                                    @foreach (var mode in AiSelectionModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Minimum random AIs</span>
                                <input class="form-control" type="number" min="1" max="100" @bind="role.MinimumAiParticipants" disabled="@(role.AiSelectionMode != CouncilRoleAiSelectionMode.RandomRange || role.HumanParticipationMode == HumanParticipationMode.HumanOnly)" />
                            </label>
                            <label>
                                <span>Maximum random AIs</span>
                                <input class="form-control" type="number" min="1" max="100" @bind="role.MaximumAiParticipants" disabled="@(role.AiSelectionMode != CouncilRoleAiSelectionMode.RandomRange || role.HumanParticipationMode == HumanParticipationMode.HumanOnly)" />
                            </label>
                            <label>
                                <span>Human participation</span>
                                <select class="form-select" @bind="role.HumanParticipationMode">
                                    @foreach (var mode in HumanParticipationModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Role performance</span>
                                <select class="form-select" @bind="role.PerformanceMode">
                                    @foreach (var mode in PerformanceModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Role boundary</span>
                                <select class="form-select" @bind="role.BoundaryMode">
                                    @foreach (var mode in BoundaryModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Response language</span>
                                <select class="form-select" @bind="role.LanguageMode">
                                    @foreach (var mode in LanguageModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                        </div>
                        <div class="wide council-role-coordination-grid">
                            <label>
                                <span>Distinct AI assignment group</span>
                                <input class="form-control" @bind="role.DistinctAiAssignmentGroup" placeholder="Optional shared group key" />
                            </label>
                            <label>
                                <span>Match AI count to role</span>
                                <input class="form-control" list="council-role-names" @bind="role.MatchAiParticipantCountToRole" placeholder="Optional role name" />
                            </label>
                            <label>
                                <span>Pair one-to-one with role</span>
                                <input class="form-control" list="council-role-names" @bind="role.PairedRole" placeholder="Optional role name" />
                            </label>
                        </div>
                        <details class="wide council-runtime-class-picker">
                            <summary>Runtime classes (@role.RuntimeClassKeys.Count selected)</summary>
                            <p class="hint">Assign database-backed runtime classes to this role. Every field remains visible with AI/human ownership, blocking behavior and keyboard/gamepad bindings.</p>
                            @foreach (var group in _runtimeClasses.GroupBy(item => item.Namespace).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                            {
                                <fieldset class="council-runtime-class-group">
                                    <legend>@group.Key</legend>
                                    @foreach (var runtimeClass in group.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <label class="form-check council-runtime-class-option">
                                            <input class="form-check-input" type="checkbox"
                                                   checked="@role.RuntimeClassKeys.Contains(runtimeClass.Key, StringComparer.OrdinalIgnoreCase)"
                                                   @onchange="args => ToggleRuntimeClass(roleIndex, runtimeClass.Key, args)" />
                                            <span><strong>@runtimeClass.DisplayName</strong> <small>@runtimeClass.Key · @runtimeClass.Kind</small></span>
                                        </label>
                                    }
                                </fieldset>
                            }
                            @foreach (var runtimeClass in RuntimeClassesFor(role))
                            {
                                <article class="council-runtime-class-preview">
                                    <header><strong>@runtimeClass.DisplayName</strong><small>@runtimeClass.Key</small></header>
                                    <p>@runtimeClass.Description</p>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle">
                                            <thead><tr><th>Field</th><th>Type/default</th><th>Input</th><th>AI</th><th>Human</th><th>Blocks next round</th><th>Keyboard</th><th>Gamepad</th></tr></thead>
                                            <tbody>
                                            @foreach (var field in runtimeClass.Fields)
                                            {
                                                <tr>
                                                    <td><strong>@field.DisplayName</strong><br /><small>@field.Name</small></td>
                                                    <td>@field.DataType<br /><small>@field.DefaultValue</small></td>
                                                    <td>@field.InputMode</td>
                                                    <td>@(field.AiAssignable ? "yes" : "no")</td>
                                                    <td>@(field.HumanAssignable ? "yes" : "no")</td>
                                                    <td>@(field.BlocksNextRoundUntilHumanInput ? "required gate" : "no")</td>
                                                    <td>@field.KeyboardKey</td>
                                                    <td>@field.GamepadButton</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                </article>
                            }
                        </details>
                        <p class="wide council-role-policy-help">@RolePolicyExplanation(role) @RolePerformanceExplanation(role) @RoleBoundaryExplanation(role) @RoleLanguageExplanation(role) @RoleCoordinationExplanation(role)</p>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveRole(roleIndex)">Remove role</button>
                    </article>
                }
                <datalist id="council-role-names">
                    @foreach (var role in _editor.Roles.Where(role => !string.IsNullOrWhiteSpace(role.Role)))
                    {
                        <option value="@role.Role"></option>
                    }
                </datalist>
            </section>

            <section class="council-structure-section">
                <header>
                    <div>
                        <h2>Rounds and workflow</h2>
                        <p>Each enabled step is a council round. Its role name links to the matching role policy above. Repeat count expands one step. Consecutive steps with the same loop group repeat together until their completion marker appears or the safety limit is reached. Placeholders include <code>{{UserPrompt}}</code>, <code>{{Transcript}}</code>, <code>{{PreviousStep}}</code>, <code>{{ModelName}}</code>, <code>{{CouncilMembers}}</code>, <code>{{RoleMembers}}</code>, <code>{{RuntimeClasses}}</code>, <code>{{PairedParticipant}}</code>, <code>{{PairedRole}}</code>, <code>{{RolePairings}}</code>, <code>{{HumanParticipationMode}}</code>, <code>{{RolePerformanceMode}}</code>, <code>{{RoleBoundaryMode}}</code>, <code>{{RoleLanguageMode}}</code>, <code>{{RolePerformanceInstruction}}</code>, <code>{{RoleBoundaryInstruction}}</code>, <code>{{RoleLanguageInstruction}}</code>, <code>{{LoopGroup}}</code>, <code>{{LoopIteration}}</code>, <code>{{LoopMaximumIterations}}</code>, <code>{{TeamName}}</code>, <code>{{Role}}</code>, <code>{{Phase}}</code>, and <code>{{RoundNumber}}</code>.</p>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddWorkflowStep">Add round</button>
                </header>
                @if (_editor.WorkflowSteps.Count == 0)
                {
                    <div class="council-empty-structure">No rounds are defined. Add at least one enabled round before saving.</div>
                }
                @for (var index = 0; index < _editor.WorkflowSteps.Count; index++)
                {
                    var stepIndex = index;
                    var step = _editor.WorkflowSteps[stepIndex];
                    <article class="council-workflow-card" @key="step">
                        <header>
                            <div>
                                <strong>@(string.IsNullOrWhiteSpace(step.DisplayName) ? $"Round {stepIndex + 1}" : step.DisplayName)</strong>
                                <small>@step.ExecutionMode · repeat @step.RepeatCount · @WorkflowLoopLabel(step) · @WorkflowRolePolicyLabel(step.Role)</small>
                            </div>
                            <div class="council-step-actions">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWorkflowStep(stepIndex, -1)" disabled="@(stepIndex == 0)">Up</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWorkflowStep(stepIndex, 1)" disabled="@(stepIndex == _editor.WorkflowSteps.Count - 1)">Down</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveWorkflowStep(stepIndex)">Remove</button>
                            </div>
                        </header>
                        <div class="council-workflow-fields">
                            <label><span>Key</span><input class="form-control" @bind="step.Key" /></label>
                            <label><span>Display name</span><input class="form-control" @bind="step.DisplayName" /></label>
                            <label><span>Phase</span><input class="form-control" @bind="step.Phase" /></label>
                            <label><span>Role for this round</span><input class="form-control" list="council-role-names" @bind="step.Role" /></label>
                            <label>
                                <span>Execution</span>
                                <select class="form-select" @bind="step.ExecutionMode">
                                    @foreach (var mode in ExecutionModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label><span>Assigned model (optional)</span><input class="form-control" @bind="step.AssignedModelName" placeholder="Used by Assigned model only" /></label>
                            <label><span>Repeat count inside this step</span><input class="form-control" type="number" min="1" max="100" @bind="step.RepeatCount" /></label>
                            <label><span>Sort order</span><input class="form-control" type="number" @bind="step.SortOrder" /></label>
                            <label>
                                <span>Loop group (optional)</span>
                                <input class="form-control" @bind="step.LoopGroup" placeholder="Same key on consecutive steps" />
                            </label>
                            <label>
                                <span>Maximum loop iterations</span>
                                <input class="form-control" type="number" min="1" max="100" @bind="step.MaximumLoopIterations" disabled="@(string.IsNullOrWhiteSpace(step.LoopGroup))" />
                            </label>
                            <label class="wide">
                                <span>Loop completion marker (optional)</span>
                                <input class="form-control" @bind="step.LoopCompletionMarker" placeholder="Example: [[TOURNAMENT_COMPLETE]]" disabled="@(string.IsNullOrWhiteSpace(step.LoopGroup))" />
                            </label>
                            @if (step.ProducesAsciiFrame)
                            {
                                <label><span>ASCII frame width</span><input class="form-control" type="number" min="20" max="240" @bind="step.AsciiFrameWidth" /></label>
                                <label><span>ASCII frame height</span><input class="form-control" type="number" min="8" max="120" @bind="step.AsciiFrameHeight" /></label>
                                <label><span>World step scale</span><input class="form-control" type="number" min="1" max="1000" @bind="step.WorldStepScale" /></label>
                                <div class="wide alert alert-info mb-0">Exactly one AI must own the complete frame. Use LeaderSingle, RoundRobinSingle or AssignedModelSingle and emit <code>[[ASCII_FRAME]]...[[/ASCII_FRAME]]</code>.</div>
                            }
                            <label class="wide"><span>Round prompt</span><textarea class="form-control council-script" rows="7" @bind="step.PromptTemplate"></textarea></label>
                        </div>
                        <div class="council-step-options">
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.IsEnabled" /><span>Enabled</span></label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.IncludePriorTranscript" /><span>Include previous transcript</span></label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.ProducesFinalAnswer" /><span>Can become final answer</span></label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.RequiresHumanCheckpoint" /><span>Respect human gate before round</span></label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.CanUseOrganicFunctions" /><span>Allow DX/organic function requests</span></label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.ProducesAsciiFrame" /><span>Produces one AI-owned ASCII frame</span></label>
                        </div>
                    </article>
                }
            </section>

            <details class="council-advanced-section">
                <summary>Advanced prompt compatibility and JSON import/export</summary>
                <div class="council-team-fields">
                    <label class="wide"><span>Legacy expert preparation prompt</span><textarea class="form-control council-script" rows="6" @bind="_editor.ExpertPreparationPromptTemplate"></textarea></label>
                    <label class="wide"><span>Legacy leader synthesis prompt</span><textarea class="form-control council-script" rows="6" @bind="_editor.LeaderSynthesisPromptTemplate"></textarea></label>
                    <label class="wide"><span>Legacy main-round instruction</span><textarea class="form-control council-script" rows="4" @bind="_editor.MainRoundInstructionTemplate"></textarea></label>
                    <label class="wide"><span>Roles JSON</span><textarea class="form-control council-script" rows="8" @bind="_rolesJson"></textarea></label>
                    <label class="wide"><span>Workflow steps JSON</span><textarea class="form-control council-script" rows="12" @bind="_workflowJson"></textarea></label>
                    <div class="wide council-json-actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshAdvancedJson">Refresh JSON from editor</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ApplyAdvancedJson">Apply JSON to editor</button>
                    </div>
                    <label class="wide"><span>Preferred organic capabilities JSON</span><textarea class="form-control council-script" rows="5" @bind="_capabilitiesJson"></textarea></label>
                    <label class="wide"><span>Architecture contracts JSON</span><textarea class="form-control council-script" rows="5" @bind="_contractsJson"></textarea></label>
                </div>
            </details>

            <div class="council-team-savebar">
                <span class="council-expanded-count">@EnabledRoundCount enabled step(s), up to @ExpandedRoundCount expanded round(s)</span>
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_editor.IsEnabled" /><span>Enabled</span></label>
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_confirmed" @bind:after="ReviewConfirmationChanged" /><span>I reviewed this social structure and its prompts</span></label>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">Save reviewed team</button>
            </div>
        </section>
    </section>
</main>

@code {
    private readonly System.Text.Json.JsonSerializerOptions JsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web) { WriteIndented = true };
    private readonly IReadOnlyList<(string Value, string Label)> ExecutionModes =
    [
        ("AllMembersParallel", "All role members in parallel"),
        ("AllMembersSequential", "All role members sequentially"),
        ("LeaderSingle", "Council leader or one role member"),
        ("RoundRobinSingle", "One rotating role member"),
        ("AssignedModelSingle", "Assigned model only")
    ];
    private readonly IReadOnlyList<(CouncilRoleAiSelectionMode Value, string Label)> AiSelectionModes =
    [
        (CouncilRoleAiSelectionMode.AllSelected, "All selected council AIs"),
        (CouncilRoleAiSelectionMode.RandomRange, "Random role members within range")
    ];
    private readonly IReadOnlyList<(HumanParticipationMode Value, string Label)> HumanParticipationModes =
    [
        (HumanParticipationMode.None, "No human role"),
        (HumanParticipationMode.Optional, "Human may participate"),
        (HumanParticipationMode.Required, "Human response required"),
        (HumanParticipationMode.HumanOnly, "Human only; no AI")
    ];
    private readonly IReadOnlyList<(CouncilRolePerformanceMode Value, string Label)> PerformanceModes =
    [
        (CouncilRolePerformanceMode.TaskSpecialist, "Task specialist"),
        (CouncilRolePerformanceMode.ImprovisationPlayer, "Improvisation player / actor")
    ];
    private readonly IReadOnlyList<(CouncilRoleBoundaryMode Value, string Label)> BoundaryModes =
    [
        (CouncilRoleBoundaryMode.Bounded, "Bounded role"),
        (CouncilRoleBoundaryMode.Collaborative, "Collaborative role"),
        (CouncilRoleBoundaryMode.Strict, "Strict role ownership")
    ];
    private readonly IReadOnlyList<(CouncilRoleLanguageMode Value, string Label)> LanguageModes =
    [
        (CouncilRoleLanguageMode.ModelChoice, "Model chooses language"),
        (CouncilRoleLanguageMode.SenderLanguage, "Match latest human sender"),
        (CouncilRoleLanguageMode.English, "English")
    ];
    private IReadOnlyList<OrganicCouncilTeamDefinition> _teams = [];
    private IReadOnlyList<CouncilRuntimeClassDefinition> _runtimeClasses = [];
    private IReadOnlyList<DxAiFunctionCatalogEntry> _dxFunctions = [];
    private OrganicCouncilTeamDefinition _editor = new();
    private string _selectedKey = string.Empty;
    private string _rolesJson = "[]";
    private string _workflowJson = "[]";
    private string _capabilitiesJson = "[]";
    private string _contractsJson = "[]";
    private string _status = string.Empty;
    private bool _hasError;
    private bool _confirmed;
    private bool _busy;

    private int EnabledRoundCount => _editor.WorkflowSteps.Count(step => step.IsEnabled);
    private int ExpandedRoundCount => CalculateExpandedRoundCount(_editor.WorkflowSteps);
    private IEnumerable<DxAiFunctionCatalogEntry> AvailableDxFunctions => _dxFunctions
        .Where(entry => entry.IsAvailable && entry.IsEnabled && !string.IsNullOrWhiteSpace(entry.FunctionName));
    private HashSet<string> RecommendedRuntimeFunctions => _runtimeClasses
        .Where(runtimeClass => _editor.Roles.Any(role => role.RuntimeClassKeys.Contains(runtimeClass.Key, StringComparer.OrdinalIgnoreCase)))
        .SelectMany(runtimeClass => runtimeClass.RecommendedDxFunctions)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            _runtimeClasses = await RuntimeClasses.GetDefinitionsAsync(includeDisabled: true).ConfigureAwait(true);
            _dxFunctions = await FunctionCatalog.GetEntriesAsync().ConfigureAwait(true);
            _teams = await TeamConfigurations.GetTeamsAsync(includeDisabled: true).ConfigureAwait(true);
            var selected = _teams.FirstOrDefault(team => team.Key == _selectedKey) ?? _teams.FirstOrDefault();
            if (selected is not null)
                SelectTeam(selected);
            else
                CreateTeam();
            _status = $"Loaded {_teams.Count} database-backed team configuration(s).";
            _hasError = false;
            Notifier.ShowInfo(nameof(CouncilTeams), _status, "Council Teams");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load AI Council team configurations.");
            ComponentActivity.RecordFailure(nameof(CouncilTeams), nameof(ReloadAsync), ex);
            _status = ex.Message;
            _hasError = true;
            Notifier.ShowError(nameof(CouncilTeams), ex.Message, "Council Teams");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnTeamChanged(ChangeEventArgs args)
    {
        var key = args.Value?.ToString() ?? string.Empty;
        var team = _teams.FirstOrDefault(item => item.Key == key);
        if (team is not null)
            SelectTeam(team);
    }

    private void SelectTeam(OrganicCouncilTeamDefinition team)
    {
        _selectedKey = team.Key;
        _editor = Clone(team);
        NormalizeEditorOrdering();
        RefreshAdvancedJson();
        _capabilitiesJson = Serialize(team.PreferredCapabilities);
        _contractsJson = Serialize(team.ArchitectureContracts);
        _confirmed = false;
    }

    private void CreateTeam()
    {
        _selectedKey = string.Empty;
        _editor = new OrganicCouncilTeamDefinition
        {
            Key = "new-team",
            DisplayName = "New Council Team",
            Purpose = "A user-defined social AI structure.",
            IsEnabled = true,
            Roles =
            [
                new OrganicCouncilRoleDefinition
                {
                    Role = "Participant",
                    Expertise = "A viewpoint chosen by the user",
                    Responsibility = "Contribute according to the saved round prompt",
                    AiSelectionMode = CouncilRoleAiSelectionMode.RandomRange,
                    MinimumAiParticipants = 1,
                    MaximumAiParticipants = 1
                }
            ],
            WorkflowSteps =
            [
                CreateWorkflowStep(0)
            ]
        };
        _capabilitiesJson = "[]";
        _contractsJson = "[]";
        RefreshAdvancedJson();
        _confirmed = false;
        _status = "Created an unsaved custom structure. Rename its key before saving if needed.";
        _hasError = false;
    }

    private void DuplicateTeam()
    {
        var source = _teams.FirstOrDefault(team => team.Key == _selectedKey) ?? _teams.FirstOrDefault();
        if (source is null)
        {
            CreateTeam();
            return;
        }

        _editor = Clone(source);
        _editor.Key = $"{source.Key}-custom";
        _editor.DisplayName = $"{source.DisplayName} custom";
        _editor.IsSystemSeed = false;
        _editor.IsUserModified = true;
        foreach (var step in _editor.WorkflowSteps)
            step.UseBuiltInBehavior = false;
        _selectedKey = string.Empty;
        RefreshAdvancedJson();
        _capabilitiesJson = Serialize(_editor.PreferredCapabilities);
        _contractsJson = Serialize(_editor.ArchitectureContracts);
        _confirmed = false;
        _status = $"Duplicated '{source.DisplayName}' as an unsaved literal workflow. Change the key if it already exists.";
        _hasError = false;
    }

    private void AddRole() => _editor.Roles.Add(new OrganicCouncilRoleDefinition
    {
        Role = $"Role {_editor.Roles.Count + 1}",
        Expertise = string.Empty,
        Responsibility = string.Empty,
        AiSelectionMode = CouncilRoleAiSelectionMode.RandomRange,
        MinimumAiParticipants = 1,
        MaximumAiParticipants = 1,
        HumanParticipationMode = HumanParticipationMode.None
    });

    private void RemoveRole(int index)
    {
        if (index >= 0 && index < _editor.Roles.Count)
            _editor.Roles.RemoveAt(index);
    }

    private void AddWorkflowStep()
    {
        foreach (var existing in _editor.WorkflowSteps)
            existing.UseBuiltInBehavior = false;
        _editor.WorkflowSteps.Add(CreateWorkflowStep(_editor.WorkflowSteps.Count));
        NormalizeEditorOrdering();
    }

    private CouncilWorkflowStepDefinition CreateWorkflowStep(int index) => new()
    {
        Key = $"round-{index + 1}",
        DisplayName = $"Round {index + 1}",
        SortOrder = (index + 1) * 10,
        Phase = "Discussion",
        Role = "Participant",
        ExecutionMode = "AllMembersParallel",
        RepeatCount = 1,
        MaximumLoopIterations = 1,
        IncludePriorTranscript = true,
        IsEnabled = true,
        CanUseOrganicFunctions = true,
        PromptTemplate = "Contribute to {{TeamName}} as {{Role}}. Address the original request, consider the prior transcript, and state disagreements or missing information plainly.\n\nUser request:\n{{UserPrompt}}\n\nPrior transcript:\n{{Transcript}}"
    };

    private void RemoveWorkflowStep(int index)
    {
        if (index < 0 || index >= _editor.WorkflowSteps.Count)
            return;
        _editor.WorkflowSteps.RemoveAt(index);
        MarkWorkflowCustom();
        NormalizeEditorOrdering();
    }

    private void MoveWorkflowStep(int index, int direction)
    {
        var target = index + direction;
        if (index < 0 || index >= _editor.WorkflowSteps.Count || target < 0 || target >= _editor.WorkflowSteps.Count)
            return;
        (_editor.WorkflowSteps[index], _editor.WorkflowSteps[target]) = (_editor.WorkflowSteps[target], _editor.WorkflowSteps[index]);
        MarkWorkflowCustom();
        NormalizeEditorOrdering();
    }

    private void MarkWorkflowCustom()
    {
        foreach (var step in _editor.WorkflowSteps)
            step.UseBuiltInBehavior = false;
    }

    private void NormalizeEditorOrdering()
    {
        foreach (var role in _editor.Roles)
        {
            role.MinimumAiParticipants = Math.Clamp(role.MinimumAiParticipants, 1, 100);
            role.MaximumAiParticipants = Math.Clamp(role.MaximumAiParticipants, 1, 100);
            if (role.MinimumAiParticipants > role.MaximumAiParticipants)
                role.MaximumAiParticipants = role.MinimumAiParticipants;
            if (!Enum.IsDefined(typeof(CouncilRoleAiSelectionMode), role.AiSelectionMode))
                role.AiSelectionMode = CouncilRoleAiSelectionMode.AllSelected;
            if (!Enum.IsDefined(typeof(HumanParticipationMode), role.HumanParticipationMode))
                role.HumanParticipationMode = HumanParticipationMode.None;
            if (!Enum.IsDefined(typeof(CouncilRolePerformanceMode), role.PerformanceMode))
                role.PerformanceMode = CouncilRolePerformanceMode.TaskSpecialist;
            if (!Enum.IsDefined(typeof(CouncilRoleLanguageMode), role.LanguageMode))
                role.LanguageMode = CouncilRoleLanguageMode.ModelChoice;
            if (!Enum.IsDefined(typeof(CouncilRoleBoundaryMode), role.BoundaryMode))
                role.BoundaryMode = CouncilRoleBoundaryMode.Bounded;
            role.DistinctAiAssignmentGroup = role.DistinctAiAssignmentGroup?.Trim() ?? string.Empty;
            role.MatchAiParticipantCountToRole = role.MatchAiParticipantCountToRole?.Trim() ?? string.Empty;
            role.PairedRole = role.PairedRole?.Trim() ?? string.Empty;
            role.RuntimeClassKeys ??= [];
            role.RuntimeClassKeys = role.RuntimeClassKeys
                .Select(value => value?.Trim().ToLowerInvariant() ?? string.Empty)
                .Where(value => value.Length > 0)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }

        for (var index = 0; index < _editor.WorkflowSteps.Count; index++)
        {
            var step = _editor.WorkflowSteps[index];
            if (step.SortOrder == 0)
                step.SortOrder = (index + 1) * 10;
            step.RepeatCount = Math.Clamp(step.RepeatCount, 1, 100);
            step.LoopGroup = step.LoopGroup?.Trim() ?? string.Empty;
            step.MaximumLoopIterations = string.IsNullOrWhiteSpace(step.LoopGroup)
                ? 1
                : Math.Clamp(step.MaximumLoopIterations, 1, 100);
            step.LoopCompletionMarker = step.LoopCompletionMarker?.Trim() ?? string.Empty;
            step.AsciiFrameWidth = Math.Clamp(step.AsciiFrameWidth, 20, 240);
            step.AsciiFrameHeight = Math.Clamp(step.AsciiFrameHeight, 8, 120);
            step.WorldStepScale = Math.Clamp(step.WorldStepScale, 1, 1000);
        }
    }

    private void RefreshAdvancedJson()
    {
        _rolesJson = Serialize(_editor.Roles);
        _workflowJson = Serialize(_editor.WorkflowSteps);
    }

    private void ApplyAdvancedJson()
    {
        try
        {
            _editor.Roles = Deserialize<List<OrganicCouncilRoleDefinition>>(_rolesJson);
            _editor.WorkflowSteps = Deserialize<List<CouncilWorkflowStepDefinition>>(_workflowJson);
            MarkWorkflowCustom();
            NormalizeEditorOrdering();
            _status = "Applied the advanced JSON to the visual editor. Review the resulting roles and rounds before saving.";
            _hasError = false;
            _confirmed = false;
        }
        catch (System.Text.Json.JsonException ex)
        {
            _status = ex.Message;
            _hasError = true;
            Notifier.ShowError(nameof(CouncilTeams), ex.Message, "Council JSON rejected");
        }
    }

    private async Task SaveAsync()
    {
        if (!_confirmed)
        {
            _status = "Review the team and check the confirmation box before saving.";
            _hasError = true;
            Notifier.ShowWarning(nameof(CouncilTeams), _status, "Review required");
            return;
        }

        _busy = true;
        try
        {
            NormalizeEditorOrdering();
            _editor.PreferredCapabilities = Deserialize<List<string>>(_capabilitiesJson);
            _editor.ArchitectureContracts = Deserialize<List<string>>(_contractsJson);
            RefreshAdvancedJson();
            var saved = await TeamConfigurations.SaveAsync(new SaveCouncilTeamConfigurationRequest
            {
                Team = _editor,
                IsEnabled = _editor.IsEnabled,
                UserConfirmed = _confirmed
            }).ConfigureAwait(true);
            _selectedKey = saved.Key;
            _status = $"Saved '{saved.DisplayName}' with {saved.Roles.Count} role(s) and {CalculateExpandedRoundCount(saved.WorkflowSteps)} maximum expanded round(s).";
            _hasError = false;
            Notifier.ShowSuccess(nameof(CouncilTeams), _status, "Council team saved");
            _confirmed = false;
            await ReloadAsync().ConfigureAwait(true);
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or ArgumentException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "AI Council team configuration was rejected.");
            ComponentActivity.RecordFailure(nameof(CouncilTeams), nameof(SaveAsync), ex);
            _status = ex.Message;
            _hasError = true;
            Notifier.ShowError(nameof(CouncilTeams), ex.Message, "Council team rejected");
        }
        finally
        {
            _busy = false;
        }
    }


    private void ReviewConfirmationChanged()
    {
        _status = _confirmed
            ? "Review confirmed. The Save reviewed team button is ready."
            : "Review confirmation cleared.";
        _hasError = false;
    }

    private void TogglePreferredCapability(string functionName, ChangeEventArgs args)
    {
        _editor.PreferredCapabilities ??= [];
        var enabled = args.Value is bool value && value;
        _editor.PreferredCapabilities.RemoveAll(item => string.Equals(item, functionName, StringComparison.OrdinalIgnoreCase));
        if (enabled)
            _editor.PreferredCapabilities.Add(functionName);
        _editor.PreferredCapabilities = _editor.PreferredCapabilities
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(item => item, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _capabilitiesJson = Serialize(_editor.PreferredCapabilities);
        _confirmed = false;
    }

    private static string FunctionNamespace(DxAiFunctionCatalogEntry entry)
    {
        var name = entry.FunctionName?.Trim() ?? string.Empty;
        var separator = name.LastIndexOf('.');
        return separator > 0 ? name[..separator] : entry.Kind;
    }

    private void ToggleRuntimeClass(int roleIndex, string key, ChangeEventArgs args)
    {
        if (roleIndex < 0 || roleIndex >= _editor.Roles.Count)
            return;
        var role = _editor.Roles[roleIndex];
        role.RuntimeClassKeys ??= [];
        var enabled = args.Value is bool value && value;
        role.RuntimeClassKeys.RemoveAll(item => string.Equals(item, key, StringComparison.OrdinalIgnoreCase));
        if (enabled)
            role.RuntimeClassKeys.Add(key);
        role.RuntimeClassKeys = role.RuntimeClassKeys
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(item => item, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _confirmed = false;
    }

    private IReadOnlyList<CouncilRuntimeClassDefinition> RuntimeClassesFor(OrganicCouncilRoleDefinition role) =>
        _runtimeClasses
            .Where(item => role.RuntimeClassKeys.Contains(item.Key, StringComparer.OrdinalIgnoreCase))
            .OrderBy(item => item.Namespace, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private OrganicCouncilRoleDefinition? FindRolePolicy(string? roleName) =>
        _editor.Roles.FirstOrDefault(role =>
            !string.IsNullOrWhiteSpace(roleName) &&
            string.Equals(role.Role, roleName.Trim(), StringComparison.OrdinalIgnoreCase));

    private string WorkflowRolePolicyLabel(string? roleName)
    {
        var role = FindRolePolicy(roleName);
        return role is null
            ? "no matching role policy; all selected AIs"
            : $"{RoleAiBadge(role)}; {RoleHumanBadge(role)}";
    }

    private string RoleAiBadge(OrganicCouncilRoleDefinition role)
    {
        if (role.HumanParticipationMode == HumanParticipationMode.HumanOnly)
            return "Human only · 0 AI";
        return role.AiSelectionMode == CouncilRoleAiSelectionMode.AllSelected
            ? "All selected AIs"
            : role.MinimumAiParticipants == role.MaximumAiParticipants
                ? $"Random {role.MinimumAiParticipants} AI" + (role.MinimumAiParticipants == 1 ? string.Empty : "s")
                : $"Random {role.MinimumAiParticipants}–{role.MaximumAiParticipants} AIs";
    }

