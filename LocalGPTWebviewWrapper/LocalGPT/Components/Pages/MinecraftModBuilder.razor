@page "/minecraft-mod-builder"

@inject ILogger<MinecraftModBuilder> Logger
@inject INotificationService Notifier
@inject IMinecraftModWorkspaceService WorkspaceService
@inject INativeCommandRunner CommandRunner
@inject IChatClient? ChatClient
@inject IMultiModelCouncilService CouncilService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Minecraft Mod Builder</PageTitle>

<div class="mod-builder">
    <ToastWrapper Name="@toastName" />

    <section class="builder-panel">
        <div class="builder-header">
            <div>
                <h1>Minecraft Mod Builder</h1>
                <p>Generate a Java mod workspace, ask Ollama or the AI Council for a grounded plan, then run scoped build commands.</p>
            </div>
            <DxButton Text="Create Workspace"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Click="CreateWorkspaceAsync"
                      Enabled="@(!isBusy)" />
            <DxButton Text="Create Datapack ZIP"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Click="CreateDatapackZipAsync"
                      Enabled="@(!isBusy && IsDatapack)" />
        </div>

        <div class="form-grid">
            <label>
                Project name
                <input @bind="request.ProjectName" />
            </label>
            <label>
                Mod id
                <input @bind="request.ModId" />
            </label>
            <label>
                Package
                <input @bind="request.PackageName" />
            </label>
            <label>
                Minecraft version
                <input @bind="request.MinecraftVersion" />
            </label>
            <label>
                Loader
                <select @bind="request.Loader">
                    <option>Fabric Mod</option>
                    <option>NeoForge Mod</option>
                    <option>Paper Plugin</option>
                    <option>Datapack</option>
                    <option>Bedrock Add-on</option>
                </select>
            </label>
            <label>
                Java
                <input @bind="request.JavaVersion" />
            </label>
            <label>
                Gradle
                <input @bind="request.GradleVersion" />
            </label>
            <label>
                IDE
                <select @bind="request.Ide">
                    <option>Eclipse</option>
                    <option>IntelliJ IDEA</option>
                    <option>Visual Studio Code</option>
                </select>
            </label>
            <label class="checkbox-label" title="Adds a small item, command, and design brief for the Living Cities 0.1 sample.">
                <input type="checkbox" @bind="request.IncludeLivingCitiesStarter" />
                Living Cities starter
            </label>
        </div>

        <label class="wide-field">
            What should the mod do?
            <textarea @bind="request.Description" rows="8" placeholder="Example: Create a magic ore, a wand item, custom crafting recipes, and server-side commands to grant spell XP."></textarea>
        </label>

        <label class="wide-field">
            Council models
            <input @bind="councilModels" placeholder="gpt-oss:20b, qwen3-coder:30b" />
        </label>

        <label class="checkbox-label" title="When enabled, LocalGPT sends num_gpu=0 to Ollama for safer low-resource council tests. Turn it off only when you intentionally want a GPU-backed model run.">
            <input type="checkbox" @bind="useCpuOnlyCouncil" />
            CPU-only council
        </label>

        <div class="button-row">
            <DxButton Text="Ask AI For Plan"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Click="GeneratePlanAsync"
                      Enabled="@(!isBusy && ChatClient is not null)" />
            <DxButton Text="Ask AI Council"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Click="GenerateCouncilPlanAsync"
                      Enabled="@(!isBusy)" />
            <DxButton Text="Living Cities Prompt"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="LoadLivingCitiesPrompt"
                      Enabled="@(!isBusy)" />
        </div>
    </section>

    @if (workspace is not null)
    {
        <section class="builder-panel">
            <h2>Workspace</h2>
            <dl class="workspace-details">
                <dt>Root</dt>
                <dd>@workspace.RootPath</dd>
                <dt>Main class</dt>
                <dd>@workspace.MainClassPath</dd>
                <dt>Metadata</dt>
                <dd>@workspace.MetadataPath</dd>
                <dt>Build file</dt>
                <dd>@workspace.BuildFilePath</dd>
                <dt>Brief</dt>
                <dd>@workspace.ReadmePath</dd>
                <dt>Build command</dt>
                <dd>@workspace.BuildCommand</dd>
                <dt>IDE import</dt>
                <dd>@workspace.EclipseImportHint</dd>
            </dl>

            <div class="command-grid">
                <label>
                    Command
                    <input @bind="commandFileName" />
                </label>
                <label>
                    Arguments
                    <input @bind="commandArguments" />
                </label>
                <DxButton Text="Run Command"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="RunCommandAsync"
                          Enabled="@(!isBusy)" />
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(aiPlan))
    {
        <section class="builder-panel">
            <h2>AI Plan</h2>
            <div class="markdown-output">@((MarkupString)Markdig.Markdown.ToHtml(aiPlan).Trim())</div>
        </section>
    }

    @if (lastCouncilResult is not null)
    {
        <section class="builder-panel">
            <h2>AI Council Log</h2>
            <dl class="workspace-details">
                <dt>Models</dt>
                <dd>@string.Join(" + ", lastCouncilResult.ModelNames)</dd>
                <dt>Log</dt>
                <dd>@lastCouncilResult.LogPath</dd>
                <dt>Memory</dt>
                <dd>@lastCouncilResult.MemoryConversationId</dd>
            </dl>
        </section>
    }

    @if (lastCommandResult is not null)
    {
        <section class="builder-panel">
            <h2>Command Result</h2>
            <div class="result-summary">
                Exit code @lastCommandResult.ExitCode in @lastCommandResult.Duration.TotalSeconds.ToString("0.0")s
            </div>
            <pre>@lastCommandResult.StandardOutput</pre>
            @if (!string.IsNullOrWhiteSpace(artifactDownloadUrl))
            {
                <div class="download-row">
                    <a class="download-link" href="@artifactDownloadUrl" target="_blank" rel="noopener" download="@artifactFileName">Download Datapack ZIP</a>
                    <span>@artifactFileName</span>
                </div>
                <dl class="artifact-details">
                    <dt>HTTP GET</dt>
                    <dd><a href="@artifactDownloadUrl" target="_blank" rel="noopener">@artifactDownloadUrl</a></dd>
                    <dt>Local file</dt>
                    <dd>@artifactPath</dd>
                </dl>
                <div class="hint">
                    The download route is served by ASP.NET Core and constrained to the generated Minecraft workspace folder.
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(lastCommandResult.StandardError))
            {
                <pre class="error-output">@lastCommandResult.StandardError</pre>
            }
        </section>
    }
</div>

@code {
    string toastName = "MinecraftModBuilderToasts";
    MinecraftModBuildRequest request = new()
    {
        ProjectName = "LivingCities",
        ModId = "living_cities",
        PackageName = "com.localgpt.livingcities",
        Loader = "Datapack",
        IncludeLivingCitiesStarter = true,
        Description = LivingCitiesPrompt
    };

    MinecraftModWorkspace? workspace;
    CommandExecutionResult? lastCommandResult;
    MultiModelCouncilResult? lastCouncilResult;
    string aiPlan = string.Empty;
    string commandFileName = "powershell.exe";
    string commandArguments = "-NoProfile -ExecutionPolicy Bypass -File .\\build-local.ps1";
    string councilModels = "gpt-oss:20b";
    bool useCpuOnlyCouncil = true;
    string? artifactDownloadUrl;
    string? artifactDownloadRoute;
    string? artifactFileName;
    string? artifactPath;
    bool isBusy;
    bool IsDatapack => string.Equals(request.Loader, "Datapack", StringComparison.OrdinalIgnoreCase);

    static readonly string LivingCitiesPrompt = string.Join(Environment.NewLine, new[]
    {
        "Living Cities 0.1 should turn Minecraft villages into persistent cities with population, food, security, personalities, chronicle, quests, and town hall administration.",
        "",
        "First build target:",
        "- generate a vanilla Java Edition datapack first",
        "- keep the first generated datapack small, buildable, and installable",
        "- include pack.mcmeta, minecraft load/tick function tags, namespace functions, and build-local.ps1 validation",
        "- include a town hall/admin book UI through trigger commands",
        "- keep the critical path documented: datapack/data structure, scoreboards or saved data, city founding, citizen registration, population management, minimal town hall",
        "- avoid world-wide scans",
        "- plan for 1000+ citizens by simulating city aggregates before individuals"
    });

    async Task CreateWorkspaceAsync()
    {
        await RunUiActionAsync(async () =>
        {
            await CreateWorkspaceCoreAsync();
            if (workspace is not null)
                Notifier.ShowSuccess(toastName, workspace.RootPath, "Workspace created");
        }, "CreateWorkspaceAsync");
    }

    async Task CreateDatapackZipAsync()
    {
        await RunUiActionAsync(async () =>
        {
            await CreateWorkspaceCoreAsync();
            await RunCommandCoreAsync();
            if (lastCommandResult?.Succeeded == true && !string.IsNullOrWhiteSpace(artifactDownloadUrl))
                Notifier.ShowSuccess(toastName, artifactFileName ?? "Datapack ZIP", "Datapack ZIP ready");
        }, "CreateDatapackZipAsync");
    }

    async Task CreateWorkspaceCoreAsync()
    {
        workspace = await WorkspaceService.CreateWorkspaceAsync(request);
        ClearDownloadArtifact();
        lastCommandResult = null;
        commandFileName = "powershell.exe";
        commandArguments = "-NoProfile -ExecutionPolicy Bypass -File .\\build-local.ps1";
    }

    async Task GeneratePlanAsync()
    {
        if (ChatClient is null)
        {
            Notifier.ShowError(toastName, "No AI chat client is configured.", "AI unavailable");
            return;
        }

        await RunUiActionAsync(async () =>
        {
            var messages = new[]
            {
                new ChatMessage(ChatRole.System, CreateMinecraftSystemPrompt("single model")),
                new ChatMessage(ChatRole.User, CreatePlanningPrompt())
            };

            var response = await ChatClient.GetResponseAsync(messages);
            aiPlan = response.Text;
        }, "GeneratePlanAsync");
    }

    async Task GenerateCouncilPlanAsync()
    {
        await RunUiActionAsync(async () =>
        {
            var result = await CouncilService.RunAsync(new MultiModelCouncilRequest
            {
                ModelNames = ParseCouncilModels().ToList(),
                Prompt = CreatePlanningPrompt(),
                MaxRounds = 0,
                MaxOutputTokens = 1024,
                MaxParallelModels = 1,
                MaxContextTokens = 2048,
                ModelTimeoutSeconds = 300,
                OllamaKeepAlive = "0s",
                OllamaNumGpu = useCpuOnlyCouncil ? 0 : null,
                IncludeMemory = true,
                SaveToMemory = true
            });

            lastCouncilResult = result;
            aiPlan = result.FinalAnswer;
            Notifier.ShowSuccess(toastName, "Council plan saved to log and memory.", "AI Council complete");
        }, "GenerateCouncilPlanAsync");
    }

    async Task RunCommandAsync()
    {
        if (workspace is null)
        {
            Notifier.ShowError(toastName, "Create a workspace first.", "No workspace");
            return;
        }

        await RunUiActionAsync(async () =>
        {
            await RunCommandCoreAsync();
            if (lastCommandResult?.Succeeded == true)
                Notifier.ShowSuccess(toastName, "Command finished successfully.", "Command complete");
            else
                Notifier.ShowError(toastName, $"Exit code {lastCommandResult?.ExitCode.ToString() ?? "unknown"}", "Command failed");
        }, "RunCommandAsync");
    }

    async Task RunCommandCoreAsync()
    {
        if (workspace is null)
            throw new InvalidOperationException("Create a workspace first.");

        lastCommandResult = await CommandRunner.RunAsync(commandFileName, commandArguments, workspace.RootPath);
        if (lastCommandResult.Succeeded)
        {
            SetDownloadArtifact(workspace.RootPath);
        }
        else
        {
            ClearDownloadArtifact();
        }
    }

    void ClearDownloadArtifact()
    {
        artifactDownloadUrl = null;
        artifactDownloadRoute = null;
        artifactFileName = null;
        artifactPath = null;
    }

    void SetDownloadArtifact(string workspaceRoot)
    {
        if (workspace is null)
            return;

        var buildDirectory = Path.Combine(workspaceRoot, "build");
        if (!Directory.Exists(buildDirectory))
        {
            ClearDownloadArtifact();
            return;
        }

        var zip = Directory.GetFiles(buildDirectory, "*.zip", SearchOption.TopDirectoryOnly)
            .OrderByDescending(File.GetLastWriteTimeUtc)
            .FirstOrDefault();
        if (string.IsNullOrWhiteSpace(zip))
        {
            ClearDownloadArtifact();
            return;
        }

        artifactPath = zip;
        artifactFileName = Path.GetFileName(zip);
        var workspaceDirectory = Path.GetFileName(Path.TrimEndingDirectorySeparator(workspaceRoot));
        if (string.IsNullOrWhiteSpace(workspaceDirectory))
        {
            ClearDownloadArtifact();
            return;
        }

        artifactDownloadRoute = $"/__artifacts/minecraft/{Uri.EscapeDataString(workspaceDirectory)}/{Uri.EscapeDataString(artifactFileName)}";
        artifactDownloadUrl = Navigation.ToAbsoluteUri(artifactDownloadRoute).ToString();
    }

    string CreatePlanningPrompt() => string.Join(Environment.NewLine, new[]
    {
        "Build target:",
        $"- Loader: {request.Loader}",
        $"- Minecraft: {request.MinecraftVersion}",
        $"- Java: {request.JavaVersion}",
        $"- Gradle: {request.GradleVersion}",
        $"- IDE: {request.Ide}",
        $"- Project: {request.ProjectName}",
        $"- Mod id: {request.ModId}",
        $"- Package: {request.PackageName}",
        $"- Workspace root: {workspace?.RootPath ?? "not created yet"}",
        "",
        "User request:",
        request.Description,
        "",
        "Return:",
        "1. Architecture and classes.",
        "2. Files to create or edit.",
        "3. Java code strategy, or explain why this target is command/datapack-only.",
        "4. Assets/data files needed.",
        "5. Build and test commands.",
        "6. User setup steps for JDK, Gradle, Eclipse/Minecraft launcher, Ollama, and LocalGPT AI Council.",
        "7. Risks or missing details to ask the user.",
        "8. Missing feature report for LocalGPT if the builder lacks a needed capability.",
        "",
        "Council rules:",
        "- Work kindly with the other models and correct each other directly.",
        "- Do not claim the mod was compiled or run unless the transcript contains command output.",
        "- If setup is incomplete, make a short user decision poll instead of guessing.",
        "- Mark version-sensitive dependency claims as Needs verification unless proven by a build."
    });

    static string CreateMinecraftSystemPrompt(string mode) => string.Join(Environment.NewLine, new[]
    {
        $"You are a senior Minecraft Java mod engineer helping through LocalGPT in {mode}.",
        "Prefer Java Edition first. Treat Bedrock as a separate behavior/resource pack exporter.",
        "For Java code work, choose Fabric mod, NeoForge mod, or Paper plugin. For command-only vanilla systems, choose datapack.",
        "For modern Java mods/plugins, expect JDK 21, Gradle, an IDE such as Eclipse, and either Fabric, NeoForge, or Paper.",
        "Produce buildable, practical implementation plans with exact files, classes, registry steps, assets, data generation, and Gradle commands.",
        "For datapacks, produce pack.mcmeta, minecraft load/tick function tags, namespace functions, validation steps, and install instructions.",
        "Help the user set up their system when tooling is missing.",
        "If LocalGPT needs a missing feature, include a 'Missing feature report' section that can be saved to memory.",
        "Label uncertain dependency versions under 'Needs verification'."
    });

    IEnumerable<string> ParseCouncilModels() =>
        councilModels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(model => !string.IsNullOrWhiteSpace(model));

    void LoadLivingCitiesPrompt()
    {
        request.ProjectName = "LivingCities";
        request.ModId = "living_cities";
        request.PackageName = "com.localgpt.livingcities";
        request.MinecraftVersion = "1.21.4";
        request.Loader = "Datapack";
        request.IncludeLivingCitiesStarter = true;
        request.Description = LivingCitiesPrompt;
    }

    async Task RunUiActionAsync(Func<Task> action, string operation)
    {
        try
        {
            isBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception in {Operation}: {Message}", operation, ex.Message);
            Notifier.ShowError(toastName, ex.Message, $"Error in {operation}");
        }
        finally
        {
            isBusy = false;
        }
    }
}
