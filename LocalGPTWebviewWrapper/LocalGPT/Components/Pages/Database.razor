    async Task LoadTableAsync(SqliteTableSummary table)
    {
        try
        {
            await RunUiActionAsync(async () =>
        {
            SelectedTable = table;
            CurrentTable = await TableEditor.GetTableAsync(table.Name, RowLimit).ConfigureAwait(false);
            EditorOverrides = new Dictionary<string, SqliteEditorFieldOverride>(await EditorPreferences.GetOverridesAsync(table.Name).ConfigureAwait(false), StringComparer.OrdinalIgnoreCase);
            SessionEditorKinds.Clear();
            GridRows.Clear();
            foreach (var row in CurrentTable.Rows)
            {
                try
                {
                    var gridRow = GridPresentation.ToGridRow(row, Logger);
                    ArgumentNullException.ThrowIfNull(gridRow);
                    GridRows.Add(gridRow);
                }
                catch (Exception ex)
                {
                    Notifier.ShowWarning(toastName, "A row could not be displayed. See local application logs for details.", "Display warning");
                    Logger.LogWarning(ex, "A database row could not be converted for display; row content was omitted from logs.");
                }


            }
            SelectedRow = CurrentTable.Rows.FirstOrDefault();
            if (SelectedRow is not null)
                SelectSqliteRow(SelectedRow);
            else
                NewSqliteRow();
            statusText = $"Loaded {CurrentTable.Rows.Count} row(s) from {CurrentTable.TableName}.";
        }, "LoadTableAsync").ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
        }
    }

    void SelectSqliteRow(SqliteRowSnapshot row)
