@page "/database"
@using System.Dynamic
@using System.Globalization

@inject IChatMemoryService ChatMemory
@inject IApplicationLogReaderService ApplicationLogs
@inject ICouncilKnowledgeService CouncilKnowledge
@inject ISqliteTableEditorService TableEditor
@inject ILogger<Database> Logger
@inject INotificationService Notifier
@rendermode InteractiveServer

<PageTitle>SQLite Database</PageTitle>

<main class="database-page">
    <ToastWrapper Name="@toastName" />

    <section class="database-header">
        <div>
            <h1>SQLite Database</h1>
            <p>Inspect and edit LocalGPT memory, council knowledge, application logs, and other local tables.</p>
        </div>
        <DxButton Text="Refresh"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Enabled="@(!isBusy)"
                  Click="RefreshAllAsync" />
    </section>

    <section class="knowledge-panel">
        <div class="panel-heading">
            <div>
                <h2>Council Knowledge</h2>
                <p>Shared notes the council can reuse in future prompts. Edit this like a grounded project notebook.</p>
                <p class="hint">@KnowledgeReviewSummary</p>
            </div>
            <DxButton Text="New Knowledge"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Enabled="@(!isBusy)"
                      Click="NewKnowledgeEntry" />
        </div>

        <div class="knowledge-layout">
            <div>
                <DxGrid Data="@KnowledgeEntries"
                        PageSize="8"
                        ShowSearchBox="true"
                        CssClass="database-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.Topic)" Caption="Topic" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.Scope)" Caption="Scope" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.Tags)" Caption="Tags" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.Confidence)" Caption="Confidence" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.VerificationStatus)" Caption="Status" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.ReviewStatus)" Caption="Review" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.ExpiresAtUtc)" Caption="Expires UTC" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.LastVerifiedAtUtc)" Caption="Verified UTC" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.LastUsedAtUtc)" Caption="Used UTC" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.UpdatedAtUtc)" Caption="Updated UTC" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.IsUserApproved)" Caption="User Approved" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.IsPinned)" Caption="Pinned" />
                    </Columns>
                </DxGrid>
                <div class="selector-row">
                    <span title="Choose a knowledge entry to edit in the form.">
                        <DxComboBox Data="@KnowledgeEntries"
                                    Value="@SelectedKnowledgeEntry"
                                    TextFieldName="@nameof(CouncilKnowledgeEntry.Topic)"
                                    CssClass="knowledge-selector"
                                    ValueChanged="@((CouncilKnowledgeEntry entry) => SelectKnowledgeEntry(entry))" />
                    </span>
                </div>
            </div>

            <div class="editor-panel">
                <label title="Short name used by the council briefing.">
                    Topic
                    <DxTextBox @bind-Text="KnowledgeEdit.Topic" />
                </label>
                <label title="Use a scope such as AI Council, Minecraft Builder, DevExpress, setup, or diagnostics.">
                    Scope
                    <DxTextBox @bind-Text="KnowledgeEdit.Scope" />
                </label>
                <label title="The actual reusable note. Keep facts grounded and correct stale notes later.">
                    Content
                    <DxMemo @bind-Text="KnowledgeEdit.Content" Rows="7" />
                </label>
                <label title="Docs, official references, sample repositories, or URLs the council wants next time.">
                    Helpful Sources
                    <DxMemo @bind-Text="KnowledgeEdit.HelpfulSources" Rows="3" />
                </label>
                <label title="Semicolon-separated tags help the council and humans filter notes.">
                    Tags
                    <DxTextBox @bind-Text="KnowledgeEdit.Tags" />
                </label>
                <label title="Trust bucket used by the council. Suggested values: SourceBacked, UserVerified, ModelSuggested, NeedsVerification, Archived.">
                    Verification Status
                    <DxTextBox @bind-Text="KnowledgeEdit.VerificationStatus" />
                </label>
                <label title="Lifecycle bucket shown to humans and used by the council briefing filter.">
                    Review Status
                    <DxComboBox Data="@ReviewStatusOptions"
                                @bind-Value="KnowledgeEdit.ReviewStatus" />
                </label>
                <label title="Optional UTC date after which this note should stop influencing the council. Use ISO format such as 2026-06-30T12:00:00Z.">
                    Expires At UTC
                    <DxTextBox Text="@FormatNullableUtc(KnowledgeEdit.ExpiresAtUtc)"
                               TextChanged="@((string value) => KnowledgeEdit.ExpiresAtUtc = ParseNullableUtc(value))" />
                </label>
                <label title="UTC date when a human or source-backed import last verified this note.">
                    Last Verified UTC
                    <DxTextBox Text="@FormatNullableUtc(KnowledgeEdit.LastVerifiedAtUtc)"
                               TextChanged="@((string value) => KnowledgeEdit.LastVerifiedAtUtc = ParseNullableUtc(value))" />
                </label>
                <label title="Optional knowledge id that replaces this entry when Review Status is Superseded.">
                    Superseded By Knowledge Id
                    <DxTextBox Text="@FormatNullableGuid(KnowledgeEdit.SupersededByKnowledgeId)"
                               TextChanged="@((string value) => KnowledgeEdit.SupersededByKnowledgeId = ParseNullableGuid(value))" />
                </label>
                <label title="Why this note needs refresh, diagnostics, expiry, or replacement.">
                    Staleness Reason
                    <DxMemo @bind-Text="KnowledgeEdit.StalenessReason" Rows="2" />
                </label>
                <label title="Who or what detected the stale state. Examples: user, LocalGPT importer, DXAiChat parser, diagnostic route.">
                    Staleness Detected By
                    <DxTextBox @bind-Text="KnowledgeEdit.StalenessDetectedBy" />
                </label>
                <label title="Source fingerprint. Source-backed imports fill this automatically; humans can paste a source hash when needed.">
                    Source Hash
                    <DxTextBox @bind-Text="KnowledgeEdit.SourceHash" />
                </label>
                <label title="Optional UTC date of the source material this knowledge summarizes.">
                    Source Date UTC
                    <DxTextBox Text="@FormatNullableUtc(KnowledgeEdit.SourceDateUtc)"
                               TextChanged="@((string value) => KnowledgeEdit.SourceDateUtc = ParseNullableUtc(value))" />
                </label>
                <div class="form-row">
                    <label title="How reliable the note currently is.">
                        Confidence
                        <DxSpinEdit @bind-Value="KnowledgeEdit.Confidence" MinValue="0" MaxValue="100" />
                    </label>
                    <DxCheckBox @bind-Checked="KnowledgeEdit.IsUserApproved" Text="User approved" />
                    <DxCheckBox @bind-Checked="KnowledgeEdit.IsPinned" Text="Pinned" />
                    <DxCheckBox @bind-Checked="KnowledgeEdit.IsArchived" Text="Archived" />
                </div>
                <div class="run-row">
                    <DxButton Text="Mark Current"
                              RenderStyle="ButtonRenderStyle.Success"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="MarkKnowledgeCurrent" />
                    <DxButton Text="Needs Review"
                              RenderStyle="ButtonRenderStyle.Warning"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="MarkKnowledgeNeedsUserReview" />
                    <DxButton Text="Source Refresh"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="MarkKnowledgeNeedsSourceRefresh" />
                    <DxButton Text="Expired"
                              RenderStyle="ButtonRenderStyle.Danger"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="MarkKnowledgeExpired" />
                </div>
                <div class="run-row">
                    <DxButton Text="Save Knowledge"
                              RenderStyle="ButtonRenderStyle.Primary"
                              RenderStyleMode="ButtonRenderStyleMode.Contained"
                              Enabled="@(!isBusy)"
                              Click="SaveKnowledgeAsync" />
                    <DxButton Text="Delete Knowledge"
                              RenderStyle="ButtonRenderStyle.Danger"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy && SelectedKnowledgeEntry is not null)"
                              Click="DeleteKnowledgeAsync" />
                </div>
            </div>
        </div>
    </section>

    <section class="table-panel">
        <div class="panel-heading">
            <div>
                <h2>Live SQLite Tables</h2>
                <p>@TableEditor.DatabasePath</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(statusText))
            {
                <span class="status-text">@statusText</span>
            }
        </div>

        <div class="table-toolbar">
            <span title="Select any LocalGPT SQLite table except internal sqlite_* tables.">
                <DxComboBox Data="@Tables"
                            Value="@SelectedTable"
                            TextFieldName="@nameof(SqliteTableSummary.Name)"
                            CssClass="table-selector"
                            ValueChanged="@((SqliteTableSummary table) => SelectTableAsync(table))" />
            </span>
            <span title="Limit the preview size so large logs and chat history stay responsive.">
                <DxSpinEdit @bind-Value="RowLimit" MinValue="10" MaxValue="500" Increment="10" />
            </span>
            <DxButton Text="Load Table"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Enabled="@(!isBusy && SelectedTable is not null)"
                      Click="LoadSelectedTableAsync" />
            <DxButton Text="New Row"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Enabled="@(!isBusy && CurrentTable is not null)"
                      Click="NewSqliteRow" />
        </div>

        @if (Tables.Count > 0)
        {
            <DxGrid Data="@Tables"
                    PageSize="8"
                    CssClass="database-grid table-list">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(SqliteTableSummary.Name)" Caption="Table" />
                    <DxGridDataColumn FieldName="@nameof(SqliteTableSummary.RowCount)" Caption="Rows" />
                    <DxGridDataColumn FieldName="@nameof(SqliteTableSummary.ColumnCount)" Caption="Columns" />
                    <DxGridDataColumn FieldName="@nameof(SqliteTableSummary.HasPrimaryKey)" Caption="Primary Key" />
                </Columns>
            </DxGrid>
        }

        @if (CurrentTable is not null)
        {
            <div class="table-workspace">
                <div class="table-preview">
                    <h3>@CurrentTable.TableName</h3>
                    <DxGrid Data="@GridRows"
                            PageSize="15"
                            ShowSearchBox="true"
                            CssClass="database-grid">
                        <Columns>
                            <DxGridDataColumn FieldName="__rowid" Caption="rowid" />
                            @foreach (var column in CurrentTable.Columns)
                            {
                                <DxGridDataColumn FieldName="@column.Name" Caption="@column.Name" />
                            }
                        </Columns>
                    </DxGrid>
                </div>

                <div class="editor-panel">
                    <label title="Select a row to edit. Use New Row for insertion.">
                        Row
                        <DxComboBox Data="@CurrentTable.Rows"
                                    Value="@SelectedRow"
                                    TextFieldName="@nameof(SqliteRowSnapshot.DisplayName)"
                                    ValueChanged="@((SqliteRowSnapshot row) => SelectSqliteRow(row))" />
                    </label>
                    <p class="hint">Primary-key columns are shown but protected here. Type <code>[null]</code> to save NULL in editable columns.</p>
                    @foreach (var column in CurrentTable.Columns)
                    {
                        var value = GetEditValue(column.Name);
                        <label title="@BuildColumnTitle(column)">
                            @column.Name <small>@column.Type@if (column.IsPrimaryKey) { <text> primary key</text> }</small>
                            @if (IsLongTextColumn(column.Name, value))
                            {
                                <DxMemo Text="@value"
                                        TextChanged="@((string newValue) => SetEditValue(column.Name, newValue))"
                                        Rows="4"
                                        ReadOnly="@column.IsPrimaryKey" />
                            }
                            else
                            {
                                <DxTextBox Text="@value"
                                           TextChanged="@((string newValue) => SetEditValue(column.Name, newValue))"
                                           ReadOnly="@column.IsPrimaryKey" />
                            }
                        </label>
                    }
                    <div class="run-row">
                        <DxButton Text="Save Row"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Enabled="@(!isBusy && CurrentTable is not null)"
                                  Click="SaveSqliteRowAsync" />
                        <DxButton Text="Delete Row"
                                  RenderStyle="ButtonRenderStyle.Danger"
                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                  Enabled="@(!isBusy && SelectedRow is not null)"
                                  Click="DeleteSqliteRowAsync" />
                    </div>
                </div>
            </div>
        }
    </section>
</main>

@code {
    readonly string toastName = "DatabaseToasts";
    readonly string[] ReviewStatusOptions =
    [
        "Current",
        "NeedsUserReview",
        "NeedsSourceRefresh",
        "NeedsDiagnosticVerification",
        "Expired",
        "Deprecated",
        "Superseded",
        "Archived"
    ];

    List<CouncilKnowledgeEntry> KnowledgeEntries { get; set; } = [];
    CouncilKnowledgeEntry? SelectedKnowledgeEntry { get; set; }
    CouncilKnowledgeEntry KnowledgeEdit { get; set; } = CreateEmptyKnowledgeEntry();

    List<SqliteTableSummary> Tables { get; set; } = [];
    SqliteTableSummary? SelectedTable { get; set; }
    SqliteTableSnapshot? CurrentTable { get; set; }
    SqliteRowSnapshot? SelectedRow { get; set; }
    Dictionary<string, string?> RowEditValues { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    List<ExpandoObject> GridRows { get; set; } = [];
    int RowLimit { get; set; } = 100;
    bool isBusy;
    string statusText = string.Empty;
    string KnowledgeReviewSummary => BuildKnowledgeReviewSummary(KnowledgeEntries);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAllAsync();
    }

    async Task RefreshAllAsync()
    {
        await RunUiActionAsync(async () =>
        {
            await ChatMemory.EnsureCreatedAsync();
            await ApplicationLogs.EnsureCreatedAsync();
            await CouncilKnowledge.EnsureCreatedAsync();
            KnowledgeEntries = SortKnowledgeEntries(await CouncilKnowledge.GetEntriesAsync(includeArchived: true, take: 250));
            Tables = (await TableEditor.GetTablesAsync()).ToList();
            SelectedKnowledgeEntry = KnowledgeEntries.FirstOrDefault(entry => entry.Id == SelectedKnowledgeEntry?.Id) ?? KnowledgeEntries.FirstOrDefault();
            if (SelectedKnowledgeEntry is not null)
                SelectKnowledgeEntry(SelectedKnowledgeEntry);
            else
                NewKnowledgeEntry();

            if (SelectedTable is not null)
                SelectedTable = Tables.FirstOrDefault(table => table.Name.Equals(SelectedTable.Name, StringComparison.OrdinalIgnoreCase));
            SelectedTable ??= Tables.FirstOrDefault(table => table.Name.Equals("CouncilKnowledgeEntries", StringComparison.OrdinalIgnoreCase)) ?? Tables.FirstOrDefault();
            if (SelectedTable is not null)
                await LoadTableAsync(SelectedTable);

            statusText = $"Loaded {Tables.Count} table(s) and {KnowledgeEntries.Count} knowledge note(s).";
        }, "RefreshAllAsync");
    }

    void SelectKnowledgeEntry(CouncilKnowledgeEntry entry)
    {
        SelectedKnowledgeEntry = entry;
        KnowledgeEdit = CopyKnowledgeEntry(entry);
    }

    void NewKnowledgeEntry()
    {
        SelectedKnowledgeEntry = null;
        KnowledgeEdit = CreateEmptyKnowledgeEntry();
        statusText = "New council knowledge note ready.";
    }

    async Task SaveKnowledgeAsync()
    {
        await RunUiActionAsync(async () =>
        {
            KnowledgeEdit = await CouncilKnowledge.SaveEntryAsync(KnowledgeEdit);
            KnowledgeEntries = SortKnowledgeEntries(await CouncilKnowledge.GetEntriesAsync(includeArchived: true, take: 250));
            SelectedKnowledgeEntry = KnowledgeEntries.FirstOrDefault(entry => entry.Id == KnowledgeEdit.Id);
            if (SelectedKnowledgeEntry is not null)
                KnowledgeEdit = CopyKnowledgeEntry(SelectedKnowledgeEntry);
            await RefreshTablesOnlyAsync(loadSelectedTable: true);
            statusText = $"Saved knowledge note: {KnowledgeEdit.Topic}";
            Notifier.ShowSuccess(toastName, "Council knowledge saved to SQLite.", "Knowledge saved");
        }, "SaveKnowledgeAsync");
    }

    async Task DeleteKnowledgeAsync()
    {
        if (SelectedKnowledgeEntry is null)
            return;

        await RunUiActionAsync(async () =>
        {
            await CouncilKnowledge.DeleteEntryAsync(SelectedKnowledgeEntry.Id);
            SelectedKnowledgeEntry = null;
            KnowledgeEdit = CreateEmptyKnowledgeEntry();
            KnowledgeEntries = SortKnowledgeEntries(await CouncilKnowledge.GetEntriesAsync(includeArchived: true, take: 250));
            await RefreshTablesOnlyAsync(loadSelectedTable: true);
            statusText = "Deleted council knowledge note.";
            Notifier.ShowSuccess(toastName, "Council knowledge deleted.", "Knowledge deleted");
        }, "DeleteKnowledgeAsync");
    }

    void MarkKnowledgeCurrent()
    {
        ApplyKnowledgeReviewPreset("Current");
    }

    void MarkKnowledgeNeedsUserReview()
    {
        ApplyKnowledgeReviewPreset("NeedsUserReview");
    }

    void MarkKnowledgeNeedsSourceRefresh()
    {
        ApplyKnowledgeReviewPreset("NeedsSourceRefresh");
    }

    void MarkKnowledgeExpired()
    {
        ApplyKnowledgeReviewPreset("Expired");
    }

    void ApplyKnowledgeReviewPreset(string reviewStatus)
    {
        var now = DateTime.UtcNow;
        KnowledgeEdit.ReviewStatus = reviewStatus;
        switch (reviewStatus)
        {
            case "Current":
                KnowledgeEdit.IsArchived = false;
                KnowledgeEdit.IsUserApproved = true;
                KnowledgeEdit.VerificationStatus = KnowledgeEdit.VerificationStatus == "SourceBacked"
                    ? "SourceBacked"
                    : "UserVerified";
                KnowledgeEdit.LastVerifiedAtUtc = now;
                KnowledgeEdit.ExpiresAtUtc = null;
                KnowledgeEdit.StalenessReason = string.Empty;
                KnowledgeEdit.StalenessDetectedAtUtc = null;
                KnowledgeEdit.StalenessDetectedBy = string.Empty;
                break;
            case "NeedsUserReview":
                KnowledgeEdit.IsArchived = false;
                KnowledgeEdit.IsUserApproved = false;
                if (KnowledgeEdit.VerificationStatus is "SourceBacked" or "UserVerified")
                    KnowledgeEdit.VerificationStatus = "NeedsVerification";
                KnowledgeEdit.ExpiresAtUtc ??= now.AddDays(30);
                KnowledgeEdit.StalenessReason = Fallback(KnowledgeEdit.StalenessReason, "Needs user review before the council treats it as trusted knowledge.");
                KnowledgeEdit.StalenessDetectedAtUtc ??= now;
                KnowledgeEdit.StalenessDetectedBy = Fallback(KnowledgeEdit.StalenessDetectedBy, "Database editor");
                break;
            case "NeedsSourceRefresh":
                KnowledgeEdit.IsArchived = false;
                KnowledgeEdit.ExpiresAtUtc ??= now.AddDays(14);
                KnowledgeEdit.StalenessReason = Fallback(KnowledgeEdit.StalenessReason, "Source should be refreshed before reuse in generation.");
                KnowledgeEdit.StalenessDetectedAtUtc ??= now;
                KnowledgeEdit.StalenessDetectedBy = Fallback(KnowledgeEdit.StalenessDetectedBy, "Database editor");
                break;
            case "Expired":
                KnowledgeEdit.IsUserApproved = false;
                KnowledgeEdit.ExpiresAtUtc = now;
                KnowledgeEdit.StalenessReason = Fallback(KnowledgeEdit.StalenessReason, "Marked expired by the database editor.");
                KnowledgeEdit.StalenessDetectedAtUtc ??= now;
                KnowledgeEdit.StalenessDetectedBy = Fallback(KnowledgeEdit.StalenessDetectedBy, "Database editor");
                break;
        }

        statusText = $"Knowledge review status set to {reviewStatus}. Save the note to persist it.";
    }

    async Task SelectTableAsync(SqliteTableSummary table)
    {
        await LoadTableAsync(table);
    }

    async Task LoadSelectedTableAsync()
    {
        if (SelectedTable is not null)
            await LoadTableAsync(SelectedTable);
    }

    async Task LoadTableAsync(SqliteTableSummary table)
    {
        await RunUiActionAsync(async () =>
        {
            SelectedTable = table;
            CurrentTable = await TableEditor.GetTableAsync(table.Name, RowLimit);
            GridRows = CurrentTable.Rows.Select(ToGridRow).ToList();
            SelectedRow = CurrentTable.Rows.FirstOrDefault();
            if (SelectedRow is not null)
                SelectSqliteRow(SelectedRow);
            else
                NewSqliteRow();
            statusText = $"Loaded {CurrentTable.Rows.Count} row(s) from {CurrentTable.TableName}.";
        }, "LoadTableAsync");
    }

    void SelectSqliteRow(SqliteRowSnapshot row)
    {
        SelectedRow = row;
        RowEditValues = CurrentTable?.Columns.ToDictionary(
            column => column.Name,
            column => row.Values.TryGetValue(column.Name, out var value) ? value : null,
            StringComparer.OrdinalIgnoreCase) ?? new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    }

    void NewSqliteRow()
    {
        SelectedRow = null;
        RowEditValues = CurrentTable?.Columns.ToDictionary(
            column => column.Name,
            _ => (string?)null,
            StringComparer.OrdinalIgnoreCase) ?? new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        statusText = "New SQLite row ready.";
    }

    async Task SaveSqliteRowAsync()
    {
        if (CurrentTable is null)
            return;

        await RunUiActionAsync(async () =>
        {
            var editableValues = CurrentTable.Columns
                .Where(column => !column.IsPrimaryKey)
                .ToDictionary(
                    column => column.Name,
                    column => NormalizeCellValue(GetEditValue(column.Name)),
                    StringComparer.OrdinalIgnoreCase);

            if (SelectedRow is null)
            {
                await TableEditor.InsertRowAsync(CurrentTable.TableName, editableValues);
                statusText = $"Inserted row into {CurrentTable.TableName}.";
            }
            else
            {
                var updates = editableValues
                    .Select(pair => new SqliteCellUpdate { ColumnName = pair.Key, Value = pair.Value })
                    .ToList();
                await TableEditor.UpdateRowAsync(CurrentTable.TableName, SelectedRow.RowId, updates);
                statusText = $"Updated row {SelectedRow.RowId} in {CurrentTable.TableName}.";
            }

            await RefreshTablesOnlyAsync(loadSelectedTable: true);
            Notifier.ShowSuccess(toastName, "SQLite row saved.", "Database saved");
        }, "SaveSqliteRowAsync");
    }

    async Task DeleteSqliteRowAsync()
    {
        if (CurrentTable is null || SelectedRow is null)
            return;

        await RunUiActionAsync(async () =>
        {
            await TableEditor.DeleteRowAsync(CurrentTable.TableName, SelectedRow.RowId);
            statusText = $"Deleted row {SelectedRow.RowId} from {CurrentTable.TableName}.";
            await RefreshTablesOnlyAsync(loadSelectedTable: true);
            Notifier.ShowSuccess(toastName, "SQLite row deleted.", "Database saved");
        }, "DeleteSqliteRowAsync");
    }

    async Task RefreshTablesOnlyAsync(bool loadSelectedTable)
    {
        Tables = (await TableEditor.GetTablesAsync()).ToList();
        if (!loadSelectedTable || CurrentTable is null)
            return;

        var table = Tables.FirstOrDefault(item => item.Name.Equals(CurrentTable.TableName, StringComparison.OrdinalIgnoreCase));
        if (table is not null)
        {
            SelectedTable = table;
            CurrentTable = await TableEditor.GetTableAsync(table.Name, RowLimit);
            GridRows = CurrentTable.Rows.Select(ToGridRow).ToList();
            SelectedRow = CurrentTable.Rows.FirstOrDefault(row => row.RowId == SelectedRow?.RowId) ?? CurrentTable.Rows.FirstOrDefault();
            if (SelectedRow is not null)
                SelectSqliteRow(SelectedRow);
        }
    }

    string GetEditValue(string columnName)
    {
        return RowEditValues.TryGetValue(columnName, out var value) ? value ?? "[null]" : string.Empty;
    }

    void SetEditValue(string columnName, string value)
    {
        RowEditValues[columnName] = value;
    }

    static string? NormalizeCellValue(string value)
    {
        return value.Equals("[null]", StringComparison.OrdinalIgnoreCase) ? null : value;
    }

    static ExpandoObject ToGridRow(SqliteRowSnapshot row)
    {
        IDictionary<string, object?> expando = new ExpandoObject();
        expando["__rowid"] = row.RowId;
        foreach (var pair in row.Values)
            expando[pair.Key] = pair.Value;
        return (ExpandoObject)expando;
    }

    static bool IsLongTextColumn(string columnName, string value)
    {
        return value.Length > 120 ||
            columnName.Contains("Content", StringComparison.OrdinalIgnoreCase) ||
            columnName.Contains("Message", StringComparison.OrdinalIgnoreCase) ||
            columnName.Contains("Exception", StringComparison.OrdinalIgnoreCase) ||
            columnName.Contains("Sources", StringComparison.OrdinalIgnoreCase);
    }

    static string BuildColumnTitle(SqliteColumnSummary column)
    {
        var required = column.IsNotNull ? "required" : "nullable";
        var key = column.IsPrimaryKey ? " Primary keys are protected by the editor." : string.Empty;
        return $"{column.Name} ({column.Type}, {required}).{key}";
    }

    static List<CouncilKnowledgeEntry> SortKnowledgeEntries(IEnumerable<CouncilKnowledgeEntry> entries)
    {
        return entries
            .OrderBy(KnowledgeReviewPriority)
            .ThenByDescending(entry => entry.IsPinned)
            .ThenByDescending(entry => entry.IsUserApproved)
            .ThenByDescending(entry => entry.UpdatedAtUtc)
            .ToList();
    }

    static int KnowledgeReviewPriority(CouncilKnowledgeEntry entry)
    {
        return entry.ReviewStatus switch
        {
            "NeedsUserReview" => 0,
            "NeedsSourceRefresh" => 1,
            "NeedsDiagnosticVerification" => 2,
            "Expired" => 3,
            "Superseded" => 4,
            "Deprecated" => 5,
            "Current" => 6,
            "Archived" => 7,
            _ => 8
        };
    }

    static string BuildKnowledgeReviewSummary(IReadOnlyCollection<CouncilKnowledgeEntry> entries)
    {
        if (entries.Count == 0)
            return "No knowledge notes loaded yet.";

        var needsAttention = entries.Count(entry => entry.ReviewStatus is "NeedsUserReview" or "NeedsSourceRefresh" or "NeedsDiagnosticVerification" or "Expired");
        var trusted = entries.Count(entry => entry.ReviewStatus == "Current" && entry.IsUserApproved);
        return $"{needsAttention} note(s) need attention. {trusted} user-approved current note(s) can guide the council.";
    }

    static string FormatNullableUtc(DateTime? value)
    {
        return value?.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture) ?? string.Empty;
    }

    static DateTime? ParseNullableUtc(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return DateTime.TryParse(
            value,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var parsed)
            ? parsed
            : null;
    }

    static string FormatNullableGuid(Guid? value)
    {
        return value?.ToString("D") ?? string.Empty;
    }

    static Guid? ParseNullableGuid(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return Guid.TryParse(value, out var parsed) ? parsed : null;
    }

    static string Fallback(string value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

