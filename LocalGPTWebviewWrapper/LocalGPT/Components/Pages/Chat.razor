                GlobalVariableSlopCollectionToRemove.OllamaModeLimitedGpu => Math.Clamp(LimitedGpuLayers, 1, 99),
                _ => null
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in ResolveOllamaNumGpu: {ex.ToString()}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in ResolveOllamaNumGpu!");
            return 0;
        }

