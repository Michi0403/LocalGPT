    private void OnOllamaAccelerationModeChanged(ChangeEventArgs e)
    {
        try
        {
            var requestedMode = Convert.ToString(e.Value) ?? GlobalVariableSlopCollectionToRemove.OllamaModeAutoGpu;
            if (!CouncilChatStaticsGeneral.TryIsSupportedOllamaMode(requestedMode, Logger) ?? false)
                requestedMode = GlobalVariableSlopCollectionToRemove.OllamaModeAutoGpu;

            OllamaAccelerationMode = requestedMode;
            if (DxAiChat is not null)
                SaveMessagesForSelectedSession(DxAiChat.SaveMessages());

            RebuildDynamicSessions();
            modelStatus = OllamaAccelerationMode switch
            {
                GlobalVariableSlopCollectionToRemove.OllamaModeSafeCpu => "Ollama acceleration: Safe CPU. LocalGPT sends num_gpu=0.",
                GlobalVariableSlopCollectionToRemove.OllamaModeLimitedGpu => $"Ollama acceleration: Limited GPU. LocalGPT sends num_gpu={Math.Clamp(LimitedGpuLayers, 1, 99)}.",
                _ => "Ollama acceleration: Auto GPU. LocalGPT lets Ollama choose GPU offload."
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in OnOllamaAccelerationModeChanged: {ex.ToString()}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in OnOllamaAccelerationModeChanged!");
        }
    }

  

    private void ToggleCouncilModel(string modelName, ChangeEventArgs e)
    {
        try
        {
            var isChecked = e.Value is bool value && value;
            if (isChecked)
            {
                if (!SelectedCouncilModelNames.Contains(modelName, StringComparer.OrdinalIgnoreCase))
                    SelectedCouncilModelNames.Add(modelName);
            }
            else
            {
                SelectedCouncilModelNames.RemoveAll(name => name.Equals(modelName, StringComparison.OrdinalIgnoreCase));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in ToggleCouncilModel: {ex.ToString()} modelName {modelName}  e {e.ToString()}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in ToggleCouncilModel!");
        }
      
    }

