    private async Task SaveCurrentConversationAsync()
    {
        await PersistCurrentConversationAsync(force: true, showToast: true);
    }

    private async Task LoadLatestConversationAsync()
    {
        await LoadLatestConversationIntoSessionAsync(loadIntoDxChat: true);
    }

    private async Task LoadLatestConversationIntoSessionAsync(bool loadIntoDxChat)
    {
        if (SavedConversations.Count == 0)
            return;

        await LoadSavedConversationAsync(SavedConversations[0], saveCurrentFirst: false, loadIntoDxChat);
    }

    private async Task LoadSavedConversationAsync(ChatMemoryConversationSummary? conversation)
    {
        await LoadSavedConversationAsync(conversation, saveCurrentFirst: true, loadIntoDxChat: true);
    }

    private async Task LoadSavedConversationAsync(ChatMemoryConversationSummary? conversation, bool saveCurrentFirst, bool loadIntoDxChat)
    {
        if (conversation is null || ChatClientProvider?.SelectedSession is null)
            return;

        try
        {
            if (saveCurrentFirst)
                await PersistCurrentConversationAsync(force: true, showToast: false);

            isMemoryBusy = true;
            var snapshot = await ChatMemory.LoadConversationAsync(conversation.Id);
            if (snapshot is null)
                return;

            ActiveConversationId = snapshot.Id;
            SelectedConversation = conversation;
            ChatClientProvider.SelectedSession.Messages.Clear();
            ChatClientProvider.SelectedSession.Messages.AddRange(snapshot.Messages);
            lastSavedSignature = CreateMessageSignature(snapshot.Messages);
            memoryStatus = $"Loaded memory: {snapshot.Title}";

            if (loadIntoDxChat && DxAiChat is not null)
                DxAiChat.LoadMessages(snapshot.Messages);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadSavedConversationAsync failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.Message, "Memory load failed");
        }
        finally
        {
            isMemoryBusy = false;
        }
    }

    private async Task PersistCurrentConversationAsync(bool force, bool showToast)
    {
        if (DxAiChat is null)
            return;

        var messages = DxAiChat.SaveMessages().ToList();
        SaveMessagesForSelectedSession(messages);
        await PersistMessagesAsync(messages, force, showToast);
    }

    private async Task PersistMessagesAsync(IReadOnlyList<BlazorChatMessage> messages, bool force, bool showToast)
    {
        if (ChatClientProvider?.SelectedSession is null || messages.Count == 0)
            return;

        var signature = CreateMessageSignature(messages);
        if (!force && signature == lastSavedSignature)
            return;

        try
        {
            isMemoryBusy = true;
            ActiveConversationId = await ChatMemory.SaveConversationAsync(
                ChatClientProvider.SelectedSession.Name,
                messages,
                ActiveConversationId);

            lastSavedSignature = signature;
            await RefreshMemoryAsync();
            memoryStatus = $"Memory saved at {DateTime.Now:t}.";

            if (showToast)
                Notifier.ShowSuccess(toastName, "Chat saved to SQLite memory.", "Memory saved");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PersistMessagesAsync failed: {Message}", ex.Message);
            if (showToast)
                Notifier.ShowError(toastName, ex.Message, "Memory save failed");
        }
        finally
        {
            isMemoryBusy = false;
        }
    }

    private async Task RefreshMemoryAsync()
    {
        SavedConversations = (await ChatMemory.GetConversationsAsync()).ToList();
        RecentThoughts = (await ChatMemory.GetRecentThoughtsAsync()).ToList();

        if (ActiveConversationId is Guid id)
            SelectedConversation = SavedConversations.FirstOrDefault(conversation => conversation.Id == id);
        else
            SelectedConversation = SavedConversations.FirstOrDefault();
    }

    private void StartAutoSaveLoop()
    {
        if (autoSaveCts is not null)
            return;

        autoSaveCts = new CancellationTokenSource();
        _ = AutoSaveLoopAsync(autoSaveCts.Token);
    }

    private async Task AutoSaveLoopAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(12), cancellationToken);
                await InvokeAsync(async () => await PersistCurrentConversationAsync(force: false, showToast: false));
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Chat memory auto-save failed: {Message}", ex.Message);
            }
        }
    }

    private static string CreateMessageSignature(IEnumerable<BlazorChatMessage> messages)
    {
        return string.Join("|", messages
            .Where(message => !message.Typing)
            .Select(message => $"{message.Role}:{message.Content.GetHashCode(StringComparison.Ordinal)}:{message.Content.Length}"));
    }

    private static string RenderChatMarkdown(string? content)
    {
        var normalized = NormalizeChatMarkdown(content);
        return Markdig.Markdown.ToHtml(normalized, ChatMarkdownPipeline).Trim();
    }

    private static string NormalizeChatMarkdown(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;

        var text = System.Net.WebUtility.HtmlDecode(content);
        text = HarmonyMarkerCleanupRegex.Replace(text, string.Empty);
        text = text.Replace("</details>\n", "</details>\n\n", StringComparison.OrdinalIgnoreCase);
        text = ListAfterHtmlRegex.Replace(text, "$1\n\n$2");
        return text.Trim();
    }

    private sealed record DecodedChatUpload(string DisplayName, long SizeBytes, string Content, string Preview)
    {
        public int CharacterCount => Content.Length;
    }

    public void Dispose()
    {
        try
        {
            autoSaveCts?.Cancel();
            autoSaveCts?.Dispose();
            if (DxAiChat is not null)
                SaveMessagesForSelectedSession(DxAiChat.SaveMessages());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in Dispose: {ex.ToString()}");
        }
    }
