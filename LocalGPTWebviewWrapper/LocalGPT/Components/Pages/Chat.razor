            return session.Name.Contains(requestedSession, StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation {Operation} failed; request and generated payloads were omitted from logs.", "Exception");
