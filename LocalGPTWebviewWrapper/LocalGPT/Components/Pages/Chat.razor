    private static string NormalizeFormerThought(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var text = value.Trim();
        // Historical memories contain both literal and HTML-encoded pre/code wrappers.
        // Decode twice, then remove only presentation wrappers while retaining line breaks.
        text = System.Net.WebUtility.HtmlDecode(System.Net.WebUtility.HtmlDecode(text));
        text = Regex.Replace(text, @"<br\s*/?>", Environment.NewLine, RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"</?(?:pre|code)(?:\s[^>]*)?>", string.Empty, RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"```(?:[a-z0-9_+.-]+)?\s*", string.Empty, RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"\s*```", string.Empty, RegexOptions.IgnoreCase);
        text = Regex.Replace(text, @"</?(?:p|div|span)(?:\s[^>]*)?>", match =>
            match.Value.StartsWith("</", StringComparison.Ordinal) ? Environment.NewLine : string.Empty,
            RegexOptions.IgnoreCase);
        return Regex.Replace(text, @"(?:
?
){3,}", Environment.NewLine + Environment.NewLine).Trim();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            HumanCollaboration.Changed += OnHumanCollaborationChanged;
            await RefreshHumanCollaborationAsync().ConfigureAwait(false);
            ArchitectureUiStack = Catalog.ArchitectureUiStackOptions.FirstOrDefault() ?? string.Empty;
            ArchitectureSolutionShape = Catalog.ArchitectureSolutionShapeOptions.FirstOrDefault() ?? string.Empty;
            ArchitectureRenderMode = Catalog.ArchitectureRenderModeOptions.FirstOrDefault() ?? string.Empty;
            ArchitectureReferenceLook = Catalog.ArchitectureReferenceLookOptions.FirstOrDefault() ?? string.Empty;

            await LoadDatabaseBackedDefaultsAsync();
