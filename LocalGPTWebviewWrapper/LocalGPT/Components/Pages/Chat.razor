        try
        {
            autoSaveCts?.Cancel();
            autoSaveCts?.Dispose();
            if (DxAiChat is not null)
                SaveMessagesForSelectedSession(DxAiChat.SaveMessages());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
        }
    }
}
