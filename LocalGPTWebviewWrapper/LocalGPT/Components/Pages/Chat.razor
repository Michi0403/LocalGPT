@rendermode InteractiveServer
@page "/Chat"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using System.Text.Json
@inject CouncilRuntimeService CouncilRuntime
@inject ILocalGptRuntimePolicyDataService RuntimePolicy
@inject CouncilTextService CouncilText
@inject LocalGptCatalogService Catalog
@inject IChatMemoryService ChatMemory
@inject IMultiModelCouncilService CouncilService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IChatContentRenderer ChatContentRenderer
@inject IChatResponseFormatterFactory ChatResponseFormatterFactory
@inject IChatProtocolResolver ChatProtocolResolver
@inject IPromptConfigService PromptConfigService
@inject IDxAiFunctionRegistry DxAiFunctionRegistry
@inject IVariableStoreService VariableStore
@inject ISystemVariableDefinitionService SystemVariables
@inject ILocalGptProjectService ProjectService
@inject IModelPresetService ModelPresetService
@inject ICouncilTeamConfigurationService CouncilTeamConfigurations
@inject IChatSessionContext SessionContext
@inject IHumanCollaborationService HumanCollaboration
@inject ICouncilLiveSessionService CouncilLiveSessions
@inject ICouncilRunConfigurationService CouncilRunConfigurations
@inject IServiceScopeFactory ServiceScopeFactory
@inject ILocalHumanInteractionContext HumanAmbientContext
@implements IDisposable
@inject ILogger<Chat> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject ISupervisedTaskRunner TaskRunner

<PageTitle>AI Chat</PageTitle>

<div class="main-container @(IsLiveCouncilInteractionAvailable ? "chat-session-active" : string.Empty)" data-testid="chat-page">
    @if (ChatClientProvider is not null)
    {
        <ToastWrapper Name="@toastName" />
        <div class="chat-primary-actions" data-testid="chat-primary-actions">
            <DxButton Text="Start new chat"
                      CssClass="chat-new-session-button localgpt-rounded-action"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      IconCssClass="oi oi-plus"
                      Click="ClearHistoryAsync" />
        </div>
        <details class="chat-configuration-ribbon" data-testid="chat-configuration-ribbon">
            <summary title="Open provider, council, memory, project and architecture controls without taking space from the conversation.">
                <span>Chat configuration</span>
                <small>@(ChatClientProvider.SelectedSession?.Name ?? "No provider") · @CouncilEditorModelNames.Count council model@(CouncilEditorModelNames.Count == 1 ? string.Empty : "s")</small>
            </summary>
            <div class="chat-configuration-content">
        <nav class="chat-session-toolbar chat-navigation-actions" data-testid="chat-session-actions" aria-label="Chat actions">
            <strong>Chat actions</strong>
            <a class="btn btn-outline-secondary" href="/install" data-enhance-nav="false"><span class="oi oi-cog" aria-hidden="true"></span> Provider setup</a>
            <DxButton CssClass="localgpt-command-refresh-models" Text="Refresh local models"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      IconCssClass="oi oi-reload"
                      Enabled="@(!isModelRefreshBusy)"
                      Click="RefreshOllamaModelsAsync" />
            <a class="btn btn-outline-secondary" href="/onewire-security" data-enhance-nav="false"><span class="oi oi-lock-locked" aria-hidden="true"></span> 1-Wire Security</a>
            <a class="btn btn-outline-secondary" href="/council-teams" data-enhance-nav="false"><span class="oi oi-people" aria-hidden="true"></span> Council Teams</a>
            <a class="btn btn-outline-secondary" href="/test-lab#remote-knowledge" data-enhance-nav="false"><span class="oi oi-cloud-download" aria-hidden="true"></span> Import knowledge</a>
            <a class="btn btn-outline-secondary" href="/database" data-enhance-nav="false"><span class="oi oi-spreadsheet" aria-hidden="true"></span> Clean up data</a>
        </nav>

        <div class="chat-provider-row" data-testid="chat-top-controls">
            <label class="chat-provider-selector" title="Choose the local or cloud model for the next response.">
                <span>AI provider</span>
                <DxComboBox Data="@ModelsList"
                            Value="ChatClientProvider.SelectedSession"
                            CssClass="selector-container-combo-editor"
                            TextFieldName="@nameof(ChatClientSession.Name)"
                            ValueChanged="@((ChatClientSession session) => OnModelChanged(session))">
                    <ItemDisplayTemplate>
                        @if (context.DataItem is ChatClientSession session)
                        {
                            <div class="ai-kernel-option">
                                <strong>@session.ModelName</strong>
                                <small><span>@session.Provider</span>@if (!string.IsNullOrWhiteSpace(session.Endpoint)) { <span> · @session.Endpoint</span> }</small>
                            </div>
                        }
                    </ItemDisplayTemplate>
                    <EditBoxDisplayTemplate>
                        @if (context.DataItem is ChatClientSession session)
                        {
                            <div class="ai-kernel-option ai-kernel-selected">
                                <strong>@session.ModelName</strong>
                                <small><span>@session.Provider</span>@if (!string.IsNullOrWhiteSpace(session.Endpoint)) { <span> · @session.Endpoint</span> }</small>
                            </div>
                        }
                    </EditBoxDisplayTemplate>
                </DxComboBox>
            </label>
            <label class="inline-dx-check" title="Keeps the current chat visible when switching to another configured AI.">
                <DxCheckBox @bind-Checked="ReuseContextWhenSwitching" />
                <span>Reuse context when switching AI</span>
            </label>
            <label class="inline-dx-check" title="Loads the most recent saved memory thread automatically when the Chat page opens. Leave off for a clean local-model context.">
                <DxCheckBox @bind-Checked="AutoLoadLatestConversation" />
                <span>Auto-load latest memory</span>
            </label>
        </div>
        <details id="localgpt-council-controls" class="council-command-center" data-testid="council-command-center">
            <summary title="Open model, hardware, team and artifact settings for AI Council runs.">
                <span>AI Council controls</span>
                <small>@CouncilEditorModelNames.Count model@(CouncilEditorModelNames.Count == 1 ? string.Empty : "s") · @CouncilEditorResourceLoadPercent% power · @CouncilEditorMaxContextTokens.ToString("N0") context</small>
            </summary>
        <div class="model-toolbar" aria-label="DXAiChat model and council controls" data-testid="chat-model-toolbar">
            <span title="Finds currently installed Ollama models and adds them as DXAiChat choices without writing to setup configuration.">
                <DxButton CssClass="localgpt-rounded-action" Text="Refresh Ollama Models"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isModelRefreshBusy)"
                          Click="RefreshOllamaModelsAsync" />
            </span>
            <label class="ollama-mode-setting" title="Controls Ollama's num_gpu option for DXAiChat and AI Council. Auto GPU lets Ollama use your GPU; Safe CPU forces num_gpu=0; Limited GPU uses a partial GPU-layer cap.">
                <span>Ollama acceleration</span>
                <select value="@OllamaAccelerationMode" @onchange="OnOllamaAccelerationModeChanged">
                    <option value="@Catalog.OllamaModeAutoGpu">Auto GPU</option>
                    <option value="@Catalog.OllamaModeSafeCpu">Safe CPU</option>
                    <option value="@Catalog.OllamaModeLimitedGpu">Limited GPU</option>
                </select>
            </label>
            @if (OllamaAccelerationMode == Catalog.OllamaModeLimitedGpu)
            {
                <label class="council-token-setting" title="Ollama num_gpu layer cap used by Limited GPU mode. Lower this if the driver becomes unstable; raise it if generation is too slow and VRAM is available.">
                    <span>GPU layers</span>
                    <input type="number"
                           min="1"
                           max="99"
                           step="1"
                           @bind="LimitedGpuLayers" />
                </label>
            }
            <label class="inline-dx-check" title="When the AI Council session is selected, it can generate downloadable code, DLL, solution, or datapack artifacts for implementation requests.">
                <DxCheckBox @bind-Checked="GenerateCouncilArtifacts" />
                <span>Council downloadable artifacts</span>
            </label>
            <label class="inline-dx-check" title="Adds saved chat memory, logs, and local project guidance to AI Council prompts. Turn off for small frontend smoke tests or narrow reviews.">
                <DxCheckBox @bind-Checked="IncludeCouncilMemory" />
                <span>Council uses memory</span>
            </label>
            <label class="council-token-setting" title="Maximum answer tokens for the DXAiChat AI Council session. Use 262144 for full source or solution generation when the model/runtime supports it. Values below 64000 are quick-chat only and are not a valid code-generation acceptance test.">
                <span>Council answer tokens</span>
                <input type="number"
                       min="256"
                       max="262144"
                       step="1024"
                       value="@CouncilEditorMaxOutputTokens"
                       @onchange="OnCouncilMaxOutputTokensChanged" />
            </label>
            <label class="council-token-setting" title="Maximum Ollama context window requested for council and detected model sessions. Use 262144 for full source or solution generation when supported. Values below 64000 are quick-chat only and are not a valid code-generation acceptance test.">
                <span>Council context tokens</span>
                <input type="number"
                       min="2048"
                       max="262144"
                       step="2048"
                       value="@CouncilEditorMaxContextTokens"
                       @onchange="OnCouncilMaxContextTokensChanged" />
            </label>
            <label class="council-token-setting" title="Number of peer critique/refinement rounds after the initial proposal. One is the balanced default; three is the most thorough and slowest mode.">
                <span>Peer review rounds</span>
                <input type="number"
                       min="0"
                       max="3"
                       step="1"
                       @bind="CouncilCritiqueRounds" />
            </label>
            <label class="council-load-setting" title="Sets the session position between every selected model's own minimum and maximum CPU/GPU road values. 30% means min + 30% of that model's configured range.">
                <span>Hardware load</span>
                <input type="range" min="0" max="100" step="5" value="@CouncilEditorResourceLoadPercent" @oninput="OnCouncilResourceLoadChanged" />
                <output>@CouncilEditorResourceLoadPercent%</output>
            </label>
            @if (!string.IsNullOrWhiteSpace(modelStatus))
            {
                <span class="memory-status">@modelStatus</span>
            }
        </div>
        @if (OllamaCandidates.Count > 0)
        {
            <div class="council-picker" aria-label="DXAiChat council model picker">
                <div>
                    <strong>DXAiChat Council Members</strong>
                    <span class="memory-status">Select the models used by the "AI Council" chat choice.</span>
                </div>
                <div class="council-member-list">
                    @foreach (var candidate in OllamaCandidates)
                    {
                        <label title="@CouncilRuntime.BuildCandidateTitle(candidate,Logger)">
                            <input type="checkbox"
                                   checked="@SelectedCouncilModelNames.Contains(candidate.ModelName)"
                                   @onchange="@((ChangeEventArgs e) => ToggleCouncilModel(candidate.ModelName, e))" />
                            <span class="council-kernel-label">
                                <strong>@candidate.ModelName</strong>
                                <small><span>@candidate.Provider · @candidate.Endpoint</span>@if (candidate.IsLoaded) { <span> · loaded</span> }</small>
                            </span>
                        </label>
                    }
                </div>
            </div>
        }
        <details class="council-road-details" data-testid="council-hardware-road-editor">
            <summary>Hardware spooler and per-model CPU/GPU roads</summary>
            @if (EditingRunningCouncilConfiguration)
            {
                <p class="memory-status live-council-settings-status">
                    Editing only running Council @ActiveCouncilRunShortId, revision @ActiveCouncilConfigurationRevision.
                    Each model reads the newest revision immediately before its next Ollama request starts. Other runs and saved presets remain unchanged.
                </p>
            }
            <CouncilHardwareRoadEditor ModelNames="CouncilEditorModelNames"
                                       Routes="@CouncilEditorRoutes"
                                       ResourceLoadPercent="CouncilEditorResourceLoadPercent"
                                       Changed="OnHardwareRoadsChanged" />
        </details>
        <div class="model-toolbar council-preset-toolbar" aria-label="AI Council model presets" data-testid="council-model-presets">
            <label title="Load a database-backed preset for council model selection and runtime limits.">
                <span>Model preset</span>
                <select value="@SelectedModelPresetValue" @onchange="OnModelPresetChangedAsync">
                    <option value="">Custom selection</option>
                    @foreach (var preset in ModelPresets)
                    {
                        <option value="@preset.Id">@preset.Name@(preset.IsDefault ? " (default)" : string.Empty)</option>
                    }
                </select>
            </label>
            <label title="Saving updates an existing preset with the same name instead of creating duplicates.">
                <span>Preset name</span>
                <input @bind="ModelPresetName" maxlength="160" placeholder="My council team" />
            </label>
            <label class="inline-dx-check" title="Creates a database-first project/revision for each explicit AI Council run when no project is selected.">
                <DxCheckBox @bind-Checked="CreateProjectPerCouncilRun" />
                <span>New project per council run</span>
            </label>
            <DxButton CssClass="localgpt-rounded-action" Text="Save Preset"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Enabled="@(!isModelPresetBusy && SelectedCouncilModelNames.Count > 0 && !string.IsNullOrWhiteSpace(ModelPresetName))"
                      Click="SaveModelPresetAsync" />
            <DxButton CssClass="localgpt-rounded-action" Text="Archive Preset"
                      RenderStyle="ButtonRenderStyle.Danger"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Enabled="@(!isModelPresetBusy && SelectedModelPreset is not null)"
                      Click="ArchiveModelPresetAsync" />
        </div>
        <div class="memory-toolbar council-team-toolbar" aria-label="AI Council team and heartbeat configuration" data-testid="council-team-picker">
            <label title="Selects the database-backed roles, prompts and heartbeat workflow for the next AI Council run.">
                <span>Council team</span>
                <select @bind="SelectedCouncilTeamKey">
                    @foreach (var team in CouncilTeams)
                    {
                        <option value="@team.Key">@team.DisplayName</option>
                    }
                </select>
            </label>
            <span class="memory-status">Roles, preparation prompts and heartbeat scripts are stored in SQLite and can be adjusted without replacing compiled services.</span>
            <a class="btn btn-outline-secondary btn-sm" href="/council-teams" data-enhance-nav="false">Edit teams and workflow</a>
        </div>
        </details>
        <details id="localgpt-memory-controls" class="chat-memory-project-center">
            <summary title="Open saved memory and project-version controls.">
                <span>Memory & project context</span>
                <small>@(SelectedChatProjectDetails?.Project.Name ?? "No project selected")</small>
            </summary>
        <div class="memory-toolbar" aria-label="Chat memory controls">
            <span title="Writes the current DXAiChat messages into the local SQLite memory database.">
                <DxButton CssClass="localgpt-rounded-action" Text="Save Memory"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isMemoryBusy)"
                          Click="SaveCurrentConversationAsync" />
            </span>
            <span title="Loads the most recently saved conversation and its former model thoughts.">
                <DxButton CssClass="localgpt-rounded-action" Text="Recall Latest"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isMemoryBusy && SavedConversations.Count > 0)"
                          Click="LoadLatestConversationAsync" />
            </span>
            <span title="Pick an older saved chat from the SQLite memory database.">
                <DxComboBox Data="@SavedConversations"
                            Value="@SelectedConversation"
                            CssClass="memory-selector"
                            TextFieldName="@nameof(ChatMemoryConversationSummary.DisplayName)"
                            ValueChanged="@((ChatMemoryConversationSummary conversation) => LoadSavedConversationAsync(conversation))" />
            </span>
            @if (!string.IsNullOrWhiteSpace(memoryStatus))
            {
                <span class="memory-status">@memoryStatus</span>
            }
        </div>
        <div class="memory-toolbar" aria-label="Chat project and release context" data-testid="chat-project-context">
            <label title="Optionally links this chat and its function calls to a LocalGPT project.">
                <span>Project</span>
                <select value="@SelectedChatProjectValue" @onchange="OnChatProjectChangedAsync">
                    <option value="">No project</option>
                    @foreach (var project in ChatProjects)
                    {
                        <option value="@project.Id">@project.DisplayName</option>
                    }
                </select>
            </label>
            <label title="Links the chat to an exact saved project version for traceability.">
                <span>Project version</span>
                <select value="@SelectedChatProjectVersionValue"
                        @onchange="OnChatProjectVersionChangedAsync"
                        disabled="@(SelectedChatProjectDetails is null)">
                    <option value="">Current / unspecified</option>
                    @if (SelectedChatProjectDetails is not null)
                    {
                        @foreach (var version in SelectedChatProjectDetails.Versions.OrderByDescending(item => item.CreatedAtUtc))
                        {
                            <option value="@version.Id">@version.Version@(version.IsCurrent ? " (current)" : string.Empty)</option>
                        }
                    }
                </select>
            </label>
            <span class="memory-status">LocalGPT @SessionContext.ApplicationVersion</span>
        </div>
        </details>
        @if (RecentThoughts.Count > 0)
        {
            <div class="memory-thoughts" data-localgpt-details-host>
                <div class="memory-thoughts-title">Former model thoughts</div>
                @foreach (var thought in RecentThoughts.Take(3))
                {
                    <details data-localgpt-panel-key="@($"former-thought-{thought.ConversationId:N}")">
                        <summary>@thought.ConversationTitle</summary>
                        <div class="former-thought-content" data-localgpt-copyable="true">@CouncilText.NormalizeFormerThought(thought.Thinking, Logger)</div>
                    </details>
                }
            </div>
        }
        <details class="architecture-poll">
            <summary>
                <span>Optional architecture choices</span>
                <small>Open only when you want to decide now. Otherwise the AI should ask with a runtime poll before coding.</small>
            </summary>
            <div class="architecture-poll-grid">
                <label title="Choose whether generated UI should use DevExpress components, plain Blazor, another UI stack, or ask at runtime.">
                    <span>UI stack</span>
                    <select @bind="ArchitectureUiStack">
                        @foreach (var option in Catalog.ArchitectureUiStackOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label title="Choose whether the generated work should be one solution, split into backend/frontend projects, or ask at runtime.">
                    <span>Solution shape</span>
                    <select @bind="ArchitectureSolutionShape">
                        @foreach (var option in Catalog.ArchitectureSolutionShapeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label title="Choose the hosting/runtime model. This is not limited to Blazor; use Ask when the app target is unclear.">
                    <span>Runtime/rendering</span>
                    <select @bind="ArchitectureRenderMode">
                        @foreach (var option in Catalog.ArchitectureRenderModeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label title="Choose how closely generated UI should recreate the reference application, or ask at runtime.">
                    <span>Reference look</span>
                    <select @bind="ArchitectureReferenceLook">
                        @foreach (var option in Catalog.ArchitectureReferenceLookOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
            </div>
            <div class="architecture-poll-actions">
                <label class="architecture-consent" title="When checked, the council may choose remaining non-dangerous sandbox defaults if your prompt already describes the intended design well enough. It still may not integrate features into LocalGPT without explicit approval.">
                    <input type="checkbox" @bind="AllowCouncilToChooseSandboxDetails" />
                    <span>Let council choose safe sandbox details when my design intent is clear</span>
                </label>
                <label title="Optional detail for the next council answer, for example an app to recode or special backend constraints.">
                    <span>Extra direction</span>
                    <input type="text"
                           @bind="ArchitecturePollNotes"
                           placeholder="Example: ask me first if target platform, framework, data model, or deployment are unclear." />
                </label>
                <DxButton CssClass="localgpt-rounded-action" Text="Add Decision To Chat"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="AddArchitecturePollToChatAsync" />
                <DxButton CssClass="localgpt-rounded-action" Text="Reset"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Click="ResetArchitecturePoll" />
            </div>
            @if (!string.IsNullOrWhiteSpace(ArchitecturePollStatus))
            {
                <p class="memory-status">@ArchitecturePollStatus</p>
            }
        </details>
            </div>
        </details>
        <ChatGameConsole ConversationId="@ActiveConversationId" SuggestedTeamKey="@SelectedCouncilTeamKey" />
        <div id="localgpt-chat-host" data-testid="dxaichat-host">
            <DxAIChat Initialized="ChatInitialized"
                      MaxTokens="int.MaxValue"
                      ResponseContentFormat="ResponseContentFormat.Markdown"
                      UseStreaming="true"
                      FileUploadEnabled="true"
                      @ref="DxAiChat"
                      CssClass="demo-chat"
                      IncludeFunctionCallInfo="true">
                <PromptSuggestions>
                    @foreach (var suggestion in PromptSuggestions)
                    {
                        <DxAIChatPromptSuggestion Title="@suggestion.Title"
                                                  Text="@suggestion.Text"
                                                  PromptMessage="@suggestion.PromptMessage" />
                    }
                </PromptSuggestions>
                <MessageContentTemplate >
                    @{
                        var liveCouncilMessage = ResolveLiveCouncilMessage(context.Content);
                    }
                    <div class="demo-chat-content" data-localgpt-details-host data-localgpt-copyable="true">
                        @(new MarkupString(ChatContentRenderer.Render(context.Content)))
                        @if (liveCouncilMessage?.IsRunning == true)
                        {
                            <div class="localgpt-message-utility-row localgpt-live-update-footer">
                                <span class="localgpt-rejoined-live-status" role="status" aria-live="polite">
                                    <span class="localgpt-rejoined-live-spinner" aria-hidden="true"></span>
                                    Council @ShortCouncilRunId(liveCouncilMessage.RunId) is still running. Waiting for the next streamed update…
                                </span>
                            </div>
                        }
                    </div>
                </MessageContentTemplate>
                <AIChatSettings>
                    <DxAIChatFileUploadSettings 
                        MaxFileCount="@Catalog.MaxUploadFiles"
                        MaxFileSize="@Catalog.MaxUploadBytes" />
                </AIChatSettings>

            </DxAIChat>
        </div>
        <details class="chat-session-tools-ribbon" data-testid="chat-session-tools-ribbon">
            <summary>
                <span>Running session tools</span>
                <small>@(ActiveCouncilRun is not null
                    ? $"Round {ActiveCouncilRun.CurrentRound} · {ActiveCouncilRun.Phase}"
                    : ActiveLiveCouncilSession is not null
                        ? $"Live run {ShortCouncilRunId(ActiveLiveCouncilSession.RunId)}"
                        : "No Council heartbeat is running")</small>
            </summary>
            <div class="chat-session-tools-content">
        <div class="memory-toolbar human-live-contribution" aria-label="Join and add information to a running AI Council" data-testid="live-council-participation">
            <label title="Join any council heartbeat that is still running in this LocalGPT process.">
                <span>Running Council session</span>
                <select value="@SelectedCouncilRunValue"
                        @onchange="OnActiveCouncilRunChanged"
                        disabled="@(RunningLiveCouncilSessions.Count == 0)">
                    @if (RunningLiveCouncilSessions.Count == 0)
                    {
                        <option value="">No Council heartbeat is running</option>
                    }
                    else
                    {
                        @foreach (var session in RunningLiveCouncilSessions)
                        {
                            var run = collaborationSnapshot.ActiveRuns.FirstOrDefault(item => item.RunId == session.RunId);
                            var runState = run is null ? "live" : $"round {run.CurrentRound} · {run.Phase}";
                            <option value="@session.RunId">@CouncilText.FormatLiveCouncilSessionOption(session.StartedAtUtc, runState, session.CouncilMembers)</option>
                        }
                    }
                </select>
            </label>
            <DxButton CssClass="localgpt-rounded-action" Text="Rejoin selected Council"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Enabled="@CanRejoinSelectedCouncilRun"
                      Click="RejoinSelectedCouncilSessionAsync" />
            <DxButton CssClass="localgpt-rounded-action" Text="Stop active Council"
                      RenderStyle="ButtonRenderStyle.Danger"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Enabled="@IsLiveCouncilInteractionAvailable"
                      Click="StopSelectedCouncilSessionAsync" />
            <DxButton CssClass="localgpt-rounded-action" Text="Refresh running sessions"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="RefreshHumanCollaborationAsync" />
            <DxButton CssClass="localgpt-rounded-action" Text="Skip current round"
                      RenderStyle="ButtonRenderStyle.Danger"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Enabled="@(ActiveCouncilRun is not null)"
                      Click="SkipCurrentCouncilRoundAsync" />
            @if (!collaborationSnapshot.Profile.IsEnabled)
            {
                <DxButton CssClass="localgpt-rounded-action" Text="Enable human participation"
                          RenderStyle="ButtonRenderStyle.Success"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="EnableHumanParticipationAsync" />
            }
            else
            {
                <span class="badge text-bg-success">Human Council member enabled</span>
            }
            <label title="This does not cancel the current model. It enters at the next council heartbeat as a human peer contribution.">
                <span>Ask AI Assistant / Council correction</span>
                <input type="text"
                       @bind="RunningCouncilContribution"
                       disabled="@(!IsLiveCouncilInteractionAvailable)"
                       placeholder="Add a correction or new information. Without a member/topic target it is shared with all Council members at the next heartbeat." />
            </label>
            <DxButton CssClass="localgpt-rounded-action" Text="Share without stopping generation"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Enabled="@(collaborationSnapshot.Profile.IsEnabled && IsLiveCouncilInteractionAvailable && !string.IsNullOrWhiteSpace(RunningCouncilContribution))"
                      Click="QueueRunningCouncilContributionAsync" />
            @if (ActiveCouncilRun is not null)
            {
                <span class="memory-status">Joined run @ActiveCouncilRunShortId · round @ActiveCouncilRun.CurrentRound · @ActiveCouncilRun.Phase</span>
            }
            else if (ActiveLiveCouncilSession is not null)
            {
                <span class="memory-status">Rejoined live run @ActiveCouncilRunShortId. Stop and direct-message controls remain connected to the running Council.</span>
            }
            else
            {
