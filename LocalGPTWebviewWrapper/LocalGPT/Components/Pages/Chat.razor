    private async Task LoadDatabaseBackedDefaultsAsync()
    {
        await MigrateCouncilDefaultsAsync().ConfigureAwait(false);
        await TryApplyDatabaseVariableAsync<int>(
            "DefaultMaxOutputTokens",
            value => CouncilMaxOutputTokens = Math.Clamp(
                value,
                LocalGptCatalogService.MinCouncilOutputTokens,
                LocalGptCatalogService.MaxCouncilOutputTokens));
        await TryApplyDatabaseVariableAsync<int>(
            "DefaultContextTokens",
            value => CouncilMaxContextTokens = Math.Clamp(
                value,
                LocalGptCatalogService.MinCouncilContextTokens,
                LocalGptCatalogService.MaxCouncilContextTokens));
        await TryApplyDatabaseVariableAsync<int>(
            "DefaultHeavyModelGpuLayers",
            value => LimitedGpuLayers = Math.Clamp(value, 1, 99));
        await TryApplyDatabaseVariableAsync<int>(
            "DefaultCouncilResourceLoadPercent",
            value => CouncilResourceLoadPercent = Math.Clamp((int)Math.Round(value / 5d) * 5, 0, 100));
        await TryApplyDatabaseVariableAsync<int>(
            "DefaultCouncilCritiqueRounds",
            value => CouncilCritiqueRounds = Math.Clamp(value, 0, 3));
        await TryApplyDatabaseVariableAsync<string>(
            "DefaultOllamaEndpoint",
            value => DefaultOllamaEndpoint = string.IsNullOrWhiteSpace(value)
                ? LocalGptCatalogService.DefaultOllamaEndpoint
                : value.Trim());
    }

    private async Task MigrateCouncilDefaultsAsync()
    {
        const int targetVersion = 2;
        try
        {
            int version;
            try { version = await VariableStore.GetAsync<int>("CouncilDefaultsVersion").ConfigureAwait(false); }
            catch { version = 0; }
            if (version >= targetVersion) return;

            try
            {
                var previousLoad = await VariableStore.GetAsync<int>("DefaultCouncilResourceLoadPercent").ConfigureAwait(false);
                if (previousLoad == 30)
                    await VariableStore.SetAsync("DefaultCouncilResourceLoadPercent", 100).ConfigureAwait(false);
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "The previous Council power default was unavailable during migration.");
            }

            await VariableStore.SetAsync("CouncilDefaultsVersion", targetVersion).ConfigureAwait(false);
            Logger.LogInformation("Migrated AI Council defaults to version {Version}.", targetVersion);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not migrate AI Council defaults; compiled defaults remain available.");
        }
    }

    private async Task TryApplyDatabaseVariableAsync<T>(string name, Action<T> apply)
    {
        try
        {
            apply(await VariableStore.GetAsync<T>(name));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "Could not apply database-backed Chat default {VariableName}; retaining the compiled fallback.",
                name);
            ComponentActivity.RecordWarning(nameof(Chat), "ApplyDatabaseDefault", "A database-backed Chat default was unavailable; LocalGPT retained its compiled fallback.");
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || isDisposed)
            return Task.CompletedTask;

        try
        {
            interactiveAttached = true;
            StartAutoSaveLoop();
            StartInitialModelRefresh();
            Logger.LogInformation("Chat interactive render attached; background refresh and auto-save supervision are active.");
            ComponentActivity.RecordInformation(nameof(Chat), "InteractiveAttach", "The Chat page attached to the interactive circuit.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not finish the Chat interactive attach sequence.");
            ComponentActivity.RecordFailure(nameof(Chat), "InteractiveAttach", ex);
            Notifier.ShowError(toastName, "Chat could not finish attaching to the interactive UI. See local logs for details.", "Chat attach error");
        }

        return Task.CompletedTask;
    }

