    private async Task LoadSavedConversationAsync(ChatMemoryConversationSummary? conversation, bool saveCurrentFirst, bool loadIntoDxChat)
    {
        try
        {
            if (conversation is null || ChatClientProvider?.SelectedSession is null)
                return;

            try
            {
                if (saveCurrentFirst)
                    await PersistCurrentConversationAsync(force: true, showToast: false).ConfigureAwait(false);

                isMemoryBusy = true;
                var snapshot = await ChatMemory.LoadConversationAsync(conversation.Id).ConfigureAwait(false);
                if (snapshot is null)
                    return;

                ActiveConversationId = snapshot.Id;
                SelectedConversation = conversation;
                ChatClientProvider.SelectedSession.Messages.Clear();
                ChatClientProvider.SelectedSession.Messages.AddRange(snapshot.Messages);
                lastSavedSignature = CouncilChatStringFunctions.CreateMessageSignature(snapshot.Messages, Logger);
                memoryStatus = $"Loaded memory: {snapshot.Title}";

                if (loadIntoDxChat && DxAiChat is not null)
                    DxAiChat.LoadMessages(snapshot.Messages);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "LoadSavedConversationAsync failed: {Message}", ex.Message);
                Notifier.ShowError(toastName, ex.Message, "Memory load failed");
            }
            finally
            {
                isMemoryBusy = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in LoadSavedConversationAsync: {ex.ToString()} conversation {conversation?.ToString()} saveCurrentFirst {saveCurrentFirst} loadIntoDxChat {loadIntoDxChat}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in LoadSavedConversationAsync!");
        }
        
    }

    private async Task PersistCurrentConversationAsync(bool force, bool showToast)
    {
        try
        {
            if (DxAiChat is null)
                return;

            var messages = DxAiChat.SaveMessages().ToList();
            SaveMessagesForSelectedSession(messages);
            await PersistMessagesAsync(messages, force, showToast).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in PersistCurrentConversationAsync: {ex.ToString()} force {force} showToast {showToast}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in PersistCurrentConversationAsync!");
        }
  
    }

    private async Task PersistMessagesAsync(IReadOnlyList<BlazorChatMessage> messages, bool force, bool showToast)
    {
        try
        {
            if (ChatClientProvider?.SelectedSession is null || messages.Count == 0)
                return;

            var signature = CouncilChatStringFunctions.CreateMessageSignature(messages, Logger);
            if (!force && signature == lastSavedSignature)
                return;

            try
            {
                isMemoryBusy = true;
                ActiveConversationId = await ChatMemory.SaveConversationAsync(
                    ChatClientProvider.SelectedSession.Name,
                    messages,
                    ActiveConversationId).ConfigureAwait(false);

                lastSavedSignature = signature;
                await RefreshMemoryAsync().ConfigureAwait(false);
                memoryStatus = $"Memory saved at {DateTime.Now:t}.";

                if (showToast)
                    Notifier.ShowSuccess(toastName, "Chat saved to SQLite memory.", "Memory saved");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "PersistMessagesAsync failed: {Message}", ex.Message);
                if (showToast)
                    Notifier.ShowError(toastName, ex.Message, "Memory save failed");
            }
            finally
            {
                isMemoryBusy = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in PersistCurrentConversationAsync: {ex.ToString()} messages {messages.ToString()} force {force} showToast {showToast}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in PersistCurrentConversationAsync!");
        }
       
    }

    private async Task RefreshMemoryAsync()
    {
        try
        {
            SavedConversations = (await ChatMemory.GetConversationsAsync().ConfigureAwait(false)).ToList();
            RecentThoughts = (await ChatMemory.GetRecentThoughtsAsync().ConfigureAwait(false)).ToList();

            if (ActiveConversationId is Guid id)
                SelectedConversation = SavedConversations.FirstOrDefault(conversation => conversation.Id == id);
            else
                SelectedConversation = SavedConversations.FirstOrDefault();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in RefreshMemoryAsync: {ex.ToString()}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in RefreshMemoryAsync!");
        }
       
    }

    private void StartAutoSaveLoop()
    {
        try
        {
            if (autoSaveCts is not null)
                return;

            autoSaveCts = new CancellationTokenSource();
            _ = AutoSaveLoopAsync(autoSaveCts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in StartAutoSaveLoop: {ex.ToString()}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in StartAutoSaveLoop!");
        }
      
    }

    private async Task AutoSaveLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(12), cancellationToken).ConfigureAwait(false);
                    await InvokeAsync(async () => await PersistCurrentConversationAsync(force: false, showToast: false).ConfigureAwait(false)).ConfigureAwait(false);
                }
                catch (OperationCanceledException ex)
                {
                    Logger.LogInformation(ex, "AutoSaveLoopAsync cancelled: {Message}", ex.Message);
                    break;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Chat memory auto-save failed: {Message}", ex.Message);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in AutoSaveLoopAsync: {ex.ToString()}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in AutoSaveLoopAsync!");
        }
        
    }

    public void Dispose()
    {
        try
        {
            autoSaveCts?.Cancel();
            autoSaveCts?.Dispose();
            if (DxAiChat is not null)
                SaveMessagesForSelectedSession(DxAiChat.SaveMessages());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in Dispose: {ex.ToString()}");
        }
    }
