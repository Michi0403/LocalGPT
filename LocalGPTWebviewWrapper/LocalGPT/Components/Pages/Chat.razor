@page "/Chat"
@using System.IO.Compression
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using System.Text.RegularExpressions

@inject ILogger<Chat> Logger
@inject INotificationService Notifier
@inject IChatMemoryService ChatMemory
@inject IMultiModelCouncilService CouncilService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@implements IDisposable
<PageTitle>AI Chat</PageTitle>

<div class="main-container">
    @if (ChatClientProvider is not null)
    {
        <ToastWrapper Name="@toastName" />

        <div class="top-container">
            <span title="Clears the visible chat and starts a fresh memory thread.">
                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          IconCssClass="refresh"
                          IconPosition="ButtonIconPosition.BeforeText"
                          CssClass="refresh-button"
                          Text="Start New Chat"
                          Click="ClearHistoryAsync" />
            </span>
            <span title="Choose the local or cloud model for the next response.">
                <DxComboBox Data="@ModelsList"
                            Value="ChatClientProvider.SelectedSession"
                            CssClass="selector-container-combo-editor"
                            TextFieldName="@nameof(ChatClientSession.Name)"
                            ValueChanged="@((ChatClientSession session) => OnModelChanged(session))" />
            </span>
            <label class="inline-dx-check" title="Keeps the current chat visible when switching to another configured AI.">
                <DxCheckBox @bind-Checked="ReuseContextWhenSwitching" />
                <span>Reuse context when switching AI</span>
            </label>
            <label class="inline-dx-check" title="Loads the most recent saved memory thread automatically when the Chat page opens. Leave off for a clean local-model context.">
                <DxCheckBox @bind-Checked="AutoLoadLatestConversation" />
                <span>Auto-load latest memory</span>
            </label>
        </div>
        <div class="model-toolbar" aria-label="DXAiChat model and council controls">
            <span title="Finds currently installed Ollama models and adds them as DXAiChat choices without writing to setup configuration.">
                <DxButton Text="Refresh Ollama Models"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isModelRefreshBusy)"
                          Click="RefreshOllamaModelsAsync" />
            </span>
            <label class="ollama-mode-setting" title="Controls Ollama's num_gpu option for DXAiChat and AI Council. Auto GPU lets Ollama use your GPU; Safe CPU forces num_gpu=0; Limited GPU uses a partial GPU-layer cap.">
                <span>Ollama acceleration</span>
                <select value="@OllamaAccelerationMode" @onchange="OnOllamaAccelerationModeChanged">
                    <option value="@OllamaModeAutoGpu">Auto GPU</option>
                    <option value="@OllamaModeSafeCpu">Safe CPU</option>
                    <option value="@OllamaModeLimitedGpu">Limited GPU</option>
                </select>
            </label>
            @if (OllamaAccelerationMode == OllamaModeLimitedGpu)
            {
                <label class="council-token-setting" title="Ollama num_gpu layer cap used by Limited GPU mode. Lower this if the driver becomes unstable; raise it if generation is too slow and VRAM is available.">
                    <span>GPU layers</span>
                    <input type="number"
                           min="1"
                           max="99"
                           step="1"
                           @bind="LimitedGpuLayers" />
                </label>
            }
            <label class="inline-dx-check" title="When the AI Council session is selected, it can generate downloadable code, DLL, solution, or datapack artifacts for implementation requests.">
                <DxCheckBox @bind-Checked="GenerateCouncilArtifacts" />
                <span>Council downloadable artifacts</span>
            </label>
            <label class="inline-dx-check" title="Adds saved chat memory, logs, and local project guidance to AI Council prompts. Turn off for small frontend smoke tests or narrow reviews.">
                <DxCheckBox @bind-Checked="IncludeCouncilMemory" />
                <span>Council uses memory</span>
            </label>
            <label class="council-token-setting" title="Maximum answer tokens for the DXAiChat AI Council session. Use 32768+ for source generation; lower it for quick checks.">
                <span>Council answer tokens</span>
                <input type="number"
                       min="256"
                       max="131072"
                       step="1024"
                       @bind="CouncilMaxOutputTokens" />
            </label>
            <label class="council-token-setting" title="Maximum Ollama context window requested for council and detected model sessions. Lower this if Ollama reports context or VRAM errors.">
                <span>Council context tokens</span>
                <input type="number"
                       min="2048"
                       max="131072"
                       step="2048"
                       @bind="CouncilMaxContextTokens" />
            </label>
            @if (!string.IsNullOrWhiteSpace(modelStatus))
            {
                <span class="memory-status">@modelStatus</span>
            }
        </div>
        @if (OllamaCandidates.Count > 0)
        {
            <div class="council-picker" aria-label="DXAiChat council model picker">
                <div>
                    <strong>DXAiChat Council Members</strong>
                    <span class="memory-status">Select the models used by the "AI Council" chat choice.</span>
                </div>
                <div class="council-member-list">
                    @foreach (var candidate in OllamaCandidates)
                    {
                        <label title="@candidate.Details">
                            <input type="checkbox"
                                   checked="@SelectedCouncilModelNames.Contains(candidate.ModelName)"
                                   @onchange="@((ChangeEventArgs e) => ToggleCouncilModel(candidate.ModelName, e))" />
                            <span>@candidate.ModelName</span>
                            @if (candidate.IsLoaded)
                            {
                                <small>loaded</small>
                            }
                        </label>
                    }
                </div>
            </div>
        }
        <div class="memory-toolbar" aria-label="Chat memory controls">
            <span title="Writes the current DXAiChat messages into the local SQLite memory database.">
                <DxButton Text="Save Memory"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isMemoryBusy)"
                          Click="SaveCurrentConversationAsync" />
            </span>
            <span title="Loads the most recently saved conversation and its former model thoughts.">
                <DxButton Text="Recall Latest"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isMemoryBusy && SavedConversations.Count > 0)"
                          Click="LoadLatestConversationAsync" />
            </span>
            <span title="Pick an older saved chat from the SQLite memory database.">
                <DxComboBox Data="@SavedConversations"
                            Value="@SelectedConversation"
                            CssClass="memory-selector"
                            TextFieldName="@nameof(ChatMemoryConversationSummary.DisplayName)"
                            ValueChanged="@((ChatMemoryConversationSummary conversation) => LoadSavedConversationAsync(conversation))" />
            </span>
            @if (!string.IsNullOrWhiteSpace(memoryStatus))
            {
                <span class="memory-status">@memoryStatus</span>
            }
        </div>
        @if (RecentThoughts.Count > 0)
        {
            <div class="memory-thoughts">
                <div class="memory-thoughts-title">Former model thoughts</div>
                @foreach (var thought in RecentThoughts.Take(3))
                {
                    <details>
                        <summary>@thought.ConversationTitle</summary>
                        <p>@thought.Thinking</p>
                    </details>
                }
            </div>
        }
        <details class="architecture-poll">
            <summary>
                <span>Optional architecture choices</span>
                <small>Open only when you want to decide now. Otherwise the AI should ask with a runtime poll before coding.</small>
            </summary>
            <div class="architecture-poll-grid">
                <label title="Choose whether generated UI should use DevExpress components, plain Blazor, another UI stack, or ask at runtime.">
                    <span>UI stack</span>
                    <select @bind="ArchitectureUiStack">
                        @foreach (var option in ArchitectureUiStackOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label title="Choose whether the generated work should be one solution, split into backend/frontend projects, or ask at runtime.">
                    <span>Solution shape</span>
                    <select @bind="ArchitectureSolutionShape">
                        @foreach (var option in ArchitectureSolutionShapeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label title="Choose the hosting/runtime model. This is not limited to Blazor; use Ask when the app target is unclear.">
                    <span>Runtime/rendering</span>
                    <select @bind="ArchitectureRenderMode">
                        @foreach (var option in ArchitectureRenderModeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label title="Choose how closely generated UI should recreate the reference application, or ask at runtime.">
                    <span>Reference look</span>
                    <select @bind="ArchitectureReferenceLook">
                        @foreach (var option in ArchitectureReferenceLookOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
            </div>
            <div class="architecture-poll-actions">
                <label title="Optional detail for the next council answer, for example an app to recode or special backend constraints.">
                    <span>Extra direction</span>
                    <input type="text"
                           @bind="ArchitecturePollNotes"
                           placeholder="Example: ask me first if target platform, framework, data model, or deployment are unclear." />
                </label>
                <DxButton Text="Add Decision To Chat"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="AddArchitecturePollToChatAsync" />
                <DxButton Text="Reset"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Click="ResetArchitecturePoll" />
            </div>
            @if (!string.IsNullOrWhiteSpace(ArchitecturePollStatus))
            {
                <p class="memory-status">@ArchitecturePollStatus</p>
            }
        </details>
        <details class="chat-file-context" open>
            <summary>
                <span>Upload text or zip context</span>
                <small>Decoded content can be added to DXAiChat before asking for code, datapacks, or review.</small>
            </summary>
            <div class="chat-file-context-grid">
                <InputFile OnChange="OnContextFilesSelectedAsync" multiple />
                <DxButton Text="Add Upload Context To Chat"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isUploadBusy && UploadedContexts.Count > 0)"
                          Click="AddUploadedContextToChatAsync" />
                <DxButton Text="Clear Uploads"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isUploadBusy && UploadedContexts.Count > 0)"
                          Click="ClearUploadedContext" />
            </div>
            @if (!string.IsNullOrWhiteSpace(uploadStatus))
            {
                <p class="memory-status">@uploadStatus</p>
            }
            @if (UploadedContexts.Count > 0)
            {
                <div class="upload-context-list">
                    @foreach (var upload in UploadedContexts)
                    {
                        <details>
                            <summary>@upload.DisplayName (@upload.CharacterCount chars)</summary>
                            <pre>@upload.Preview</pre>
                        </details>
                    }
                </div>
            }
        </details>
        <DxAIChat Initialized="ChatInitialized" ResponseContentFormat="ResponseContentFormat.Markdown" UseStreaming="true" FileUploadEnabled="true" @ref="DxAiChat" CssClass="demo-chat">
            <PromptSuggestions>
                @foreach (var suggestion in PromptSuggestions)
                {
                    <DxAIChatPromptSuggestion Title="@suggestion.Title"
                                              Text="@suggestion.Text"
                                              PromptMessage="@suggestion.PromptMessage" />
                }
            </PromptSuggestions>
            <MessageContentTemplate>
                <div class="demo-chat-content">
                    @(new MarkupString(RenderChatMarkdown(context.Content)))
                </div>
            </MessageContentTemplate>
            <AIChatSettings>
                <DxAIChatFileUploadSettings MaxFileCount="2"
                                            MaxFileSize="4000000"
                                            AllowedFileExtensions="@(new List<string> { ".txt", ".md", ".json", ".xml", ".csv", ".cs", ".razor", ".css", ".js", ".ts", ".mcfunction", ".zip" })"
                                            FileTypeFilter="@(new List<string> { "text/*", "application/json", "application/xml", "application/zip", "application/x-zip-compressed" })" />
            </AIChatSettings>

        </DxAIChat>
    }
    else
    {
        <div class="title-header-text">No ChatClient Initialized</div>
        <div class="title-content-text">Welcome to your LocalChatGPT, go to the Setup Page to Setup the AI Chat Clients</div>
    }
</div>

@code {
    [Inject]
    IChatClient? ChatClient { get; set; }
    CompositeChatClient? ChatClientProvider => ChatClient as CompositeChatClient;
    DxAIChat? DxAiChat { get; set; }
    List<ChatClientSession> ModelsList => ChatClientProvider?.AvailableChatClients ?? new();
    string toastName = "ChatToasts";
    const string DetectedOllamaSessionPrefix = "Ollama detected — ";
    const string CouncilSessionName = "AI Council — selected Ollama models";
    const string DefaultOllamaEndpoint = "http://127.0.0.1:11434";
    bool ReuseContextWhenSwitching { get; set; } = true;
    bool AutoLoadLatestConversation { get; set; }
    bool UseFreshDiagnosticChat { get; set; }
    const string OllamaModeAutoGpu = "auto-gpu";
    const string OllamaModeSafeCpu = "safe-cpu";
    const string OllamaModeLimitedGpu = "limited-gpu";
    const int MinCouncilOutputTokens = 256;
    const int DefaultCouncilOutputTokens = 32768;
    const int MaxCouncilOutputTokens = 131072;
    const int MinCouncilContextTokens = 2048;
    const int DefaultCouncilContextTokens = 32768;
    const int MaxCouncilContextTokens = 131072;
    string OllamaAccelerationMode { get; set; } = OllamaModeAutoGpu;
    int LimitedGpuLayers { get; set; } = 20;
    bool GenerateCouncilArtifacts { get; set; } = true;
    bool IncludeCouncilMemory { get; set; } = true;
    string? DiagnosticRequestedSessionName { get; set; }
    int CouncilMaxOutputTokens { get; set; } = DefaultCouncilOutputTokens;
    int CouncilMaxContextTokens { get; set; } = DefaultCouncilContextTokens;
    static readonly string[] ArchitectureUiStackOptions =
    [
        "Ask me before choosing UI stack",
        "DevExpress Blazor components",
        "Plain Blazor components",
        "No UI / backend or tool only",
        "Other target-specific UI"
    ];
    static readonly string[] ArchitectureSolutionShapeOptions =
    [
        "Ask me before choosing solution shape",
        "Single cohesive solution",
        "Split backend and frontend projects",
        "Library/plugin/package only",
        "Datapack/mod workspace only"
    ];
    static readonly string[] ArchitectureRenderModeOptions =
    [
        "Ask me before choosing runtime/rendering",
        "Blazor Server / InteractiveServer",
        "Blazor WebAssembly with ASP.NET Core backend",
        "Static SSR plus interactive islands",
        "ASP.NET Core API / backend only",
        "Desktop wrapper / WebView2",
        "Minecraft Java/datapack runtime",
        "CLI/tooling runtime"
    ];
    static readonly string[] ArchitectureReferenceLookOptions =
    [
        "Ask me before choosing visual fidelity",
        "Recreate the goal app look closely",
        "Use LocalGPT style but preserve goal app structure",
        "Functional prototype first",
        "No visual reference"
    ];
    string ArchitectureUiStack { get; set; } = ArchitectureUiStackOptions[0];
    string ArchitectureSolutionShape { get; set; } = ArchitectureSolutionShapeOptions[0];
    string ArchitectureRenderMode { get; set; } = ArchitectureRenderModeOptions[0];
    string ArchitectureReferenceLook { get; set; } = ArchitectureReferenceLookOptions[0];
    string ArchitecturePollNotes { get; set; } = string.Empty;
    string ArchitecturePollStatus { get; set; } = string.Empty;
    List<PromptSuggestion> PromptSuggestions { get; set; } = new();
    List<ChatMemoryConversationSummary> SavedConversations { get; set; } = new();
    List<ChatMemoryThought> RecentThoughts { get; set; } = new();
    List<MultiModelCouncilModelCandidate> OllamaCandidates { get; set; } = new();
    List<string> SelectedCouncilModelNames { get; set; } = new();
    List<string> DiagnosticCouncilModelNames { get; set; } = new();
    ChatMemoryConversationSummary? SelectedConversation { get; set; }
    Guid? ActiveConversationId { get; set; }
    string memoryStatus = string.Empty;
    string modelStatus = string.Empty;
    string uploadStatus = string.Empty;
    bool isMemoryBusy;
    bool isModelRefreshBusy;
    bool isUploadBusy;
    CancellationTokenSource? autoSaveCts;
    string lastSavedSignature = string.Empty;
    List<DecodedChatUpload> UploadedContexts { get; set; } = new();
    static readonly MarkdownPipeline ChatMarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();
    static readonly Regex HarmonyMarkerCleanupRegex = new("<\\|[^|>]+\\|>", RegexOptions.CultureInvariant | RegexOptions.Compiled);
    static readonly Regex ListAfterHtmlRegex = new("(?i)(</(?:p|details|pre|div)>)\\s*((?:[-*]|\\d+\\.)\\s+)", RegexOptions.CultureInvariant | RegexOptions.Compiled);
    const long MaxUploadBytes = 4 * 1024 * 1024;
    const int MaxUploadFiles = 5;
    const int MaxDecodedCharactersPerFile = 40_000;
    const int MaxDecodedCharactersTotal = 120_000;

    protected override async Task OnInitializedAsync()
    {
        PromptSuggestions = GetSuggestion();
        await RefreshMemoryAsync();
        ApplyDiagnosticQueryOptions(selectSession: false);
        await RefreshOllamaModelsAsync(showToast: false);
        ApplyDiagnosticQueryOptions(selectSession: true);
        if (UseFreshDiagnosticChat)
        {
            ClearSelectedSessionForFreshStart();
            memoryStatus = "Diagnostic fresh chat: saved memory was not auto-loaded into the selected model.";
        }
        else if (AutoLoadLatestConversation)
        {
            await LoadLatestConversationIntoSessionAsync(loadIntoDxChat: false);
        }
        else if (SavedConversations.Count > 0)
        {
            memoryStatus = "Saved memory is available. Click Load latest memory when you want to continue an older chat.";
        }
    }

    void ChatInitialized()
    {
        ApplyDiagnosticQueryOptions(selectSession: true);
        LoadSelectedSessionMessages();
        StartAutoSaveLoop();
    }

    public List<PromptSuggestion> GetSuggestion()
    {
        return new List<PromptSuggestion>() {
        new PromptSuggestion("Recall memory", "Use saved chats and former thoughts", "Review your saved LocalGPT memory and former model thoughts, then summarize what you remember about this project and continue from that context."),
        new PromptSuggestion("Minecraft target choice", "Pick Fabric, NeoForge, Paper, or datapack", "Act as a LocalGPT AI Council member. Compare Fabric mod, NeoForge mod, Paper plugin, vanilla datapack, and future Bedrock add-on for my request. Recommend one target, explain setup, and create a short poll if a decision or missing tool blocks progress."),
        new PromptSuggestion("Minecraft mod plan", "Plan a buildable Java mod or plugin", "Act as a senior Minecraft Java engineer. Create a buildable Fabric, NeoForge, or Paper plan with exact classes, registry or command steps, assets/data files, Gradle commands, and risks. If LocalGPT is missing a needed feature, include a 'Missing feature report' section."),
        new PromptSuggestion("Minecraft datapack", "Generate vanilla datapack files", "Generate a vanilla Minecraft Java datapack. Include pack.mcmeta, load/tick function tags, namespace functions, scoreboard/storage design, validation steps, install commands, and performance notes. If AI Council downloadable artifacts are enabled, create a download-ready datapack zip."),
        new PromptSuggestion("Datapack debug", "Find why /function cannot see files", "Debug a Minecraft Java datapack whose function is not visible in /function. Check zip root layout, pack.mcmeta, pack_format, singular/plural function folders for the target version, load/tick tags, namespace/path casing, .mcfunction.txt mistakes, storage syntax, and provide exact file tree fixes."),
        new PromptSuggestion("Living Cities datapack", "Generate a phased Living Cities datapack", "Use the Living Cities 0.1 technical plan as the target. Produce a buildable, download-ready datapack zip plus optional Java follow-up steps, file paths, commands, scoreboard/storage design, and performance notes for 1000+ citizens."),
        new PromptSuggestion("Missing features", "Write gaps to report file", "Review LocalGPT as a Minecraft mod builder. List missing features, blocked workflows, and required backend/frontend capabilities under a 'Missing feature report' heading."),
        new PromptSuggestion("Write an email", "Make your text look and sound professional", "Format text as a formal email to a client:"),
        new PromptSuggestion("Brainstorm ideas", "Get creative input for your tasks", "Help me brainstorm ideas for:"),
        new PromptSuggestion("Fix my writing", "Avoid spelling, grammar, and style errors", "Proofread the following text:"),
    };
    }

    private async Task ClearHistoryAsync()
    {
        try
        {
            if (ChatClientProvider?.SelectedSession is null || DxAiChat is null)
                return;

            await PersistCurrentConversationAsync(force: true, showToast: false);
            ChatClientProvider.SelectedSession.Messages.Clear();
            ActiveConversationId = null;
            SelectedConversation = null;
            lastSavedSignature = string.Empty;
            memoryStatus = "New empty chat started.";
            DxAiChat.LoadMessages(ChatClientProvider.SelectedSession.Messages);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in ClearHistory: {ex.ToString()}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in ClearHistory!");
        }

    }

    private async Task AddArchitecturePollToChatAsync()
    {
        try
        {
            if (ChatClientProvider?.SelectedSession is null || DxAiChat is null)
                return;

            var messages = DxAiChat.SaveMessages().ToList();
            var pollMessage = BuildArchitecturePollMessage();
            messages.Add(new BlazorChatMessage(ChatRole.User, pollMessage, new List<AIChatUploadFileInfo>()));
            ChatClientProvider.SelectedSession.Messages.Clear();
            ChatClientProvider.SelectedSession.Messages.AddRange(messages);
            DxAiChat.LoadMessages(messages);
            await PersistMessagesAsync(messages, force: true, showToast: false);
            ArchitecturePollStatus = "Architecture decision guidance was added to the DXAiChat conversation.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception in AddArchitecturePollToChatAsync: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.Message, "Architecture poll failed");
        }
    }

    private async Task OnContextFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        try
        {
            isUploadBusy = true;
            uploadStatus = "Reading uploaded context...";
            var decoded = new List<DecodedChatUpload>();
            var remainingCharacters = MaxDecodedCharactersTotal;

            foreach (var file in e.GetMultipleFiles(MaxUploadFiles))
            {
                if (remainingCharacters <= 0)
                    break;

                var upload = await DecodeUploadAsync(file, remainingCharacters);
                decoded.Add(upload);
                remainingCharacters -= upload.Content.Length;
            }

            UploadedContexts = decoded;
            uploadStatus = UploadedContexts.Count == 0
                ? "No supported text context was decoded."
                : $"Decoded {UploadedContexts.Count} upload(s). Add them to DXAiChat before sending the next request.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception in OnContextFilesSelectedAsync: {Message}", ex.Message);
            uploadStatus = $"Upload decode failed: {ex.Message}";
            Notifier.ShowError(toastName, ex.Message, "Upload decode failed");
        }
        finally
        {
            isUploadBusy = false;
        }
    }

    private async Task<DecodedChatUpload> DecodeUploadAsync(IBrowserFile file, int characterBudget)
    {
        await using var stream = file.OpenReadStream(MaxUploadBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var bytes = memory.ToArray();
        var extension = Path.GetExtension(file.Name);
        var decoded = extension.Equals(".zip", StringComparison.OrdinalIgnoreCase)
            ? DecodeZipText(bytes, characterBudget)
            : DecodePlainText(bytes, characterBudget);

        return new DecodedChatUpload(
            file.Name,
            file.Size,
            decoded,
            decoded.Length > 2000 ? decoded[..2000] + Environment.NewLine + "... truncated preview ..." : decoded);
    }

    private static string DecodePlainText(byte[] bytes, int characterBudget)
    {
        var text = Encoding.UTF8.GetString(bytes);
        return TrimDecodedText(text, characterBudget);
    }

    private static string DecodeZipText(byte[] bytes, int characterBudget)
    {
        using var memory = new MemoryStream(bytes);
        using var archive = new ZipArchive(memory, ZipArchiveMode.Read);
        var builder = new System.Text.StringBuilder();

        foreach (var entry in archive.Entries
            .Where(entry => IsTextLikeZipEntry(entry.FullName))
            .OrderBy(entry => entry.FullName, StringComparer.OrdinalIgnoreCase)
            .Take(40))
        {
            if (builder.Length >= characterBudget)
                break;

            builder.AppendLine($"## {entry.FullName}");
            using var stream = entry.Open();
            using var entryMemory = new MemoryStream();
            stream.CopyTo(entryMemory);
            var entryText = Encoding.UTF8.GetString(entryMemory.ToArray());
            builder.AppendLine(TrimDecodedText(entryText, Math.Min(12_000, characterBudget - builder.Length)));
            builder.AppendLine();
        }

        return builder.Length == 0
            ? "Zip contained no supported text-like files."
            : TrimDecodedText(builder.ToString(), characterBudget);
    }

    private static bool IsTextLikeZipEntry(string name)
    {
        var extension = Path.GetExtension(name);
        return extension is ".txt" or ".md" or ".json" or ".xml" or ".csv" or ".cs" or ".razor" or ".css" or ".js" or ".ts" or ".mcfunction" or ".yml" or ".yaml" or ".props" or ".targets" or ".csproj" or ".sln" or ".sql";
    }

    private static string TrimDecodedText(string text, int characterBudget)
    {
        if (characterBudget <= 0)
            return string.Empty;

        text = text.Replace("\0", string.Empty, StringComparison.Ordinal);
        return text.Length <= characterBudget
            ? text
            : text[..characterBudget] + Environment.NewLine + "... truncated by LocalGPT upload context budget ...";
    }

    private async Task AddUploadedContextToChatAsync()
    {
        try
        {
            if (ChatClientProvider?.SelectedSession is null || DxAiChat is null || UploadedContexts.Count == 0)
                return;

            var messages = DxAiChat.SaveMessages().ToList();
            var contextMessage = BuildUploadedContextMessage();
            messages.Add(new BlazorChatMessage(ChatRole.User, contextMessage, new List<AIChatUploadFileInfo>()));
            ChatClientProvider.SelectedSession.Messages.Clear();
            ChatClientProvider.SelectedSession.Messages.AddRange(messages);
            DxAiChat.LoadMessages(messages);
            await PersistMessagesAsync(messages, force: true, showToast: false);
            uploadStatus = "Uploaded context was added to DXAiChat. Ask the model to use it in your next message.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception in AddUploadedContextToChatAsync: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.Message, "Adding upload context failed");
        }
    }

    private string BuildUploadedContextMessage()
    {
        var builder = new System.Text.StringBuilder()
            .AppendLine("# LocalGPT Uploaded File Context")
            .AppendLine()
            .AppendLine("Use this decoded local context for the next DXAiChat request. Text and zip contents were truncated to stay within LocalGPT context budgets.")
            .AppendLine();

        foreach (var upload in UploadedContexts)
        {
            builder
                .AppendLine($"## {upload.DisplayName}")
                .AppendLine($"Original size: {upload.SizeBytes} bytes")
                .AppendLine()
                .AppendLine("```text")
                .AppendLine(upload.Content)
                .AppendLine("```")
                .AppendLine();
        }

        return builder.ToString();
    }

    private void ClearUploadedContext()
    {
        UploadedContexts.Clear();
        uploadStatus = "Upload context cleared.";
    }

    private string BuildArchitecturePollMessage()
    {
        var builder = new System.Text.StringBuilder()
            .AppendLine("# LocalGPT Architecture Poll Decision")
            .AppendLine()
            .AppendLine("Treat explicit non-Ask values as my current decision for the next answer. Treat Ask values as unresolved and ask me before implementing:")
            .AppendLine($"- UI stack: {ArchitectureUiStack}")
            .AppendLine($"- Solution shape: {ArchitectureSolutionShape}")
            .AppendLine($"- Runtime/rendering: {ArchitectureRenderMode}")
            .AppendLine($"- Reference look: {ArchitectureReferenceLook}");

        if (!string.IsNullOrWhiteSpace(ArchitecturePollNotes))
            builder.AppendLine($"- Extra direction: {ArchitecturePollNotes.Trim()}");

        builder
            .AppendLine()
            .AppendLine("If any selected value says \"Ask me\", stop before generating code or files. Return a concise runtime poll with concrete options and wait for my answer.")
            .AppendLine("Do not assume Blazor or DevExpress unless I chose it, the target repository already requires it, or the requested app type clearly benefits from it.")
            .AppendLine("When recreating a goal application, compare its layout, navigation, data flows, API routes, settings, and user workflows, then recreate the recognizable structure with the selected architecture.");

        return builder.ToString().Trim();
    }

    private void ResetArchitecturePoll()
    {
        ArchitectureUiStack = ArchitectureUiStackOptions[0];
        ArchitectureSolutionShape = ArchitectureSolutionShapeOptions[0];
        ArchitectureRenderMode = ArchitectureRenderModeOptions[0];
        ArchitectureReferenceLook = ArchitectureReferenceLookOptions[0];
        ArchitecturePollNotes = string.Empty;
        ArchitecturePollStatus = "Architecture choices reset to ask-at-runtime defaults.";
    }

    private async Task OnModelChanged(ChatClientSession value)
    {
        try
        {
            if (ChatClientProvider is null || DxAiChat is null || value is null)
                return;

            if (!string.IsNullOrWhiteSpace(DiagnosticRequestedSessionName) &&
                !MatchesRequestedDiagnosticSession(value, DiagnosticRequestedSessionName))
            {
                var diagnosticSession = FindRequestedDiagnosticSession(DiagnosticRequestedSessionName);
                if (diagnosticSession is not null)
                {
                    ChatClientProvider.SelectedSession = diagnosticSession;
                    ChatClientProvider.LockedSessionName = diagnosticSession.Name;
                    DxAiChat.LoadMessages(diagnosticSession.Messages);
                    modelStatus = $"Diagnostic session locked to {diagnosticSession.Name}.";
                }

                return;
            }

            var currentMessages = DxAiChat.SaveMessages().ToList();
            SaveMessagesForSelectedSession(currentMessages);
            await PersistMessagesAsync(currentMessages, force: true, showToast: false);

            ChatClientProvider.LockedSessionName = null;
            ChatClientProvider.ForcedMaxOutputTokens = null;
            ChatClientProvider.ForcedMaxPromptCharacters = null;
            ChatClientProvider.SuppressBootstrapContext = false;
            ChatClientProvider.SelectedSession = value;

            if (ReuseContextWhenSwitching && value.Messages.Count == 0 && currentMessages.Count > 0)
                value.Messages.AddRange(currentMessages);

            DxAiChat.LoadMessages(value.Messages);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Exception in OnModelChanged: {ex.ToString()}");
            Notifier.ShowError(toastName, $"Exception: {ex.ToString()}", "Error in OnModelChanged!");
        }

    }

    private async Task RefreshOllamaModelsAsync()
    {
        await RefreshOllamaModelsAsync(showToast: true);
    }

    private async Task RefreshOllamaModelsAsync(bool showToast)
    {
        if (ChatClientProvider is null)
            return;

        try
        {
            isModelRefreshBusy = true;
            if (DxAiChat is not null)
                SaveMessagesForSelectedSession(DxAiChat.SaveMessages());

            OllamaCandidates = (await CouncilService.GetCandidatesAsync())
                .Where(candidate => candidate.IsInstalled || candidate.IsConfigured)
                .GroupBy(candidate => candidate.ModelName, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderByDescending(candidate => candidate.IsLoaded)
                .ThenBy(candidate => candidate.ModelName, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (SelectedCouncilModelNames.Count == 0 && DiagnosticCouncilModelNames.Count == 0)
            {
                var preferred = OllamaCandidates.FirstOrDefault(candidate => candidate.ModelName.Equals("gpt-oss:20b", StringComparison.OrdinalIgnoreCase))
                    ?? OllamaCandidates.FirstOrDefault();
                if (preferred is not null)
                    SelectedCouncilModelNames.Add(preferred.ModelName);
            }

            RebuildDynamicSessions();
            modelStatus = OllamaCandidates.Count == 0
                ? "No installed Ollama models detected."
                : $"Detected {OllamaCandidates.Count} Ollama model(s). Added missing models and AI Council to DXAiChat.";
            if (DiagnosticCouncilModelNames.Count > 0)
            {
                modelStatus = $"Diagnostic council model override: {string.Join(", ", DiagnosticCouncilModelNames)}. LocalGPT will not auto-select a different council member for this run.";
            }

            if (showToast)
                Notifier.ShowSuccess(toastName, modelStatus, "Ollama models refreshed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RefreshOllamaModelsAsync failed: {Message}", ex.Message);
            modelStatus = $"Model refresh failed: {ex.Message}";
            if (showToast)
                Notifier.ShowError(toastName, ex.Message, "Model refresh failed");
        }
        finally
        {
            isModelRefreshBusy = false;
        }
    }

    private void RebuildDynamicSessions()
    {
        if (ChatClientProvider is null)
            return;

        var previousSelection = ChatClientProvider.SelectedSession?.Name;
        var previousMessages = ChatClientProvider.AvailableChatClients
            .Where(IsDynamicSession)
            .ToDictionary(session => session.Name, session => session.Messages.ToList(), StringComparer.OrdinalIgnoreCase);

        foreach (var session in ChatClientProvider.AvailableChatClients.Where(IsDynamicSession).ToList())
        {
            ChatClientProvider.AvailableChatClients.Remove(session);
            session.Client.Dispose();
        }

        foreach (var candidate in OllamaCandidates)
        {
            if (HasConfiguredSessionForModel(candidate.ModelName) && !ShouldAddRuntimeProfileSession())
                continue;

            var session = new ChatClientSession(
                new OllamaThinkingChatClient(
                    new OllamaCoreOptions { Uri = candidate.Endpoint, ModelName = candidate.ModelName },
                    keepAlive: "0s",
                    contextLength: ResolveCouncilContextTokens(),
                    timeout: TimeSpan.FromMinutes(10),
                    numGpu: ResolveOllamaNumGpu()),
                $"{DetectedOllamaSessionPrefix}{candidate.ModelName}");

            if (previousMessages.TryGetValue(session.Name, out var messages))
                session.Messages.AddRange(messages);

            ChatClientProvider.AvailableChatClients.Add(session);
        }

        EnsureDiagnosticOllamaSession(previousMessages);

        var councilSession = new ChatClientSession(
            new CouncilChatClient(CouncilService, CreateCouncilRequest),
            CouncilSessionName);
        if (previousMessages.TryGetValue(councilSession.Name, out var councilMessages))
            councilSession.Messages.AddRange(councilMessages);
        ChatClientProvider.AvailableChatClients.Add(councilSession);

        ChatClientProvider.SelectedSession =
            ChatClientProvider.AvailableChatClients.FirstOrDefault(session => session.Name == previousSelection)
            ?? ChatClientProvider.SelectedSession
            ?? ChatClientProvider.AvailableChatClients.FirstOrDefault();
    }

    private void EnsureDiagnosticOllamaSession(IReadOnlyDictionary<string, List<BlazorChatMessage>> previousMessages)
    {
        if (ChatClientProvider is null ||
            string.IsNullOrWhiteSpace(DiagnosticRequestedSessionName) ||
            DiagnosticRequestedSessionName.Equals("council", StringComparison.OrdinalIgnoreCase) ||
            FindRequestedDiagnosticSession(DiagnosticRequestedSessionName) is not null)
        {
            return;
        }

        var endpoint = OllamaCandidates.FirstOrDefault()?.Endpoint;
        if (string.IsNullOrWhiteSpace(endpoint))
            endpoint = DefaultOllamaEndpoint;

        var session = new ChatClientSession(
            new OllamaThinkingChatClient(
                new OllamaCoreOptions { Uri = endpoint, ModelName = DiagnosticRequestedSessionName },
                keepAlive: "0s",
                contextLength: ResolveCouncilContextTokens(),
                timeout: TimeSpan.FromMinutes(10),
                numGpu: ResolveOllamaNumGpu()),
            $"{DetectedOllamaSessionPrefix}{DiagnosticRequestedSessionName}");

        if (previousMessages.TryGetValue(session.Name, out var messages))
            session.Messages.AddRange(messages);

        ChatClientProvider.AvailableChatClients.Add(session);
        modelStatus = $"Diagnostic Ollama session created for {DiagnosticRequestedSessionName} at {endpoint}.";
    }

    private MultiModelCouncilRequest CreateCouncilRequest()
    {
        var selectedModels = DiagnosticCouncilModelNames.Count > 0
            ? DiagnosticCouncilModelNames
            : SelectedCouncilModelNames;
        var selectedEndpoint = OllamaCandidates
            .FirstOrDefault(candidate => selectedModels.Contains(candidate.ModelName, StringComparer.OrdinalIgnoreCase))
            ?.Endpoint;

        return new MultiModelCouncilRequest
        {
            ModelNames = OrderCouncilModelsForLoad(selectedModels).ToList(),
            BaseUri = selectedEndpoint,
            MaxRounds = 0,
            MaxOutputTokens = ResolveCouncilOutputTokens(),
            MaxParallelModels = 1,
            MaxContextTokens = ResolveCouncilContextTokens(),
            ModelTimeoutSeconds = 900,
            OllamaKeepAlive = "0s",
            OllamaNumGpu = ResolveOllamaNumGpu(),
            IncludeMemory = IncludeCouncilMemory,
            SaveToMemory = true,
            GenerateImplementationArtifact = GenerateCouncilArtifacts,
            Title = "DXAiChat AI Council"
        };
    }

    private void ApplyDiagnosticQueryOptions(bool selectSession)
    {
        if (ChatClientProvider is null)
            return;

        var query = QueryHelpers.ParseQuery(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query);
        if (query.TryGetValue("diagCouncilMaxOutputTokens", out var maxTokens) &&
            int.TryParse(maxTokens.ToString(), out var parsedMaxTokens))
        {
            CouncilMaxOutputTokens = Math.Clamp(parsedMaxTokens, MinCouncilOutputTokens, MaxCouncilOutputTokens);
        }

        if (query.TryGetValue("diagCouncilMaxContextTokens", out var maxContext) &&
            int.TryParse(maxContext.ToString(), out var parsedMaxContext))
        {
            CouncilMaxContextTokens = Math.Clamp(parsedMaxContext, MinCouncilContextTokens, MaxCouncilContextTokens);
        }

        if (query.TryGetValue("diagMaxOutputTokens", out var maxOutputTokens) &&
            int.TryParse(maxOutputTokens.ToString(), out var parsedMaxOutputTokens))
        {
            ChatClientProvider.ForcedMaxOutputTokens = Math.Clamp(parsedMaxOutputTokens, 64, 131072);
        }

        if (query.TryGetValue("diagMaxPromptCharacters", out var maxPromptCharacters) &&
            int.TryParse(maxPromptCharacters.ToString(), out var parsedMaxPromptCharacters))
        {
            ChatClientProvider.ForcedMaxPromptCharacters = Math.Clamp(parsedMaxPromptCharacters, 512, 12000);
        }

        if (query.TryGetValue("diagSkipBootstrap", out var skipBootstrap) &&
            bool.TryParse(skipBootstrap.ToString(), out var parsedSkipBootstrap))
        {
            ChatClientProvider.SuppressBootstrapContext = parsedSkipBootstrap;
        }

        if (query.TryGetValue("diagOllamaMode", out var ollamaMode))
        {
            var mode = ollamaMode.ToString();
            if (IsSupportedOllamaMode(mode))
                OllamaAccelerationMode = mode;
        }

        if (query.TryGetValue("diagGpuLayers", out var gpuLayers) &&
            int.TryParse(gpuLayers.ToString(), out var parsedGpuLayers))
        {
            LimitedGpuLayers = Math.Clamp(parsedGpuLayers, 1, 99);
        }

        if (query.TryGetValue("diagCpuOnly", out var cpuOnly) &&
            bool.TryParse(cpuOnly.ToString(), out var parsedCpuOnly))
        {
            OllamaAccelerationMode = parsedCpuOnly ? OllamaModeSafeCpu : OllamaModeAutoGpu;
        }

        if (query.TryGetValue("diagCouncilIncludeMemory", out var includeMemory) &&
            bool.TryParse(includeMemory.ToString(), out var parsedIncludeMemory))
        {
            IncludeCouncilMemory = parsedIncludeMemory;
        }

        if (query.TryGetValue("diagGenerateCouncilArtifacts", out var generateArtifacts) &&
            bool.TryParse(generateArtifacts.ToString(), out var parsedGenerateArtifacts))
        {
            GenerateCouncilArtifacts = parsedGenerateArtifacts;
        }

        if (query.TryGetValue("diagCouncilModels", out var councilModels))
        {
            DiagnosticCouncilModelNames = councilModels
                .ToString()
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(modelName => !string.IsNullOrWhiteSpace(modelName))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            SelectedCouncilModelNames = DiagnosticCouncilModelNames.ToList();
        }

        if (query.TryGetValue("diagFreshChat", out var freshChat) &&
            bool.TryParse(freshChat.ToString(), out var parsedFreshChat))
        {
            UseFreshDiagnosticChat = parsedFreshChat;
            if (parsedFreshChat)
                AutoLoadLatestConversation = false;
        }

        if (query.TryGetValue("diagSession", out var sessionValue))
            DiagnosticRequestedSessionName = sessionValue.ToString();

        if (!selectSession || string.IsNullOrWhiteSpace(DiagnosticRequestedSessionName))
            return;

        var requestedSession = DiagnosticRequestedSessionName;
        var selectedSession = FindRequestedDiagnosticSession(requestedSession);

        if (selectedSession is not null)
        {
            ChatClientProvider.SelectedSession = selectedSession;
            ChatClientProvider.LockedSessionName = selectedSession.Name;
            modelStatus = $"Diagnostic session locked to {selectedSession.Name}.";
        }

        if (DiagnosticCouncilModelNames.Count > 0)
            modelStatus = $"Diagnostic council model override: {string.Join(", ", DiagnosticCouncilModelNames)}. LocalGPT will not auto-select a different council member for this run.";
    }

    private ChatClientSession? FindRequestedDiagnosticSession(string requestedSession)
    {
        if (ChatClientProvider is null)
            return null;

        return requestedSession.Equals("council", StringComparison.OrdinalIgnoreCase)
            ? ChatClientProvider.AvailableChatClients.FirstOrDefault(session => session.Name.Equals(CouncilSessionName, StringComparison.OrdinalIgnoreCase))
            : ChatClientProvider.AvailableChatClients.FirstOrDefault(session => IsDynamicSession(session) && session.Name.Contains(requestedSession, StringComparison.OrdinalIgnoreCase))
                ?? ChatClientProvider.AvailableChatClients.FirstOrDefault(session => session.Name.Contains(requestedSession, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesRequestedDiagnosticSession(ChatClientSession session, string requestedSession)
    {
        if (requestedSession.Equals("council", StringComparison.OrdinalIgnoreCase))
            return session.Name.Equals(CouncilSessionName, StringComparison.OrdinalIgnoreCase);

        return session.Name.Contains(requestedSession, StringComparison.OrdinalIgnoreCase);
    }

    private bool ShouldAddRuntimeProfileSession()
    {
        if (!OllamaAccelerationMode.Equals(OllamaModeAutoGpu, StringComparison.OrdinalIgnoreCase))
            return true;

        var query = QueryHelpers.ParseQuery(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query);
        return query.ContainsKey("diagCpuOnly") || query.ContainsKey("diagOllamaMode");
    }

    private void ClearSelectedSessionForFreshStart()
    {
        if (ChatClientProvider?.SelectedSession is null)
            return;

        ChatClientProvider.SelectedSession.Messages.Clear();
        ActiveConversationId = null;
        SelectedConversation = null;
        lastSavedSignature = string.Empty;
    }

    private bool HasConfiguredSessionForModel(string modelName) =>
        ChatClientProvider?.AvailableChatClients.Any(session =>
            !IsDynamicSession(session) &&
            session.Name.Contains(modelName, StringComparison.OrdinalIgnoreCase)) == true;

    private static bool IsDynamicSession(ChatClientSession session) =>
        session.Name.StartsWith(DetectedOllamaSessionPrefix, StringComparison.OrdinalIgnoreCase) ||
        session.Name.Equals(CouncilSessionName, StringComparison.OrdinalIgnoreCase);

    private int? ResolveOllamaNumGpu()
    {
        return OllamaAccelerationMode switch
        {
            OllamaModeSafeCpu => 0,
            OllamaModeLimitedGpu => Math.Clamp(LimitedGpuLayers, 1, 99),
            _ => null
        };
    }

    private int ResolveCouncilOutputTokens() =>
        Math.Clamp(CouncilMaxOutputTokens, MinCouncilOutputTokens, MaxCouncilOutputTokens);

    private int ResolveCouncilContextTokens() =>
        Math.Clamp(CouncilMaxContextTokens, MinCouncilContextTokens, MaxCouncilContextTokens);

    private static bool IsSupportedOllamaMode(string mode) =>
        mode.Equals(OllamaModeAutoGpu, StringComparison.OrdinalIgnoreCase) ||
        mode.Equals(OllamaModeSafeCpu, StringComparison.OrdinalIgnoreCase) ||
        mode.Equals(OllamaModeLimitedGpu, StringComparison.OrdinalIgnoreCase);

    private void OnOllamaAccelerationModeChanged(ChangeEventArgs e)
    {
        var requestedMode = Convert.ToString(e.Value) ?? OllamaModeAutoGpu;
        if (!IsSupportedOllamaMode(requestedMode))
            requestedMode = OllamaModeAutoGpu;

        OllamaAccelerationMode = requestedMode;
        if (DxAiChat is not null)
            SaveMessagesForSelectedSession(DxAiChat.SaveMessages());

        RebuildDynamicSessions();
        modelStatus = OllamaAccelerationMode switch
        {
            OllamaModeSafeCpu => "Ollama acceleration: Safe CPU. LocalGPT sends num_gpu=0.",
            OllamaModeLimitedGpu => $"Ollama acceleration: Limited GPU. LocalGPT sends num_gpu={Math.Clamp(LimitedGpuLayers, 1, 99)}.",
            _ => "Ollama acceleration: Auto GPU. LocalGPT lets Ollama choose GPU offload."
        };
    }

    private static IEnumerable<string> OrderCouncilModelsForLoad(IEnumerable<string> modelNames)
    {
        return modelNames
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(GetCouncilModelLoadPriority)
            .ThenBy(name => name, StringComparer.OrdinalIgnoreCase);
    }

    private static int GetCouncilModelLoadPriority(string modelName)
    {
        if (modelName.Contains("gpt-oss", StringComparison.OrdinalIgnoreCase))
            return 0;

        if (modelName.Contains("deepseek-r1:8b", StringComparison.OrdinalIgnoreCase))
            return 1;

        if (modelName.Contains("gemma", StringComparison.OrdinalIgnoreCase))
            return 2;

        if (modelName.Contains("qwen", StringComparison.OrdinalIgnoreCase))
            return 3;

        return 10;
    }

    private void ToggleCouncilModel(string modelName, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool value && value;
        if (isChecked)
        {
            if (!SelectedCouncilModelNames.Contains(modelName, StringComparer.OrdinalIgnoreCase))
                SelectedCouncilModelNames.Add(modelName);
        }
        else
        {
            SelectedCouncilModelNames.RemoveAll(name => name.Equals(modelName, StringComparison.OrdinalIgnoreCase));
        }
    }

