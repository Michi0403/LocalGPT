    private async Task Save()
    {
        try
        {
            IsSaving = true;
            NormalizeLocalEndpoint();

            var root = Opts.CurrentValue;
            ApplyModelsToConfiguration(root);
            await Writer.SaveAsync(root).ConfigureAwait(false);

            // Saving provider setup always performs one fresh local-host/model scan.
            // Any default-port Ollama or LM Studio selection discovered by that scan is
            // persisted immediately, so the next application boot uses it without a
            // separate Test Connection + Save cycle.
            await RefreshConnectivityStatusAsync(showToast: false).ConfigureAwait(false);
            NormalizeLocalEndpoint();
            ApplyModelsToConfiguration(root);
            await Writer.SaveAsync(root).ConfigureAwait(false);

            await Append("Saved durable provider settings and refreshed local models.").ConfigureAwait(false);
            Notifier.ShowSuccess(toastName, "Provider settings saved and local models refreshed.", "Saved");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Save failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            await Append("(Save) " + ex.Message).ConfigureAwait(false);
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    private void ApplyModelsToConfiguration(LocalGPT.BusinessObjects.ConfigurationRoot root)
    {
        root.AICore ??= new AICoreOptions();
        root.AICore.ChatGPTLocalCore = Model.ChatGPTLocalCore;
        root.AICore.OllamaCore = Model.OllamaCore;
        root.AICore.OllamaCores = Model.OllamaCores
            .Where(option => !string.IsNullOrWhiteSpace(option.Uri) || !string.IsNullOrWhiteSpace(option.ModelName))
            .ToList();
        root.AICore.OpenAICore = Model.OpenAICore;
        root.AICore.OpenAIServiceCore = Model.OpenAIServiceCore;
        root.LoggingCore = LoggingModel;
        root.LoggingCore.DatabaseCore = DatabaseLoggerModel;
    }

