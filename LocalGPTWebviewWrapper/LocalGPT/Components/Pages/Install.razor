@page "/install"

@using LocalGPT.BusinessObjects.Enums
@inject ILogger<Install> Logger
@inject INotificationService Notifier
@inject IOptionsMonitor<ConfigurationRoot> Opts
@inject IConfigurationWriter Writer
@inject IAiConnectivityProbe Probe
@inject NavigationManager Nav
@rendermode InteractiveServer
<PageTitle>AI Setup</PageTitle>

<div class="main-container">
    <ToastWrapper Name="@toastName" />

    <div class="p-4 space-y-6">
        <div class="top-container">
            <DxButton Text="Save"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      IconCssClass="save"
                      Click="Save" />
            <DxButton Text="Back to Chat"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      IconCssClass="chevron-left"
                      Click="GoChat" />
        </div>

        <h2 class="text-xl font-semibold">AI Providers Setup</h2>

        <div class="@ConnectivityAlertCss" role="status">
            <div class="d-flex flex-wrap align-items-center gap-2 justify-content-between">
                <div>
                    <strong>Local AI Connectivity</strong>
                    <div>@ConnectivityStatus</div>
                    @if (LastConnectivityCheck is not null)
                    {
                        <small>Last checked @LastConnectivityCheck.Value.ToLocalTime().ToString("HH:mm:ss").</small>
                    }
                </div>
                <DxButton Text="Refresh Connectivity"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!IsConnectivityChecking)"
                          Click="RefreshConnectivityStatusFromButton" />
            </div>
        </div>

        <div class="top-container">
            <DxButton Text="Find Local AI Hosts"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Enabled="@(!IsDiscovering)"
                      Click="DiscoverLocalAiHosts" />
            <DxButton Text="Use Ollama gpt-oss:20b"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="UseOllamaGptOss20b" />
        </div>

        @if (DiscoveredHosts.Count > 0)
        {
            <DxFormLayout>
                <DxFormLayoutGroup Caption="Discovered Local AI Hosts" ColSpanMd="12">
                    @foreach (var host in DiscoveredHosts)
                    {
                        <DxFormLayoutItem Caption="@($"{host.Provider} - {host.Endpoint}")" ColSpanMd="12">
                            <div class="discovered-ai-host">
                                <div>@(host.IsReachable ? "Reachable" : "Unavailable"): @host.Status</div>
                                @if (host.Models.Count > 0)
                                {
                                    <div class="top-container">
                                        @foreach (var model in host.Models)
                                        {
                                            <DxButton Text="@CouncilChatStringFunctions.GetDiscoveredModelButtonText(model,Logger)"
                                                      RenderStyle="ButtonRenderStyle.Primary"
                                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                      Click="@(() => ApplyDiscoveredModel(host, model))" />
                                        }
                                    </div>
                                }
                            </div>
                        </DxFormLayoutItem>
                    }
                </DxFormLayoutGroup>
            </DxFormLayout>
        }

        <DxFormLayout>
            <DxFormLayoutTabPages>

                <DxFormLayoutTabPage Caption="Local (OpenAI-compatible)">
                    <DxFormLayoutItem Caption="Endpoint (host, no /v1)">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.Endpoint" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="API Key">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.ApiKey" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Model Name">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.ModelName" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem>
                        <DxCheckBox @bind-Checked="Model.ChatGPTLocalCore.AutoStartServer"
                                    Text="Auto start server if not running" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Working Directory">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.WorkingDir" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Start Command (bat/exe)">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.StartCommand" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Health Timeout (s)">
                        <DxSpinEdit @bind-Value="Model.ChatGPTLocalCore.HealthTimeoutSeconds" Min="5" Max="300" />
                    </DxFormLayoutItem>

                    <div class="top-container">
                  @*       <DxButton Text="Check Python" Click="CheckPython" />
                        <DxButton Text="Install Dependencies" Click="InstallDependencies" />
                        <DxButton Text="Download Model" Click="DownloadModel" /> *@
                        <DxButton Text="Start Local Server" Click="StartLocal" />
                        <DxButton Text="Test Connection" Click="TestLocal" />
                    </div>
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="Ollama">
                    <DxFormLayoutItem Caption="URI">
                        <DxTextBox @bind-Text="Model.OllamaCore.Uri" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Model">
                        <DxTextBox @bind-Text="Model.OllamaCore.ModelName" />
                    </DxFormLayoutItem>
                    <DxButton Text="Test Connection" Click="TestOllama" />

                    <DxFormLayoutItem Caption="Additional Ollama Models">
                        <DxButton Text="Add Ollama Model"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Click="AddOllamaModel" />
                    </DxFormLayoutItem>

                    @foreach (var ollama in AdditionalOllamaModels)
                    {
                        <DxFormLayoutItem Caption="URI">
                            <DxTextBox @bind-Text="ollama.Uri" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Model">
                            <DxTextBox @bind-Text="ollama.ModelName" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem>
                            <DxButton Text="Remove"
                                      RenderStyle="ButtonRenderStyle.Danger"
                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                      Click="@(() => RemoveOllamaModel(ollama))" />
                        </DxFormLayoutItem>
                    }
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="OpenAI (Cloud)">
                    <DxFormLayoutItem Caption="API Key">
                        <DxTextBox @bind-Text="Model.OpenAICore.ApiKey" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Model">
                        <DxTextBox @bind-Text="Model.OpenAICore.ModelName" />
                    </DxFormLayoutItem>
                    <DxButton Text="Test Connection" Click="TestOpenAI" />
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="Azure OpenAI">
                    <DxFormLayoutItem Caption="Endpoint">
                        <DxTextBox @bind-Text="Model.OpenAIServiceCore.Endpoint" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Key">
                        <DxTextBox @bind-Text="Model.OpenAIServiceCore.Key" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Deployment Name">
                        <DxTextBox @bind-Text="Model.OpenAIServiceCore.DeploymentName" />
                    </DxFormLayoutItem>
                    <DxButton Text="Test Connection" Click="TestAzure" />
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="App Logging">
                    <DxFormLayoutItem Caption="Global Log Level">
                        <DxComboBox Data="@LogLevels"
                                    @bind-Value="LoggingModel.CoreLogLevel" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="SQLite Log Level">
                        <DxComboBox Data="@LogLevels"
                                    @bind-Value="DatabaseLoggerModel.CoreLogLevel" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Queue Length">
                        <DxSpinEdit @bind-Value="DatabaseLoggerModel.MaxQueueLength" Min="100" Max="50000" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Batch Size">
                        <DxSpinEdit @bind-Value="DatabaseLoggerModel.BatchSize" Min="1" Max="500" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Flush Interval (s)">
                        <DxSpinEdit @bind-Value="DatabaseLoggerModel.FlushIntervalSeconds" Min="1" Max="30" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Retention (days)">
                        <DxSpinEdit @bind-Value="DatabaseLoggerModel.RetentionDays" Min="1" Max="3660" />
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>

            </DxFormLayoutTabPages>
        </DxFormLayout>

        <DxMemo Rows="8" ReadOnly="true" @bind-Text="_log" CssClass="w-full" />
    </div>
</div>

@code {
    private AICoreOptions Model = new();
    private LoggingCoreOptions LoggingModel = new();
    private DatabaseLoggerCoreOptions DatabaseLoggerModel = new();
    private IReadOnlyList<CoreLogLevel> LogLevels { get; } = Enum.GetValues<CoreLogLevel>();
    private string _log = "";
    private string toastName = "InstallToasts";
    private bool IsDiscovering;
    private bool IsConnectivityChecking;
    private string ConnectivityStatus = "Connectivity not checked yet. Refresh to verify Ollama or LM Studio.";
    private DateTimeOffset? LastConnectivityCheck;
    private IReadOnlyList<LocalAiHostDiscoveryResult> DiscoveredHosts = Array.Empty<LocalAiHostDiscoveryResult>();
    private List<OllamaCoreOptions> AdditionalOllamaModels => Model.OllamaCores;
    private bool HasReachableAiHost => DiscoveredHosts.Any(host => host.IsReachable);
    private string ConnectivityAlertCss => HasReachableAiHost ? "alert alert-success" : "alert alert-warning";

    protected override void OnInitialized()
    {
        try
        {
            var current = Opts.CurrentValue.AICore ?? new AICoreOptions();
            // ensure non-null sub-sections
            Model.ChatGPTLocalCore = current.ChatGPTLocalCore ?? new ChatGPTLocalCoreOptions();
            Model.OllamaCore      = current.OllamaCore      ?? new OllamaCoreOptions();
            Model.OllamaCores = current.OllamaCores ?? new List<OllamaCoreOptions>();
            Model.OpenAICore      = current.OpenAICore      ?? new OpenAICompatOptions();
            Model.OpenAIServiceCore = current.OpenAIServiceCore ?? new OpenAIServiceCoreOptions();

            LoggingModel = Opts.CurrentValue.LoggingCore ?? new LoggingCoreOptions
            {
                CoreLogLevel = CoreLogLevel.Information,
                FileCore = new FileLoggerCoreOptions { CoreLogLevel = CoreLogLevel.Error, FilePath = string.Empty },
                EmailCore = new EmailLoggerCoreOptions { CoreLogLevel = CoreLogLevel.None },
                DatabaseCore = new DatabaseLoggerCoreOptions { CoreLogLevel = CoreLogLevel.Warning }
            };
            LoggingModel.FileCore ??= new FileLoggerCoreOptions { CoreLogLevel = CoreLogLevel.Error, FilePath = string.Empty };
            LoggingModel.EmailCore ??= new EmailLoggerCoreOptions { CoreLogLevel = CoreLogLevel.None };
            DatabaseLoggerModel = LoggingModel.DatabaseCore ?? new DatabaseLoggerCoreOptions { CoreLogLevel = CoreLogLevel.Warning };
            LoggingModel.DatabaseCore = DatabaseLoggerModel;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Install.OnInitialized failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Initialization Error");
            _ = Append("(Init) " + ex.Message);
        }
    }

    private void NormalizeLocalEndpoint()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Model.ChatGPTLocalCore?.Endpoint)) return;

            var ep = Model.ChatGPTLocalCore.Endpoint.Trim().TrimEnd('/');
            if (ep.EndsWith("/v1", StringComparison.OrdinalIgnoreCase))
                ep = ep[..^3]; // remove "/v1"
            Model.ChatGPTLocalCore.Endpoint = ep;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to normalize local endpoint: {Message}", ex.Message);
            _ = Append("Normalization warning: " + ex.Message);
        }
    }

    private async Task Append(string text)
    {
        _log = $"[{DateTime.Now:T}] {text}\n" + _log;
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestLocal()
    {
        try
        {
            NormalizeLocalEndpoint();
            var (ok, msg) = await Probe.TestLocalOpenAICompatAsync(Model.ChatGPTLocalCore!, default);
            await Append((ok ? "OK" : "FAIL") + " Local: " + msg);
            if (ok) Notifier.ShowSuccess(toastName, "Local endpoint is reachable.", "Local Test OK");
            else    Notifier.ShowWarning(toastName, msg, "Local Test Failed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TestLocal failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Local Test Error");
            await Append("(Local Test) " + ex.Message);
        }
    }

    private async Task StartLocal()
    {
        try
        {
            NormalizeLocalEndpoint();
            var (ok, msg) = await Probe.TryStartLocalAsync(Model.ChatGPTLocalCore!, default);
            await Append((ok ? "Started" : "Failed") + ": " + msg);
            if (ok) Notifier.ShowSuccess(toastName, "Local server started.", "Start OK");
            else    Notifier.ShowWarning(toastName, msg, "Start Failed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "StartLocal failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Start Error");
            await Append("(Start Local) " + ex.Message);
        }
    }

    private async Task TestOllama()
    {
        try
        {
            var (ok, msg) = await Probe.TestOllamaAsync(Model.OllamaCore!, default);
            LastConnectivityCheck = DateTimeOffset.Now;
            ConnectivityStatus = ok
                ? $"Ollama reachable at {Model.OllamaCore?.Uri}. Selected model: {Model.OllamaCore?.ModelName}."
                : $"Ollama not reachable at {Model.OllamaCore?.Uri}: {msg}";
            await Append((ok ? "OK" : "FAIL") + " Ollama: " + msg);
            if (ok) Notifier.ShowSuccess(toastName, "Ollama reachable.", "Ollama Test OK");
            else    Notifier.ShowWarning(toastName, msg, "Ollama Test Failed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TestOllama failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Ollama Test Error");
            await Append("(Ollama Test) " + ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await RefreshConnectivityStatusAsync(showToast: false);
    }

    private async Task DiscoverLocalAiHosts()
    {
        try
        {
            IsDiscovering = true;
            await Append("Scanning localhost for Ollama and LM Studio...");

            DiscoveredHosts = await Probe.DiscoverLocalHostsAsync(default);
            AutoSelectBestDiscoveredModel();

            var reachable = DiscoveredHosts.Count(h => h.IsReachable);
            var models = DiscoveredHosts.Sum(h => h.Models.Count);

            await Append($"Discovery found {reachable} reachable host(s) and {models} model(s).");
            LastConnectivityCheck = DateTimeOffset.Now;
            ConnectivityStatus = BuildConnectivityStatus(reachable, models);

            if (reachable > 0)
                Notifier.ShowSuccess(toastName, $"Found {reachable} local AI host(s).", "Discovery Complete");
            else
                Notifier.ShowWarning(toastName, "No local AI hosts responded.", "Discovery Complete");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "DiscoverLocalAiHosts failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Discovery Error");
            await Append("(Discovery) " + ex.Message);
        }
        finally
        {
            IsDiscovering = false;
        }
    }

    private Task RefreshConnectivityStatusFromButton()
    {
        return RefreshConnectivityStatusAsync(showToast: true);
    }

    private async Task RefreshConnectivityStatusAsync(bool showToast)
    {
        try
        {
            IsConnectivityChecking = true;
            await InvokeAsync(StateHasChanged);
            DiscoveredHosts = await Probe.DiscoverLocalHostsAsync(default);
            AutoSelectBestDiscoveredModel();

            var reachable = DiscoveredHosts.Count(host => host.IsReachable);
            var models = DiscoveredHosts.Sum(host => host.Models.Count);
            LastConnectivityCheck = DateTimeOffset.Now;
            ConnectivityStatus = BuildConnectivityStatus(reachable, models);
            await Append($"Connectivity refresh: {ConnectivityStatus}");

            if (!showToast)
                return;

            if (reachable > 0)
                Notifier.ShowSuccess(toastName, ConnectivityStatus, "Connectivity OK");
            else
                Notifier.ShowWarning(toastName, ConnectivityStatus, "Connectivity Warning");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RefreshConnectivityStatusAsync failed: {Message}", ex.Message);
            LastConnectivityCheck = DateTimeOffset.Now;
            ConnectivityStatus = "Connectivity check failed: " + ex.Message;
            if (showToast)
                Notifier.ShowError(toastName, ex.ToString(), "Connectivity Error");
            await Append("(Connectivity) " + ex.Message);
        }
        finally
        {
            IsConnectivityChecking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string BuildConnectivityStatus(int reachable, int models)
    {
        if (reachable <= 0)
            return "No local Ollama or LM Studio host is reachable. Start Ollama or LM Studio, then refresh.";

        var hostSummaries = DiscoveredHosts
            .Where(host => host.IsReachable)
            .Select(host => $"{host.Provider} at {host.Endpoint} ({host.Models.Count} model(s))");
        return $"Reachable: {string.Join("; ", hostSummaries)}. Total detected models: {models}.";
    }

    private async Task ApplyDiscoveredModel(LocalAiHostDiscoveryResult host, LocalAiModelInfo model)
    {
        try
        {
            if (string.Equals(host.Provider, "Ollama", StringComparison.OrdinalIgnoreCase))
            {
                Model.OllamaCore.Uri = host.Endpoint;
                Model.OllamaCore.ModelName = model.Name;
                await Append($"Selected Ollama model {model.Name} at {host.Endpoint}.");
            }
            else
            {
                Model.ChatGPTLocalCore.Endpoint = host.Endpoint;
                Model.ChatGPTLocalCore.ApiKey = string.IsNullOrWhiteSpace(Model.ChatGPTLocalCore.ApiKey)
                    ? "local-key"
                    : Model.ChatGPTLocalCore.ApiKey;
                Model.ChatGPTLocalCore.ModelName = model.Name;
                await Append($"Selected {host.Provider} model {model.Name} at {host.Endpoint}.");
            }

            Notifier.ShowSuccess(toastName, $"{host.Provider}: {model.Name}", "Model Selected");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ApplyDiscoveredModel failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Selection Error");
            await Append("(Selection) " + ex.Message);
        }
    }

    private void AutoSelectBestDiscoveredModel()
    {
        var best = DiscoveredHosts
            .Where(h => h.IsReachable)
            .SelectMany(h => h.Models.Select(m => new { Host = h, Model = m }))
            .OrderByDescending(x => string.Equals(x.Host.Provider, "Ollama", StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(x => x.Model.Name.Contains("gpt-oss", StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(x => x.Model.IsLoaded)
            .FirstOrDefault();

        if (best is null)
        {
            var ollama = DiscoveredHosts.FirstOrDefault(h => h.IsReachable && string.Equals(h.Provider, "Ollama", StringComparison.OrdinalIgnoreCase));
            if (ollama is not null && string.IsNullOrWhiteSpace(Model.OllamaCore.Uri))
                Model.OllamaCore.Uri = ollama.Endpoint;
            return;
        }

        if (string.Equals(best.Host.Provider, "Ollama", StringComparison.OrdinalIgnoreCase))
        {
            Model.OllamaCore.Uri = best.Host.Endpoint;
            Model.OllamaCore.ModelName = best.Model.Name;
        }
        else
        {
            Model.ChatGPTLocalCore.Endpoint = best.Host.Endpoint;
            Model.ChatGPTLocalCore.ApiKey = string.IsNullOrWhiteSpace(Model.ChatGPTLocalCore.ApiKey)
                ? "local-key"
                : Model.ChatGPTLocalCore.ApiKey;
            Model.ChatGPTLocalCore.ModelName = best.Model.Name;
        }
    }

    private async Task UseOllamaGptOss20b()
    {
        Model.OllamaCore.Uri = "http://localhost:11434";
        Model.OllamaCore.ModelName = "gpt-oss:20b";
        await Append("Selected Ollama gpt-oss:20b at http://localhost:11434.");
        Notifier.ShowSuccess(toastName, "Ollama gpt-oss:20b selected.", "Model Selected");
    }

  

    private void AddOllamaModel()
    {
        Model.OllamaCores.Add(new OllamaCoreOptions
        {
            Uri = Model.OllamaCore?.Uri ?? "http://localhost:11434",
            ModelName = string.Empty
        });
    }

    private void RemoveOllamaModel(OllamaCoreOptions ollama)
    {
        Model.OllamaCores.Remove(ollama);
    }

    private async Task TestOpenAI()
    {
        try
        {
            var (ok, msg) = await Probe.TestOpenAIAsync(Model.OpenAICore!, default);
            await Append((ok ? "OK" : "FAIL") + " OpenAI: " + msg);
            if (ok) Notifier.ShowSuccess(toastName, "OpenAI reachable.", "OpenAI Test OK");
            else    Notifier.ShowWarning(toastName, msg, "OpenAI Test Failed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TestOpenAI failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "OpenAI Test Error");
            await Append("(OpenAI Test) " + ex.Message);
        }
    }

    private async Task TestAzure()
    {
        try
        {
            var (ok, msg) = await Probe.TestAzureAsync(Model.OpenAIServiceCore!, default);
            await Append((ok ? "OK" : "FAIL") + " Azure: " + msg);
            if (ok) Notifier.ShowSuccess(toastName, "Azure endpoint reachable.", "Azure Test OK");
            else    Notifier.ShowWarning(toastName, msg, "Azure Test Failed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TestAzure failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Azure Test Error");
            await Append("(Azure Test) " + ex.Message);
        }
    }

    private async Task Save()
    {
        try
        {
            NormalizeLocalEndpoint();

            var root = Opts.CurrentValue;
            root.AICore ??= new AICoreOptions();
            root.AICore.ChatGPTLocalCore = Model.ChatGPTLocalCore;
            root.AICore.OllamaCore = Model.OllamaCore;
            root.AICore.OllamaCores = Model.OllamaCores
                .Where(o => !string.IsNullOrWhiteSpace(o.Uri) || !string.IsNullOrWhiteSpace(o.ModelName))
                .ToList();
            root.AICore.OpenAICore = Model.OpenAICore;
            root.AICore.OpenAIServiceCore = Model.OpenAIServiceCore;
            root.LoggingCore = LoggingModel;
            root.LoggingCore.DatabaseCore = DatabaseLoggerModel;

            await Writer.SaveAsync(root);
            await Append("Saved appsettings.json. New chats will use updated providers.");
            Notifier.ShowSuccess(toastName, "Settings saved.", "Saved");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Save failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Save Error");
            await Append("(Save) " + ex.Message);
        }
    }

    private void GoChat()
    {
        try
        {
            Nav.NavigateTo("/Chat");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Navigation to /Chat failed: {Message}", ex.Message);
            Notifier.ShowError(toastName, ex.ToString(), "Navigation Error");
            _ = Append("(Nav) " + ex.Message);
        }
    }
}
