@page "/model-council"

@inject IMultiModelCouncilService CouncilService
@inject IChatMemoryService ChatMemory
@inject ILogger<ModelCouncil> Logger
@inject INotificationService Notifier
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>AI Council</PageTitle>

<main class="council-page">
    <ToastWrapper Name="@toastName" />

    <section class="council-header">
        <div>
            <h1>AI Council</h1>
            <p>Let several local Ollama models propose, critique, verify, and memorize a shared answer.</p>
        </div>
        <DxButton Text="Refresh Models"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Enabled="@(!isBusy)"
                  Click="LoadCandidatesAsync" />
    </section>

    <section class="council-layout">
        <div class="council-controls">
            <div class="control-group">
                <div class="control-title">Council Models</div>
                @if (Candidates.Count == 0)
                {
                    <p class="muted">No Ollama models detected yet. Start Ollama or add a model name manually.</p>
                }
                else
                {
                    <div class="candidate-list">
                        @foreach (var candidate in Candidates)
                        {
                            <label class="candidate-row" title="@candidate.Details">
                                <input type="checkbox"
                                       checked="@SelectedModels.Contains(candidate.ModelName)"
                                       @onchange="@((ChangeEventArgs e) => ToggleModel(candidate.ModelName, e))" />
                                <span>
                                    <strong>@candidate.ModelName</strong>
                                    <small>@candidate.Provider@if (candidate.IsLoaded) { <text> - loaded</text> }</small>
                                </span>
                            </label>
                        }
                    </div>
                }
                @if (SelectedModels.Count < 2)
                {
                    <p class="hint">Select at least two installed models for real negotiation. If your coder model is not listed, pull it in Ollama and refresh.</p>
                }
            </div>

            <div class="control-group">
                <label class="manual-model">
                    Add model name
                    <span>
                        <input @bind="ManualModelName" placeholder="qwen3-coder:30b" />
                        <DxButton Text="Add"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Click="AddManualModel" />
                    </span>
                </label>
            </div>

            <div class="control-grid">
                <label>
                    Review rounds
                    <input type="number" min="0" max="3" @bind="Request.MaxRounds" />
                </label>
                <label>
                    Parallel models
                    <input type="number" min="1" max="4" @bind="Request.MaxParallelModels" />
                </label>
                <label>
                    Max output tokens
                    <input type="number" min="64" max="8192" step="64" @bind="Request.MaxOutputTokens" />
                </label>
                <label>
                    Context tokens
                    <input type="number" min="2048" max="32768" step="1024" @bind="Request.MaxContextTokens" />
                </label>
                <label>
                    Timeout seconds
                    <input type="number" min="30" max="900" step="30" @bind="Request.ModelTimeoutSeconds" />
                </label>
                <label>
                    Ollama keep-alive
                    <input @bind="KeepAliveText" placeholder="auto" />
                </label>
            </div>
            <div class="run-row">
                <DxButton Text="Low GPU Preset"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isBusy)"
                          Click="ApplyLowResourcePreset" />
                <DxButton Text="Balanced Preset"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isBusy)"
                          Click="ApplyBalancedPreset" />
            </div>
            <p class="hint">Default scheduling runs one large model at a time and can unload between models. Use Low GPU Preset after driver resets, black screens, or 20B/30B model pressure; it keeps prompts database-first and intentionally small.</p>

            <div class="check-row">
                <label title="Passes Ollama num_gpu=0 for this council run. This is slower, but reduces GPU pressure while debugging.">
                    <input type="checkbox" @bind="ForceCpuOnlyOllama" />
                    CPU-only Ollama
                </label>
                <label title="Shares saved LocalGPT memory and AI project guidance with every council participant.">
                    <input type="checkbox" @bind="Request.IncludeMemory" />
                    Shared memory
                </label>
                <label title="Stores the full council transcript in SQLite chat memory after the run.">
                    <input type="checkbox" @bind="Request.SaveToMemory" />
                    Memorize transcript
                </label>
                <label title="Creates downloadable C# source and, when the local .NET SDK can build it, a sandbox DLL for implementation-oriented council results.">
                    <input type="checkbox" @bind="Request.GenerateImplementationArtifact" />
                    Generate code + DLL
                </label>
            </div>

            <div class="control-group">
                <div class="control-title">Continue Council Memory</div>
                @if (SavedCouncilConversations.Count == 0)
                {
                    <p class="muted">No saved council conversations yet.</p>
                }
                else
                {
                    <DxComboBox Data="@SavedCouncilConversations"
                                Value="@SelectedCouncilConversation"
                                CssClass="memory-selector"
                                TextFieldName="@nameof(ChatMemoryConversationSummary.DisplayName)"
                                ValueChanged="@((ChatMemoryConversationSummary conversation) => SelectCouncilConversation(conversation))" />
                }
                <div class="run-row">
                    <DxButton Text="New Thread"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="StartNewCouncilThread" />
                    <DxButton Text="Feature Request Chat"
                              RenderStyle="ButtonRenderStyle.Primary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="StartFeatureRequestChat" />
                    <DxButton Text="Refresh Memory"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="LoadSavedCouncilConversationsAsync" />
                </div>
                @if (SelectedCouncilConversation is not null)
                {
                    <p class="hint">Continuing: @SelectedCouncilConversation.DisplayName</p>
                }
            </div>
        </div>

        <div class="prompt-panel">
            <label>
                Council prompt
                <textarea @bind="Request.Prompt" rows="14"></textarea>
            </label>
            <div class="run-row">
                <DxButton Text="Run Council"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@CanRun"
                          Click="RunCouncilAsync" />
                @if (isBusy)
                {
                    <span class="muted">Models are negotiating. This can take a while on 20B/30B models.</span>
                }
                else if (!string.IsNullOrWhiteSpace(statusText))
                {
                    <span class="status-text">@statusText</span>
                }
            </div>
        </div>
    </section>

    @if (LastResult is not null)
    {
        <section class="result-meta">
            <div>
                <strong>Participants</strong>
                <span>@string.Join(" + ", LastResult.ModelNames)</span>
            </div>
            @if (LastResult.MemoryConversationId is Guid memoryId)
            {
                <div>
                    <strong>Memory</strong>
                    <span>@memoryId</span>
                </div>
            }
            @if (LastResult.KnowledgeEntryId is Guid knowledgeId)
            {
                <div>
                    <strong>Knowledge</strong>
                    <span>@knowledgeId</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(LastResult.LogPath))
            {
                <div>
                    <strong>Log</strong>
                    <span>@LastResult.LogPath</span>
                </div>
            }
            @if (LastResult.ContinuedFromConversationId is Guid continuedFrom)
            {
                <div>
                    <strong>Continued From</strong>
                    <span>@continuedFrom</span>
                </div>
            }
        </section>

        <section class="result-meta">
            @foreach (var model in LastResult.ModelNames)
            {
                <div>
                    <strong>@model</strong>
                    <DxButton Text="Exclude Next Round"
                              RenderStyle="ButtonRenderStyle.Danger"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy && SelectedModels.Count > 1)"
                              Click="@(() => ExcludeModel(model))" />
                </div>
            }
        </section>

        @if (LastResult.Warnings.Count > 0)
        {
            <section class="warning-panel">
                @foreach (var warning in LastResult.Warnings)
                {
                    <p>@warning</p>
                }
            </section>
        }

        @if (LastResult.UserPoll is not null)
        {
            <section class="poll-panel">
                <h2>User Decision Poll</h2>
                <p>@LastResult.UserPoll.Reason</p>
                <strong>@LastResult.UserPoll.Question</strong>
                <div class="poll-options">
                    @foreach (var option in LastResult.UserPoll.Options)
                    {
                        <button type="button"
                                title="@option.FollowUpPrompt"
                                @onclick="@(() => ApplyPollOption(option))">
                            @option.Label
                        </button>
                    }
                </div>
            </section>
        }

        @if (LastResult.Artifacts.Count > 0)
        {
            <section class="final-panel">
                <h2>Downloadable Examples</h2>
                @foreach (var artifact in LastResult.Artifacts)
                {
                    <div class="artifact-download">
                        <a href="@GetArtifactUrl(artifact)" target="_blank" rel="noopener" download="@artifact.Name">@artifact.Name</a>
                        <span class="muted"> - @artifact.Kind - @artifact.Summary</span>
                        <dl>
                            <dt>HTTP GET</dt>
                            <dd><a href="@GetArtifactUrl(artifact)" target="_blank" rel="noopener">@GetArtifactUrl(artifact)</a></dd>
                            <dt>Local file</dt>
                            <dd>@artifact.FilePath</dd>
                        </dl>
                    </div>
                }
            </section>
        }

        <section class="final-panel">
            <h2>Consensus Answer</h2>
            <div class="markdown-output">@((MarkupString)Markdown.ToHtml(LastResult.FinalAnswer).Trim())</div>
        </section>

        <section class="transcript-panel">
            <h2>Conversation And Visible Thought Process</h2>
            @foreach (var step in LastResult.Steps.OrderBy(step => step.SortOrder))
            {
                <article class="council-step @(string.IsNullOrWhiteSpace(step.Error) ? string.Empty : "has-error")">
                    <header>
                        <span>@step.Phase</span>
                        <strong>@step.ModelName</strong>
                        <small>@step.Role - @step.DurationSeconds.ToString("0.0")s</small>
                        <small>Members: @string.Join(" + ", step.CouncilMembers.Count > 0 ? step.CouncilMembers : LastResult.ModelNames)</small>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(step.Error))
                    {
                        <DxButton Text="@($"Exclude {step.ModelName}")"
                                  RenderStyle="ButtonRenderStyle.Danger"
                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                  Enabled="@(!isBusy && SelectedModels.Count > 1)"
                                  Click="@(() => ExcludeModel(step.ModelName))" />
                    }
                    @if (!string.IsNullOrWhiteSpace(step.Thinking))
                    {
                        <details class="thinking-box" open>
                            <summary>Visible model thinking</summary>
                            <pre>@step.Thinking</pre>
                        </details>
                    }
                    <div class="markdown-output">@((MarkupString)Markdown.ToHtml(step.VisibleContent).Trim())</div>
                </article>
            }
        </section>
    }
</main>

@code {
    readonly string toastName = "ModelCouncilToasts";
    readonly HashSet<string> SelectedModels = new(StringComparer.OrdinalIgnoreCase);
    List<MultiModelCouncilModelCandidate> Candidates { get; set; } = [];
    List<ChatMemoryConversationSummary> SavedCouncilConversations { get; set; } = [];
    ChatMemoryConversationSummary? SelectedCouncilConversation { get; set; }
    MultiModelCouncilResult? LastResult { get; set; }
    string ManualModelName { get; set; } = "qwen3-coder:30b";
    string statusText = string.Empty;
    bool isBusy;

    MultiModelCouncilRequest Request { get; set; } = new()
    {
        Prompt = "Ask gpt-oss:20b and the coder model to design the best and most ethical LocalGPT multi-model council feature." + "\n\n" +
            "Cover:\n" +
            "- how several models should peacefully negotiate and correct each other,\n" +
            "- how the transcript and visible reasoning notes should be shown to users,\n" +
            "- how SQLite memory should make prior council work available to later model calls,\n" +
            "- how this should help generate complex Java Minecraft mods safely,\n" +
            "- what privacy, safety, and user-control limits should exist.\n\n" +
            "Separate what LocalGPT already does from proposed future improvements. Mark anything uncertain under Needs verification.",
        MaxRounds = 1,
        MaxOutputTokens = 1024,
        MaxParallelModels = 1,
        MaxContextTokens = 4096,
        ModelTimeoutSeconds = 180,
        IncludeMemory = true,
        SaveToMemory = true,
        GenerateImplementationArtifact = false
    };

    bool CanRun => !isBusy && SelectedModels.Count > 0 && !string.IsNullOrWhiteSpace(Request.Prompt);
    string KeepAliveText
    {
        get => Request.OllamaKeepAlive ?? string.Empty;
        set => Request.OllamaKeepAlive = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    bool ForceCpuOnlyOllama
    {
        get => Request.OllamaNumGpu == 0;
        set => Request.OllamaNumGpu = value ? 0 : null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCandidatesAsync();
        await LoadSavedCouncilConversationsAsync();
    }

    async Task LoadCandidatesAsync()
    {
        await RunUiActionAsync(async () =>
        {
            Candidates = (await CouncilService.GetCandidatesAsync()).ToList();

            if (SelectedModels.Count == 0)
            {
                foreach (var candidate in Candidates.Where(candidate => candidate.IsInstalled || candidate.IsConfigured).Take(2))
                    SelectedModels.Add(candidate.ModelName);
            }

            statusText = Candidates.Count == 0
                ? "No Ollama models found."
                : $"Found {Candidates.Count} Ollama model(s).";
        }, "LoadCandidatesAsync");
    }

    async Task RunCouncilAsync()
    {
        await RunUiActionAsync(async () =>
        {
            Request.ModelNames = SelectedModels.ToList();
            LastResult = await CouncilService.RunAsync(Request);
            if (LastResult.MemoryConversationId is Guid memoryId)
            {
                Request.ContinueConversationId = memoryId;
                await LoadSavedCouncilConversationsAsync(showStatus: false);
                SelectedCouncilConversation = SavedCouncilConversations.FirstOrDefault(conversation => conversation.Id == memoryId);
            }
            statusText = $"Council completed with {LastResult.Steps.Count} transcript step(s).";
            Notifier.ShowSuccess(toastName, "Council transcript saved and visualized.", "Council complete");
        }, "RunCouncilAsync");
    }

    async Task LoadSavedCouncilConversationsAsync()
    {
        await LoadSavedCouncilConversationsAsync(showStatus: true);
    }

    async Task LoadSavedCouncilConversationsAsync(bool showStatus)
    {
        await RunUiActionAsync(async () =>
        {
            SavedCouncilConversations = (await ChatMemory.GetConversationsAsync(100))
                .Where(conversation => conversation.ProviderName.StartsWith("AI Council", StringComparison.OrdinalIgnoreCase))
                .ToList();

            SelectedCouncilConversation = Request.ContinueConversationId is Guid selectedId
                ? SavedCouncilConversations.FirstOrDefault(conversation => conversation.Id == selectedId)
                : null;

            if (showStatus)
                statusText = $"Loaded {SavedCouncilConversations.Count} saved council conversation(s).";
        }, "LoadSavedCouncilConversationsAsync");
    }

    void AddManualModel()
    {
        var model = ManualModelName.Trim();
        if (string.IsNullOrWhiteSpace(model))
            return;

        SelectedModels.Add(model);
        if (!Candidates.Any(candidate => candidate.ModelName.Equals(model, StringComparison.OrdinalIgnoreCase)))
        {
            Candidates.Add(new MultiModelCouncilModelCandidate(
                model,
                "Manual Ollama",
                "http://localhost:11434",
                IsInstalled: false,
                IsConfigured: false,
                IsLoaded: false,
                Details: "Manual model name. Ollama will report an error if it is not installed."));
        }
        statusText = $"Added {model}.";
    }

    void ToggleModel(string modelName, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value
            ? value
            : bool.TryParse(Convert.ToString(args.Value), out var parsed) && parsed;

        if (isChecked)
            SelectedModels.Add(modelName);
        else
            SelectedModels.Remove(modelName);
    }

    void SelectCouncilConversation(ChatMemoryConversationSummary conversation)
    {
        SelectedCouncilConversation = conversation;
        Request.ContinueConversationId = conversation.Id;
        statusText = $"Selected council memory: {conversation.DisplayName}";
    }

    void StartNewCouncilThread()
    {
        SelectedCouncilConversation = null;
        Request.ContinueConversationId = null;
        Request.GenerateImplementationArtifact = false;
        statusText = "Next council run will start a new memory conversation.";
    }

    void ApplyLowResourcePreset()
    {
        Request.MaxRounds = 0;
        Request.MaxOutputTokens = 1024;
        Request.MaxParallelModels = 1;
        Request.MaxContextTokens = 2048;
        Request.ModelTimeoutSeconds = 300;
        Request.OllamaKeepAlive = "0s";
        Request.OllamaNumGpu = 0;
        Request.IncludeMemory = true;
        Request.SaveToMemory = true;
        statusText = "Low GPU preset active: one proposal pass, small context, CPU-only Ollama, and unload after each model.";
    }

    void ApplyBalancedPreset()
    {
        Request.MaxRounds = 1;
        Request.MaxOutputTokens = 2048;
        Request.MaxParallelModels = 1;
        Request.MaxContextTokens = 8192;
        Request.ModelTimeoutSeconds = 240;
        Request.OllamaKeepAlive = null;
        Request.OllamaNumGpu = null;
        Request.IncludeMemory = true;
        Request.SaveToMemory = true;
        statusText = "Balanced preset active: sequential models, one review round, normal Ollama GPU scheduling.";
    }

    void StartFeatureRequestChat()
    {
        SelectedCouncilConversation = null;
        Request.ContinueConversationId = null;
        Request.SaveToMemory = true;
        Request.IncludeMemory = true;
        Request.GenerateImplementationArtifact = true;
        Request.Prompt = string.Join(Environment.NewLine, new[]
        {
            "Start a new LocalGPT implementation-request council chat.",
            "",
            "Goal:",
            "Ask the council to identify one useful feature request, decide which part of LocalGPT owns it, and produce a grounded implementation plan.",
            "",
            "Requirements:",
            "- classify the target area: .NET/Blazor/ASP.NET Core, WinUI/WebView2, Minecraft builder, diagnostics/logging, or frontend UX",
            "- check the DevExpress inventory before proposing DevExpress APIs, reports, Office files, PDFs, or document components",
            "- keep DevExpress Office/report/PDF/file generation in ASP.NET Core backend services with safe download links",
            "- prototype requested features in a harmless sandbox artifact or temporary workspace before integrating into the real project",
            "- never self-expand LocalGPT or integrate generated features without explicit user permission",
            "- never overrule a user decision that denies or limits expansion",
            "- separate current implementation facts from proposed work",
            "- list exact files or services likely to change",
            "- include a small user decision poll if ownership or scope is uncertain",
            "- request a downloadable example file when a .NET/Blazor/ASP.NET Core sketch would help",
            "- mark unsupported claims under Needs verification"
        });
        statusText = "Started a new implementation-request council chat with example file generation enabled.";
    }

    string GetArtifactUrl(CouncilArtifact artifact) =>
        Navigation.ToAbsoluteUri(artifact.DownloadUrl).ToString();

    void ExcludeModel(string modelName)
    {
        if (SelectedModels.Count <= 1)
        {
            statusText = "Keep at least one council model selected.";
            return;
        }

        if (SelectedModels.Remove(modelName))
        {
            Request.Prompt = $"{Request.Prompt}\n\nUser decision for the next council round:\nExclude `{modelName}` from the council unless I re-add it. Remaining members must acknowledge the exclusion and continue from the prior transcript.";
            statusText = $"Excluded {modelName} from the next round.";
        }
    }

    void ApplyPollOption(CouncilUserPollOption option)
    {
        if (option.Label.Contains("Exclude", StringComparison.OrdinalIgnoreCase) && LastResult is not null)
        {
            foreach (var modelName in LastResult.Steps
                .Where(step => !string.IsNullOrWhiteSpace(step.Error))
                .Select(step => step.ModelName)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList())
            {
                if (SelectedModels.Count > 1)
                    SelectedModels.Remove(modelName);
            }
        }

        Request.Prompt = $"{Request.Prompt}\n\nUser decision for the next council round:\n{option.FollowUpPrompt}";
        statusText = $"Poll choice added: {option.Label}. Run Council again to continue.";
    }

    async Task RunUiActionAsync(Func<Task> action, string operation)
    {
        try
        {
            isBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception in {Operation}: {Message}", operation, ex.Message);
            statusText = ex.Message;
            Notifier.ShowError(toastName, ex.Message, $"Error in {operation}");
        }
        finally
        {
            isBusy = false;
        }
    }
}
