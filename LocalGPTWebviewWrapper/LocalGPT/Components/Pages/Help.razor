@page "/help"
@inject ICustomVersion Version
@inject IDocumentationCatalogService Documentation
@inject ILogger<Help> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization

<PageTitle>Documentation</PageTitle>

<main class="help-page">
    <section class="help-hero">
        <div>
            <p class="help-kicker">LocalGPT @Version.Version</p>
            <h1>Documentation</h1>
            <p>The former handwritten help cards have been replaced by build-generated DocFX documentation and API reference pages sourced from maintained articles and C# XML comments.</p>
            <div class="help-status" aria-label="Documentation status">
                <span class="badge text-bg-@(documentationStatus.HtmlAvailable ? "success" : "warning")">HTML @(documentationStatus.HtmlAvailable ? "ready" : "not built")</span>
                <span class="badge text-bg-@(documentationStatus.PdfAvailable ? "success" : "warning")">PDF @(documentationStatus.PdfAvailable ? "ready" : "not built")</span>
                <span class="badge text-bg-secondary">@documentationStatus.CommentCount XML members</span>
                @if (documentationStatus.GeneratedAtUtc is DateTime generated)
                {
                    <span>Generated @generated.ToLocalTime().ToString("g")</span>
                }
            </div>
        </div>
        <div class="help-actions" aria-label="Documentation actions">
            <a class="btn btn-primary" href="/help-docs/index.html" target="_blank" rel="noopener">Open HTML documentation</a>
            <a class="btn btn-outline-secondary" href="@documentationStatus.PdfUrl" data-enhance-nav="false">@Localization.GetText("Open PDF documentation")</a>
            <a class="btn btn-outline-secondary" href="/api/documentation/status" target="_blank" rel="noopener">Build status JSON</a>
            <a class="btn btn-outline-secondary" href="/api/documentation/comments?limit=100" target="_blank" rel="noopener">Browse XML comments</a>
        </div>
    </section>

    <section class="help-grid">
        <article class="help-panel">
            <h2>Chat and AI Council</h2>
            <p>Provider selection, Council teams, model routes, human participation, memory and responsive configuration surfaces.</p>
            <a href="/help-docs/articles/chat-and-council.html" target="_blank" rel="noopener">Read chapter</a>
        </article>
        <article class="help-panel">
            <h2>Embedded firmware</h2>
            <p>ESP32/Arduino pin planning, transport-neutral wiring, firmware artifacts and approval-gated compiler boundaries.</p>
            <a href="/help-docs/articles/embedded-firmware.html" target="_blank" rel="noopener">Read chapter</a>
        </article>
        <article class="help-panel">
            <h2>Workspaces</h2>
            <p>Local environments, compiler profiles, expected structures, regex policies and Approved/Warning/Danger findings.</p>
            <a href="/help-docs/articles/workspaces.html" target="_blank" rel="noopener">Read chapter</a>
        </article>
        <article class="help-panel">
            <h2>GameDirector runtime</h2>
            <p>Authoritative move validation, controller proposals, creature/object subdirectors and runtime-class factories.</p>
            <a href="/help-docs/articles/game-director.html" target="_blank" rel="noopener">Read chapter</a>
        </article>
        <article class="help-panel">
            <h2>Security</h2>
            <p>Local-first execution, untrusted inputs, bounded writes, protected transports and explicit approval boundaries.</p>
            <a href="/help-docs/articles/security.html" target="_blank" rel="noopener">Read chapter</a>
        </article>
        <article class="help-panel help-api-panel">
            <h2>API reference</h2>
            <p>Public services, controllers, business contracts and runtime capabilities generated from XML documentation.</p>
            <a href="/help-docs/api/index.html" target="_blank" rel="noopener">Open API reference</a>
        </article>
    </section>

    <section class="help-panel help-wide">
        <h2>Build behavior</h2>
        <p>Normal Windows builds restore the repository-local DocFX tool, generate the complete modern HTML site and XML-backed API reference, and require one versioned PDF containing the same root table of contents. PDF generation requires Node.js 20 or later. Set <code>BuildLocalGptDocumentation=false</code> or <code>RequireLocalGptDocumentationPdf=false</code> only for an explicit infrastructure diagnosis.</p>
    </section>
</main>

@code {
    private LocalGptDocumentationStatus documentationStatus = new();

    protected override void OnInitialized()
    {
        try
        {
            documentationStatus = Documentation.GetStatus();
            ComponentActivity.RecordInformation(nameof(Help), nameof(OnInitialized), "The generated documentation catalog status was loaded.", "/help");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Loading generated LocalGPT documentation status failed.");
            ComponentActivity.RecordFailure(nameof(Help), nameof(OnInitialized), exception, "/help");
            Notifier.ShowWarning(nameof(Help), "Documentation status is unavailable; build-generated files may not exist yet.", "Documentation");
        }
    }
}
