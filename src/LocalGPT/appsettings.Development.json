    "PackageProfiles": [
      {
        "Key": "core",
        "DisplayName": "Local AI Python core",
        "Description": "Baseline Python packages for LocalGPT-managed AI environments. Python.NET itself is a .NET application dependency and is not installed with pip.",
        "Packages": [
          "safetensors>=0.5"
        ],
        "IncludesTorch": false
      },
      {
        "Key": "pytorch-default",
        "DisplayName": "PyTorch default wheels",
        "Description": "Installs the default PyPI PyTorch packages. For vendor-specific CUDA/ROCm builds, install the reviewed vendor wheel source instead of using this profile.",
        "Packages": [
          "torch",
          "torchvision",
          "torchaudio"
        ],
        "IncludesTorch": true
      },
      {
        "Key": "whisper-runtime",
        "DisplayName": "OpenAI Whisper Python support",
        "Description": "Installs Whisper Python dependencies except PyTorch. Install the PyTorch backend appropriate for this machine separately; LocalGPT then installs the reviewed OpenAI Whisper GitHub source with --no-deps so it cannot silently replace your torch build.",
        "Packages": [
          "more-itertools",
          "numba",
          "numpy",
          "tiktoken",
          "tqdm",
          "soundfile",
          "librosa"
        ],
        "IncludesTorch": false
      },
      {
        "Key": "image",
        "DisplayName": "Diffusers image generation",
        "Description": "Diffusers image pipelines such as Qwen-Image, FLUX and compatible text-to-image models. Requires a working PyTorch installation.",
        "Packages": [
          "diffusers>=0.35",
          "transformers>=4.55",
          "accelerate>=1.10",
          "Pillow>=10",
          "sentencepiece",
          "protobuf"
        ],
        "IncludesTorch": false
      },
      {
        "Key": "video",
        "DisplayName": "Diffusers video generation",
        "Description": "Text-to-video pipelines such as compatible Wan-family models. Requires a working PyTorch installation and can consume substantial VRAM/RAM.",
        "Packages": [
          "diffusers>=0.35",
          "transformers>=4.55",
          "accelerate>=1.10",
          "Pillow>=10",
          "imageio>=2.37",
          "imageio-ffmpeg>=0.6",
          "sentencepiece",
          "protobuf"
        ],
        "IncludesTorch": false
      },
      {
        "Key": "speech",
        "DisplayName": "Transformers speech recognition",
        "Description": "Whisper-family and compatible automatic speech-recognition pipelines with decoded-audio admission checks.",
        "Packages": [
          "transformers>=4.55",
          "accelerate>=1.10",
          "soundfile>=0.13",
          "librosa>=0.11",
          "sentencepiece",
          "protobuf"
        ],
        "IncludesTorch": false
      },
      {
        "Key": "hub-huggingface",
        "DisplayName": "Optional Hugging Face Hub client",
        "Description": "Optional provider-hub client used only when you explicitly choose Hugging Face metadata/snapshot workflows. It is not required for direct GitHub/Python model installation.",
        "Packages": [
          "huggingface_hub>=0.30"
        ],
        "IncludesTorch": false
      },
      {
        "Key": "web-content",
        "DisplayName": "Dynamic web content",
        "Description": "Playwright rendering and bounded web evidence. Install Chromium separately through localai.web.browser.install.",
        "Packages": [
          "playwright>=1.48,<2"
        ],
        "IncludesTorch": false
      }
    ]
  },
