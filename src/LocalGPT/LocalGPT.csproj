  <Target Name="IncludeWireProtocolPackageForPublish"
          BeforeTargets="ComputeFilesToPublish"
          Condition="'$(IncludeWireProtocolPackageInPublish)' == 'true'">
    <PropertyGroup>
      <WireProtocolPackageName>LocalGPT.WireProtocolVersion.$(LocalGptWireProtocolVersion).nupkg</WireProtocolPackageName>
      <WireProtocolPackage>$(LocalGptWireProtocolPackageDirectory)\$(WireProtocolPackageName)</WireProtocolPackage>
    </PropertyGroup>
    <Error Condition="!Exists('$(WireProtocolPackage)')"
           Text="The RID-neutral LocalGPT 1-Wire package is missing: $(WireProtocolPackage). Run build\Publish-WireProtocolPackage.ps1 first or disable IncludeWireProtocolPackageInPublish." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(WireProtocolPackage)">
        <RelativePath>protocol/$(WireProtocolPackageName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Update="Localization\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Configuration\OrganicAddons\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Configuration\EmbeddedBoards\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
