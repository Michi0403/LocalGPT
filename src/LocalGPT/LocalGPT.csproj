<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Version>2.3.5</Version>
	  <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
	  <IncludeSymbols>True</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <AnalysisLevel>latest</AnalysisLevel>
	  <AnalysisMode>None</AnalysisMode>
	  <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	  <IsPackable>false</IsPackable>
	  <CopySatelliteAssemblies>true</CopySatelliteAssemblies>
	  
	  <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
	  <PublishTrimmed>false</PublishTrimmed>
	  <PublishSingleFile>false</PublishSingleFile>
	  <PublishReadyToRun>false</PublishReadyToRun>
	  <Optimize>False</Optimize>
	  <RuntimeIdentifiers>
		  win-x64;
		  win-x86;
		  win-arm64;
		  linux-x64;
		  linux-arm64;
		  osx-x64;
		  osx-arm64
	  </RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalWireProtocolProject)' == 'true'">
    <ProjectReference Include="..\LocalGPT.WireProtocolVersion\LocalGPT.WireProtocolVersion.csproj"
                      GlobalPropertiesToRemove="Platform;PlatformTarget;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun;PublishAot" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalWireProtocolProject)' != 'true'">
    <PackageReference Include="LocalGPT.WireProtocolVersion" Version="$(LocalGptWireProtocolVersion)" />
  </ItemGroup>

