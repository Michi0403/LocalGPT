@inject ThemeService Themes
@implements IDisposable
@implements IThemeLoadNotifier
@inject ILogger<ThemeSwitcherContainer> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization

<div class="themeswitcher-container shadow @StateCssClass">
    <ToastWrapper Name="@toastName" />
    @if (IsLoaded)
    {
        <div class="theme-layer-toolbar">
            <div class="theme-layer-toolbar-title">
                <strong>@T("Theme Fusion")</strong>
                <small>@ThemeRouteSummary</small>
            </div>
            <button type="button" class="localgpt-native-button" @onclick="CloseAsync">@T("Done")</button>
        </div>
        <div class="blazor-themes blazor-scroll-view">
            <section class="theme-layer-section" aria-label="@(T("Base theme"))">
                <div class="theme-layer-heading">
                    <strong>@T("Base Theme")</strong>
                    <small>@T("Sets the visual foundation for pages, navigation, native surfaces and syntax highlighting.")</small>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var themeSet in Themes.ThemeSets)
                    {
                        <span class="themeswitcher-group card-header list-group-item">@themeSet.Title</span>
                        @foreach (var theme in themeSet.Themes)
                        {
                            <ThemeSwitcherItem Theme="@theme"
                                               IsActive="@IsShellThemeActive(theme)"
                                               Click="@(selected => ThemeSwitcherItem_Click(selected, ThemeApplicationTarget.Shell))" />
                        }
                    }
                </div>
            </section>

            <section class="theme-layer-section" aria-label="@(T("Style layer"))">
                <div class="theme-layer-heading">
                    <strong>@T("Style Layer")</strong>
                    <small>@T("Blends with, overrides or extends the Base Theme across DevExpress editors, grids, chat controls and buttons.")</small>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var themeSet in Themes.ThemeSets)
                    {
                        <span class="themeswitcher-group card-header list-group-item">@themeSet.Title</span>
                        @foreach (var theme in themeSet.Themes)
                        {
                            <ThemeSwitcherItem Theme="@theme"
                                               IsActive="@IsComponentThemeActive(theme)"
                                               Click="@(selected => ThemeSwitcherItem_Click(selected, ThemeApplicationTarget.Components))" />
                        }
                    }
                </div>
            </section>

            <section class="theme-route-section" aria-label="@(T("Theme Fusion route"))">
                <div class="theme-layer-heading theme-route-heading">
                    <strong>@T("Fusion Route")</strong>
                    <small>@T("The result can depend on selection order. This is the stored path that produced the current mix.")</small>
                </div>
                <div class="theme-route-content" aria-live="polite">
                    <div class="theme-route-current">
                        <span><strong>@T("Base"):</strong> @Themes.ActiveShellTheme.Title</span>
                        <span><strong>@T("Style"):</strong> @Themes.ActiveComponentTheme.Title</span>
                    </div>

                    <div class="theme-used-block">
                        <strong>@T("Used themes")</strong>
                        <div class="theme-used-list">
                            @foreach (var theme in UsedThemes)
                            {
                                <span class="theme-used-chip @theme.IconCssClass" title="@theme.Name">@theme.Title</span>
                            }
                        </div>
                    </div>

                    @if (Themes.FusionRoute.Count == 0)
                    {
                        <p class="theme-route-empty">@T("No selection route has been recorded yet.")</p>
                    }
                    else
                    {
                        <ol class="theme-route-list">
                            @foreach (var step in Themes.FusionRoute)
                            {
                                <li class="theme-route-step">
                                    <span class="theme-route-number">@step.Sequence</span>
                                    <span class="theme-route-target @GetTargetCssClass(step.Target)">@GetTargetTitle(step.Target)</span>
                                    <span class="theme-route-theme" title="@step.ThemeName">@Themes.GetThemeTitle(step.ThemeName)</span>
                                </li>
                            }
                        </ol>
                    }

                    <div class="theme-route-reset">
                        <button type="button"
                                class="localgpt-native-button"
                                disabled="@(Themes.ThemeChangeRequestDispatcher is null)"
                                @onclick="ResetFusionRouteAsync">
                            @T("Reset route")
                        </button>
                        <small>@T("Keeps the current Base Theme and Style Layer, removes earlier swaps, then reloads the page cleanly.")</small>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the toast name value that forms part of the theme switcher container state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The toast name value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    string toastName { get; set; } = "ThemeSwitcherContainerToasts";

    /// <summary>
    /// Gets or sets a value indicating whether shown applies to the theme switcher container state.
    /// </summary>
    /// <value>The shown value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    [Parameter]
    public bool Shown { get; set; }

    /// <summary>
    /// Gets or sets the shown changed value that forms part of the theme switcher container state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The shown changed value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    [Parameter]
    public EventCallback<bool> ShownChanged { get; set; }

    /// <summary>
    /// Gets or sets the shell theme name value that forms part of the theme switcher container state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The shell theme name value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    [Parameter]
    public string? ShellThemeName { get; set; }

    /// <summary>
    /// Gets or sets the shell theme name changed value that forms part of the theme switcher container state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The shell theme name changed value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    [Parameter]
    public EventCallback<string> ShellThemeNameChanged { get; set; }

    /// <summary>
    /// Gets or sets the component theme name value that forms part of the theme switcher container state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The component theme name value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    [Parameter]
    public string? ComponentThemeName { get; set; }

    /// <summary>
    /// Gets or sets the component theme name changed value that forms part of the theme switcher container state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The component theme name changed value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    [Parameter]
    public EventCallback<string> ComponentThemeNameChanged { get; set; }

    /// <summary>
    /// Gets the state CSS class value that forms part of the theme switcher container state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The state CSS class value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    string StateCssClass => IsLoaded
        ? Shown ? "themeswitcher-container-shown" : "themeswitcher-container-hidden"
        : string.Empty;

    /// <summary>
    /// Gets the used themes collection maintained or exposed by this theme switcher container instance for downstream processing.
    /// </summary>
    /// <value>The used themes value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    IEnumerable<Theme> UsedThemes => Themes.FusionRoute
        .Select(step => Themes.FindThemeByName(step.ThemeName))
        .Where(theme => theme is not null)
        .Cast<Theme>()
        .GroupBy(theme => theme.Name, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First());

    /// <summary>
    /// Gets or sets a value indicating whether loaded applies to the theme switcher container state.
    /// </summary>
    /// <value>The is loaded value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    bool IsLoaded { get; set; }
    /// <summary>
    /// Stores the internal disposed value state used by <see cref="ThemeSwitcherContainer"/> while executing its surrounding workflow.
    /// </summary>
    bool disposedValue;

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="ThemeSwitcherContainer"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            base.OnInitialized();
            Themes.ThemeLoadNotifier = this;
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            Logger.LogError(ex, "Unable to initialize the theme switcher.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcherContainer), nameof(OnInitialized), ex);
        }
    }

    /// <summary>
    /// Determines whether shell theme active for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <param name="theme">Theme value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    bool IsShellThemeActive(Theme theme) =>
        string.Equals(ShellThemeName, theme.Name, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Determines whether component theme active for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <param name="theme">Theme value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    bool IsComponentThemeActive(Theme theme) =>
        string.Equals(ComponentThemeName, theme.Name, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Performs t for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <param name="source">Source value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    string T(string source) => Localization.GetText(source);

    /// <summary>
    /// Gets the theme route summary value that forms part of the theme switcher container state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The theme route summary value exposed by <see cref="ThemeSwitcherContainer"/>.</value>
    string ThemeRouteSummary => string.Format(
        System.Globalization.CultureInfo.CurrentUICulture,
        T("{0} route steps · {1} themes used"),
        Themes.FusionRoute.Count,
        UsedThemes.Count());

    /// <summary>
    /// Retrieves target title for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <param name="target">Target value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    string GetTargetTitle(ThemeApplicationTarget target) =>
        T(target == ThemeApplicationTarget.Shell ? "Base" : "Style");

    /// <summary>
    /// Retrieves target CSS class for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <param name="target">Target value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    string GetTargetCssClass(ThemeApplicationTarget target) =>
        target == ThemeApplicationTarget.Shell ? "theme-route-target-base" : "theme-route-target-style";

    /// <summary>
    /// Performs theme switcher item click for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <param name="theme">Theme value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <param name="target">Target value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task ThemeSwitcherItem_Click(Theme theme, ThemeApplicationTarget target)
    {
        try
        {
            if (Themes.ThemeChangeRequestDispatcher is null)
                throw new InvalidOperationException("The theme change dispatcher is not ready yet.");

            await Themes.ThemeChangeRequestDispatcher
                .RequestThemeChangeAsync(theme, target)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // The user navigated while a theme asset was changing.
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            Logger.LogError(ex, "Theme Fusion selection failed; selected theme details were omitted from logs.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcherContainer), nameof(ThemeSwitcherItem_Click), ex);
        }
    }

    /// <summary>
    /// Performs reset fusion route for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task ResetFusionRouteAsync()
    {
        try
        {
            if (Themes.ThemeChangeRequestDispatcher is null)
                throw new InvalidOperationException("The theme change dispatcher is not ready yet.");

            await Themes.ThemeChangeRequestDispatcher
                .ResetFusionRouteAsync()
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // The requested clean reload can cancel the current circuit callback.
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The Theme Fusion route could not be reset. See local logs for details.", "Route reset failed");
            Logger.LogError(ex, "Theme Fusion route reset request failed.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcherContainer), nameof(ResetFusionRouteAsync), ex);
        }
    }

    /// <summary>
    /// Performs notify theme loaded for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <param name="theme">Theme value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <param name="target">Target value supplied to the theme switcher container operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async Task NotifyThemeLoadedAsync(Theme theme, ThemeApplicationTarget target)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (target == ThemeApplicationTarget.Shell)
                {
                    ShellThemeName = theme.Name;
                    await ShellThemeNameChanged.InvokeAsync(theme.Name).ConfigureAwait(false);
                }
                else
                {
                    ComponentThemeName = theme.Name;
                    await ComponentThemeNameChanged.InvokeAsync(theme.Name).ConfigureAwait(false);
                }

                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // The user navigated while the callback was queued.
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            Logger.LogError(ex, "Theme-loaded UI notification failed; selected theme details were omitted from logs.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcherContainer), nameof(NotifyThemeLoadedAsync), ex);
        }
    }

    /// <summary>
    /// Performs close for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    Task CloseAsync() => ToggleThemeSwitcherPanel(false);

    /// <summary>
    /// Performs toggle theme switcher panel for <see cref="ThemeSwitcherContainer"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher container workflow.
    /// </summary>
    /// <param name="shown">Value indicating whether shown should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task ToggleThemeSwitcherPanel(bool shown)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (shown == Shown)
                    return;

                Shown = shown;
                await ShownChanged.InvokeAsync(shown).ConfigureAwait(false);
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // The user navigated while the panel was closing.
        }
        catch (Exception ex)
        {
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            Logger.LogError(ex, "Theme panel state change failed.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcherContainer), nameof(ToggleThemeSwitcherPanel), ex);
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="ThemeSwitcherContainer"/> and leaves the theme switcher container workflow in a safely disposed state.
    /// </summary>
    /// <returns>The void i disposable produced by the operation.</returns>
    void IDisposable.Dispose()
    {
        if (disposedValue)
            return;

        if (ReferenceEquals(Themes.ThemeLoadNotifier, this))
            Themes.ThemeLoadNotifier = null;

        disposedValue = true;
        GC.SuppressFinalize(this);
    }

    /// <summary>
    /// Handles the after render lifecycle or event notification for <see cref="ThemeSwitcherContainer"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    protected override void OnAfterRender(bool firstRender)
    {
        try
        {
            if (!firstRender)
                return;

            IsLoaded = true;
            if (Shown)
                StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Theme state restoration failed; persisted theme details were omitted from logs.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcherContainer), "RestoreThemeState", ex);
            Notifier.ShowWarning(toastName, "The saved theme state could not be restored. LocalGPT kept the current themes.", "Theme warning");
        }
    }
}
