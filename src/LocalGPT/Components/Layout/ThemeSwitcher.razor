@inject CouncilTextService CouncilText
@implements IDisposable
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject ThemeService Themes
@inject ILogger<ThemeSwitcher> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<ThemeJsChangeDispatcher InitialShellThemeName="@ShellThemeName"
                         InitialComponentThemeName="@ComponentThemeName" />
<ToastWrapper Name="@toastName" />
<div class="@HeaderCss">
    <div class="btn-container d-flex">
        <DxButton Click="@Toggle"
                  CssClass="@ButtonCss"
                  SizeMode="SizeMode.Large"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  IconCssClass="theme-icon"
                  aria-label="Themes"
                  aria-haspopup="true"
                  aria-expanded="@_open" />
    </div>

    <ThemeSwitcherContainer @bind-Shown="_open"
                            @bind-ShellThemeName="ShellThemeName"
                            @bind-ComponentThemeName="ComponentThemeName" />
</div>

@code
{
    /// <summary>
    /// Gets or sets the toast name value that forms part of the theme switcher state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The toast name value exposed by <see cref="ThemeSwitcher"/>.</value>
    string toastName { get; set; } = "ThemeSwitcherRazorToasts";
    /// <summary>
    /// Gets or sets the shell theme name value that forms part of the theme switcher state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The shell theme name value exposed by <see cref="ThemeSwitcher"/>.</value>
    string ShellThemeName { get; set; } = ThemeService.DEFAULT_THEME_NAME;
    /// <summary>
    /// Gets or sets the component theme name value that forms part of the theme switcher state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The component theme name value exposed by <see cref="ThemeSwitcher"/>.</value>
    string ComponentThemeName { get; set; } = ThemeService.DEFAULT_THEME_NAME;
    /// <summary>
    /// Stores the internal open state used by <see cref="ThemeSwitcher"/> while executing its surrounding workflow.
    /// </summary>
    bool _open;
    /// <summary>
    /// Stores the internal disposed state used by <see cref="ThemeSwitcher"/> while executing its surrounding workflow.
    /// </summary>
    bool _disposed;

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="ThemeSwitcher"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            if (!Themes.IsInitialized)
            {
                var legacyCookie = HttpContextAccessor.HttpContext?.Request.Cookies[ThemeService.LegacyThemeCookieName];
                var shellCookie = HttpContextAccessor.HttpContext?.Request.Cookies[ThemeService.ShellThemeCookieName];
                var componentCookie = HttpContextAccessor.HttpContext?.Request.Cookies[ThemeService.ComponentThemeCookieName];
                Themes.InitializeThemes(shellCookie ?? legacyCookie, componentCookie ?? legacyCookie);
            }

            ShellThemeName = Themes.ActiveShellTheme.Name;
            ComponentThemeName = Themes.ActiveComponentTheme.Name;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Theme initialization failed; local state details were omitted from logs.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcher), nameof(OnInitialized), ex);
            Notifier.ShowError(toastName, "The theme could not be initialized. See local application logs for details.", "Theme initialization failed");
        }
    }

    /// <summary>
    /// Performs toggle for <see cref="ThemeSwitcher"/>, keeping the operation consistent with the state and invariants of the surrounding theme switcher workflow.
    /// </summary>
    void Toggle()
    {
        try
        {
            _open = !_open;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Theme panel toggle failed.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcher), nameof(Toggle), ex);
            Notifier.ShowError(toastName, "The theme panel could not be opened. See local logs for details.", "Theme panel failed");
        }
    }

    /// <summary>
    /// Gets the button CSS value that forms part of the theme switcher state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The button CSS value exposed by <see cref="ThemeSwitcher"/>.</value>
    string ButtonCss => "themeswitcher-button theme-settings " + _open;
    /// <summary>
    /// Gets the header CSS value that forms part of the theme switcher state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The header CSS value exposed by <see cref="ThemeSwitcher"/>.</value>
    string HeaderCss => Themes.GetThemeLayerCssClass(ShellThemeName, ComponentThemeName);

    /// <summary>
    /// Releases resources owned by <see cref="ThemeSwitcher"/> and leaves the theme switcher workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        try
        {
            if (_disposed)
                return;

            _disposed = true;
            GC.SuppressFinalize(this);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Theme switcher disposal failed.");
            ComponentActivity.RecordFailure(nameof(ThemeSwitcher), nameof(Dispose), ex);
        }
    }
}
