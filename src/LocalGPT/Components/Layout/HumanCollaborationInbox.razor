@using System.Text.Json
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject IHumanCollaborationService Collaboration
@inject IDeferredDxAiInvocationService DeferredDxInvocations
@inject ILocalGptVocabularyService Vocabulary
@inject ILocalGptRuntimePolicyDataService RuntimePolicy
@inject ILocalHumanInteractionContext HumanAmbientContext
@inject ILogger<HumanCollaborationInbox> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject ISupervisedTaskRunner TaskRunner
@inject IJSRuntime JS

<ToastWrapper Name="HumanCollaborationToasts" />

@if (!isOpen && approvalBarVisible && PendingRequests.Count > 0)
{
    var nextRequest = PendingRequests[0];
    <aside class="human-approval-bar" data-localgpt-overlay="approval" role="region" aria-label="Pending LocalGPT approvals">
        <div class="human-approval-bar-summary">
            <strong>@PendingCount AI Council action@(PendingCount == 1 ? string.Empty : "s") waiting</strong>
            <span>@nextRequest.Title</span>
            <small>@nextRequest.RequestKind · @nextRequest.QuestionScope · @GetGateLabel(nextRequest) · @nextRequest.RequestedBy</small>
        </div>
        <div class="human-approval-bar-actions">
            <button type="button" class="human-primary" data-localgpt-command="open-approvals" @onclick="OpenApprovalPanel">Review and work through</button>
            <button type="button" class="human-secondary" @onclick="HideApprovalBar">Hide bar</button>
        </div>
    </aside>
}

<button type="button"
        data-localgpt-command="open-approvals"
        class="human-inbox-launcher @(PendingCount > 0 ? "has-pending" : string.Empty)"
        title="Approvals, permissions and human Council participation"
        @onclick="TogglePanel">
    <span aria-hidden="true">🔒</span>
    <span>Approvals & team</span>
    @if (PendingCount > 0)
    {
        <strong>@PendingCount</strong>
    }
</button>

@if (isOpen)
{
    <aside class="human-inbox-panel" aria-label="Human Collaboration Inbox">
        <header>
            <div>
                <h2>Human Collaboration</h2>
                <p>Persistent approvals, guidance, and council participation.</p>
            </div>
            <button type="button" class="human-inbox-close" @onclick="TogglePanel" aria-label="Close">×</button>
        </header>

        @if (isBusy)
        {
            <p class="human-inbox-status">Updating…</p>
        }
        else if (!string.IsNullOrWhiteSpace(statusText))
        {
            <p class="human-inbox-status">@statusText</p>
        }

        @if (recentDeferredResults.Count > 0)
        {
            <section class="human-inbox-section human-deferred-results">
                <h3>Completed approved actions</h3>
                @foreach (var result in recentDeferredResults)
                {
                    <article class="human-run-card">
                        <div class="human-card-heading">
                            <strong>@result.FunctionName</strong>
                            <span>@result.ResultStatus</span>
                        </div>
                        <p>@result.Summary</p>
                        @if (!string.IsNullOrWhiteSpace(result.DownloadUrl))
                        {
                            <a class="human-primary human-result-download" href="@result.DownloadUrl" target="_blank" rel="noopener">Download generated ZIP</a>
                        }
                    </article>
                }
            </section>
        }

        <section class="human-inbox-section">
            <h3>Take Part</h3>
            <label class="human-inbox-check">
                <input type="checkbox" @bind="profile.IsEnabled" @bind:after="MarkProfileDirty" />
                <span>Join active councils as a human peer</span>
            </label>
            <label>
                Display name
                <input @bind="profile.DisplayName" @bind:after="MarkProfileDirty" maxlength="120" />
            </label>
            <label>
                Team role
                <input @bind="profile.RoleName" @bind:after="MarkProfileDirty" maxlength="180" placeholder="Architecture reviewer, domain expert, musician…" />
            </label>
            <label>
                Expertise
                <textarea @bind="profile.Expertise" @bind:after="MarkProfileDirty" maxlength="2000" rows="3"></textarea>
            </label>
            <label>
                Working style
                <textarea @bind="profile.WorkingStyle" @bind:after="MarkProfileDirty" maxlength="1200" rows="2"></textarea>
            </label>
            <button type="button" class="human-primary" @onclick="SaveProfileAsync">Save participant profile</button>
            <p class="human-inbox-note">Participation is peer input, not automatic truth and not security approval.</p>
        </section>

        @if (snapshot.ActiveRuns.Count > 0)
        {
            <section class="human-inbox-section">
                <h3>Active council runs</h3>
                @foreach (var run in snapshot.ActiveRuns)
                {
                    <article @key="run.RunId" class="human-run-card">
                        <div class="human-card-heading">
                            <strong>Round @run.CurrentRound · @run.Phase</strong>
                            <span>@run.CouncilMembers.Count team member(s)</span>
                        </div>
                        @if (run.IsWaitingForFinalHumanInput)
                        {
                            <p><strong>Paused:</strong> this Council boundary is waiting for all applicable blocking questions below to be answered.</p>
                        }
                        <p>Your message enters the next heartbeat as a clearly marked human council contribution. Models must review it like every other member answer.</p>
                        <textarea id="@GetContributionEditorId(run.RunId)"
                                  data-localgpt-heartbeat-draft="true"
                                  maxlength="1000000"
                                  rows="4"
                                  placeholder="Add evidence, corrections, constraints, or your own answer without stopping the run."></textarea>
                        <button type="button" class="human-primary" @onclick="(() => SubmitContributionAsync(run.RunId))">Add to next heartbeat</button>
                    </article>
                }
            </section>
        }

        <section class="human-inbox-section">
            <h3>Open requests (@PendingCount)</h3>
            @if (PendingRequests.Count == 0)
            {
                <p class="human-inbox-note">No approval or feedback request is waiting.</p>
            }
            @foreach (var request in PendingRequests)
            {
                var editor = GetEditor(request);
                <article class="@GetRequestCssClass(request)">
                    <div class="human-card-heading">
                        <strong>@request.Title</strong>
                        <span>@request.RequestKind · @request.QuestionScope · @GetGateLabel(request)</span>
                    </div>
                    <p>@request.Description</p>
                    <dl>
                        <dt>Requested by</dt><dd>@request.RequestedBy</dd>
                        <dt>Source</dt><dd>@request.Source</dd>
                        <dt>Role requested</dt><dd>@request.RequestedRole</dd>
                        <dt>Question scope</dt><dd>@GetScopeLabel(request)</dd>
                        <dt>Execution gate</dt><dd>@GetGateDescription(request)</dd>
                        @if (!string.IsNullOrWhiteSpace(request.TargetMembersText))
                        {
                            <dt>Affected members</dt><dd>@request.TargetMembersDisplay</dd>
                        }
                        <dt>Asked during</dt><dd>Round @request.RequestedCouncilRound · @(string.IsNullOrWhiteSpace(request.RequestedCouncilPhase) ? "Unspecified phase" : request.RequestedCouncilPhase)</dd>
                        <dt>Operation</dt><dd>@request.OperationKey</dd>
                        @if (!string.IsNullOrWhiteSpace(request.ParameterFingerprint))
                        {
                            <dt>Exact request</dt><dd>@FingerprintPrefix(request.ParameterFingerprint)</dd>
                        }

                    </dl>
                    @if (request.SuggestedResponses.Count > 0)
                    {
                        <div class="human-suggestions">
                            @foreach (var suggestion in request.SuggestedResponses)
                            {
                                <button type="button" @onclick="(() => editor.Response = suggestion)">@suggestion</button>
                            }
                        </div>
                    }
                    @if (!request.AllowFreeText && !string.IsNullOrWhiteSpace(editor.Response))
                    {
                        <p><strong>Selected response:</strong> @editor.Response</p>
                    }
                    @if (request.AllowFreeText)
                    {
                        <label>
                            @(string.IsNullOrWhiteSpace(request.ResponsePrompt) ? "Response" : request.ResponsePrompt)
                            <textarea @bind="editor.Response" maxlength="1000000" rows="3"></textarea>
                        </label>
                    }
                    <label>
                        Reason / team note
                        <textarea @bind="editor.Reason" maxlength="2000" rows="2"></textarea>
                    </label>
                    @if (request.RequestKind == Vocabulary.Get().HumanRequestApproval)
                    {
                        <label>
                            Reuse scope
                            <select class="form-select" @bind="editor.ReuseScope">
                                <option value="@HumanApprovalReuseScope.ExactRequestOnce">Exact request once</option>
                                <option value="@HumanApprovalReuseScope.CurrentApplicationSession">Current application session</option>
                                <option value="@HumanApprovalReuseScope.PersistentUntilChanged">Persistent until changed</option>
                            </select>
                        </label>
                        <label class="human-inbox-check">
                            <input type="checkbox" @bind="editor.ConsumeApproval" />
                            <span>Consume the saved approval after one matching use</span>
                        </label>
                        <p class="human-inbox-note">Reuse always remains bound to the exact operation and parameter fingerprint. High-impact requests default to one use.</p>
                        <div class="human-decision-row">
                            <button type="button" class="human-approve" @onclick="(() => ResolveAsync(request, true))">Approve and save</button>
                            <button type="button" class="human-decline" @onclick="(() => ResolveAsync(request, false))">Decline and save</button>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="human-primary" @onclick="(() => ResolveAsync(request, null))">Send to team</button>
                    }
                </article>
            }
        </section>

        @if (snapshot.Contributions.Count > 0)
        {
            <section class="human-inbox-section">
                <h3>Your council contributions</h3>
                @foreach (var contribution in snapshot.Contributions.Take(12))
                {
                    <details class="human-history-card">
                        <summary>@contribution.Status · @contribution.EvaluationVerdict · @contribution.HumanRole · round @contribution.EarliestCouncilRound</summary>
                        <p>@contribution.Content</p>
                        @if (!string.IsNullOrWhiteSpace(contribution.Evaluation))
                        {
                            <p><strong>Peer review:</strong> @contribution.Evaluation</p>
                        }
                    </details>
                }
            </section>
        }

        @if (ResolvedRequests.Count > 0)
        {
            <section class="human-inbox-section">
                <h3>Saved decisions</h3>
                <p class="human-inbox-note">Saved decisions can be corrected later. Saving an edited approval clears its consumed timestamp and applies the new policy to the next exact matching call.</p>
                @foreach (var request in ResolvedRequests.Take(20))
                {
                    var editor = GetEditor(request);
                    <details class="human-history-card">
                        <summary>@request.Status · @request.Title</summary>
                        <dl>
                            <dt>Operation</dt><dd>@request.OperationKey</dd>
                            @if (!string.IsNullOrWhiteSpace(request.ParameterFingerprint))
                            {
                                <dt>Exact request</dt><dd>@FingerprintPrefix(request.ParameterFingerprint)</dd>
                            }
                            <dt>Decision version</dt><dd>@request.DecisionVersion</dd>
                            <dt>Updated</dt><dd>@request.UpdatedAtUtc.ToLocalTime()</dd>
                            @if (request.ConsumedAtUtc is DateTime consumedAt)
                            {
                                <dt>Consumed</dt><dd>@consumedAt.ToLocalTime()</dd>
                            }
                        </dl>
                        @if (request.AllowFreeText || request.RequestKind != Vocabulary.Get().HumanRequestApproval)
                        {
                            <label>
                                @(string.IsNullOrWhiteSpace(request.ResponsePrompt) ? "Response" : request.ResponsePrompt)
                                <textarea @bind="editor.Response" maxlength="1000000" rows="3"></textarea>
                            </label>
                        }
                        <label>
                            Reason / team note
                            <textarea @bind="editor.Reason" maxlength="2000" rows="2"></textarea>
                        </label>
                        @if (request.RequestKind == Vocabulary.Get().HumanRequestApproval)
                        {
                            <label>
                                Reuse scope
                                <select class="form-select" @bind="editor.ReuseScope">
                                    <option value="@HumanApprovalReuseScope.ExactRequestOnce">Exact request once</option>
                                    <option value="@HumanApprovalReuseScope.CurrentApplicationSession">Current application session</option>
                                    <option value="@HumanApprovalReuseScope.PersistentUntilChanged">Persistent until changed</option>
                                </select>
                            </label>
                            <label class="human-inbox-check">
                                <input type="checkbox" @bind="editor.ConsumeApproval" />
                                <span>Consume the saved approval after one matching use</span>
                            </label>
                            <div class="human-decision-row">
                                <button type="button" class="human-approve" @onclick="(() => ResolveAsync(request, true))">Save as approved</button>
                                <button type="button" class="human-decline" @onclick="(() => ResolveAsync(request, false))">Save as declined</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="human-primary" @onclick="(() => ResolveAsync(request, null))">Save updated answer</button>
                        }
                    </details>
                }
            </section>
        }
    </aside>
}

@code {
    private string GetGateLabel(HumanCollaborationRequest request) => request.GateMode switch
    {
        "NextPhase" => "blocks next phase",
        "NextRound" => "blocks next round",
        "Completion" => "blocks completion",
        _ => "non-blocking"
    };

    private string GetGateDescription(HumanCollaborationRequest request) => request.GateMode switch
    {
        "NextPhase" => "The Council may finish the current phase, then waits for all applicable open questions before starting the next phase.",
        "NextRound" => "The Council may continue the current round, then waits before starting the next round.",
        "Completion" => "Independent work may continue, but the Council cannot complete until this question is answered.",
        _ => "Advisory context. The Council continues and consumes the answer at the next heartbeat."
    };

    private string GetScopeLabel(HumanCollaborationRequest request) => request.QuestionScope switch
    {
        "Consensus" => "Council consensus question",
        "SelectedMembers" => "Question shared by selected Council members",
        _ => "Question from one Council member"
    };

    private HumanCollaborationSnapshot snapshot = new(new HumanCouncilParticipantProfile(), [], [], []);
    private HumanCouncilParticipantProfile profile = new();
    private readonly Dictionary<Guid, HumanCollaborationRequestEditor> editors = [];
    private readonly CancellationTokenSource lifetimeCts = new();
    private bool isOpen;
    private bool approvalBarVisible = true;
    private bool isDisposed;
    private bool isBusy;
    private bool profileDirty;
    private string statusText = string.Empty;
    private readonly List<DeferredResultView> recentDeferredResults = [];

    private IReadOnlyList<HumanCollaborationRequest> PendingRequests => snapshot.Requests
        .Where(item => item.Status == Vocabulary.Get().HumanStatusPending)
        .ToList();
    private IReadOnlyList<HumanCollaborationRequest> ResolvedRequests => snapshot.Requests
        .Where(item => item.Status != Vocabulary.Get().HumanStatusPending)
        .OrderByDescending(item => item.UpdatedAtUtc)
        .ToList();
    private int PendingCount => PendingRequests.Count;

    protected override async Task OnInitializedAsync()
    {
        Collaboration.Changed += OnCollaborationChanged;
        await RefreshAsync().ConfigureAwait(false);
    }

    private void TogglePanel()
    {
        isOpen = !isOpen;
        if (isOpen)
            approvalBarVisible = true;
        ComponentActivity.RecordInformation(nameof(HumanCollaborationInbox), "Toggle", isOpen ? "The collaboration inbox opened." : "The collaboration inbox closed.");
    }

    private void OpenApprovalPanel()
    {
        approvalBarVisible = true;
        isOpen = true;
        ComponentActivity.RecordInformation(nameof(HumanCollaborationInbox), "OpenApprovalBar", "The pending approval work bar opened the collaboration inbox.");
    }

    private void HideApprovalBar()
    {
        approvalBarVisible = false;
        ComponentActivity.RecordInformation(nameof(HumanCollaborationInbox), "HideApprovalBar", "The pending approval work bar was hidden; the Human team launcher remains available.");
    }

    private async Task RefreshAsync()
    {
        try
        {
            snapshot = await Collaboration.GetSnapshotAsync(includeResolved: true, take: 80).ConfigureAwait(true) /* renderer-affine loading continuation */;
            if (!profileDirty)
            {
                profile = new HumanCouncilParticipantProfile
                {
                    Id = snapshot.Profile.Id,
                    DisplayName = snapshot.Profile.DisplayName,
                    RoleName = snapshot.Profile.RoleName,
                    Expertise = snapshot.Profile.Expertise,
                    WorkingStyle = snapshot.Profile.WorkingStyle,
                    IsEnabled = snapshot.Profile.IsEnabled,
                    ProfileVersion = snapshot.Profile.ProfileVersion,
                    UpdatedAtUtc = snapshot.Profile.UpdatedAtUtc,
                    UpdatedBy = snapshot.Profile.UpdatedBy
                };
            }
            foreach (var request in snapshot.Requests)
                editors.TryAdd(request.Id, CreateEditor(request));
            await InvokeAsync(StateHasChanged).ConfigureAwait(true) /* renderer-affine loading continuation */;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not refresh the Human Collaboration Inbox.");
            ComponentActivity.RecordFailure(nameof(HumanCollaborationInbox), "Refresh", ex);
            statusText = "The collaboration inbox could not be refreshed. Review LocalGPT logs.";
        }
    }

    private async Task SaveProfileAsync()
    {
        await RunHumanUiOperationAsync("SaveProfile", async () =>
        {
            using var scope = HumanAmbientContext.PushHumanInteraction(
                RuntimePolicy.GetGuid(LocalGptRuntimeValue.LocalHumanProfileId),
                profile.DisplayName,
                nameof(HumanCollaborationInbox));
            profile = await Collaboration.SaveProfileAsync(profile).ConfigureAwait(false);
            profileDirty = false;
            statusText = profile.IsEnabled ? "Human council participation is enabled." : "Human council participation is disabled.";
            Notifier.ShowSuccess("HumanCollaborationToasts", statusText, "Participant profile");
        }).ConfigureAwait(false);
    }

    private async Task SubmitContributionAsync(Guid runId)
    {
        var editorId = GetContributionEditorId(runId);
        var content = await JS.InvokeAsync<string>("localGptHumanDrafts.read", editorId).ConfigureAwait(false);
        if (string.IsNullOrWhiteSpace(content))
        {
            statusText = "Write a Council contribution before adding it to the next heartbeat.";
            return;
        }

        await RunHumanUiOperationAsync("QueueContribution", async () =>
        {
            using var scope = HumanAmbientContext.PushHumanInteraction(
                RuntimePolicy.GetGuid(LocalGptRuntimeValue.LocalHumanProfileId),
                profile.DisplayName,
                nameof(HumanCollaborationInbox),
                councilRunId: runId);
            await Collaboration.QueueContributionAsync(runId, content).ConfigureAwait(false);
            await JS.InvokeVoidAsync("localGptHumanDrafts.clear", editorId).ConfigureAwait(false);
            statusText = "Your contribution will enter the next council heartbeat without stopping the current work.";
            Notifier.ShowSuccess("HumanCollaborationToasts", statusText, "Council contribution queued");
        }).ConfigureAwait(false);
    }

    private async Task ResolveAsync(HumanCollaborationRequest request, bool? approved)
    {
        var editor = GetEditor(request);
        await RunHumanUiOperationAsync("ResolveRequest", async () =>
        {
            using var scope = HumanAmbientContext.PushHumanInteraction(
                RuntimePolicy.GetGuid(LocalGptRuntimeValue.LocalHumanProfileId),
                profile.DisplayName,
                nameof(HumanCollaborationInbox),
                request.CorrelationId,
                request.CouncilRunId);
            var resolved = await Collaboration.ResolveRequestAsync(
                request.Id,
                new HumanDecisionSubmission(
                    approved,
                    editor.Response,
                    editor.Reason,
                    editor.ReuseScope,
                    editor.ConsumeApproval)).ConfigureAwait(false);
            editors.Remove(request.Id);
            statusText = resolved is null ? "The request no longer exists." : $"Decision saved as {resolved.Status}.";
            if (approved == true && resolved is not null)
            {
                var outcomes = await DeferredDxInvocations.ExecuteApprovedForApprovalRequestAsync(request.Id).ConfigureAwait(false);
                if (outcomes.Count > 0)
                {
                    recentDeferredResults.Clear();
                    recentDeferredResults.AddRange(outcomes.Select(ToDeferredResultView));
                    statusText += $" Executed {outcomes.Count} approved deferred function call(s) immediately.";
                }
            }
            Notifier.ShowInfo("HumanCollaborationToasts", statusText, "Human decision saved");
        }).ConfigureAwait(false);
    }

    private async Task RunHumanUiOperationAsync(string operation, Func<Task> action)
    {
        if (isBusy)
            return;
        isBusy = true;
        statusText = string.Empty;
        try
        {
            await action().ConfigureAwait(true) /* renderer-affine loading continuation */;
            await RefreshAsync().ConfigureAwait(true) /* renderer-affine loading continuation */;
            ComponentActivity.RecordInformation(nameof(HumanCollaborationInbox), operation, "The trusted local human UI operation completed.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Human Collaboration operation {Operation} failed; user-entered content was omitted from logs.", operation);
            ComponentActivity.RecordFailure(nameof(HumanCollaborationInbox), operation, ex);
            statusText = ex is InvalidOperationException
                ? ex.Message
                : "The Human Collaboration operation failed. Review LocalGPT logs for technical details.";
            Notifier.ShowError("HumanCollaborationToasts", statusText, "Human Collaboration");
        }
        finally
        {
            isBusy = false;
        }
    }

    private static DeferredResultView ToDeferredResultView(DeferredDxAiExecutionOutcome outcome)
    {
        var summary = outcome.Status;
        var downloadUrl = string.Empty;
        try
        {
            using var document = JsonDocument.Parse(outcome.ResultSummary);
            var root = document.RootElement;
            if (root.TryGetProperty("Value", out var value) && value.ValueKind == JsonValueKind.Object)
            {
                if (value.TryGetProperty("DownloadUrl", out var download) && download.ValueKind == JsonValueKind.String)
                    downloadUrl = download.GetString() ?? string.Empty;
                if (value.TryGetProperty("Status", out var generatedStatus) && generatedStatus.ValueKind == JsonValueKind.String)
                    summary = $"Approved operation completed with status {generatedStatus.GetString()}.";
                if (value.TryGetProperty("WrittenFileCount", out var written) && written.TryGetInt32(out var count))
                    summary += $" {count} generated file(s) were packaged.";
                if (value.TryGetProperty("BuildStatus", out var build) && build.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(build.GetString()))
                    summary += $" Build: {build.GetString()}.";
            }
            if (root.TryGetProperty("Error", out var error) && error.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(error.GetString()))
                summary = error.GetString()!;
        }
        catch (JsonException)
        {
            summary = outcome.ResultStatus;
        }

        return new DeferredResultView(outcome.FunctionName, outcome.ResultStatus, summary, downloadUrl);
    }

    private sealed record DeferredResultView(string FunctionName, string ResultStatus, string Summary, string DownloadUrl);

    private HumanCollaborationRequestEditor GetEditor(HumanCollaborationRequest request)
    {
        if (!editors.TryGetValue(request.Id, out var editor))
        {
            editor = CreateEditor(request);
            editors[request.Id] = editor;
        }
        return editor;
    }

    private HumanCollaborationRequestEditor CreateEditor(HumanCollaborationRequest request) => new(
        request.Status == Vocabulary.Get().HumanStatusPending ? request.PrefillText : request.UserResponse,
        request.DecisionReason,
        request.ApprovalReuseScope,
        request.ConsumeApproval);

    private void MarkProfileDirty() => profileDirty = true;

    private string FingerprintPrefix(string value) => value[..Math.Min(12, value.Length)];
    private string GetRequestCssClass(HumanCollaborationRequest request)
    {
        var risk = string.IsNullOrWhiteSpace(request.RiskLevel)
            ? "medium"
            : new string(request.RiskLevel
                .Where(character => char.IsLetterOrDigit(character) || character == '-')
                .Select(char.ToLowerInvariant)
                .ToArray());
        return $"human-request-card risk-{(string.IsNullOrWhiteSpace(risk) ? "medium" : risk)}";
    }
    private static string GetContributionEditorId(Guid runId) => $"localgpt-heartbeat-draft-{runId:N}";

    private void OnCollaborationChanged()
    {
        if (isDisposed)
            return;

        try
        {
            TaskRunner.Run(
                nameof(HumanCollaborationInbox),
                "RefreshAfterCollaborationChange",
                _ => InvokeAsync(RefreshAsync),
                lifetimeCts.Token);
        }
        catch (ObjectDisposedException) when (isDisposed)
        {
            // A final service event raced with circuit disposal.
        }
    }

    public void Dispose()
    {
        if (isDisposed)
            return;

        isDisposed = true;
        Collaboration.Changed -= OnCollaborationChanged;
        lifetimeCts.Cancel();
        lifetimeCts.Dispose();
        GC.SuppressFinalize(this);
    }

}
