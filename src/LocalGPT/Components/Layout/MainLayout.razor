@inherits LayoutComponentBase
@implements IDisposable
@using LocalGPT.Services;
@inject NavigationUrlService NavigationUrls
@inject NavigationManager NavigationManager
@namespace LocalGPT.Components.Layout
@inject ILogger<MainLayout> Logger
@inject ISupervisedTaskRunner TaskRunner
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization

<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner MainLayout">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
<div class="page" data-testid="main-layout">
    <Drawer DrawerHeader="drawerHeader"
            DrawerFooter="drawerFooter"
            CssClass="@(IsChatPage ? "navigation-drawer chat-navigation-drawer" : "navigation-drawer")">
        <DrawerBody>
            <div class="w-100">
                <MenuIsland></MenuIsland>
                <NavMenu>
                </NavMenu>
            </div>
        </DrawerBody>
        <DrawerTarget>
    
            <article id="current-main-window" class="p-4 full-height @(IsChatPage ? "chat-main-window" : string.Empty)" data-testid="main-content">
                <div class="nav-buttons-container drawer-target">

                    <NavLink data-enhance-nav="false" href="@NavigationUrls.GetUrl(new Uri(NavigationManager.Uri).LocalPath, !ToggledSidebar)">
                        <DxButton RenderStyle="@ButtonRenderStyle.Dark" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button localgpt-shell-toolbar-button" IconCssClass="icon icon-menu"></DxButton>
                    </NavLink>
                    @if (new Uri(NavigationManager.Uri).LocalPath != "/")
                    {
                        <NavLink data-enhance-nav="false" href="@NavigationUrls.GetUrl("/", ToggledSidebar)" class="button-link hidden">
                            <DxButton RenderStyle="@ButtonRenderStyle.Dark" Text="Back to Home" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button-nav localgpt-shell-toolbar-button localgpt-back-home-button" IconCssClass="icon icon-back"></DxButton>
                        </NavLink>
                    }
                    <LanguageSwitcher />
                </div>
                <SafeErrorBoundary @key="NavigationManager.Uri" Area="MainLayout" ToastName="ComponentSafetyToasts">
                    @Body
                </SafeErrorBoundary>
            </article>
        </DrawerTarget>
    </Drawer>

    <aside class="localgpt-assistant-rail" aria-label="LocalGPT approvals and Council tools">
        <HumanCollaborationInbox />
        <CouncilSpoolerPanel />
        @if (IsInstallPage)
        {
            <nav class="localgpt-page-scroll-assist" aria-label="@(Localization.Get("Navigation.ScrollAssist", fallback: "Page scrolling"))">
                <a href="#install-scroll-top" data-enhance-nav="false" aria-label="@(Localization.Get("Navigation.ScrollUp", fallback: "Scroll to top"))">▲</a>
                <a href="#install-scroll-bottom" data-enhance-nav="false" aria-label="@(Localization.Get("Navigation.ScrollDown", fallback: "Scroll to bottom"))">▼</a>
            </nav>
        }
    </aside>
</div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>


@code {
    /// <summary>
    /// Gets or sets a value indicating whether toggled sidebar applies to the main layout state.
    /// </summary>
    /// <value>The toggled sidebar value exposed by <see cref="MainLayout"/>.</value>
    [SupplyParameterFromQuery(Name = NavigationUrlService.ToggleSidebarName)]
    public bool ToggledSidebar { get; set; }

    /// <summary>
    /// Gets a value indicating whether chat page applies to the main layout state.
    /// </summary>
    /// <value>The is chat page value exposed by <see cref="MainLayout"/>.</value>
    private bool IsChatPage =>
        GetIsChatPageForRender();

    /// <summary>
    /// Gets a value indicating whether install page applies to the main layout state.
    /// </summary>
    /// <value>The is install page value exposed by <see cref="MainLayout"/>.</value>
    private bool IsInstallPage =>
        GetIsInstallPageForRender();

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="MainLayout"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
        NavigationManager.LocationChanged += OnLocationChanged;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, "Component method MainLayout.OnInitialized failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the location changed lifecycle or event notification for <see cref="MainLayout"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="sender">Sender value supplied to the main layout operation and used when producing its result.</param>
    /// <param name="args">Args value supplied to the main layout operation and used when producing its result.</param>
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        try
        {
            TaskRunner.Run(nameof(MainLayout), nameof(OnLocationChanged), _ => InvokeAsync(StateHasChanged));
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, "Component method MainLayout.OnLocationChanged failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="MainLayout"/> and leaves the main layout workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        try
        {
            NavigationManager.LocationChanged -= OnLocationChanged;
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, "Component method MainLayout.Dispose failed.");
            throw;
        }
    }

    /// <summary>
    /// Handles the parameters set lifecycle or event notification for <see cref="MainLayout"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnParametersSet()
    {
        try
        {
            Logger.LogDebug("Applying MainLayout parameters for {Path}.", new Uri(NavigationManager.Uri).LocalPath);
            ComponentActivity.RecordInformation(nameof(MainLayout), "LayoutState", ToggledSidebar ? "Navigation drawer is open." : "Navigation drawer is closed.", NavigationManager.Uri);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "MainLayout parameter handling failed.");
            ComponentActivity.RecordFailure(nameof(MainLayout), nameof(OnParametersSet), ex);
            Notifier.ShowError("ComponentSafetyToasts", "The layout could not apply its navigation state. See local logs for details.", "Layout error");
        }
    }

    /// <summary>
    /// Gets the drawer header value that forms part of the main layout state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The drawer header value exposed by <see cref="MainLayout"/>.</value>
    private RenderFragment drawerHeader => GetdrawerHeaderForRender();

    /// <summary>
    /// Gets the drawer footer value that forms part of the main layout state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The drawer footer value exposed by <see cref="MainLayout"/>.</value>
    private RenderFragment drawerFooter => GetdrawerFooterForRender();


    /// <summary>Computes IsChatPage for the render path with component-local diagnostics.</summary>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool GetIsChatPageForRender()
    {
        try
        {
            return string.Equals(new Uri(NavigationManager.Uri).AbsolutePath, "/Chat", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception __componentPropertyException)
        {
            Logger.LogError(__componentPropertyException, "Computed render property MainLayout.IsChatPage failed.");
            throw;
        }
    }

    /// <summary>Computes IsInstallPage for the render path with component-local diagnostics.</summary>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool GetIsInstallPageForRender()
    {
        try
        {
            return string.Equals(new Uri(NavigationManager.Uri).AbsolutePath, "/install", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception __componentPropertyException)
        {
            Logger.LogError(__componentPropertyException, "Computed render property MainLayout.IsInstallPage failed.");
            throw;
        }
    }

    /// <summary>Computes drawerHeader for the render path with component-local diagnostics.</summary>
    /// <returns>The render fragment produced by the operation.</returns>
    private RenderFragment GetdrawerHeaderForRender()
    {
        try
        {
            return @<div class="navigation-drawer-header">
        <img class="logo" src="images/TacosLogos.svg" alt="LocalGPT logo" />
        <NavLink data-enhance-nav="false" href="@NavigationUrls.GetUrl(new Uri(NavigationManager.Uri).LocalPath, !ToggledSidebar)">
            <DxButton RenderStyle="@ButtonRenderStyle.Light" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="menu-button-nav localgpt-navigation-button" IconCssClass="@(ToggledSidebar ? "icon icon-close" : "icon icon-menu")"></DxButton>
        </NavLink>
    </div>;
        }
        catch (Exception __componentPropertyException)
        {
            Logger.LogError(__componentPropertyException, "Computed render property MainLayout.drawerHeader failed.");
            throw;
        }
    }

    /// <summary>Computes drawerFooter for the render path with component-local diagnostics.</summary>
    /// <returns>The render fragment produced by the operation.</returns>
    private RenderFragment GetdrawerFooterForRender()
    {
        try
        {
            return @<div>
    <NavLink href="https://github.com/Michi0403/LocalGPT" class="button-link">
            <DxButton Text="Github" RenderStyleMode="@ButtonRenderStyleMode.Text" CssClass="footer-button localgpt-navigation-button" RenderStyle="@ButtonRenderStyle.Light" IconCssClass="icon docs-icon"></DxButton>
        </NavLink>
    </div>;
        }
        catch (Exception __componentPropertyException)
        {
            Logger.LogError(__componentPropertyException, "Computed render property MainLayout.drawerFooter failed.");
            throw;
        }
    }
}
