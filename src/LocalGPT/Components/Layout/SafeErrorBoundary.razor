@inject ILogger<SafeErrorBoundary> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<ErrorBoundary @ref="boundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="error">
        @RenderFailure(error)
    </ErrorContent>
</ErrorBoundary>

@code {
    /// <summary>
    /// Gets or sets the child content value that forms part of the safe error boundary state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The child content value exposed by <see cref="SafeErrorBoundary"/>.</value>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the area value that forms part of the safe error boundary state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The area value exposed by <see cref="SafeErrorBoundary"/>.</value>
    [Parameter]
    public string Area { get; set; } = "Component";

    /// <summary>
    /// Gets or sets the toast name value that forms part of the safe error boundary state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The toast name value exposed by <see cref="SafeErrorBoundary"/>.</value>
    [Parameter]
    public string ToastName { get; set; } = "ComponentSafetyToasts";

    /// <summary>
    /// Stores the internal boundary state used by <see cref="SafeErrorBoundary"/> while executing its surrounding workflow.
    /// </summary>
    private ErrorBoundary? boundary;
    /// <summary>
    /// Stores the internal reported error state used by <see cref="SafeErrorBoundary"/> while executing its surrounding workflow.
    /// </summary>
    private Exception? reportedError;

    /// <summary>
    /// Performs recover for <see cref="SafeErrorBoundary"/>, keeping the operation consistent with the state and invariants of the surrounding safe error boundary workflow.
    /// </summary>
    public void Recover()
    {
        reportedError = null;
        boundary?.Recover();
    }

    /// <summary>
    /// Performs render failure for <see cref="SafeErrorBoundary"/>, keeping the operation consistent with the state and invariants of the surrounding safe error boundary workflow.
    /// </summary>
    /// <param name="error">Error value supplied to the safe error boundary operation and used when producing its result.</param>
    /// <returns>The render fragment produced by the operation.</returns>
    private RenderFragment RenderFailure(Exception error) => builder =>
    {
        ReportOnce(error);
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "alert alert-danger");
        builder.AddContent(2, "This LocalGPT area could not finish loading. The failure was logged and added to bounded short-term operational context.");
        builder.CloseElement();
    };

    /// <summary>
    /// Performs report once for <see cref="SafeErrorBoundary"/>, keeping the operation consistent with the state and invariants of the surrounding safe error boundary workflow.
    /// </summary>
    /// <param name="error">Error value supplied to the safe error boundary operation and used when producing its result.</param>
    private void ReportOnce(Exception error)
    {
        if (ReferenceEquals(reportedError, error))
            return;

        reportedError = error;
        Logger.LogError(error, "Unhandled component failure in {Area}; user and model content were omitted from logs.", Area);
        ComponentActivity.RecordFailure(nameof(SafeErrorBoundary), Area, error);
        Notifier.ShowError(ToastName, "The operation failed. See local application logs for technical details.", "Operation failed");
    }
}
