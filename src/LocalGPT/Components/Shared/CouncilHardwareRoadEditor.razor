@inject ICouncilHardwareRoadConfigurationService RoadConfiguration

<section class="council-road-editor" aria-label="Per-model CPU and GPU roads">
    <header class="council-road-editor-header">
        <div>
            <strong>Model hardware roads</strong>
            <p>Each model owns independent minimum and maximum values. The session load percentage chooses the interpolation point; a model may optionally override it with a typed value.</p>
        </div>
        <span class="council-road-load-badge">Session @ResourceLoadPercent%</span>
    </header>

    @if (Routes.Count == 0)
    {
        <p class="memory-status">Select at least one model to configure its CPU/GPU road.</p>
    }
    else
    {
        <div class="council-road-grid">
            @foreach (var route in Routes)
            {
                var load = route.LoadPercentOverride ?? ResourceLoadPercent;
                <article class="council-road-card" @key="route.ModelName">
                    <header>
                        <div class="council-road-identity">
                            <strong title="@route.ModelName">@GetRouteDisplayName(route)</strong>
                            <small>@GetRouteEndpointLabel(route)</small>
                        </div>
                        <label class="inline-dx-check compact">
                            <DxCheckBox Checked="@route.IsEnabled" CheckedChanged="@((bool value) => SetEnabled(route, value))" />
                            <span>Enabled</span>
                        </label>
                    </header>

                    <div class="council-road-fields">
                        <label>Road
                            <DxComboBox Data="@HardwareKinds"
                                        Value="@route.HardwareKind"
                                        ValueChanged="@((OneWireHardwareKind value) => SetHardwareKind(route, value))" />
                        </label>
                        <label>Device index
                            <DxSpinEdit Value="@route.HardwareIndex" ValueChanged="@((int value) => SetInt(route, nameof(route.HardwareIndex), value))" MinValue="-1" MaxValue="64" />
                        </label>
                        <label class="wide">Device name
                            <DxTextBox Text="@route.HardwareName" TextChanged="@((string value) => SetText(route, nameof(route.HardwareName), value))" NullText="CPU, GPU 0, RTX 3060, iGPU…" />
                        </label>
                        <label>Min output
                            <DxSpinEdit Value="@route.MinOutputTokens" ValueChanged="@((int value) => SetInt(route, nameof(route.MinOutputTokens), value))" MinValue="1" MaxValue="262144" Increment="256" />
                        </label>
                        <label>Max output
                            <DxSpinEdit Value="@route.MaxOutputTokens" ValueChanged="@((int value) => SetInt(route, nameof(route.MaxOutputTokens), value))" MinValue="1" MaxValue="262144" Increment="256" />
                        </label>
                        <label>Min context
                            <DxSpinEdit Value="@route.MinContextTokens" ValueChanged="@((int value) => SetInt(route, nameof(route.MinContextTokens), value))" MinValue="256" MaxValue="1048576" Increment="1024" />
                        </label>
                        <label>Max context
                            <DxSpinEdit Value="@route.MaxContextTokens" ValueChanged="@((int value) => SetInt(route, nameof(route.MaxContextTokens), value))" MinValue="256" MaxValue="1048576" Increment="1024" />
                        </label>
                        @if (string.IsNullOrWhiteSpace(route.ProviderKind) || route.ProviderKind.Equals(ProviderModelKinds.Ollama, StringComparison.OrdinalIgnoreCase))
                        {
                            <label title="CPU always uses 0. For GPU or accelerator roads leave this blank so Ollama chooses the offload automatically, or enter a positive layer count.">Ollama num_gpu
                                <DxSpinEdit Value="@route.OllamaNumGpu" ValueChanged="@((int? value) => SetNullableInt(route, nameof(route.OllamaNumGpu), value))" MinValue="0" MaxValue="999" NullText="auto" />
                            </label>
                        }
                        else
                        {
                            <div class="provider-road-note" title="This provider does not accept Ollama-specific GPU layer settings.">Provider acceleration is managed by @route.ProviderName.</div>
                        }
                        <label>Lane concurrency
                            <DxSpinEdit Value="@route.MaxConcurrentModelsOnLane" ValueChanged="@((int value) => SetInt(route, nameof(route.MaxConcurrentModelsOnLane), value))" MinValue="1" MaxValue="16" />
                        </label>
                    </div>

                    <div class="council-road-load-row">
                        <label class="inline-dx-check compact" title="Enable a model-specific load percentage instead of the session-wide value.">
                            <DxCheckBox Checked="@route.LoadPercentOverride.HasValue" CheckedChanged="@((bool value) => ToggleOverride(route, value))" />
                            <span>Model override</span>
                        </label>
                        <label class="council-road-load-editor">Load percent
                            <DxSpinEdit Value="@load"
                                        ValueChanged="@((int value) => SetLoadOverride(route, value))"
                                        MinValue="0"
                                        MaxValue="100"
                                        Increment="5"
                                        Enabled="@route.LoadPercentOverride.HasValue" />
                        </label>
                        <output>@load%</output>
                    </div>
                    <p class="council-road-effective">
                        Effective ceiling: @RoadConfiguration.Interpolate(route.MinOutputTokens, route.MaxOutputTokens, load).ToString("N0") output ·
                        @RoadConfiguration.Interpolate(route.MinContextTokens, route.MaxContextTokens, load).ToString("N0") context
                    </p>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<OneWireHardwareKind> HardwareKinds { get; } = Enum.GetValues<OneWireHardwareKind>();

    /// <summary>
    /// Gets or sets the model names collection maintained or exposed by this council hardware road editor instance for downstream processing.
    /// </summary>
    /// <value>The model names value exposed by <see cref="CouncilHardwareRoadEditor"/>.</value>
    [Parameter] public IReadOnlyCollection<string> ModelNames { get; set; } = [];
    /// <summary>
    /// Gets or sets the routes collection maintained or exposed by this council hardware road editor instance for downstream processing.
    /// </summary>
    /// <value>The routes value exposed by <see cref="CouncilHardwareRoadEditor"/>.</value>
    [Parameter, EditorRequired] public List<OneWireCouncilModelRoute> Routes { get; set; } = [];
    /// <summary>
    /// Gets or sets the resource load percent value that forms part of the council hardware road editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The resource load percent value exposed by <see cref="CouncilHardwareRoadEditor"/>.</value>
    [Parameter] public int ResourceLoadPercent { get; set; } = 30;
    /// <summary>
    /// Gets or sets the changed value that forms part of the council hardware road editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The changed value exposed by <see cref="CouncilHardwareRoadEditor"/>.</value>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>
    /// Handles the parameters set lifecycle or event notification for <see cref="CouncilHardwareRoadEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnParametersSet()
    {
        var synchronized = RoadConfiguration.Synchronize(ModelNames, Routes);
        if (SameRoutes(synchronized, Routes)) return;
        Routes.Clear();
        Routes.AddRange(synchronized);
    }

    /// <summary>
    /// Performs same routes for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="left">One wire council model route dependency used by the council hardware road editor workflow to provide the corresponding application capability.</param>
    /// <param name="right">One wire council model route dependency used by the council hardware road editor workflow to provide the corresponding application capability.</param>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool SameRoutes(IReadOnlyList<OneWireCouncilModelRoute> left, IReadOnlyList<OneWireCouncilModelRoute> right) =>
        left.Count == right.Count && left.Select(route => route.ModelName).SequenceEqual(right.Select(route => route.ModelName), StringComparer.OrdinalIgnoreCase);


    /// <summary>
    /// Retrieves route display name for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string GetRouteDisplayName(OneWireCouncilModelRoute route)
    {
        var model = string.IsNullOrWhiteSpace(route.ProviderModelName) ? route.ModelName : route.ProviderModelName;
        var provider = string.IsNullOrWhiteSpace(route.ProviderName) ? "AI provider" : route.ProviderName;
        return $"{model} — {provider}";
    }

    /// <summary>
    /// Retrieves route endpoint label for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string GetRouteEndpointLabel(OneWireCouncilModelRoute route)
    {
        if (string.IsNullOrWhiteSpace(route.ProviderEndpoint))
            return "Legacy/default provider route";
        return new ProviderModelIdentity().GetEndpointLabel(route.ProviderEndpoint);
    }

    /// <summary>
    /// Normalizes and notify for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task NormalizeAndNotify(OneWireCouncilModelRoute route)
    {
        RoadConfiguration.Normalize(route);
        await Changed.InvokeAsync().ConfigureAwait(false);
    }

    /// <summary>
    /// Sets enabled for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="value">Whether the route is enabled.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SetEnabled(OneWireCouncilModelRoute route, bool value)
    {
        route.IsEnabled = value;
        return NormalizeAndNotify(route);
    }

    /// <summary>
    /// Sets hardware kind for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="kind">Hardware kind selected for the route.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SetHardwareKind(OneWireCouncilModelRoute route, OneWireHardwareKind kind)
    {
        var previousKind = route.HardwareKind;
        route.HardwareKind = kind;
        if (kind == OneWireHardwareKind.Cpu)
        {
            route.HardwareIndex = 0;
            route.OllamaNumGpu = 0;
            if (string.IsNullOrWhiteSpace(route.HardwareName) ||
                previousKind == OneWireHardwareKind.Auto ||
                route.HardwareName.Equals("Automatic", StringComparison.OrdinalIgnoreCase))
            {
                route.HardwareName = "CPU";
            }
        }
        else if (kind is OneWireHardwareKind.Gpu or OneWireHardwareKind.Accelerator)
        {
            route.HardwareIndex = Math.Max(0, route.HardwareIndex);
            if (route.OllamaNumGpu == 0)
                route.OllamaNumGpu = null;
            if (string.IsNullOrWhiteSpace(route.HardwareName) ||
                route.HardwareName.Equals("CPU", StringComparison.OrdinalIgnoreCase) ||
                route.HardwareName.Equals("Automatic", StringComparison.OrdinalIgnoreCase))
            {
                route.HardwareName = kind == OneWireHardwareKind.Gpu ? "GPU 0" : "Accelerator 0";
            }
        }
        else if (kind == OneWireHardwareKind.Auto)
        {
            route.HardwareIndex = -1;
            if (string.IsNullOrWhiteSpace(route.HardwareName) ||
                route.HardwareName.Equals("CPU", StringComparison.OrdinalIgnoreCase))
            {
                route.HardwareName = "Automatic";
            }
        }

        return NormalizeAndNotify(route);
    }

    /// <summary>
    /// Sets text for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="property">Property value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="value">Text value to assign to the selected route property.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SetText(OneWireCouncilModelRoute route, string property, string value)
    {
        if (property == nameof(route.HardwareName)) route.HardwareName = value ?? string.Empty;
        return NormalizeAndNotify(route);
    }

    /// <summary>
    /// Sets int for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="property">Property value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="value">Integer value to assign to the selected route property.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SetInt(OneWireCouncilModelRoute route, string property, int value)
    {
switch (property)
        {
            case nameof(route.HardwareIndex): route.HardwareIndex = value; break;
            case nameof(route.MinOutputTokens): route.MinOutputTokens = value; break;
            case nameof(route.MaxOutputTokens): route.MaxOutputTokens = value; break;
            case nameof(route.MinContextTokens): route.MinContextTokens = value; break;
            case nameof(route.MaxContextTokens): route.MaxContextTokens = value; break;
            case nameof(route.MaxConcurrentModelsOnLane): route.MaxConcurrentModelsOnLane = value; break;
        }
        return NormalizeAndNotify(route);
    }

    /// <summary>
    /// Sets nullable int for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="property">Property value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="value">Nullable integer value to assign to the selected route property.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SetNullableInt(OneWireCouncilModelRoute route, string property, int? value)
    {
        if (property == nameof(route.OllamaNumGpu)) route.OllamaNumGpu = value;
        return NormalizeAndNotify(route);
    }

    /// <summary>
    /// Performs toggle override for <see cref="CouncilHardwareRoadEditor"/>, keeping the operation consistent with the state and invariants of the surrounding council hardware road editor workflow.
    /// </summary>
    /// <param name="route">Route value supplied to the council hardware road editor operation and used when producing its result.</param>
    /// <param name="value">Whether the route-specific load override is enabled.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task ToggleOverride(OneWireCouncilModelRoute route, bool value)
    {
        route.LoadPercentOverride = value
            ? RoadConfiguration.NormalizeLoadPercent(ResourceLoadPercent)
            : null;
        return NormalizeAndNotify(route);
    }

    /// <summary>
    /// Sets the model-specific load override from a strongly typed DevExpress number editor.
    /// </summary>
    /// <param name="route">Route whose interpolation load is being changed.</param>
    /// <param name="value">Requested load percentage.</param>
    /// <returns>A task that completes after the route has been normalized and published.</returns>
    private Task SetLoadOverride(OneWireCouncilModelRoute route, int value)
    {
        route.LoadPercentOverride = RoadConfiguration.NormalizeLoadPercent(value);
        return NormalizeAndNotify(route);
    }
}
