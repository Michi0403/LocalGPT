@* Inherits the InteractiveServer circuit from Chat, Install, and ModelCouncil so EventCallbacks stay circuit-local. *@
@using System.Text.Json
@implements IDisposable
@inject IProviderModelBenchmarkService BenchmarkService
@inject CouncilTextService CouncilText
@inject ILogger<ProviderModelPanel> Logger
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization

<article class="provider-model-panel @(Selected ? "is-selected" : string.Empty) @(IsUnavailable ? "is-unavailable" : string.Empty)" aria-labelledby="@HeadingId">
    <header class="provider-model-heading">
        @if (ShowSelection)
        {
            <input id="@SelectionId"
                   type="checkbox"
                   checked="@Selected"
                   @onchange="OnSelectionChangedAsync"
                   aria-label="@($"Select {Model.DisplayName} from {Model.EndpointLabel}")" />
        }
        <div class="provider-model-title">
            <strong id="@HeadingId">@Model.ModelName</strong>
            <small>@Model.ProviderName · @Model.EndpointLabel</small>
        </div>
        <div class="provider-model-badges" aria-label="@(T("Model status"))">
            @if (Model.IsReachable)
            {
                <span class="model-badge">@T("reachable")</span>
            }
            else if (IsUnavailable)
            {
                <span class="model-badge model-badge-danger">@Localization.Get("ProviderModel.Unreachable", fallback: "unreachable")</span>
            }
            @if (Model.IsLoaded)
            {
                <span class="model-badge">@T("loaded")</span>
            }
            @if (Model.IsConfigured)
            {
                <span class="model-badge">@T("configured")</span>
            }
        </div>
    </header>

    <div class="provider-model-commandbar" role="group" aria-label="@($"Actions for {Model.DisplayName}")">
        @if (ShowUseAction)
        {
            <button type="button" class="model-action model-action-primary" @onclick="ActivateAsync">@UseActionText</button>
        }
        <details class="provider-model-menu">
            <summary class="model-action" aria-label="@(T("Open model actions"))">@T("Actions")</summary>
            <div class="provider-model-menu-items" role="menu">
                @if (showProperties)
                {
                    <button type="button"
                            role="menuitem"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleProperties"
                            aria-expanded="true"
                            aria-controls="@PropertiesId">@T("Hide properties")</button>
                }
                else
                {
                    <button type="button"
                            role="menuitem"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="ToggleProperties"
                            aria-expanded="false"
                            aria-controls="@PropertiesId">@T("Properties")</button>
                }
                <button type="button"
                        role="menuitem"
                        class="btn btn-sm btn-outline-secondary"
                        disabled="@(!Model.SupportsBenchmark || isBusy)"
                        @onclick="ToggleBenchmark"
                        aria-expanded="@showBenchmark"
                        aria-controls="@BenchmarkId">@(showBenchmark ? T("Hide benchmark") : T("Benchmark"))</button>
            </div>
        </details>
        @if (isBusy)
        {
            <button type="button" class="model-action" @onclick="CancelBenchmark">@T("Cancel")</button>
        }
        @if (activeRunId is Guid)
        {
            <a class="model-action benchmark-live-session-link"
               href="@BenchmarkChatUrl"
               target="_blank"
               rel="noopener">@T("Open live transcript")</a>
        }
    </div>

    @if (showProperties)
    {
        <dl id="@PropertiesId" class="provider-model-properties">
            <div><dt>@T("Provider kind")</dt><dd>@Model.ProviderKind</dd></div>
            <div><dt>@T("Endpoint")</dt><dd>@Model.Endpoint</dd></div>
            <div><dt>@T("Provider model")</dt><dd>@Model.ModelName</dd></div>
            <div><dt>@T("Hosting")</dt><dd>@(Model.IsLocal ? T("local") : T("remote"))</dd></div>
            <div><dt>@T("Benchmark")</dt><dd>@(Model.SupportsBenchmark ? T("available") : T("unavailable"))</dd></div>
            <div><dt>@T("Council address")</dt><dd>@Model.SelectionKey</dd></div>
            <div><dt>@T("Stable identity")</dt><dd>@Model.StableId</dd></div>
            @if (!string.IsNullOrWhiteSpace(Model.Details))
            {
                <div><dt>@T("Details")</dt><dd>@Model.Details</dd></div>
            }
        </dl>
    }

    @if (showBenchmark)
    {
        <section id="@BenchmarkId"
                 class="provider-model-benchmark"
                 aria-label="@($"Benchmark configuration for {Model.DisplayName}")">
            <div class="benchmark-config-grid">
                <label>
                    <span>Profile plan</span>
                    <select class="form-select" @bind="profileMode">
                        <option value="@ProviderModelBenchmarkProfileMode.EvenlySpaced">Evenly spaced to maximum</option>
                        <option value="@ProviderModelBenchmarkProfileMode.Adaptive">Adaptive named profiles (legacy)</option>
                    </select>
                </label>
                <label>
                    <span>@(profileMode == ProviderModelBenchmarkProfileMode.EvenlySpaced ? "Even steps" : "Adaptive profiles")</span>
                    <input class="form-control" type="number" min="1" step="1" @bind="maxProfiles" />
                </label>
                <BoundedNumberEditor Label="Tasks" Min="1" Max="4" Value="@maxTasks" ValueChanged="@(value => maxTasks = value)" />
                <BoundedNumberEditor Label="Timeout seconds" Min="10" Max="900" Step="10" Suffix=" s" Value="@maxSeconds" ValueChanged="@(value => maxSeconds = value)" />
                <BoundedNumberEditor Label="Stop threshold" Min="0" Max="50" Suffix="%" Value="@improvementThreshold" ValueChanged="@(value => improvementThreshold = value)" />
                @if (profileMode == ProviderModelBenchmarkProfileMode.EvenlySpaced)
                {
                    <BoundedNumberEditor Label="Minimum context" Min="2048" Max="@maximumContext" Step="1024" Value="@minimumContext" ValueChanged="@(value => minimumContext = value)" />
                    <BoundedNumberEditor Label="Minimum output" Min="128" Max="@maximumOutput" Step="128" Value="@minimumOutput" ValueChanged="@(value => minimumOutput = value)" />
                }
                <BoundedNumberEditor Label="Maximum context" Min="2048" Max="262144" Step="1024" Value="@maximumContext" ValueChanged="OnMaximumContextChanged" />
                <BoundedNumberEditor Label="Maximum output" Min="128" Max="8192" Step="128" Value="@maximumOutput" ValueChanged="OnMaximumOutputChanged" />
                <label class="benchmark-check form-check"><input class="form-check-input" type="checkbox" @bind="includeCouncilReview" /> <span>@T("Council review")</span></label>
                <label class="benchmark-check form-check"><input class="form-check-input" type="checkbox" @bind="stopWhenImprovementStalls" /> <span>Allow early stop</span></label>
                @if (profileMode == ProviderModelBenchmarkProfileMode.Adaptive)
                {
                    <label class="benchmark-check form-check"><input class="form-check-input" type="checkbox" @bind="includeCpuSafeControl" /> <span>CPU-safe control</span></label>
                }
            </div>
            <p class="benchmark-council-summary">
                @T("Review council"):@(" " + ReviewerSummary)
            </p>
            <div class="provider-model-actions">
                <button type="button" class="model-action model-action-primary" disabled="@isBusy" @onclick="RunBenchmarkAsync">Run bounded benchmark</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusText))
            {
                <p class="benchmark-status" role="status" aria-live="polite">@statusText</p>
            }

            @if (report is not null && SuccessfulTarget is { } target)
            {
                <ProviderModelBenchmarkReportAuditSummary Report="report" />
                <div class="benchmark-result">
                    <strong>Recommended: @target.Recommendation.ProfileName</strong>
                    <span>Empirical @target.Recommendation.EmpiricalScore.ToString("0.0") / Council @target.Recommendation.CouncilScore.ToString("0.0")</span>
                    <span>Context @target.Recommendation.ContextTokens.ToString("N0") · Output @target.Recommendation.OutputTokens.ToString("N0")</span>
                    <small>@target.Recommendation.Rationale</small>
                    @foreach (var profile in target.Profiles.OrderByDescending(item => item.Score))
                    {
                        <details>
                            <summary>@profile.ProfileName · score @profile.Score.ToString("0.0") · @profile.AverageTokensPerSecond.ToString("0.0") tok/s</summary>
                            <div class="benchmark-task-results">
                                @foreach (var task in profile.Tasks)
                                {
                                    <ProviderModelBenchmarkTaskEvidence Task="task" />
                                }
                            </div>
                        </details>
                    }
                </div>
            }
        </section>
    }
</article>

@code {
    string T(string source) => Localization.GetText(source);
    bool IsUnavailable => Model.IsConfigured && !Model.IsReachable
        && (Model.ProviderKind.Equals(ProviderModelKinds.Ollama, StringComparison.OrdinalIgnoreCase)
            || Model.ProviderKind.Equals(ProviderModelKinds.OpenAICompatible, StringComparison.OrdinalIgnoreCase));

    [Parameter, EditorRequired] public ProviderModelReference Model { get; set; } = new();
    [Parameter] public bool ShowSelection { get; set; } = true;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<bool> SelectedChanged { get; set; }
    [Parameter] public bool ShowUseAction { get; set; }
    [Parameter] public string UseActionText { get; set; } = "Use model";
    [Parameter] public EventCallback<ProviderModelReference> Activated { get; set; }
    [Parameter] public IReadOnlyList<ProviderModelReference> CouncilModels { get; set; } = [];
    [Parameter] public EventCallback<ProviderModelBenchmarkAppliedEvent> BenchmarkApplied { get; set; }
    [Parameter] public EventCallback<HardwarePerformancePreset> PerformancePresetSaved { get; set; }
    [Parameter] public EventCallback<Guid> BenchmarkStarted { get; set; }

    readonly string instanceId = Guid.NewGuid().ToString("N");
    bool showProperties;
    bool showBenchmark;
    bool isBusy;
    bool includeCouncilReview = true;
    bool includeCpuSafeControl = true;
    bool stopWhenImprovementStalls;
    ProviderModelBenchmarkProfileMode profileMode = ProviderModelBenchmarkProfileMode.EvenlySpaced;
    int maxProfiles = 5;
    int maxTasks = 3;
    int maxSeconds = 180;
    int improvementThreshold = 5;
    int minimumContext = 2048;
    int minimumOutput = 128;
    int maximumContext = 32768;
    int maximumOutput = 1024;
    string statusText = string.Empty;
    ProviderModelBenchmarkReport? report;
    CancellationTokenSource? benchmarkCts;
    Guid? activeRunId;

    string BenchmarkChatUrl => activeRunId is Guid runId
        ? $"/Chat?rejoinCouncilRunId={runId:D}"
        : "/Chat";
    string HeadingId => $"provider-model-{instanceId}";
    string SelectionId => $"provider-model-select-{instanceId}";
    string PropertiesId => $"provider-model-properties-{instanceId}";
    string BenchmarkId => $"provider-model-benchmark-{instanceId}";
    ProviderModelBenchmarkTargetResult? SuccessfulTarget => report?.Targets.FirstOrDefault(target =>
        target.Model.SelectionKey.Equals(Model.SelectionKey, StringComparison.OrdinalIgnoreCase)
        && string.IsNullOrWhiteSpace(target.Error));
    string ReviewerSummary => CouncilText.ProviderModelReviewerSummary(Model, CouncilModels, Logger);

    async Task OnSelectionChangedAsync(ChangeEventArgs args)
    {
        var selected = args.Value is bool value
            ? value
            : bool.TryParse(Convert.ToString(args.Value), out var parsed) && parsed;
        await SelectedChanged.InvokeAsync(selected).ConfigureAwait(false);
    }

    Task ActivateAsync() => Activated.InvokeAsync(Model);
    void ToggleProperties() => showProperties = !showProperties;
    void ToggleBenchmark() => showBenchmark = !showBenchmark;

    async Task RunBenchmarkAsync()
    {
        benchmarkCts?.Cancel();
        benchmarkCts?.Dispose();
        benchmarkCts = new CancellationTokenSource();
        isBusy = true;
        report = null;
        activeRunId = Guid.NewGuid();
        statusText = $"Benchmark {activeRunId.Value.ToString("N")[..8]} is running. Open its Chat transcript to watch or stop the live session.";
        try
        {
            var benchmarkTask = BenchmarkService.RunAsync(new ProviderModelBenchmarkRequest
            {
                RunId = activeRunId.Value,
                Targets = [Model],
                CouncilReviewers = CouncilModels.ToList(),
                MaxProfilesPerModel = Math.Max(1, maxProfiles),
                ProfileMode = profileMode,
                MinimumContextTokens = minimumContext,
                MinimumOutputTokens = minimumOutput,
                IncludeCpuSafeControl = includeCpuSafeControl,
                StopWhenImprovementStalls = stopWhenImprovementStalls,
                MaxTasks = maxTasks,
                MaxCouncilReviewers = 3,
                MaxSecondsPerCall = maxSeconds,
                ImprovementThresholdPercent = improvementThreshold,
                MaximumContextTokens = maximumContext,
                MaximumOutputTokens = maximumOutput,
                IncludeCouncilReview = includeCouncilReview
            }, benchmarkCts.Token);
            await InvokeAsync(() => BenchmarkStarted.InvokeAsync(activeRunId.Value)).ConfigureAwait(false);
            var completedReport = await benchmarkTask.ConfigureAwait(false);
            HardwarePerformancePreset? savedPerformancePreset = null;
            if (completedReport.Targets.Any(target => string.IsNullOrWhiteSpace(target.Error) && !string.IsNullOrWhiteSpace(target.Recommendation.ProfileName)))
            {
                savedPerformancePreset = await BenchmarkService.SavePerformancePresetAsync(
                    completedReport,
                    $"Benchmark performance · {Model.ProviderName} · {Model.ModelName}",
                    userConfirmed: true,
                    benchmarkCts.Token).ConfigureAwait(false);
            }
            await InvokeAsync(async () =>
            {
                report = completedReport;
                var target = SuccessfulTarget;
                statusText = target is null
                    ? report.Warnings.FirstOrDefault() ?? report.Targets.FirstOrDefault()?.Error ?? "No benchmark profile completed successfully."
                    : savedPerformancePreset is null
                        ? $"Benchmark complete. {target.CouncilReviews.Count(review => string.IsNullOrWhiteSpace(review.Error))} council review(s) contributed."
                        : $"Benchmark complete and saved as hardware performance profile “{savedPerformancePreset.Name}”. It is now selectable in Hardware spooler.";
                if (savedPerformancePreset is not null)
                    await PerformancePresetSaved.InvokeAsync(savedPerformancePreset).ConfigureAwait(false);
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() => statusText = "Benchmark cancelled. No settings were applied.").ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Provider model benchmark UI failed for identity {ModelIdentity}; prompts and responses were omitted.", Model.StableId);
            await InvokeAsync(() => statusText = "Benchmark failed. Review LocalGPT logs for the provider-qualified model identity.").ConfigureAwait(false);
        }
        finally
        {
            await InvokeAsync(() => isBusy = false).ConfigureAwait(false);
        }
    }

    async Task ApplyRecommendationAsync()
    {
        if (report is null || SuccessfulTarget is null)
            return;
        isBusy = true;
        statusText = "Applying the council recommendation as a provider-qualified user preset…";
        try
        {
            var presets = await BenchmarkService.ApplyRecommendationsAsync(
                report,
                $"Benchmark · {Model.ProviderName} · {Model.ModelName}",
                makeDefault: false,
                userConfirmed: true).ConfigureAwait(false);
            var preset = presets.Single();
            var routes = JsonSerializer.Deserialize<List<OneWireCouncilModelRoute>>(preset.ModelRoutesJson) ?? [];
            var route = routes.First(item => item.ModelName.Equals(Model.SelectionKey, StringComparison.OrdinalIgnoreCase));
            statusText = $"Applied as preset “{preset.Name}”. The route remains bound to {Model.ProviderName} at {Model.EndpointLabel}.";
            await BenchmarkApplied.InvokeAsync(new ProviderModelBenchmarkAppliedEvent(Model, route, preset)).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Applying provider benchmark recommendation failed for identity {ModelIdentity}.", Model.StableId);
            statusText = "The recommendation could not be applied. Existing provider and preset settings were left unchanged.";
        }
        finally
        {
            isBusy = false;
        }
    }

    Task OnMaximumContextChanged(int value)
    {
        maximumContext = value;
        minimumContext = Math.Min(minimumContext, maximumContext);
        return Task.CompletedTask;
    }

    Task OnMaximumOutputChanged(int value)
    {
        maximumOutput = value;
        minimumOutput = Math.Min(minimumOutput, maximumOutput);
        return Task.CompletedTask;
    }

    void CancelBenchmark() => benchmarkCts?.Cancel();

    public void Dispose()
    {
        benchmarkCts?.Cancel();
        benchmarkCts?.Dispose();
    }
}
