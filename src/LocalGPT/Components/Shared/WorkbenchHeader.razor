@inject ILogger<WorkbenchHeader> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<header class="localgpt-workbench-header">
    <div class="localgpt-workbench-heading">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="localgpt-workbench-eyebrow">@Eyebrow</span>
        }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p>@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="localgpt-workbench-actions">
            @Actions
        </div>
    }
</header>

@code {
    /// <summary>
    /// Gets or sets the title value that forms part of the workbench header state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The title value exposed by <see cref="WorkbenchHeader"/>.</value>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the subtitle value that forms part of the workbench header state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The subtitle value exposed by <see cref="WorkbenchHeader"/>.</value>
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the eyebrow value that forms part of the workbench header state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The eyebrow value exposed by <see cref="WorkbenchHeader"/>.</value>
    [Parameter] public string Eyebrow { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the actions value that forms part of the workbench header state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The actions value exposed by <see cref="WorkbenchHeader"/>.</value>
    [Parameter] public RenderFragment? Actions { get; set; }
}
