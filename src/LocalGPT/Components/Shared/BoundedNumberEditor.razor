@using System.Globalization

<div class="bounded-number-editor @CssClass">
    <label for="@InputId">@Label</label>
    <div class="bounded-number-control">
        <DxSpinEdit id="@InputId"
                    Value="@Value"
                    ValueChanged="@((int value) => OnNumberChangedAsync(value))"
                    MinValue="@Min"
                    MaxValue="@Max"
                    Increment="@Step"
                    CssClass="bounded-number-input"
                    title="@(string.IsNullOrWhiteSpace(HelpText) ? $"Adjust {Label}" : HelpText)"
                    aria-label="@($"Adjust {Label}")" />
        <div class="bounded-number-hint" aria-live="off">
            <span>@Min.ToString("N0")</span>
            <strong>@Value.ToString("N0")@Suffix</strong>
            <span>@Max.ToString("N0") · step @Math.Max(1, Step).ToString("N0")</span>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Gets or sets the label value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The label value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the help text value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The help text value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter] public string HelpText { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the suffix value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The suffix value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter] public string Suffix { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the CSS class value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The CSS class value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter] public string CssClass { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the min value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The min value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter] public int Min { get; set; }
    /// <summary>
    /// Gets or sets the max value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The max value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter] public int Max { get; set; } = 100;
    /// <summary>
    /// Gets or sets the step value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The step value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter] public int Step { get; set; } = 1;
    /// <summary>
    /// Gets or sets the value value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The value value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter] public int Value { get; set; }
    /// <summary>
    /// Gets or sets the value changed value that forms part of the bounded number editor state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The value changed value exposed by <see cref="BoundedNumberEditor"/>.</value>
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    /// <summary>
    /// Stores the internal input identifier state used by <see cref="BoundedNumberEditor"/> while executing its surrounding workflow.
    /// </summary>
    readonly string InputId = $"bounded-number-{Guid.NewGuid():N}";
    /// <summary>
    /// Handles the number changed async lifecycle or event notification for <see cref="BoundedNumberEditor"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="value">New bounded numeric value supplied by the DevExpress number editor.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task OnNumberChangedAsync(int value)
    {
        await SetValueAsync(value).ConfigureAwait(false);
    }

    /// <summary>
    /// Sets value for <see cref="BoundedNumberEditor"/>, keeping the operation consistent with the state and invariants of the surrounding bounded number editor workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the bounded number editor operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task SetValueAsync(int value)
    {
        var normalizedStep = Math.Max(1, Step);
        var normalized = Math.Clamp(value, Min, Max);
        if (normalizedStep > 1)
        {
            var offset = normalized - Min;
            normalized = Min + (int)Math.Round(offset / (double)normalizedStep) * normalizedStep;
            normalized = Math.Clamp(normalized, Min, Max);
        }

        Value = normalized;
        await InvokeAsync(() => ValueChanged.InvokeAsync(normalized)).ConfigureAwait(false);
    }
}
