@inject ILogger<ConfigurationWorkbenchNav> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<nav class="configuration-workbench-nav" aria-label="@AriaLabel">
    @foreach (var item in Items)
    {
        var active = string.Equals(item.Key, ActiveKey, StringComparison.OrdinalIgnoreCase);
        <button type="button"
                class="configuration-workbench-nav-item @(active ? "active" : string.Empty)"
                aria-current="@(active ? "page" : null)"
                @onclick="@(() => SelectAsync(item.Key))">
            <span class="configuration-workbench-nav-label">@item.Label</span>
            @if (!string.IsNullOrWhiteSpace(item.Badge))
            {
                <span class="configuration-workbench-nav-badge">@item.Badge</span>
            }
            @if (!string.IsNullOrWhiteSpace(item.Description))
            {
                <small>@item.Description</small>
            }
        </button>
    }
</nav>

@code {
    /// <summary>
    /// Gets or sets the items collection maintained or exposed by this configuration workbench nav instance for downstream processing.
    /// </summary>
    /// <value>The items value exposed by <see cref="ConfigurationWorkbenchNav"/>.</value>
    [Parameter, EditorRequired]
    public IReadOnlyList<WorkbenchNavItem> Items { get; set; } = Array.Empty<WorkbenchNavItem>();

    /// <summary>
    /// Gets or sets the stable active key used to identify or correlate this configuration workbench nav instance with related application state.
    /// </summary>
    /// <value>The active key value exposed by <see cref="ConfigurationWorkbenchNav"/>.</value>
    [Parameter, EditorRequired]
    public string ActiveKey { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the active key changed value that forms part of the configuration workbench nav state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The active key changed value exposed by <see cref="ConfigurationWorkbenchNav"/>.</value>
    [Parameter]
    public EventCallback<string> ActiveKeyChanged { get; set; }

    /// <summary>
    /// Gets or sets the aria label value that forms part of the configuration workbench nav state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The aria label value exposed by <see cref="ConfigurationWorkbenchNav"/>.</value>
    [Parameter]
    public string AriaLabel { get; set; } = "Configuration sections";

    /// <summary>
    /// Performs select for <see cref="ConfigurationWorkbenchNav"/>, keeping the operation consistent with the state and invariants of the surrounding configuration workbench nav workflow.
    /// </summary>
    /// <param name="key">Key value supplied to the configuration workbench nav operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SelectAsync(string key)
    {
        try
        {
            if (ActiveKeyChanged.HasDelegate)
                await ActiveKeyChanged.InvokeAsync(key).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Configuration workbench section selection failed for {SectionKey}.", key);
            ComponentActivity.RecordFailure(nameof(ConfigurationWorkbenchNav), nameof(SelectAsync), ex);
            Notifier.ShowError("ComponentSafetyToasts", "The requested configuration section could not be opened. See local logs for details.", "Configuration navigation");
        }
    }
}
