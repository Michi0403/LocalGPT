    private async Task RebuildModelChoicesAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedProviderKey))
        {
            await InvokeAsync(() => modelChoices.Clear()).ConfigureAwait(false);
            return;
        }
        try
        {
            var values = await Setup.BuildModelChoicesAsync(selectedProviderKey, recommendations).ConfigureAwait(false);
            await InvokeAsync(() =>
            {
                modelChoices.Clear();
                modelChoices.AddRange(values);
                var strongestInstalled = values.Where(item => item.IsInstalled && !string.IsNullOrWhiteSpace(item.SelectionKey)).OrderByDescending(item => item.RecommendationScore).Take(2).ToList();
                if (strongestInstalled.Count > 0)
