@using LocalGPT.BusinessObjects
@using Microsoft.AspNetCore.Components.Forms
@inject IInitialSetupAssistantService Setup
@inject IAiProviderBootstrapService Providers
@inject IOllamaProcessService OllamaProcesses
@inject IConsoleCommandService Console
@inject CouncilTextService CouncilText
@inject ILogger<InitialSetupAssistantPanel> Logger
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization
@implements IDisposable

<section class="initial-setup-assistant" aria-label="AI-guided initial setup assistant">
    <header class="initial-setup-heading">
        <div>
            <strong>AI-guided local runtime setup</strong>
            <p>This assistant remains available after first run. Hardware, provider installation, model selection and the initial benchmark team all use normal LocalGPT services and DXFunctions.</p>
        </div>
        <div class="initial-setup-heading-actions">
            <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="RefreshAsync">Refresh</button>
            @if (snapshot?.CanStartAiGuidedSetup == true)
            {
                <a class="localgpt-native-button" data-enhance-nav="false" href="@snapshot.AiGuidedSetupRoute">Continue with AI setup Council</a>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(statusText))
    {
        <div class="alert alert-info" role="status">@statusText</div>
    }

    @if (snapshot is null)
    {
        <p>Loading local setup state…</p>
    }
    else
    {
        @if (!snapshot.CanStartAiGuidedSetup)
        {
            <div class="alert alert-secondary">The AI-guided Setup Council becomes available here as soon as LocalGPT can see at least one installed local model. Until then, use the same setup functions manually below to bootstrap the first provider/model.</div>
        }
        <div class="initial-setup-grid">
            <article class="initial-setup-card">
                <h4>1. Local host hardware</h4>
                <p>LocalGPT detects the physical host CPU, RAM/unified memory and every GPU it can identify. The optional CanIRun.ai hardware match is separate so a user can choose the catalog variant without overwriting LocalGPT's detected hardware facts.</p>
                <label>Physical host endpoint
                    <input class="form-control" @bind="hardwareEndpoint" />
                </label>
                <div class="initial-setup-hardware-list">
                    @foreach (var device in hardware)
                    {
                        <div class="initial-setup-hardware-row" @key="device.Key">
                            <label class="initial-setup-hardware-use"><input type="checkbox" @bind="device.Selected" /> Use this host/device row</label>
                            <label>Provider endpoint / physical host<input class="form-control" @bind="device.Endpoint" /></label>
                            <label>CPU / SoC<input class="form-control" @bind="device.CpuName" /></label>
                            <label>GPU / accelerator (optional)<input class="form-control" @bind="device.Name" /></label>
                            <label>GPU vendor<input class="form-control" @bind="device.Vendor" /></label>
                            <label>Dedicated VRAM GiB<input class="form-control" type="number" step="0.25" min="0" @bind="device.DedicatedVramGiB" /></label>
                            <label>System / unified RAM GiB<input class="form-control" type="number" step="0.25" min="0" @bind="device.SystemMemoryGiB" /></label>
                            <label class="initial-setup-hardware-canirun">CanIRun.ai hardware match (optional catalog variant)<input class="form-control" @bind="device.CanIRunHardwareName" /></label>
                            <button type="button" class="localgpt-native-button initial-setup-hardware-remove" @onclick="() => RemoveHardware(device)">Remove row</button>
                        </div>
                    }
                </div>
                <div class="initial-setup-actions">
                    <button type="button" class="localgpt-native-button" @onclick="AddHardware">Add hardware row</button>
                    <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="DetectLocalHardwareAsync">Detect local hardware</button>
                    <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="SaveHardwareAsync">Save reviewed list</button>
                </div>
                <details>
                    <summary>HWiNFO text import</summary>
                    <p>The report stays local. LocalGPT deterministically extracts all supported GPU-memory sections plus CPU/RAM/OS facts.</p>
                    <textarea class="form-control" rows="6" @bind="hwInfoText" placeholder="Paste HWiNFO text export"></textarea>
                    <InputFile OnChange="ReadHwInfoFileAsync" accept=".txt,text/plain" />
                    <button type="button" class="localgpt-native-button" disabled="@(busy || string.IsNullOrWhiteSpace(hwInfoText))" @onclick="ImportHwInfoAsync">Import HWiNFO</button>
                </details>
            </article>

            <article class="initial-setup-card">
                <h4>2. Optional CanIRun.ai hardware-fit model discovery</h4>
                <p><strong>Credit:</strong> <a href="https://www.canirun.ai/" target="_blank" rel="noopener noreferrer">CanIRun.ai by midudev</a> can discover open models that fit the reviewed consumer hardware, including models the user may not already know. This optional web lookup is independent from the provider's own model inventory/catalog.</p>
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="canIRunOptIn" />
                    <span>I want LocalGPT to send the reviewed CPU, selected accelerator/CanIRun.ai variant, system/unified RAM and, when known, dedicated VRAM to CanIRun.ai. LocalGPT endpoint and host identifiers are not sent.</span>
                </label>
                <button type="button" class="localgpt-native-button" disabled="@(busy || !canIRunOptIn)" @onclick="LoadRecommendationsAsync">Find hardware-fit models</button>
                @if (recommendations.Count > 0)
                {
                    <div class="initial-setup-model-list">
                        @foreach (var item in recommendations)
                        {
                            <div class="initial-setup-model-row" @key="@(item.DeviceEndpoint + item.ModelId)">
                                <strong>@item.ModelName</strong>
                                <span>Grade @item.Grade · score @item.Score · @item.Status</span>
                                <span>@item.Quantization @((item.RequiredVramGiB is null) ? string.Empty : $"· {item.RequiredVramGiB:0.##} GiB")</span>
                                @if (!string.IsNullOrWhiteSpace(item.DeviceEndpoint)) { <code>@item.DeviceEndpoint</code> }
                                <a href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">CanIRun.ai source</a>
                            </div>
                        }
                    </div>
                }
            </article>

            <article class="initial-setup-card">
                <h4>3. Local AI provider</h4>
                <p>Commands come from the local Knowledge Database. Install/download actions use the shared bounded console; Ollama lifecycle actions use LocalGPT's process service. Mutating actions require your explicit confirmation.</p>
                <label>Provider profile
                    <select class="form-select" @bind="selectedProviderKey" @bind:after="ProviderSelectionChangedAsync">
                        <option value="">Choose provider</option>
                        @foreach (var profile in snapshot.ProviderProfiles)
                        {
                            <option value="@profile.Key">@profile.DisplayName · @profile.Platform</option>
                        }
                    </select>
                </label>
                @if (SelectedProvider is not null)
                {
                    <div class="initial-setup-provider-detail">
                        <strong>@SelectedProvider.DisplayName</strong>
                        <code>@SelectedProvider.Endpoint</code>
                        @if (IsSelectedOllama)
                        {
                            <span>Ollama: @T(ollamaStatus.IsInstalled ? "installed" : "not detected") · @T("runtime") @T(ollamaStatus.IsRunning ? "running" : "stopped")</span>
                            @if (!string.IsNullOrWhiteSpace(ollamaStatus.ExecutablePath))
                            {
                                <code>@ollamaStatus.ExecutablePath</code>
                            }
                            @if (ollamaUpdateRequired)
                            {
                                <div class="alert alert-warning" role="status">@T("A model requires a newer Ollama runtime. Update Ollama with explicit confirmation, then retry the model installation.")</div>
                            }
                        }
                        <a href="@SelectedProvider.SourceUrl" target="_blank" rel="noopener noreferrer">Provider installation source</a>
                        @if (!string.IsNullOrWhiteSpace(SelectedProvider.ModelCatalogUrl))
                        {
                            <a href="@SelectedProvider.ModelCatalogUrl" target="_blank" rel="noopener noreferrer">Browse official provider model catalog</a>
                        }
                        <small>If a guided install/start action is unavailable for this host, open the vendor source, complete the vendor setup, then use Detect again. LocalGPT keeps manual and guided paths equivalent.</small>
                    </div>
                    <div class="initial-setup-actions">
                        <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="DetectProviderAsync">Detect</button>
                        <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="ListProviderModelsAsync">List local models</button>
                        <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="InstallProviderAsync">Install (confirmed)</button>
                        @if (IsSelectedOllama)
                        {
                            <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="GuidedOllamaSetupAsync">@T("Set up Ollama (confirmed: install / start / register)")</button>
                            <button type="button" class="localgpt-native-button" disabled="@(busy || !ollamaStatus.IsInstalled || ollamaStatus.IsRunning)" @onclick="StartOllamaAsync">Start Ollama</button>
                            <button type="button" class="localgpt-native-button" disabled="@(busy || !ollamaStatus.IsRunning)" @onclick="StopOllamaAsync">Stop Ollama</button>
                            <button type="button" class="localgpt-native-button" disabled="@(busy || !ollamaStatus.IsInstalled)" @onclick="RestartOllamaAsync">Restart Ollama</button>
                            <button type="button" class="localgpt-native-button" disabled="@(busy || !ollamaStatus.IsInstalled)" @onclick="UpdateOllamaAsync">@T("Update Ollama (confirmed)")</button>
                            <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="RefreshAsync">Refresh Ollama / models</button>
                        }
                        else
                        {
                            <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="StartProviderAsync">Start (confirmed)</button>
                        }
                        <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="ConfigureProviderAsync">Register endpoint in LocalGPT</button>
                    </div>
                }
            </article>

            <article class="initial-setup-card">
                <h4>4. Provider models and hardware-fit discoveries</h4>
                <p>Installed models and knowledge-backed provider catalog mappings are always shown. CanIRun.ai adds hardware-fit discoveries when you opt in; it does not gate the provider model list.</p>
                @if (SelectedProvider is not null)
                {
                    <label>Model ID
                        <input class="form-control" @bind="manualModelId" placeholder="Provider model ID, for example qwen3:4b" />
                    </label>
                    <button type="button" class="localgpt-native-button" disabled="@(busy || string.IsNullOrWhiteSpace(manualModelId))" @onclick="InstallManualModelAsync">Download / install model</button>
                    <small>The provider model ID is validated as one safe token and installed through the same provider bootstrap service. Use the official provider catalog link to discover additional models even when CanIRun.ai is unavailable.</small>
                    @if (!string.IsNullOrWhiteSpace(SelectedProvider.ModelCatalogUrl))
                    {
                        <div class="initial-setup-provider-catalog-search">
                            <label>Official provider catalog search
                                <input class="form-control" @bind="providerCatalogQuery" placeholder="Optional search, for example qwen or deepseek" />
                            </label>
                            <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="SearchProviderCatalogAsync">Search official provider catalog</button>
                            <small>This user-triggered lookup contacts only the selected provider's maintained public catalog. It does not send LocalGPT endpoints, hardware facts, or CanIRun.ai state.</small>
                        </div>
                    }
                }
                @if (modelChoices.Count == 0)
                {
                    <p>No provider model entries are currently available. You can still enter a provider model ID manually or browse the selected provider's official catalog.</p>
                }
                else
                {
                    <div class="initial-setup-model-list">
                        @foreach (var choice in modelChoices)
                        {
                            <div class="initial-setup-model-row" @key="choice.ProviderModelId">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="choice.Selected" />
                                    <span><strong>@choice.DisplayName</strong> → <code>@choice.ProviderModelId</code></span>
                                </label>
                                <span>
                                    @(choice.IsInstalled ? T("installed") : choice.CanInstall ? T("available to install") : T("manual provider ID required"))
                                    @if (choice.IsProviderInventory) { <text> @T("· provider inventory")</text> }
                                    @if (choice.IsProviderCatalogEntry) { <text> @T("· official provider catalog")</text> }
                                    @if (choice.IsHardwareRecommended) { <text> @T("· CanIRun.ai hardware-fit discovery")</text> }
                                    @if (!string.IsNullOrWhiteSpace(choice.RecommendationGrade)) { <text> @T("· grade") @choice.RecommendationGrade</text> }
                                    @if (choice.RecommendationScore > 0) { <text> @T("· score") @choice.RecommendationScore</text> }
                                    @if (!string.IsNullOrWhiteSpace(choice.RecommendationStatus)) { <text> · @choice.RecommendationStatus</text> }
                                    @if (!string.IsNullOrWhiteSpace(choice.Quantization)) { <text> · @choice.Quantization</text> }
                                    @if (choice.RequiredVramGiB is > 0) { <text> · @choice.RequiredVramGiB.Value.ToString("0.##") GiB</text> }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(choice.SourceUrl))
                                {
                                    <a href="@choice.SourceUrl" target="_blank" rel="noopener noreferrer">CanIRun.ai model</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(choice.ProviderCatalogUrl))
                                {
                                    <a href="@choice.ProviderCatalogUrl" target="_blank" rel="noopener noreferrer">@T(choice.IsProviderCatalogUrlExact ? "Provider model page" : "Search provider catalog for this model")</a>
                                }
                                @if (!choice.IsInstalled && choice.CanInstall)
                                {
                                    <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="() => InstallModelAsync(choice)">Install model</button>
                                }
                                else if (choice.IsInstalled && choice.CanCheckUpdate)
                                {
                                    <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="() => CheckUpdateModelAsync(choice)">Check / refresh model</button>
                                }
                                else if (!choice.IsInstalled && choice.IsHardwareRecommended)
                                {
                                    <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="() => ResolveAndInstallModelAsync(choice)">@T("Resolve & install model")</button>
                                    <small>@T(choice.MappingStatus) @T("LocalGPT can check the selected provider's official catalog before installing; ambiguous results remain review-only.")</small>
                                }
                                else if (!choice.IsInstalled)
                                {
                                    <small>@T(choice.MappingStatus) @T("Enter the provider model ID above to install manually.")</small>
                                }
                            </div>
                        }
                    </div>
                }
                @if (providerCatalogChoices.Count > 0)
                {
                    <div class="initial-setup-provider-catalog-results">
                        <h5>Official provider catalog results</h5>
                        <p>These are provider-owned search results and remain independent from CanIRun.ai hardware-fit discoveries.</p>
                        <div class="initial-setup-model-list">
                            @foreach (var choice in providerCatalogChoices)
                            {
                                <div class="initial-setup-model-row" @key="choice.ProviderModelId">
                                    <span><strong>@choice.DisplayName</strong> → <code>@choice.ProviderModelId</code></span>
                                    <span>@(choice.IsInstalled ? T("installed") : choice.CanInstall ? T("available to install") : T("manual provider ID required")) @T("· official provider catalog")</span>
                                    @if (!string.IsNullOrWhiteSpace(choice.ProviderCatalogUrl))
                                    {
                                        <a href="@choice.ProviderCatalogUrl" target="_blank" rel="noopener noreferrer">@T("Provider model page")</a>
                                    }
                                    @if (!choice.IsInstalled && choice.CanInstall)
                                    {
                                        <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="() => InstallModelAsync(choice)">Install model</button>
                                    }
                                    else if (choice.IsInstalled && choice.CanCheckUpdate)
                                    {
                                        <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="() => CheckUpdateModelAsync(choice)">Check / refresh model</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </article>

            <article class="initial-setup-card initial-setup-wide">
                <h4>5. Hardware-curated benchmark Council</h4>
                <p>Select installed provider-qualified models. Mark the strongest ones as curator models; the saved team binds curator/director/reviewer roles to that stronger pool while benchmark-subject roles can exercise the broader selection.</p>
                @if (snapshot.InstalledModels.Count == 0)
                {
                    <p>No installed provider-qualified model is currently visible to LocalGPT.</p>
                }
                else
                {
                    <div class="initial-setup-installed-grid">
                        @foreach (var model in snapshot.InstalledModels)
                        {
                            var selected = selectedModels.Contains(model.SelectionKey);
                            var preferred = preferredCuratorModels.Contains(model.SelectionKey);
                            <div class="initial-setup-installed-row" @key="model.SelectionKey">
                                <label><input type="checkbox" checked="@selected" @onchange="args => ToggleModel(model.SelectionKey, args)" /> @T("Use")</label>
                                <label><input type="checkbox" checked="@preferred" @onchange="args => TogglePreferredModel(model.SelectionKey, args)" /> @T("Curator")</label>
                                <strong>@model.DisplayName</strong>
                                <code>@model.EndpointLabel</code>
                            </div>
                        }
                    </div>
                    <label>Team name<input class="form-control" @bind="benchmarkTeamName" /></label>
                    <button type="button" class="localgpt-native-button" disabled="@busy" @onclick="CreateBenchmarkTeamAsync">Create / refresh hardware benchmark team</button>
                }
            </article>

            <article class="initial-setup-card initial-setup-wide">
                <h4>Shared ASCII command console</h4>
                <p>The same bounded command feed appears in Chat's ASCII console whenever no game is running.</p>
                <pre class="initial-setup-console" aria-live="polite">@Console.GetRecentDisplayText(120)</pre>
            </article>
        </div>
    }
</section>

@code {
    /// <summary>Returns one setup-assistant string through the maintained LocalGPT localization catalog.</summary>
    /// <param name="source">English source text used as the exact localization-catalog lookup value.</param>
    /// <returns>The localized setup-assistant text, or the maintained fallback when no culture-specific value exists.</returns>
    private string T(string source) => Localization.GetText(source);

    /// <summary>Formats one localized setup-assistant sentence using the current UI culture.</summary>
    /// <param name="source">English source text used as the exact localization-catalog lookup value.</param>
    /// <param name="args">Values inserted into the localized format string.</param>
    /// <returns>The localized and culture-formatted setup-assistant sentence.</returns>
    private string TF(string source, params object?[] args) => string.Format(CultureInfo.CurrentUICulture, T(source), args);

    /// <summary>
    /// Stores the internal snapshot state used by <see cref="InitialSetupAssistantPanel"/> while executing its surrounding workflow.
    /// </summary>
    private InitialSetupAssistantSnapshot? snapshot;
    /// <summary>
    /// Stores the in-memory hardware collection maintained internally by <see cref="InitialSetupAssistantPanel"/> for its current workflow state.
    /// </summary>
    private readonly List<InitialSetupHardwareDevice> hardware = [];
    /// <summary>
    /// Stores the in-memory recommendations collection maintained internally by <see cref="InitialSetupAssistantPanel"/> for its current workflow state.
    /// </summary>
    private readonly List<CanIRunModelRecommendation> recommendations = [];
    /// <summary>
    /// Stores the in-memory model choices collection maintained internally by <see cref="InitialSetupAssistantPanel"/> for its current workflow state.
    /// </summary>
    private readonly List<InitialSetupModelChoice> modelChoices = [];
    /// <summary>Stores provider-owned catalog search results separately from installed inventory and CanIRun.ai discovery state.</summary>
    private readonly List<InitialSetupModelChoice> providerCatalogChoices = [];
    /// <summary>
    /// Stores the in-memory selected models collection maintained internally by <see cref="InitialSetupAssistantPanel"/> for its current workflow state.
    /// </summary>
    private readonly HashSet<string> selectedModels = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>
    /// Stores the in-memory preferred curator models collection maintained internally by <see cref="InitialSetupAssistantPanel"/> for its current workflow state.
    /// </summary>
    private readonly HashSet<string> preferredCuratorModels = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>
    /// Stores the internal selected provider key state used by <see cref="InitialSetupAssistantPanel"/> while executing its surrounding workflow.
    /// </summary>
    private string selectedProviderKey = string.Empty;
    /// <summary>Stores the explicit provider model ID used to bootstrap a first model without a recommendation lookup.</summary>
    private string manualModelId = string.Empty;
    /// <summary>Stores optional user-entered search text for the selected provider's official public model catalog.</summary>
    private string providerCatalogQuery = string.Empty;
    /// <summary>Stores the current Ollama process status resolved by the existing lifecycle service.</summary>
    private OllamaProcessStatus ollamaStatus = new(false, false, null, Array.Empty<OllamaProcessInfo>(), string.Empty, "Ollama process status not checked yet.");
    /// <summary>
    /// Stores the internal hardware endpoint state used by <see cref="InitialSetupAssistantPanel"/> while executing its surrounding workflow.
    /// </summary>
    private string hardwareEndpoint = "http://127.0.0.1:11434";
    /// <summary>
    /// Stores the internal hw info text state used by <see cref="InitialSetupAssistantPanel"/> while executing its surrounding workflow.
    /// </summary>
    private string hwInfoText = string.Empty;
    /// <summary>
    /// Stores the internal benchmark team name state used by <see cref="InitialSetupAssistantPanel"/> while executing its surrounding workflow.
    /// </summary>
    private string benchmarkTeamName = "Hardware-curated initial benchmark";
    /// <summary>
    /// Stores the internal status text state used by <see cref="InitialSetupAssistantPanel"/> while executing its surrounding workflow.
    /// </summary>
    private string statusText = string.Empty;
    /// <summary>
    /// Stores the internal can i run opt in state used by <see cref="InitialSetupAssistantPanel"/> while executing its surrounding workflow.
    /// </summary>
    private bool canIRunOptIn;
    /// <summary>
    /// Stores the internal busy state used by <see cref="InitialSetupAssistantPanel"/> while executing its surrounding workflow.
    /// </summary>
    private bool busy;
    /// <summary>Tracks whether a provider model pull reported that the installed Ollama runtime is too old for that model.</summary>
    private bool ollamaUpdateRequired;
    /// <summary>Marks that console output changed and a renderer refresh should be coalesced into the active worker.</summary>
    private int consoleRenderPending;
    /// <summary>Ensures only one bounded console-render worker is active for this component.</summary>
    private int consoleRenderWorkerRunning;
    /// <summary>Cancels the console-render worker when the component is disposed.</summary>
    private readonly CancellationTokenSource consoleRenderCancellation = new();
    /// <summary>
    /// Gets the selected provider value that forms part of the initial setup assistant panel state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The selected provider value exposed by <see cref="InitialSetupAssistantPanel"/>.</value>
    private AiProviderBootstrapProfile? SelectedProvider => snapshot?.ProviderProfiles.FirstOrDefault(item => item.Key.Equals(selectedProviderKey, StringComparison.OrdinalIgnoreCase));
    /// <summary>Reports whether the selected setup profile resolves to LocalGPT's Ollama provider path.</summary>
    /// <value><see langword="true"/> when the selected profile represents Ollama; otherwise <see langword="false"/>.</value>
    private bool IsSelectedOllama => SelectedProvider is { } profile
        && IsOllamaProfileForRender(profile);

    /// <summary>Classifies an Ollama profile locally for render-time checks so frequent UI refreshes do not invoke a decorated service method.</summary>
    /// <param name="profile">Provider bootstrap profile being classified for the setup UI.</param>
    /// <returns><see langword="true"/> when the profile uses LocalGPT's maintained Ollama provider identity; otherwise <see langword="false"/>.</returns>
    private bool IsOllamaProfileForRender(AiProviderBootstrapProfile profile)
        => profile.ProviderKind.Equals("Ollama", StringComparison.OrdinalIgnoreCase)
            || CouncilText.StartsWithText(profile.Key, "ollama-", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Handles the initialized async lifecycle or event notification for <see cref="InitialSetupAssistantPanel"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnInitializedAsync()
    {
        Console.Changed += OnConsoleChanged;
        benchmarkTeamName = T("Hardware-curated initial benchmark");
        await RefreshAsync().ConfigureAwait(false);
    }

    /// <summary>
    /// Performs refresh for <see cref="InitialSetupAssistantPanel"/>, keeping the operation consistent with the state and invariants of the surrounding initial setup assistant panel workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RefreshAsync()
    {
        try
        {
            await SetBusyAsync(true).ConfigureAwait(false);
            InitialSetupAssistantSnapshot value;
            var recoveryMode = false;
            try
            {
                value = await Setup.GetSnapshotAsync().ConfigureAwait(false);
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Initial setup snapshot was unavailable; rendering the provider/Ollama recovery surface instead of hiding the setup form.");
                value = await BuildRecoverySnapshotAsync().ConfigureAwait(false);
                recoveryMode = true;
            }

            OllamaProcessStatus processStatus;
            try
            {
                processStatus = await OllamaProcesses.GetStatusAsync().ConfigureAwait(false);
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Ollama process status was unavailable during setup refresh; provider/model setup remains usable.");
                processStatus = ollamaStatus with { Message = T("Ollama process status is temporarily unavailable.") };
            }
            await InvokeAsync(() =>
            {
                snapshot = value;
                ollamaStatus = processStatus;
                hardware.Clear();
                hardware.AddRange(value.Hardware);
                if (!string.IsNullOrWhiteSpace(selectedProviderKey)
                    && value.ProviderProfiles.All(item => !item.Key.Equals(selectedProviderKey, StringComparison.OrdinalIgnoreCase)))
                    selectedProviderKey = string.Empty;
                if (string.IsNullOrWhiteSpace(selectedProviderKey) && processStatus.IsInstalled)
                    selectedProviderKey = value.ProviderProfiles.FirstOrDefault(IsOllamaProfileForRender)?.Key ?? string.Empty;
                selectedModels.Clear();
                foreach (var model in value.InstalledModels) selectedModels.Add(model.SelectionKey);
                if (preferredCuratorModels.Count == 0)
                    foreach (var key in value.RecommendedCuratorModelKeys) preferredCuratorModels.Add(key);
                var ollamaSummary = processStatus.IsInstalled
                    ? " " + TF("Ollama runtime: {0}.", processStatus.IsRunning ? T("running") : T("stopped"))
                    : string.Empty;
                statusText = recoveryMode
                    ? T("Setup loaded in recovery mode. Provider/Ollama controls remain available.") + ollamaSummary
                    : TF("{0} hardware device(s), {1} provider profile(s), {2} installed model(s).", value.Hardware.Count, value.ProviderProfiles.Count, value.InstalledModels.Count) + ollamaSummary;
            }).ConfigureAwait(false);
            await RebuildModelChoicesAsync().ConfigureAwait(false);
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, "Refreshing initial setup assistant was cancelled.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Refreshing initial setup assistant failed after recovery handling.");
            await SetStatusAsync(T("Setup refresh failed after recovery handling. Provider controls may require a page reload; review LocalGPT logs.")).ConfigureAwait(false);
        }
        finally { await SetBusyAsync(false).ConfigureAwait(false); }
    }

