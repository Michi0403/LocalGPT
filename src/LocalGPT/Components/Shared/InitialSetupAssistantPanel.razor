    /// <summary>Resolves an unmapped hardware-fit recommendation through the official provider catalog and installs it only when one conservative exact provider match is found.</summary>
    /// <param name="choice">Hardware-fit recommendation that does not yet have a provider-safe install identifier.</param>
    /// <returns>A task that completes after provider-catalog resolution and, when unambiguous, the explicit install action.</returns>
    private async Task ResolveAndInstallModelAsync(InitialSetupModelChoice choice)
    {
        if (string.IsNullOrWhiteSpace(selectedProviderKey) || choice is null || !choice.IsHardwareRecommended)
            return;
        try
        {
            await SetBusyAsync(true).ConfigureAwait(false);
            var resolution = await Setup.ResolveProviderCatalogRecommendationAsync(
                selectedProviderKey,
                choice.RecommendationId,
                choice.DisplayName,
                userConfirmedWebLookup: true).ConfigureAwait(false);
            await InvokeAsync(() =>
            {
                providerCatalogChoices.Clear();
                providerCatalogChoices.AddRange(resolution.Candidates);
            }).ConfigureAwait(false);

            if (resolution.Match is null)
            {
                await SetStatusAsync(resolution.Candidates.Count == 0
                    ? T("No official provider model match was found for this hardware-fit recommendation. The CanIRun.ai source and provider search link remain available for review.")
                    : T("No unambiguous official provider match was found. Review the provider catalog results below; LocalGPT will not guess an install ID.")).ConfigureAwait(false);
                return;
            }

            var match = resolution.Match;
            await InvokeAsync(() =>
            {
                choice.ProviderModelId = match.ProviderModelId;
                choice.ProviderCatalogUrl = match.ProviderCatalogUrl;
                choice.IsProviderCatalogUrlExact = match.IsProviderCatalogUrlExact;
                choice.CanInstall = match.CanInstall;
                choice.IsProviderCatalogEntry = true;
                choice.MappingStatus = "CanIRun.ai hardware-fit discovery matched uniquely in the selected provider catalog.";
            }).ConfigureAwait(false);

            if (match.IsInstalled)
            {
                await RefreshAsync().ConfigureAwait(false);
                await SetStatusAsync(T("The official provider match is already installed; LocalGPT refreshed the model inventory.")).ConfigureAwait(false);
                return;
            }
            if (!match.CanInstall)
            {
                await SetStatusAsync(T("A unique provider model page was found, but this provider profile does not define a model-install action.")).ConfigureAwait(false);
                return;
            }

            var result = await Providers.InstallModelAsync(selectedProviderKey, match.ProviderModelId, true).ConfigureAwait(false);
            if (await HandleOllamaUpdateRequirementAsync(result).ConfigureAwait(false))
                return;
            if (result.Succeeded)
                await RefreshAsync().ConfigureAwait(false);
            await SetStatusAsync(TF("Provider-matched model installation: {0}.", T(result.Status))).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Resolving and installing a hardware-fit provider model failed; model identifiers were omitted.");
            await SetStatusAsync(T("Provider model resolution or installation failed. Review the provider catalog results, shared console, and LocalGPT logs.")).ConfigureAwait(false);
        }
        finally
        {
            await SetBusyAsync(false).ConfigureAwait(false);
        }
    }

    /// <summary>Recognizes the provider's explicit "newer Ollama required" model-pull response and exposes the confirmed updater action instead of treating it as an opaque install failure.</summary>
    /// <param name="result">Provider model-install result whose bounded stdout/stderr may contain the runtime compatibility response.</param>
    /// <returns><see langword="true"/> when the user should update Ollama before retrying this model.</returns>
    private async Task<bool> HandleOllamaUpdateRequirementAsync(LocalConsoleCommandResult result)
    {
        try
        {
            if (!IsSelectedOllama || result.Succeeded)
                return false;
            var diagnostic = string.Concat(result.StandardError, Environment.NewLine, result.StandardOutput);
            var requiresUpdate = CouncilText.ContainsText(diagnostic, "requires a newer version of Ollama", StringComparison.OrdinalIgnoreCase)
                || CouncilText.ContainsText(diagnostic, "Please download the latest version", StringComparison.OrdinalIgnoreCase);
            if (!requiresUpdate)
                return false;

            await InvokeAsync(() => ollamaUpdateRequired = true).ConfigureAwait(false);
            await SetStatusAsync(T("This model requires a newer Ollama runtime. Use Update Ollama (confirmed), then retry the model installation; LocalGPT will not update the runtime without that separate confirmation.")).ConfigureAwait(false);
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Recognizing an Ollama model/runtime compatibility response failed; provider output was omitted.");
            return false;
        }
    }

    /// <summary>Runs the selected provider's explicit install/pull operation for an installed model so the provider can check and refresh its local copy.</summary>
    /// <param name="choice">Installed provider model to check/refresh.</param>
    /// <returns>A task that completes after the provider action and setup refresh.</returns>
    private Task CheckUpdateModelAsync(InitialSetupModelChoice choice) => InstallModelAsync(choice);

    /// <summary>Installs one provider-safe model choice exposed by provider inventory or hardware-aware discovery.</summary>
    /// <param name="choice">Provider model choice whose validated provider identifier should be installed.</param>
    /// <returns>A task that completes after the provider action and setup refresh.</returns>
    private async Task InstallModelAsync(InitialSetupModelChoice choice)
    {
        if (string.IsNullOrWhiteSpace(selectedProviderKey) || !choice.CanInstall) return;
        try
        {
            await SetBusyAsync(true).ConfigureAwait(false);
            var result = await Providers.InstallModelAsync(selectedProviderKey, choice.ProviderModelId, true).ConfigureAwait(false);
            if (await HandleOllamaUpdateRequirementAsync(result).ConfigureAwait(false))
                return;
            if (result.Succeeded)
            {
                choice.IsInstalled = true;
                choice.IsProviderInventory = true;
                choice.CanCheckUpdate = IsSelectedOllama;
                await RefreshAsync().ConfigureAwait(false);
            }
            await SetStatusAsync(TF("Model installation: {0}.", T(result.Status))).ConfigureAwait(false);
        }
        catch (Exception exception) { Logger.LogError(exception, "Initial setup model install failed; model identifier omitted."); await SetStatusAsync(T("Model installation failed. Review LocalGPT logs.")).ConfigureAwait(false); }
        finally { await SetBusyAsync(false).ConfigureAwait(false); }
    }

    /// <summary>
    /// Performs toggle model for <see cref="InitialSetupAssistantPanel"/>, keeping the operation consistent with the state and invariants of the surrounding initial setup assistant panel workflow.
    /// </summary>
    /// <param name="selectionKey">Selection key value supplied to the initial setup assistant panel operation and used when producing its result.</param>
    /// <param name="args">Args value supplied to the initial setup assistant panel operation and used when producing its result.</param>
    private void ToggleModel(string selectionKey, ChangeEventArgs args)
    {
        if (args.Value is bool enabled && enabled) selectedModels.Add(selectionKey); else selectedModels.Remove(selectionKey);
        if (!selectedModels.Contains(selectionKey)) preferredCuratorModels.Remove(selectionKey);
    }

    /// <summary>
    /// Performs toggle preferred model for <see cref="InitialSetupAssistantPanel"/>, keeping the operation consistent with the state and invariants of the surrounding initial setup assistant panel workflow.
    /// </summary>
    /// <param name="selectionKey">Selection key value supplied to the initial setup assistant panel operation and used when producing its result.</param>
    /// <param name="args">Args value supplied to the initial setup assistant panel operation and used when producing its result.</param>
    private void TogglePreferredModel(string selectionKey, ChangeEventArgs args)
    {
        if (args.Value is bool enabled && enabled) { selectedModels.Add(selectionKey); preferredCuratorModels.Add(selectionKey); }
        else preferredCuratorModels.Remove(selectionKey);
    }

    /// <summary>
    /// Creates benchmark team for <see cref="InitialSetupAssistantPanel"/>, keeping the operation consistent with the state and invariants of the surrounding initial setup assistant panel workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task CreateBenchmarkTeamAsync()
    {
        try
        {
            await SetBusyAsync(true).ConfigureAwait(false);
            var saved = await Setup.CreateBenchmarkTeamAsync(new CreateInitialBenchmarkTeamRequest
            {
                DisplayName = benchmarkTeamName,
                ModelSelectionKeys = selectedModels.ToList(),
                PreferredCuratorModelKeys = preferredCuratorModels.ToList(),
                UserConfirmed = true
            }).ConfigureAwait(false);
            await SetStatusAsync(TF("Council team '{0}' is ready in Council Teams.", saved.DisplayName)).ConfigureAwait(false);
        }
        catch (Exception exception) { Logger.LogError(exception, "Creating initial benchmark team from setup panel failed."); await SetStatusAsync(T("Benchmark team could not be created. Review LocalGPT logs.")).ConfigureAwait(false); }
        finally { await SetBusyAsync(false).ConfigureAwait(false); }
    }

    /// <summary>
    /// Handles the console changed lifecycle or event notification for <see cref="InitialSetupAssistantPanel"/>, updating the state required by the surrounding workflow.
    /// </summary>
    private void OnConsoleChanged()
    {
        Interlocked.Exchange(ref consoleRenderPending, 1);
        if (Interlocked.CompareExchange(ref consoleRenderWorkerRunning, 1, 0) == 0)
            _ = RefreshConsoleRenderAsync();
    }

    /// <summary>Coalesces high-frequency provider progress frames so terminal percentages remain live without flooding the Blazor circuit with one render per terminal rewrite.</summary>
    /// <returns>A task that completes after the latest bounded console state has been rendered.</returns>
    private async Task RefreshConsoleRenderAsync()
    {
        try
        {
            while (!consoleRenderCancellation.IsCancellationRequested)
            {
                await Task.Delay(250, consoleRenderCancellation.Token).ConfigureAwait(false);
                Interlocked.Exchange(ref consoleRenderPending, 0);
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);

                if (Volatile.Read(ref consoleRenderPending) == 0)
                    break;
            }
        }
        catch (OperationCanceledException) when (consoleRenderCancellation.IsCancellationRequested)
        {
            // Component disposal cancels any delayed renderer refresh.
        }
        catch (ObjectDisposedException)
        {
            // The circuit may dispose this component while a delayed progress render is pending.
        }
        finally
        {
            Interlocked.Exchange(ref consoleRenderWorkerRunning, 0);
            if (Volatile.Read(ref consoleRenderPending) != 0
                && !consoleRenderCancellation.IsCancellationRequested
                && Interlocked.CompareExchange(ref consoleRenderWorkerRunning, 1, 0) == 0)
                _ = RefreshConsoleRenderAsync();
        }
    }
    /// <summary>
    /// Sets busy for <see cref="InitialSetupAssistantPanel"/>, keeping the operation consistent with the state and invariants of the surrounding initial setup assistant panel workflow.
    /// </summary>
    /// <param name="value">Value indicating whether value should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SetBusyAsync(bool value) => InvokeAsync(() => busy = value);
    /// <summary>
    /// Sets status for <see cref="InitialSetupAssistantPanel"/>, keeping the operation consistent with the state and invariants of the surrounding initial setup assistant panel workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the initial setup assistant panel operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task SetStatusAsync(string value) => InvokeAsync(() => statusText = value);

    /// <summary>
    /// Releases resources owned by <see cref="InitialSetupAssistantPanel"/> and leaves the initial setup assistant panel workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        Console.Changed -= OnConsoleChanged;
        consoleRenderCancellation.Cancel();
        consoleRenderCancellation.Dispose();
        GC.SuppressFinalize(this);
    }
}
