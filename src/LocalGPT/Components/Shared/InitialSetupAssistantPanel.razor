    /// <summary>Runs the explicit guided Ollama path: install only when missing, start only when stopped, then register the loopback endpoint.</summary>
    /// <returns>A task that completes after the guided setup action has refreshed provider/model state.</returns>
    private async Task GuidedOllamaSetupAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedProviderKey) || !IsSelectedOllama)
            return;
        try
        {
            await SetBusyAsync(true).ConfigureAwait(false);
            var processStatus = await OllamaProcesses.GetStatusAsync().ConfigureAwait(false);
            if (!processStatus.IsInstalled)
            {
                var install = await Providers.InstallAsync(selectedProviderKey, true).ConfigureAwait(false);
                if (!install.Succeeded)
                {
                    await SetStatusAsync(T("Ollama installation did not complete successfully. Review the shared console and provider source before retrying.")).ConfigureAwait(false);
                    return;
                }
                processStatus = await OllamaProcesses.GetStatusAsync().ConfigureAwait(false);
            }

            if (!processStatus.IsInstalled)
            {
                await SetStatusAsync(T("The installer completed, but LocalGPT still cannot find the Ollama executable. Open the provider source if the macOS app needs one manual launch, then use this guided action again.")).ConfigureAwait(false);
                return;
            }

            if (!processStatus.IsRunning)
                processStatus = await OllamaProcesses.StartAsync().ConfigureAwait(false);
            if (!processStatus.IsRunning)
            {
                await SetStatusAsync(TF("Ollama is installed but did not reach the running state: {0}", T(processStatus.Message))).ConfigureAwait(false);
                return;
            }

            var endpoint = await Providers.ConfigureEndpointAsync(selectedProviderKey, true).ConfigureAwait(false);
            await RefreshAsync().ConfigureAwait(false);
            await SetStatusAsync(TF("Ollama guided setup completed. Runtime is running and {0} is registered in LocalGPT.", endpoint)).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Guided Ollama setup failed; command and endpoint details omitted.");
            await SetStatusAsync(T("Guided Ollama setup failed. Review the shared console and LocalGPT logs; completed steps remain intact for the next retry.")).ConfigureAwait(false);
        }
        finally
        {
            await SetBusyAsync(false).ConfigureAwait(false);
        }
    }

    /// <summary>Updates Ollama through the selected knowledge-backed profile while preserving the pre-update running/stopped state.</summary>
    /// <returns>A task that completes after the update, lifecycle recovery, and setup refresh.</returns>
    private async Task UpdateOllamaAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedProviderKey) || !IsSelectedOllama || !ollamaStatus.IsInstalled)
            return;
        var wasRunning = false;
        var runtimeStoppedForUpdate = false;
        try
        {
            await SetBusyAsync(true).ConfigureAwait(false);
            var before = await OllamaProcesses.GetStatusAsync().ConfigureAwait(false);
            wasRunning = before.IsRunning;
            if (wasRunning)
            {
                var stopped = await OllamaProcesses.StopAsync().ConfigureAwait(false);
                runtimeStoppedForUpdate = !stopped.IsRunning;
                if (!runtimeStoppedForUpdate)
                {
                    await SetStatusAsync(T("Ollama could not be stopped safely for the update. The update was not started.")).ConfigureAwait(false);
                    return;
                }
            }

            var update = await Providers.UpdateAsync(selectedProviderKey, true).ConfigureAwait(false);
            if (!update.Succeeded)
            {
                if (wasRunning && runtimeStoppedForUpdate)
                    await RestoreOllamaAfterUpdateAttemptAsync().ConfigureAwait(false);
                await SetStatusAsync(T("Ollama update did not complete successfully. The previous runtime was preserved where possible; review the shared console and provider source.")).ConfigureAwait(false);
                return;
            }

            var after = await OllamaProcesses.GetStatusAsync().ConfigureAwait(false);
            if (!after.IsInstalled)
            {
                if (wasRunning && runtimeStoppedForUpdate)
                    await RestoreOllamaAfterUpdateAttemptAsync().ConfigureAwait(false);
                await SetStatusAsync(T("The Ollama updater completed, but LocalGPT can no longer resolve the executable. Use the provider source and Detect before retrying.")).ConfigureAwait(false);
                return;
            }
            if (wasRunning && !after.IsRunning)
                after = await OllamaProcesses.StartAsync().ConfigureAwait(false);

            await InvokeAsync(() =>
            {
                ollamaStatus = after;
                ollamaUpdateRequired = false;
            }).ConfigureAwait(false);
            await RefreshAsync().ConfigureAwait(false);
            await SetStatusAsync(after.IsRunning
                ? T("Ollama update completed and the runtime is running again. You can retry the model installation now.")
                : T("Ollama update completed. The runtime remains stopped because it was stopped before the update.")).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Updating Ollama from the initial setup assistant failed; command and executable details omitted.");
            if (wasRunning && runtimeStoppedForUpdate)
                await RestoreOllamaAfterUpdateAttemptAsync().ConfigureAwait(false);
            await SetStatusAsync(T("Ollama update failed. Review the shared console and LocalGPT logs before retrying.")).ConfigureAwait(false);
        }
        finally
        {
            await SetBusyAsync(false).ConfigureAwait(false);
        }
    }

    /// <summary>Best-effort restores a previously running Ollama process after an update attempt that did not complete.</summary>
    /// <returns>A task that completes after the lifecycle recovery attempt.</returns>
