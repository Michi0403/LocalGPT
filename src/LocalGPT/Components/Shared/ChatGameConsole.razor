@using LocalGPT.BusinessObjects
@using Microsoft.JSInterop
@inject ICouncilGameSessionService Games
@inject IConsoleCommandService Console
@inject IJSRuntime JS
@inject ILogger<ChatGameConsole> Logger
@implements IAsyncDisposable

<section id="@elementId"
         class="chat-game-console @(snapshot is null ? "chat-game-console-empty" : "chat-game-console-active")"
         tabindex="0"
         data-localgpt-game-console
         data-localgpt-copyable="true"
         data-scale-mode="@fullscreenScaleMode.ToLowerInvariant()"
         aria-label="Persistent ASCII game screen">
    <header class="chat-game-console-header">
        <div>
            <strong>@(snapshot?.DisplayName ?? (consoleOutput.Count > 0 ? "ASCII command console" : "ASCII game console"))</strong>
            <small>@(snapshot is null ? (consoleOutput.Count > 0 ? "Live bounded LocalGPT terminal output. Start a game any time to replace this surface." : "Start a directly playable runtime-class game.") : $"Turn {snapshot.Turn} · {snapshot.CurrentTurnOwner} · {snapshot.ControlMode}")</small>
        </div>
        <div class="chat-game-console-actions">
            @if (snapshot is null)
            {
                <button type="button" @onclick="StartDoomAsync">Play ASCII corridor</button>
                <button type="button" @onclick="StartDragonAsync">Play Green Dragon story</button>
            }
            else
            {
                <label>
                    <span>Control</span>
                    <select value="@snapshot.ControlMode" @onchange="ChangeControlModeAsync">
                        <option value="Human">Human</option>
                        <option value="Shared">Human + AI</option>
                        <option value="Ai">AI autoplay</option>
                    </select>
                </label>
                @if (snapshot.ControlMode != CouncilGameControlMode.Human)
                {
                    <label>
                        <span>AI step</span>
                        <select value="@snapshot.AutoplayDelayMilliseconds" @onchange="ChangeAutoplayDelayAsync">
                            <option value="500">0.5 s</option>
                            <option value="1000">1 s</option>
                            <option value="1500">1.5 s</option>
                            <option value="2500">2.5 s</option>
                            <option value="5000">5 s</option>
                        </select>
                    </label>
                }
                <label>
                    <span>Fullscreen scale</span>
                    <select value="@fullscreenScaleMode" @onchange="ChangeFullscreenScaleModeAsync">
                        <option value="Fit">Fit whole frame</option>
                        <option value="Width">Fit width + vertical scroll</option>
                        <option value="Native">Native size + scroll</option>
                    </select>
                </label>
                <button type="button" @onclick="ToggleControls">@(showControls ? "Hide guide" : "Show guide")</button>
                <button type="button" @onclick="FullscreenAsync">Fullscreen</button>
            }
            <button type="button"
                    class="chat-game-console-close"
                    @onclick="CloseAsync"
                    aria-label="Close ASCII game console"
                    title="Close ASCII game console">
                <span aria-hidden="true">×</span>
                <span>Close</span>
            </button>
        </div>
    </header>

    @if (snapshot is null)
    {
        <div class="chat-game-console-placeholder">
            @if (consoleOutput.Count > 0)
            {
                <pre class="chat-game-screen" aria-live="polite">@ConsoleText</pre>
            }
            else
            {
                <pre>┌──────────────────────────────────────────────────────────────────────────────┐
│  /Chat ASCII surface ready                                                  │
│  Provider/toolchain commands appear here when no game is running.           │
│  One authoritative game frame replaces the command feed while a game runs.  │
└──────────────────────────────────────────────────────────────────────────────┘</pre>
            }
        </div>
    }
    else
    {
        <div class="chat-game-stage @(ShowControlGuide ? "has-guide" : "screen-only")">
            <div class="chat-game-screen-viewport">
                <pre class="chat-game-screen" aria-live="polite">@snapshot.FrameText</pre>
            </div>
            @if (ShowControlGuide)
            {
                <aside class="chat-game-control-guide" role="group" aria-label="Your game controls" aria-busy="@InputBusyState">
                    <div class="chat-game-control-card">
                        <strong>Your turn</strong>
                        <div class="chat-game-control-status">
                            @if (inputInFlight)
                            {
                                <span role="status">Applying move…</span>
                            }
                            else if (snapshot.HumanInputRequired)
                            {
                                <span>@snapshot.InputReason</span>
                            }
                            else
                            {
                                <span role="status">Waiting for your next turn…</span>
                            }
                        </div>
                        <div class="chat-game-touch-grid">
                            <button type="button" class="up" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="move-forward" @onclick='@(() => SendControlAsync("move-forward"))'>▲</button>
                            <button type="button" class="left" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="left" @onclick='@(() => SendControlAsync(snapshot.GameKey == "green-dragon" ? "turn-left" : "strafe-left"))'>◀</button>
                            <button type="button" class="down" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="move-backward" @onclick='@(() => SendControlAsync("move-backward"))'>▼</button>
                            <button type="button" class="right" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="right" @onclick='@(() => SendControlAsync(snapshot.GameKey == "green-dragon" ? "turn-right" : "strafe-right"))'>▶</button>
                            <button type="button" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="turn-left" @onclick='@(() => SendControlAsync("turn-left"))'>Aim ◁</button>
                            <button type="button" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="turn-right" @onclick='@(() => SendControlAsync("turn-right"))'>Aim ▷</button>
                            @if (snapshot.GameKey == "ascii-doom")
                            {
                                <button type="button" class="primary" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="shoot" @onclick='@(() => SendControlAsync("shoot"))'>Shoot</button>
                                <button type="button" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="duck" @onclick='@(() => SendControlAsync("duck"))'>Duck</button>
                            }
                            <button type="button" class="primary" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="use" @onclick='@(() => SendControlAsync("use"))'>Use</button>
                        </div>
                        <small>Keyboard and connected gamepads use these exact actions. Fit mode scales the frame in fullscreen; Native mode keeps the original monospace size and enables scrolling.</small>
                    </div>
                </aside>
            }
        </div>
        <footer class="chat-game-console-footer">
            <span>@snapshot.FrameCaption</span>
            <span>Renderer: @snapshot.FrameRenderer</span>
        </footer>
    }
</section>

@code {
    /// <summary>
    /// Gets or sets the stable conversation identifier used to identify or correlate this chat game console instance with related application state.
    /// </summary>
    /// <value>The conversation identifier value exposed by <see cref="ChatGameConsole"/>.</value>
    [Parameter] public Guid? ConversationId { get; set; }
    /// <summary>
    /// Gets or sets the stable suggested team key used to identify or correlate this chat game console instance with related application state.
    /// </summary>
    /// <value>The suggested team key value exposed by <see cref="ChatGameConsole"/>.</value>
    [Parameter] public string SuggestedTeamKey { get; set; } = string.Empty;
    /// <summary>
    /// Gets or sets the close requested value that forms part of the chat game console state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The close requested value exposed by <see cref="ChatGameConsole"/>.</value>
    [Parameter] public EventCallback CloseRequested { get; set; }

    /// <summary>
    /// Stores the internal element identifier state used by <see cref="ChatGameConsole"/> while executing its surrounding workflow.
    /// </summary>
    private readonly string elementId = $"localgpt-game-{Guid.NewGuid():N}";
    /// <summary>
    /// Stores the internal snapshot state used by <see cref="ChatGameConsole"/> while executing its surrounding workflow.
    /// </summary>
    private CouncilGameSessionSnapshot? snapshot;
    /// <summary>
    /// Stores the in-memory console output collection maintained internally by <see cref="ChatGameConsole"/> for its current workflow state.
    /// </summary>
    private IReadOnlyList<LocalConsoleOutputEvent> consoleOutput = [];
    /// <summary>
    /// Stores the internal reference state used by <see cref="ChatGameConsole"/> while executing its surrounding workflow.
    /// </summary>
    private DotNetObjectReference<ChatGameConsole>? reference;
    /// <summary>
    /// Stores the internal attached state used by <see cref="ChatGameConsole"/> while executing its surrounding workflow.
    /// </summary>
    private bool attached;
    /// <summary>
    /// Stores the internal show controls state used by <see cref="ChatGameConsole"/> while executing its surrounding workflow.
    /// </summary>
    private bool showControls = true;
    /// <summary>
    /// Stores the internal input in flight state used by <see cref="ChatGameConsole"/> while executing its surrounding workflow.
    /// </summary>
    private bool inputInFlight;
    /// <summary>
    /// Stores the internal fullscreen scale mode state used by <see cref="ChatGameConsole"/> while executing its surrounding workflow.
    /// </summary>
    private string fullscreenScaleMode = "Fit";
    /// <summary>
    /// Gets a value indicating whether show control guide applies to the chat game console state.
    /// </summary>
    /// <value>The show control guide value exposed by <see cref="ChatGameConsole"/>.</value>
    private bool ShowControlGuide => snapshot is { ControlMode: not CouncilGameControlMode.Ai } && showControls;
    /// <summary>
    /// Gets a value indicating whether submit human control applies to the chat game console state.
    /// </summary>
    /// <value>The can submit human control value exposed by <see cref="ChatGameConsole"/>.</value>
    private bool CanSubmitHumanControl => snapshot is { HumanInputRequired: true, ControlMode: not CouncilGameControlMode.Ai } && !inputInFlight;
    /// <summary>
    /// Gets the input busy state value that forms part of the chat game console state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The input busy state value exposed by <see cref="ChatGameConsole"/>.</value>
    private string InputBusyState => inputInFlight ? "true" : "false";
    /// <summary>
    /// Gets the console text value that forms part of the chat game console state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The console text value exposed by <see cref="ChatGameConsole"/>.</value>
    private string ConsoleText => Console.GetRecentDisplayText(160);

    /// <summary>
    /// Handles the initialized async lifecycle or event notification for <see cref="ChatGameConsole"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnInitializedAsync()
    {
        Games.Changed += OnGameChanged;
        Console.Changed += OnConsoleChanged;
        consoleOutput = Console.GetRecentOutput(160);
        snapshot = await Games.GetActiveAsync(ConversationId).ConfigureAwait(false);
    }

    /// <summary>
    /// Handles the parameters set async lifecycle or event notification for <see cref="ChatGameConsole"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnParametersSetAsync()
    {
        if (snapshot is null || (ConversationId is not null && snapshot.ConversationId != ConversationId))
            snapshot = await Games.GetActiveAsync(ConversationId).ConfigureAwait(false);
    }

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="ChatGameConsole"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!attached)
        {
            reference ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("localGptGameConsole.attach", elementId, reference).ConfigureAwait(true) /* renderer-affine lifecycle continuation */;
            attached = true;
        }
        var inputEnabled = CanSubmitHumanControl;
        await JS.InvokeVoidAsync("localGptGameConsole.setEnabled", elementId, inputEnabled).ConfigureAwait(true) /* renderer-affine lifecycle continuation */;
        await JS.InvokeVoidAsync("localGptGameConsole.setScaleMode", elementId, fullscreenScaleMode).ConfigureAwait(true) /* renderer-affine lifecycle continuation */;
    }

    /// <summary>
    /// Starts doom for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task StartDoomAsync() => await StartAsync("ascii-doom", "ascii-doom-council-adventure").ConfigureAwait(false);
    /// <summary>
    /// Starts dragon for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task StartDragonAsync() => await StartAsync("green-dragon", "green-dragon-runtime-story").ConfigureAwait(false);

    /// <summary>
    /// Performs start for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <param name="gameKey">Game key value supplied to the chat game console operation and used when producing its result.</param>
    /// <param name="teamKey">Team key value supplied to the chat game console operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task StartAsync(string gameKey, string teamKey)
    {
        try
        {
            snapshot = await Games.StartAsync(new StartCouncilGameRequest
            {
                GameKey = gameKey,
                TeamKey = string.IsNullOrWhiteSpace(SuggestedTeamKey) ? teamKey : SuggestedTeamKey,
                ConversationId = ConversationId,
                ControlMode = CouncilGameControlMode.Human,
                StartedBy = "Human User"
            }).ConfigureAwait(false);
            showControls = true;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not start the in-chat game console.");
        }
    }

    /// <summary>
    /// Performs change control mode for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the chat game console operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ChangeControlModeAsync(ChangeEventArgs args)
    {
        if (snapshot is null) return;
        if (!Enum.TryParse<CouncilGameControlMode>(args.Value?.ToString(), true, out var mode)) return;
        snapshot = await Games.SetControlModeAsync(
            snapshot.Id,
            mode,
            mode is CouncilGameControlMode.Ai or CouncilGameControlMode.Shared,
            snapshot.AutoplayDelayMilliseconds).ConfigureAwait(false);
    }

    /// <summary>
    /// Performs change autoplay delay for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the chat game console operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ChangeAutoplayDelayAsync(ChangeEventArgs args)
    {
        if (snapshot is null || !int.TryParse(args.Value?.ToString(), out var delay)) return;
        snapshot = await Games.SetControlModeAsync(
            snapshot.Id,
            snapshot.ControlMode,
            snapshot.ControlMode is CouncilGameControlMode.Ai or CouncilGameControlMode.Shared,
            delay).ConfigureAwait(false);
    }

    /// <summary>
    /// Performs toggle controls for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    private void ToggleControls() => showControls = !showControls;

    /// <summary>
    /// Performs change fullscreen scale mode for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <param name="args">Args value supplied to the chat game console operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ChangeFullscreenScaleModeAsync(ChangeEventArgs args)
    {
        var requestedMode = args.Value?.ToString();
        fullscreenScaleMode = string.Equals(requestedMode, "Native", StringComparison.OrdinalIgnoreCase)
            ? "Native"
            : string.Equals(requestedMode, "Width", StringComparison.OrdinalIgnoreCase) ? "Width" : "Fit";
        await JS.InvokeVoidAsync("localGptGameConsole.setScaleMode", elementId, fullscreenScaleMode).ConfigureAwait(false);
    }

    /// <summary>
    /// Performs fullscreen for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task FullscreenAsync() =>
        await JS.InvokeVoidAsync("localGptGameConsole.fullscreen", elementId).ConfigureAwait(false);

    /// <summary>
    /// Performs close for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task CloseAsync()
    {
        await JS.InvokeVoidAsync("localGptGameConsole.exitFullscreen", elementId).ConfigureAwait(false);
        if (CloseRequested.HasDelegate)
            await CloseRequested.InvokeAsync().ConfigureAwait(false);
    }

    /// <summary>
    /// Performs submit control from JavaScript for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <param name="action">Action value supplied to the chat game console operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task SubmitControlFromJs(string action) => SendControlAsync(action);

    /// <summary>
    /// Performs send control for <see cref="ChatGameConsole"/>, keeping the operation consistent with the state and invariants of the surrounding chat game console workflow.
    /// </summary>
    /// <param name="action">Action value supplied to the chat game console operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SendControlAsync(string action)
    {
        if (snapshot is null || !CanSubmitHumanControl) return;
        var sessionId = snapshot.Id;
        var expectedTurn = snapshot.Turn;
        inputInFlight = true;
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        try
        {
            snapshot = await Games.ApplyControlAsync(new CouncilGameControlRequest
            {
                SessionId = sessionId,
                Action = action,
                ExpectedTurn = expectedTurn,
                Source = "HumanUI",
                ActorName = "Human Player"
            }).ConfigureAwait(false);
            await Task.Delay(260).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The in-chat game control {Action} was rejected.", action);
            snapshot = await Games.GetAsync(sessionId).ConfigureAwait(false);
        }
        finally
        {
            inputInFlight = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Handles the game changed lifecycle or event notification for <see cref="ChatGameConsole"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="sessionId">Identifier of the session to use for this operation.</param>
    private void OnGameChanged(Guid sessionId)
    {
        if (snapshot is not null && snapshot.Id != sessionId) return;
        _ = InvokeAsync(async () =>
        {
            snapshot = await Games.GetAsync(sessionId).ConfigureAwait(false);
            StateHasChanged();
        });
    }

    /// <summary>
    /// Handles the console changed lifecycle or event notification for <see cref="ChatGameConsole"/>, updating the state required by the surrounding workflow.
    /// </summary>
    private void OnConsoleChanged()
    {
        _ = InvokeAsync(() =>
        {
            consoleOutput = Console.GetRecentOutput(160);
            StateHasChanged();
        });
    }

    /// <summary>
    /// Releases resources owned by <see cref="ChatGameConsole"/> and leaves the chat game console workflow in a safely disposed state.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    public async ValueTask DisposeAsync()
    {
        Games.Changed -= OnGameChanged;
        Console.Changed -= OnConsoleChanged;
        try
        {
            if (attached) await JS.InvokeVoidAsync("localGptGameConsole.detach", elementId).ConfigureAwait(false);
        }
        catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
