@using LocalGPT.BusinessObjects
@using DevExpress.AIIntegration.Blazor.Chat
@using Microsoft.JSInterop
@inject ICouncilGameSessionService Games
@inject IGameProjectService GameProjects
@inject IHumanCollaborationService HumanCollaboration
@inject IDeferredDxAiInvocationService DeferredDxInvocations
@inject ISupervisedTaskRunner TaskRunner
@inject ILocalHumanInteractionContext HumanAmbientContext
@inject IConsoleCommandService Console
@inject IConsoleOperatorService Operator
@inject AsciiChatTextService AsciiText
@inject CouncilTextService CouncilText
@inject ILocalGptVocabularyService Vocabulary
@inject IJSRuntime JS
@inject ILogger<ChatGameConsole> Logger
@implements IAsyncDisposable

@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner ChatGameConsole">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
<DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext002">
        <div id="@elementId"
         class="chat-game-console @(operatorMode ? "chat-game-console-operator" : conversationMode ? "chat-game-console-conversation" : snapshot is null ? "chat-game-console-empty" : "chat-game-console-active")"
         tabindex="0"
         data-localgpt-game-console
         data-localgpt-copyable="true"
         data-scale-mode="@fullscreenScaleMode.ToLowerInvariant()"
         data-display-mode="@gameDisplayMode.ToLowerInvariant()"
         aria-label="Persistent LocalGPT ASCII chat, game and operator console">
    <header class="chat-game-console-header">
        <div>
            <strong>@AsciiSurfaceTitle</strong>
            <small>@AsciiSurfaceSubtitle</small>
        </div>
        <div class="chat-game-console-actions">
            <DxButton Text="Chat"
                      CssClass="@("ascii-console-button ascii-operator-toggle" + (!operatorMode && conversationMode ? " is-active" : string.Empty))"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="ShowConversationModeAsync" />
            @if (snapshot is not null)
            {
                <DxButton Text="Game"
                          CssClass="@("ascii-console-button ascii-operator-toggle" + (!operatorMode && !conversationMode ? " is-active" : string.Empty))"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Click="ShowGameModeAsync" />
            }
            <DxButton Text="@(operatorMode ? "Operator OFF" : "Operator")"
                      CssClass="@("ascii-console-button ascii-operator-toggle" + (operatorMode ? " is-active" : string.Empty))"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="ToggleOperatorModeAsync" />
            <label>
                <span>Fullscreen scale</span>
                <DxComboBox Data="@FullscreenScaleOptions"
                            Value="@SelectedFullscreenScaleOption"
                            TextFieldName="Label"
                            ValueChanged="@((AsciiSelectOption<string> option) => ChangeFullscreenScaleModeAsync(option))"
                            CssClass="ascii-console-combo" />
            </label>
            <DxButton Text="Fullscreen" CssClass="ascii-console-button chat-game-fullscreen-toggle" RenderStyle="ButtonRenderStyle.Secondary" Click="FullscreenAsync" />
            @if (!operatorMode && snapshot is null)
            {
                <DxButton Text="Play ASCII corridor" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Secondary" Click="StartDoomAsync" />
                <DxButton Text="Play Green Dragon story" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Secondary" Click="StartDragonAsync" />
            }
            else if (!operatorMode && !conversationMode && snapshot is not null)
            {
                <label>
                    <span>Display</span>
                    <DxComboBox Data="@GameDisplayOptions"
                                Value="@SelectedGameDisplayOption"
                                TextFieldName="Label"
                                ValueChanged="@((AsciiSelectOption<string> option) => ChangeGameDisplayModeAsync(option))"
                                CssClass="ascii-console-combo" />
                </label>
                @if (IsCouncilHotSeatGame)
                {
                    <span class="chat-game-runtime-badge" title="This presentation is controlled by the Council workflow; the human role is played directly in the game surface.">
                        Council hot-seat
                    </span>
                }
                else
                {
                    <label>
                        <span>Control</span>
                        <DxComboBox Data="@ControlModeOptions"
                                    Value="@SelectedControlModeOption"
                                    TextFieldName="Label"
                                    ValueChanged="@((AsciiSelectOption<CouncilGameControlMode> option) => ChangeControlModeAsync(option))"
                                    CssClass="ascii-console-combo" />
                    </label>
                    @if (snapshot.ControlMode == CouncilGameControlMode.Ai)
                    {
                        <label>
                            <span>AI step</span>
                            <DxComboBox Data="@AutoplayDelayOptions"
                                        Value="@SelectedAutoplayDelayOption"
                                        TextFieldName="Label"
                                        ValueChanged="@((AsciiSelectOption<int> option) => ChangeAutoplayDelayAsync(option))"
                                        CssClass="ascii-console-combo" />
                        </label>
                    }
                }
                @if (CanShowControlGuide)
                {
                    <DxButton Text="@(showControls ? "Hide guide" : "Show guide")" CssClass="ascii-console-button chat-game-guide-toggle" RenderStyle="ButtonRenderStyle.Secondary" Click="ToggleControls" />
                }
                @if (string.Equals(snapshot.Status, "Running", StringComparison.OrdinalIgnoreCase))
                {
                    <DxButton Text="End game" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Danger" Click="EndGameAsync" />
                }
                else if (CanRestartCorridor)
                {
                    <DxButton Text="Restart same map" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Secondary" Click="RestartSameMapAsync" />
                    <DxButton Text="New map" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Secondary" Click="StartFreshMapAsync" />
                }
            }
            @if (!operatorMode)
            {
                <div class="chat-game-revision-picker @(showRevisionPicker ? "is-open" : string.Empty)" aria-label="Play an approved Game Studio revision">
                    <DxButton Text="@(playableRevisions.Count > 0 ? $"Games ({playableRevisions.Count})" : "Games (0)")"
                              RenderStyle="ButtonRenderStyle.Secondary" Click="ToggleRevisionPicker" />
                    @if (showRevisionPicker)
                    {
                        @if (playableRevisions.Count > 0)
                        {
                            <DxListBox Data="@playableRevisions" Value="@selectedPlayableRevision"
                                       ValueExpression="@(() => selectedPlayableRevision)"
                                       TextFieldName="@nameof(ProjectGameRevisionChoice.DisplayName)"
                                       ValueChanged="@((ProjectGameRevisionChoice choice) => SelectPlayableRevision(choice))"
                                       Height="110px" />
                        }
                        <div class="chat-game-revision-actions">
                            @if (playableRevisions.Count > 0)
                            {
                                <DxButton Text="Play revision" RenderStyle="ButtonRenderStyle.Primary"
                                          Enabled="@(!revisionsLoading && selectedPlayableRevision is not null)"
                                          Click="StartSelectedRevisionAsync" />
                            }
                            <DxButton Text="Refresh" RenderStyle="ButtonRenderStyle.Secondary"
                                      Enabled="@(!revisionsLoading)" Click="RefreshPlayableRevisionsAsync" />
                        </div>
                        @if (revisionsStatus is not "")
                        {
                            <small role="status">@revisionsStatus</small>
                        }
                    }
                </div>
            }
            <DxButton Text="× Close"
                      CssClass="ascii-console-button chat-game-console-close"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="CloseAsync" />
        </div>
    </header>

    @if (operatorMode)
    {
        <div class="ascii-operator-stage" aria-busy="@OperatorBusyState">
            <div class="ascii-operator-output" role="log" aria-live="polite">
                <pre class="chat-game-screen">@OperatorConsoleText</pre>
            </div>
            <form class="ascii-operator-command-row" @onsubmit="SubmitOperatorLineAsync" @onsubmit:preventDefault="true">
                <span class="ascii-operator-prompt" aria-hidden="true">λ</span>
                <label class="visually-hidden">Operator shell</label>
                <DxComboBox Data="@availableShells"
                            Value="@operatorShell"
                            ValueFieldName="@nameof(LocalConsoleShellDescriptor.Shell)"
                            TextFieldName="DisplayName"
                            ValueChanged="@((LocalConsoleShellKind shell) => ChangeOperatorShell(shell))"
                            ReadOnly="@operatorSubmitting"
                            CssClass="ascii-operator-shell" />
                <label class="visually-hidden">ASCII operator command</label>
                <DxTextBox @bind-Text="operatorInput"
                           BindValueMode="BindValueMode.OnInput"
                           Enabled="@(!operatorSubmitting)"
                           NullText=":help, :chat, :council, :session, :game, :mode or a shell command"
                           CssClass="ascii-operator-input" />
                <DxButton Text="@(operatorSubmitting ? "QUEUING…" : "RUN")"
                          CssClass="ascii-console-button ascii-operator-submit"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Enabled="@(!operatorSubmitting)"
                          SubmitFormOnClick="true" />
            </form>
            <div class="ascii-operator-status" role="status">
                <span>@operatorStatus</span>
                <span>@ActiveJobText</span>
            </div>
        </div>
    }
    else if (conversationMode)
    {
        <div class="ascii-conversation-stage">
            @if (HasGameInteractionRequest)
            {
                <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext003">
        <div class="chat-game-control-card chat-game-hotseat-card chat-game-ai-request-card ascii-conversation-request" aria-label="AI request awaiting review">
                    <div class="chat-game-hotseat-heading">
                        <strong>@gameInteractionRequest!.Title</strong>
                        <span>@gameInteractionRequest.RequestedRole · @gameInteractionRequest.RequestedBy</span>
                    </div>
                    <div class="chat-game-control-status" role="status">
                        <span>@(string.IsNullOrWhiteSpace(gameInteractionRequest.ResponsePrompt) ? gameInteractionRequest.Description : gameInteractionRequest.ResponsePrompt)</span>
                    </div>
                    @if (IsApprovalGameInteraction)
                    {
                        <div class="chat-game-hotseat-dash" aria-label="AI request decision">
                            <DxButton Text="APPROVE" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Success" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(true, gameInteractionText, string.Empty))' />
                            <DxButton Text="DECLINE" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Danger" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(false, gameInteractionText, gameInteractionText))' />
                        </div>
                    }
                    @if (gameInteractionRequest.SuggestedResponses.Count > 0)
                    {
                        <div class="chat-game-ai-request-options" aria-label="Suggested responses">
                            @foreach (var suggestion in gameInteractionRequest.SuggestedResponses)
                            {
                                <DxButton Text="@suggestion" CssClass="ascii-console-button" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(null, suggestion, string.Empty))' />
                            }
                        </div>
                    }
                    @if (gameInteractionRequest.AllowFreeText || !IsApprovalGameInteraction)
                    {
                        <form class="chat-game-hotseat-text" @onsubmit="SubmitGameInteractionTextAsync" @onsubmit:preventDefault="true">
                            <label>@(IsApprovalGameInteraction ? "Decision note / decline reason" : "Your answer")</label>
                            <div>
                                <DxTextBox @bind-Text="gameInteractionText" BindValueMode="BindValueMode.OnInput" MaxLength="2000" NullText="Respond without leaving ASCII mode" Enabled="@(!gameInteractionSubmitting)" CssClass="ascii-game-interaction-input" />
                                @if (!IsApprovalGameInteraction)
                                {
                                    <DxButton Text="SEND" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!gameInteractionSubmitting && !string.IsNullOrWhiteSpace(gameInteractionText))" SubmitFormOnClick="true" />
                                }
                            </div>
                        </form>
                    }
                    <small>This function/review request belongs to the active Council session and remains usable in ASCII Chat mode even when no game is running.</small>
                </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
            }
            @if (asciiSequenceFrames.Count > 1)
            {
                <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext004">
        <div class="ascii-sequence-player" aria-label="ASCII animation from the latest chat message">
                    <header>
                        <strong>ASCII SEQUENCE</strong>
                        <small>@asciiSequenceFrames.Count frames · pauses with the page/window</small>
                    </header>
                    <pre class="chat-game-screen ascii-sequence-screen" data-ascii-sequence-screen>@asciiSequenceFrames[0]</pre>
                </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
            }
            <div class="ascii-conversation-output" role="log" aria-live="polite" aria-label="ASCII rendering of the current chat conversation">
                <pre class="chat-game-screen">@asciiConversationText</pre>
            </div>
            <footer class="ascii-conversation-footer">
                <span>Shared /chat history · replayable when switching views</span>
                <span>@(FunModeEnabled ? "Contextual ASCII fun: ON" : "Contextual ASCII fun: OFF")</span>
            </footer>
        </div>
    }
    else if (snapshot is null)
    {
        @if (HasGameInteractionRequest)
        {
            <div class="chat-game-stage screen-only council-work-surface">
                <div class="chat-game-screen-viewport council-work-screen">
                    <pre class="chat-game-screen">┌──────────────────────────────────────────────────────────────────────────────┐
│  COUNCIL WORK CONTROL                                                       │
│  No deterministic game is required for this AI review/function request.     │
│  Use the same durable Chat approval below; completed work returns to Chat.   │
└───────────────────────────────────────────────────────────────────────────────┘</pre>
                    <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext005">
        <div class="chat-game-control-card chat-game-hotseat-card chat-game-ai-request-card council-work-request" aria-label="Non-game Council request awaiting review">
                        <div class="chat-game-hotseat-heading">
                            <strong>@gameInteractionRequest!.Title</strong>
                            <span>@gameInteractionRequest.RequestedRole · @gameInteractionRequest.RequestedBy</span>
                        </div>
                        <div class="chat-game-control-status" role="status">
                            <span>@(string.IsNullOrWhiteSpace(gameInteractionRequest.ResponsePrompt) ? gameInteractionRequest.Description : gameInteractionRequest.ResponsePrompt)</span>
                        </div>
                        @if (IsApprovalGameInteraction)
                        {
                            <div class="chat-game-hotseat-dash" aria-label="AI request decision">
                                <DxButton Text="APPROVE" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Success" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(true, gameInteractionText, string.Empty))' />
                                <DxButton Text="DECLINE" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Danger" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(false, gameInteractionText, gameInteractionText))' />
                            </div>
                        }
                        @if (gameInteractionRequest.SuggestedResponses.Count > 0)
                        {
                            <div class="chat-game-ai-request-options" aria-label="Suggested responses">
                                @foreach (var suggestion in gameInteractionRequest.SuggestedResponses)
                                {
                                    <DxButton Text="@suggestion" CssClass="ascii-console-button" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(null, suggestion, string.Empty))' />
                                }
                            </div>
                        }
                        @if (gameInteractionRequest.AllowFreeText || !IsApprovalGameInteraction)
                        {
                            <form class="chat-game-hotseat-text" @onsubmit="SubmitGameInteractionTextAsync" @onsubmit:preventDefault="true">
                                <label>@(IsApprovalGameInteraction ? "Decision note / decline reason" : "Your answer")</label>
                                <div>
                                    <DxTextBox @bind-Text="gameInteractionText" BindValueMode="BindValueMode.OnInput" MaxLength="2000" NullText="Respond to the Council work request" Enabled="@(!gameInteractionSubmitting)" CssClass="ascii-game-interaction-input" />
                                    @if (!IsApprovalGameInteraction)
                                    {
                                        <DxButton Text="SEND" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!gameInteractionSubmitting && !string.IsNullOrWhiteSpace(gameInteractionText))" SubmitFormOnClick="true" />
                                    }
                                </div>
                            </form>
                        }
                        <small>Game controls are reused as a bounded non-game work console; this does not create or mutate a game session.</small>
                    </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
                </div>
            </div>
        }
        else
        {
            <div class="chat-game-console-placeholder">
                <pre>┌──────────────────────────────────────────────────────────────────────────────┐
│  No ASCII game or pending Council work request is running.                   │
│  CHAT returns to the mirrored conversation.                                  │
│  Start a built-in game or let a Council/function request create work.        │
└───────────────────────────────────────────────────────────────────────────────┘</pre>
            </div>
        }
    }
    else
    {
        <div class="chat-game-stage @(ShowControlGuide ? "has-guide" : "screen-only") @(IsKernelTournament ? "kernel-tournament-stage" : string.Empty)">
            <div class="chat-game-screen-viewport">
                @if (!string.IsNullOrWhiteSpace(GamePreparationStatus))
                {
                    <div class="chat-game-live-status" role="status" aria-live="polite">@GamePreparationStatus</div>
                }
                <pre class="chat-game-screen" data-game-animation-screen aria-live="polite">@snapshot.FrameText</pre>
                <canvas id="@($"{elementId}-scene-pixel")" class="chat-game-pixel-screen" data-game-pixel-screen aria-label="Pixel rendering of the current deterministic game frame" hidden></canvas>
                <div class="chat-game-animation-subtitle" data-game-animation-subtitle aria-live="polite" hidden>@snapshot.AnimationSubtitle</div>
            </div>
            @if (ShowControlGuide)
            {
                <aside class="chat-game-control-guide" role="group" aria-label="Your game controls" aria-busy="@InputBusyState">
                    @if (HasHotSeatRequest)
                    {
                        <div class="chat-game-control-card chat-game-hotseat-card">
                            <div class="chat-game-hotseat-heading">
                                <strong>@hotSeatRequest!.RequestedRole</strong>
                                <span>Round @hotSeatRequest.RequestedCouncilRound · @hotSeatRequest.RequestedCouncilPhase</span>
                            </div>
                            <div class="chat-game-control-status" role="status">
                                <span>@(string.IsNullOrWhiteSpace(hotSeatRequest.ResponsePrompt) ? hotSeatRequest.Description : hotSeatRequest.ResponsePrompt)</span>
                            </div>
                            <div class="chat-game-hotseat-grid" aria-label="Council hot-seat movement">
                                <DxButton Text="MOVE N" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("MOVE N"))' />
                                <DxButton Text="MOVE W" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("MOVE W"))' />
                                <DxButton Text="PASS" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("PASS"))' />
                                <DxButton Text="MOVE E" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("MOVE E"))' />
                                <DxButton Text="MOVE S" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("MOVE S"))' />
                            </div>
                            <div class="chat-game-hotseat-dash" aria-label="Council hot-seat dash moves">
                                <DxButton Text="DASH N" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("DASH N"))' />
                                <DxButton Text="DASH W" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("DASH W"))' />
                                <DxButton Text="DASH S" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("DASH S"))' />
                                <DxButton Text="DASH E" CssClass="ascii-console-button" Enabled="@CanSubmitHumanControl" Click='@(() => SubmitHotSeatResponseAsync("DASH E"))' />
                            </div>
                            <form class="chat-game-hotseat-text" @onsubmit="SubmitHotSeatTextAsync" @onsubmit:preventDefault="true">
                                <label>Short emote / role text</label>
                                <div>
                                    <DxTextBox @bind-Text="hotSeatText" BindValueMode="BindValueMode.OnInput" MaxLength="80" NullText="Optional short emote" Enabled="@(!hotSeatSubmitting)" CssClass="ascii-hotseat-input" />
                                    <DxButton Text="EMOTE" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!hotSeatSubmitting && !string.IsNullOrWhiteSpace(hotSeatText))" SubmitFormOnClick="true" />
                                </div>
                            </form>
                            <small>Play here: W/A/S/D map to MOVE N/W/S/E; the active Council seat stays on this ASCII surface.</small>
                        </div>
                    }
                    @if (HasGameInteractionRequest)
                    {
                        <div class="chat-game-control-card chat-game-hotseat-card chat-game-ai-request-card">
                            <div class="chat-game-hotseat-heading">
                                <strong>@gameInteractionRequest!.Title</strong>
                                <span>@gameInteractionRequest.RequestedRole · @gameInteractionRequest.RequestedBy</span>
                            </div>
                            <div class="chat-game-control-status" role="status">
                                <span>@(string.IsNullOrWhiteSpace(gameInteractionRequest.ResponsePrompt) ? gameInteractionRequest.Description : gameInteractionRequest.ResponsePrompt)</span>
                            </div>
                            @if (IsApprovalGameInteraction)
                            {
                                <div class="chat-game-hotseat-dash" aria-label="AI request decision">
                                    <DxButton Text="APPROVE" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Success" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(true, gameInteractionText, string.Empty))' />
                                    <DxButton Text="DECLINE" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Danger" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(false, gameInteractionText, gameInteractionText))' />
                                </div>
                            }
                            else if (gameInteractionRequest.SuggestedResponses.Count > 0)
                            {
                                <div class="chat-game-ai-request-options" aria-label="Suggested responses">
                                    @foreach (var suggestion in gameInteractionRequest.SuggestedResponses)
                                    {
                                        <DxButton Text="@suggestion" CssClass="ascii-console-button" Enabled="@(!gameInteractionSubmitting)" Click='@(() => SubmitGameInteractionAsync(null, suggestion, string.Empty))' />
                                    }
                                </div>
                            }
                            @if (gameInteractionRequest.AllowFreeText || !IsApprovalGameInteraction)
                            {
                                <form class="chat-game-hotseat-text" @onsubmit="SubmitGameInteractionTextAsync" @onsubmit:preventDefault="true">
                                    <label>@(IsApprovalGameInteraction ? "Decision note / decline reason" : "Your answer")</label>
                                    <div>
                                        <DxTextBox @bind-Text="gameInteractionText" BindValueMode="BindValueMode.OnInput" MaxLength="2000" NullText="Respond without leaving ASCII mode" Enabled="@(!gameInteractionSubmitting)" CssClass="ascii-game-interaction-input" />
                                        @if (!IsApprovalGameInteraction)
                                        {
                                            <DxButton Text="SEND" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!gameInteractionSubmitting && !string.IsNullOrWhiteSpace(gameInteractionText))" SubmitFormOnClick="true" />
                                        }
                                    </div>
                                </form>
                            }
                            <small>This Council/AI request is projected into the active game so play does not need to leave ASCII mode.</small>
                        </div>
                    }
                    @if (!HasHotSeatRequest && !HasGameInteractionRequest && CanRestartCorridor)
                    {
                        <div class="chat-game-control-card chat-game-restart-card">
                            <strong>Mission complete</strong>
                            <span>Keep this chat and start another deterministic ASCII run.</span>
                            <div class="chat-game-restart-actions">
                                <DxButton Text="Restart same map" CssClass="ascii-console-button" Click="RestartSameMapAsync" />
                                <DxButton Text="New map" CssClass="ascii-console-button" Click="StartFreshMapAsync" />
                            </div>
                            <form class="chat-game-scenario-row" @onsubmit="StartScenarioAsync" @onsubmit:preventDefault="true">
                                <label>New ASCII scenario</label>
                                <DxMemo @bind-Text="scenarioPrompt" BindValueMode="BindValueMode.OnInput" MaxLength="240" Rows="3" NullText="Example: abandoned moon relay, icy refinery, neon sewer…" CssClass="ascii-scenario-input" />
                                <DxButton Text="Start scenario" CssClass="ascii-console-button" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!string.IsNullOrWhiteSpace(scenarioPrompt))" SubmitFormOnClick="true" />
                            </form>
                        </div>
                    }
                    else if (!HasHotSeatRequest && !HasGameInteractionRequest && !CanRestartCorridor)
                    {
                        <div class="chat-game-control-card">
                            <strong>Your turn</strong>
                            <div class="chat-game-control-status">
                                @if (inputInFlight)
                                {
                                    <span role="status">Applying move…</span>
                                }
                                else if (snapshot.HumanInputRequired)
                                {
                                    <span>@snapshot.InputReason</span>
                                }
                                else
                                {
                                    <span role="status">Waiting for your next turn…</span>
                                }
                            </div>
                            <div class="chat-game-touch-grid">
                                <DxButton CssClass="up" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="move-forward" data-semantic-action="move-forward" Click='@(() => SendControlAsync("move-forward"))'>▲</DxButton>
                                <DxButton CssClass="left" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="left" data-semantic-action='@(snapshot.GameKey == "green-dragon" ? "turn-left" : "strafe-left")' Click='@(() => SendControlAsync(snapshot.GameKey == "green-dragon" ? "turn-left" : "strafe-left"))'>◀</DxButton>
                                <DxButton CssClass="down" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="move-backward" data-semantic-action="move-backward" Click='@(() => SendControlAsync("move-backward"))'>▼</DxButton>
                                <DxButton CssClass="right" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="right" data-semantic-action='@(snapshot.GameKey == "green-dragon" ? "turn-right" : "strafe-right")' Click='@(() => SendControlAsync(snapshot.GameKey == "green-dragon" ? "turn-right" : "strafe-right"))'>▶</DxButton>
                                <DxButton aria-disabled="@(!CanSubmitHumanControl)" data-game-action="turn-left" data-semantic-action="turn-left" Click='@(() => SendControlAsync("turn-left"))'>Aim ◁</DxButton>
                                <DxButton aria-disabled="@(!CanSubmitHumanControl)" data-game-action="turn-right" data-semantic-action="turn-right" Click='@(() => SendControlAsync("turn-right"))'>Aim ▷</DxButton>
                                @if (snapshot.GameKey == "ascii-doom")
                                {
                                    <DxButton CssClass="primary" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="shoot" data-semantic-action="shoot" Click='@(() => SendControlAsync("shoot"))'>Shoot</DxButton>
                                    <DxButton aria-disabled="@(!CanSubmitHumanControl)" data-game-action="duck" data-semantic-action="duck" Click='@(() => SendControlAsync("duck"))'>Duck</DxButton>
                                }
                                <DxButton CssClass="primary" aria-disabled="@(!CanSubmitHumanControl)" data-game-action="use" data-semantic-action="use" Click='@(() => SendControlAsync("use"))'>Use</DxButton>
                            </div>
                            <small>Mouse/touch, keyboard, connected gamepads and approved AI/team calls share these semantic actions. Controller polling only runs while this game surface can accept input.</small>
                        </div>
                    }
                </aside>
            }
        </div>
        <footer class="chat-game-console-footer">
            <span>@snapshot.FrameCaption</span>
            <span>Renderer: @snapshot.FrameRenderer</span>
        </footer>
    }
</div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>


