@using Microsoft.JSInterop
@using LocalGPT.BusinessObjects
@using LocalGPT.Interfaces
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILocalAiRuntimeService Runtime
@inject ILogger<ChatMicrophone> Logger
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization

<div @ref="element" class="chat-microphone" aria-busy="@busy">
    <DxComboBox Data="@models" TextFieldName="ModelId" ValueFieldName="InstallationId" @bind-Value="installationId"
                Enabled="@(!recording && !busy)" NullText="@T("Chat.Microphone.Model", "Whisper model")" />
    <DxButton Text="@(recording ? T("Chat.Microphone.Stop", "Stop and start Council") : T("Chat.Microphone.Start", "Microphone"))"
              IconCssClass="oi oi-microphone" Enabled="@(!busy && !Disabled)" Click="ToggleAsync" />
    @if (recording || busy)
    {
        <DxButton Text="@T("Chat.Microphone.Cancel", "Cancel recording")" Click="CancelAsync" />
    }
    @if (models.Count == 0)
    {
        <DxButton Text="@T("Chat.Microphone.Setup", "Ask Council to set up Whisper")" Enabled="@(!busy && !Disabled)" Click="RequestSetupAsync" />
    }
    <span role="status" aria-live="polite">@status</span>
</div>

@code {
    /// <summary>Gets or sets the callback that receives a completed Whisper transcript.</summary>
    /// <value>A callback invoked only after a nonempty transcription succeeds.</value>
    [Parameter] public EventCallback<string> Transcribed { get; set; }
    /// <summary>Gets or sets the callback that requests the preseeded Whisper setup Council.</summary>
    /// <value>A callback invoked when no supported Whisper installation is available.</value>
    [Parameter] public EventCallback SetupRequested { get; set; }
    /// <summary>Gets or sets whether microphone actions are disabled while another live Council interaction owns the chat flow.</summary>
    /// <value><see langword="true"/> when recording/setup actions must be unavailable; otherwise <see langword="false"/>.</value>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>References the component root used by the JavaScript lifetime observer.</summary>
    private ElementReference element;
    /// <summary>Stores the lazily imported microphone JavaScript module for component-owned browser capture.</summary>
    private IJSObjectReference? module;
    /// <summary>Stores the component-owned JavaScript capture object across one recording session.</summary>
    private IJSObjectReference? capture;
    /// <summary>Keeps the .NET callback target alive while the JavaScript capture object exists.</summary>
    private DotNetObjectReference<ChatMicrophone>? reference;
    /// <summary>Cancels component-owned operations when the component is disposed.</summary>
    private CancellationTokenSource lifetime = new();
    /// <summary>Cancels only the active transcription without ending the component lifetime.</summary>
    private CancellationTokenSource? transcription;
    /// <summary>Contains currently installed OpenAI Whisper speech-recognition models.</summary>
    private IReadOnlyList<LocalAiModelInstallation> models = [];
    /// <summary>Stores the selected Whisper model installation identifier used for server-side transcription.</summary>
    private string installationId = string.Empty;
    /// <summary>Stores operator-visible recording/transcription status without transcript content.</summary>
    private string status = string.Empty;
    /// <summary>Tracks recording, server work and component disposal state.</summary>
    private bool recording, busy, disposed;

    /// <summary>Resolves one localized microphone label for the component using a stable fallback.</summary>
    /// <param name="key">Localization key to resolve.</param>
    /// <param name="fallback">Fallback text used when no localized value is available.</param>
    /// <returns>The localized or fallback text.</returns>
    private string T(string key, string fallback) => Localization.Get(key, fallback: fallback);

    /// <summary>Loads installed Whisper models into component state when the component initializes.</summary>
    protected override void OnInitialized()
    {
        try { RefreshModels(); }
        catch (Exception exception) { Fail(exception); }
    }

    /// <summary>Refreshes the selectable model list from installed speech-recognition capabilities.</summary>
    private void RefreshModels()
    {
        models = Runtime.GetInstalledModels().Where(model => model.Capabilities.Contains(LocalAiCapability.SpeechRecognition)
            && string.Equals(model.Adapter, "openai-whisper", StringComparison.OrdinalIgnoreCase)).ToList();
        if (!models.Any(model => model.InstallationId == installationId)) installationId = models.FirstOrDefault()?.InstallationId ?? string.Empty;
    }

    /// <summary>Starts microphone capture or stops the current capture and submits it for transcription.</summary>
    /// <returns>A task representing the asynchronous browser capture transition.</returns>
    private async Task ToggleAsync()
    {
        if (busy || disposed) return;
        try
        {
            if (recording) { await capture!.InvokeVoidAsync("stop").ConfigureAwait(false); return; }
            RefreshModels();
            if (string.IsNullOrWhiteSpace(installationId))
            {
                status = T("Chat.Microphone.Missing", "Install a Whisper model with Council or on the Install page first.");
                return;
            }
            busy = true;
            var policy = await Runtime.GetRuntimeConfigurationAsync(lifetime.Token).ConfigureAwait(false);
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", lifetime.Token, "./js/localgpt-microphone.js?v=4.9.0").ConfigureAwait(false);
            reference ??= DotNetObjectReference.Create(this);
            capture ??= await module.InvokeAsync<IJSObjectReference>("create", lifetime.Token, reference, element).ConfigureAwait(false);
            await capture.InvokeVoidAsync("start", lifetime.Token, policy.MaximumAudioSeconds).ConfigureAwait(false);
            recording = true;
            status = T("Chat.Microphone.Recording", "Recording. Stop to transcribe and start Council with your current settings.");
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { Logger.LogDebug("Microphone circuit disconnected."); }
        catch (Exception exception) { Fail(exception); }
        finally { busy = false; }
    }

    /// <summary>Receives one bounded WAV stream from the browser, transcribes it and forwards the resulting text to Chat.</summary>
    /// <param name="audio">Browser-provided WAV stream reference.</param>
    /// <param name="length">Declared WAV byte length.</param>
    /// <returns>A task representing transcription and callback delivery.</returns>
    [JSInvokable]
    public async Task RecordingReady(IJSStreamReference audio, long length)
    {
        recording = false;
        if (disposed) { await audio.DisposeAsync().ConfigureAwait(false); return; }
        busy = true;
        transcription = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        try
        {
            status = T("Chat.Microphone.Transcribing", "Whisper is transcribing…");
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            await using (audio.ConfigureAwait(false))
            {
                var stream = await audio.OpenReadStreamAsync(16 * 1024 * 1024, transcription.Token).ConfigureAwait(false);
                await using var configuredStream = stream.ConfigureAwait(false);
                var result = await Runtime.TranscribeMicrophoneAsync(stream, length, installationId, transcription.Token).ConfigureAwait(false);
                transcription.Token.ThrowIfCancellationRequested();
                if (!result.Succeeded) throw new InvalidOperationException("Whisper returned a failed transcription.");
                if (string.IsNullOrWhiteSpace(result.Text)) { status = T("Chat.Microphone.Empty", "No speech detected. Try again."); return; }
                status = T("Chat.Microphone.Submitted", "Transcribed. Starting Council with your current settings.");
                await InvokeAsync(() => Transcribed.InvokeAsync(result.Text.Trim())).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) { status = T("Chat.Microphone.Cancelled", "Recording cancelled."); }
        catch (JSDisconnectedException) { Logger.LogDebug("Microphone upload ended after circuit disconnect."); }
        catch (Exception exception) { Fail(exception); }
        finally
        {
            transcription?.Dispose(); transcription = null; busy = false;
            if (!disposed) await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    /// <summary>Cancels active transcription and discards any current browser recording.</summary>
    /// <returns>A task representing capture cancellation.</returns>
    private async Task CancelAsync()
    {
        transcription?.Cancel();
        try { if (capture is not null) await capture.InvokeVoidAsync("cancel").ConfigureAwait(false); }
        catch (JSDisconnectedException) { Logger.LogDebug("Microphone cancellation followed circuit disconnect."); }
        catch (Exception exception) { Fail(exception); }
        recording = false;
        status = T("Chat.Microphone.Cancelled", "Recording cancelled.");
    }

    /// <summary>Requests the parent Chat page to start the Whisper setup Council.</summary>
    /// <returns>A task representing the parent callback.</returns>
    private Task RequestSetupAsync() => SetupRequested.InvokeAsync();

    /// <summary>Logs a bounded microphone failure and replaces it with operator-facing recovery guidance.</summary>
    /// <param name="exception">Exception whose type is recorded while sensitive audio/transcript data remains omitted.</param>
    private void Fail(Exception exception)
    {
        Logger.LogError("Chat microphone failed with {ExceptionType}; audio and transcript omitted.", exception.GetType().Name);
        status = T("Chat.Microphone.Error", "Microphone or Whisper failed. Check browser microphone permission and the managed Python/Whisper setup.");
        recording = false;
    }

    /// <summary>Stops capture, cancels transcription and releases JavaScript/.NET interop references.</summary>
    /// <returns>A value task representing asynchronous component cleanup.</returns>
    public async ValueTask DisposeAsync()
    {
        disposed = true; lifetime.Cancel(); transcription?.Cancel();
        try
        {
            if (capture is not null) { await capture.InvokeVoidAsync("dispose").ConfigureAwait(false); await capture.DisposeAsync().ConfigureAwait(false); }
            if (module is not null) await module.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException) { Logger.LogDebug("Microphone disposed after circuit disconnect."); }
        catch (Exception exception) { Logger.LogDebug("Microphone cleanup ended with {ExceptionType}.", exception.GetType().Name); }
        reference?.Dispose(); lifetime.Dispose();
    }
}
