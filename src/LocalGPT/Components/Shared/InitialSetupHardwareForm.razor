@using LocalGPT.BusinessObjects
@inject ILogger<InitialSetupHardwareForm> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<div class="razor-component-boundary">
    <DxFormLayout CssClass="razor-component-layout-owner InitialSetupHardwareForm">
        <DxFormLayoutItem ColSpanMd="12">
            <Template Context="hardwareFormItemContext">
<article class="initial-setup-card">
                <h4>1. Local host hardware</h4>
                <OperationStatusStrip Busy='@HardwareBusy' Text='@(HardwareBusy ? BusyText : string.Empty)' Detail='@(HardwareBusy ? StatusDetail : string.Empty)' />
                <p>LocalGPT detects the physical host CPU, RAM/unified memory and every GPU it can identify. The optional CanIRun.ai hardware match is separate so a user can choose the catalog variant without overwriting LocalGPT's detected hardware facts.</p>
                <label>Physical host endpoint
                    <DxTextBox Text="@HardwareEndpoint" TextChanged="@((string value) => HardwareEndpointChanged.InvokeAsync(value))" CssClass="localgpt-editor" />
                </label>
                <div class="initial-setup-hardware-list">
                    @foreach (var hostGroup in Hardware.GroupBy(device =>
                        string.IsNullOrWhiteSpace(device.HostKey) ? device.Endpoint : device.HostKey,
                        StringComparer.OrdinalIgnoreCase))
                    {
                        var primaryDevice = hostGroup.First();
                        <div class="initial-setup-physical-host" @key="primaryDevice.Key" aria-label="Physical Ollama host">
                            <h5>Physical host · @primaryDevice.Endpoint</h5>
                            <div class="initial-setup-host-facts">
                                <label>Provider endpoint / physical host
                                    <DxTextBox Text="@primaryDevice.Endpoint"
                                               TextChanged="@((string endpoint) => UpdateHardwareGroupEndpoint(hostGroup.Key, endpoint))"
                                               CssClass="localgpt-editor" />
                                </label>
                                <label>CPU / SoC<DxTextBox @bind-Text="primaryDevice.CpuName" CssClass="localgpt-editor" /></label>
                                <label>System / unified RAM GiB<InvariantDoubleEditor @bind-Value="primaryDevice.SystemMemoryGiB" Min="0" Step="0.25" DecimalPlaces="2" /></label>
                            </div>
                            <div class="initial-setup-accelerator-list">
                                @foreach (var device in hostGroup)
                                {
                                    <div class="initial-setup-hardware-row" @key="device.Key">
                                        <label class="initial-setup-hardware-use"><DxCheckBox @bind-Checked="device.Selected" /> Use this accelerator/device row</label>
                                        <label>GPU / accelerator (optional)<DxTextBox @bind-Text="device.Name" CssClass="localgpt-editor" /></label>
                                        <label>GPU vendor<DxTextBox @bind-Text="device.Vendor" CssClass="localgpt-editor" /></label>
                                        <label>Dedicated VRAM GiB<InvariantDoubleEditor @bind-Value="device.DedicatedVramGiB" Min="0" Step="0.25" DecimalPlaces="2" /></label>
                                        <label class="initial-setup-hardware-canirun">CanIRun.ai hardware match (optional catalog variant)<DxTextBox @bind-Text="device.CanIRunHardwareName" CssClass="localgpt-editor" /></label>
                                        <DxButton CssClass="localgpt-native-button initial-setup-hardware-remove" Click="() => OnRemoveHardware.InvokeAsync(device)">Remove device row</DxButton>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="initial-setup-actions">
                    <DxButton CssClass="localgpt-native-button" Click="@(() => OnAddHardware.InvokeAsync())">Add hardware row</DxButton>
                    <DxButton CssClass="localgpt-native-button" Enabled="@(!Busy)" Click="@(() => OnDetectHardware.InvokeAsync())">Detect local hardware</DxButton>
                    <DxButton CssClass="localgpt-native-button" Enabled="@(!Busy)" Click="@(() => OnSaveHardware.InvokeAsync())">Save reviewed list</DxButton>
                </div>
                <details>
                    <summary>HWiNFO text import</summary>
                    <p>The report stays local. LocalGPT deterministically extracts all supported GPU-memory sections plus CPU/RAM/OS facts.</p>
                    <DxMemo Text="@HwInfoText" TextChanged="@((string value) => HwInfoTextChanged.InvokeAsync(value))" CssClass="localgpt-editor" Rows="6" NullText="Paste HWiNFO text export" />
                    <DxFileInput FilesUploading="@((FilesUploadingEventArgs args) => OnUploadHwInfo.InvokeAsync(args))" UploadMode="UploadMode.OnButtonClick" MaxFileCount="1" MaxFileSize="8388608" AcceptedFileTypes="@HwInfoAcceptedTypes" AllowedFileExtensions="@HwInfoAllowedExtensions" />
                    <DxButton CssClass="localgpt-native-button" Enabled="@(!(Busy || string.IsNullOrWhiteSpace(HwInfoText)))" Click="@(() => OnImportHwInfo.InvokeAsync())">Import HWiNFO</DxButton>
                </details>
            </article>
            </Template>
        </DxFormLayoutItem>
    </DxFormLayout>
</div>
