@implements IDisposable
@inject IDocumentationViewerService Viewer
@inject ILogger<DocumentationViewerHost> Logger

@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner DocumentationViewerHost">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
@if (Viewer.State.IsOpen)
{
    <DxPopup Visible="true"
             VisibleChanged="OnDocumentationPopupVisibilityChanged"
             HeaderText="@Viewer.State.Title"
             Width="min(1280px, 96vw)"
             MaxHeight="94vh"
             CloseOnOutsideClick="true">
        <BodyContentTemplate Context="documentationPopupContext">
        <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext002">
        <div class="localgpt-documentation-dialog" @onclick:stopPropagation="true">
            <header>
                <h2 id="localgpt-documentation-viewer-title">@Viewer.State.Title</h2>
                <div>
                    <a href="@Viewer.State.Url" target="_blank" rel="noopener noreferrer" data-enhance-nav="false">Open in browser tab</a>
                    <DxButton data-documentation-viewer-close aria-label="Close documentation viewer" Click="Close">Close</DxButton>
                </div>
            </header>
            <iframe @key="Viewer.State.Revision"
                    src="@Viewer.State.Url"
                    title="@Viewer.State.Title"
                    loading="eager"></iframe>
        </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
        </BodyContentTemplate>
    </DxPopup>
}
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>


@code {
    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="DocumentationViewerHost"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            Viewer.StateChanged += OnViewerStateChanged;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Subscribing the LocalGPT documentation viewer failed.");
        }
    }

    /// <summary>
    /// Handles the viewer state changed lifecycle or event notification for <see cref="DocumentationViewerHost"/>, updating the state required by the surrounding workflow.
    /// </summary>
    private void OnViewerStateChanged()
    {
        try
        {
        _ = RefreshViewerAsync();
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, "Component method DocumentationViewerHost.OnViewerStateChanged failed.");
            throw;
        }
    }

    /// <summary>
    /// Refreshes viewer for <see cref="DocumentationViewerHost"/>, keeping the operation consistent with the state and invariants of the surrounding documentation viewer host workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RefreshViewerAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Refreshing the LocalGPT documentation viewer state failed.");
        }
    }

    /// <summary>
    /// Performs close for <see cref="DocumentationViewerHost"/>, keeping the operation consistent with the state and invariants of the surrounding documentation viewer host workflow.
    /// </summary>
    private void Close()
    {
        try
        {
            Viewer.Close();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Closing the LocalGPT documentation viewer failed.");
        }
    }

    /// <summary>
    /// Closes from browser for <see cref="DocumentationViewerHost"/>, keeping the operation consistent with the state and invariants of the surrounding documentation viewer host workflow.
    /// </summary>
    [Microsoft.JSInterop.JSInvokable]
    public void CloseFromBrowser()
    {
        try
        {
            Close();
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, "Component method DocumentationViewerHost.CloseFromBrowser failed.");
            throw;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="DocumentationViewerHost"/> and leaves the documentation viewer host workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        try
        {
        Viewer.StateChanged -= OnViewerStateChanged;
    
        }
        catch (Exception __componentMethodException)
        {
            Logger.LogError(__componentMethodException, "Component method DocumentationViewerHost.Dispose failed.");
            throw;
        }
    }
    /// <summary>
    /// Handles the documentation popup visibility changed lifecycle or event notification for <see cref="DocumentationViewerHost"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="visible">Value indicating whether visible should apply to this operation.</param>
    private void OnDocumentationPopupVisibilityChanged(bool visible)
    {
        try
        {
            if (!visible)
                Close();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Applying the LocalGPT documentation popup visibility change failed.");
            throw;
        }
    }

}
