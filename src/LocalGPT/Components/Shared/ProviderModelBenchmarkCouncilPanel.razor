@* Inherits the InteractiveServer circuit from the containing page. *@
@using System.Text.Json
@implements IDisposable
@inject IProviderModelBenchmarkService BenchmarkService
@inject CouncilTextService CouncilText
@inject ILogger<ProviderModelBenchmarkCouncilPanel> Logger

<section class="benchmark-council-panel" aria-labelledby="@HeadingId">
    <header>
        <div>
            <strong id="@HeadingId">Benchmark Council</strong>
            <small>All selected provider-qualified models run the bounded benchmark. Other selected models review each recommendation.</small>
        </div>
        <span class="benchmark-count">@Models.Count selected</span>
    </header>

    <div class="benchmark-council-config">
        <BoundedNumberEditor Label="Profiles per model" Min="1" Max="6" Value="@maxProfiles" ValueChanged="@(value => maxProfiles = value)" />
        <BoundedNumberEditor Label="Tasks per profile" Min="1" Max="4" Value="@maxTasks" ValueChanged="@(value => maxTasks = value)" />
        <BoundedNumberEditor Label="Timeout seconds" Min="10" Max="900" Step="10" Suffix=" s" Value="@maxSeconds" ValueChanged="@(value => maxSeconds = value)" />
        <BoundedNumberEditor Label="Stop threshold" Min="0" Max="50" Suffix="%" Value="@improvementThreshold" ValueChanged="@(value => improvementThreshold = value)" />
        <BoundedNumberEditor Label="Maximum context" Min="2048" Max="262144" Step="1024" Value="@maximumContext" ValueChanged="@(value => maximumContext = value)" />
        <BoundedNumberEditor Label="Maximum output" Min="128" Max="8192" Step="128" Value="@maximumOutput" ValueChanged="@(value => maximumOutput = value)" />
    </div>

    <div class="benchmark-council-actions">
        <button type="button" class="btn btn-primary" disabled="@(isBusy || Models.Count == 0)" @onclick="RunAsync">Benchmark all selected models</button>
        @if (CanApply)
        {
            <button type="button" class="btn btn-outline-primary" disabled="@isBusy" @onclick="ApplyAsync">Apply all recommendations</button>
        }
        @if (isBusy)
        {
            <button type="button" class="btn btn-outline-danger" @onclick="Cancel">Cancel</button>
        }
        @if (activeRunId is Guid)
        {
            <a class="benchmark-live-session-link"
               href="@BenchmarkChatUrl"
               target="_blank"
               rel="noopener">
                Open benchmark transcript in Chat
            </a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(statusText))
    {
        <p role="status" aria-live="polite" class="benchmark-council-status">@statusText</p>
    }

    @if (report is not null)
    {
        <div class="benchmark-council-results">
            @foreach (var target in report.Targets)
            {
                <details open="@string.IsNullOrWhiteSpace(target.Error)">
                    <summary>@target.Model.DisplayName · @(string.IsNullOrWhiteSpace(target.Error) ? $"{target.Recommendation.EmpiricalScore:0.0} empirical / {target.Recommendation.CouncilScore:0.0} council" : "failed")</summary>
                    @if (!string.IsNullOrWhiteSpace(target.Error))
                    {
                        <p>@target.Error</p>
                    }
                    else
                    {
                        <p>@target.Recommendation.ProfileName · context @target.Recommendation.ContextTokens.ToString("N0") · output @target.Recommendation.OutputTokens.ToString("N0")</p>
                        <small>@target.Recommendation.Rationale</small>
                    }
                </details>
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<ProviderModelReference> Models { get; set; } = [];
    [Parameter] public EventCallback<ProviderModelBenchmarkBatchAppliedEvent> BenchmarkApplied { get; set; }
    [Parameter] public EventCallback<Guid> BenchmarkStarted { get; set; }

    readonly string HeadingId = $"benchmark-council-{Guid.NewGuid():N}";
    int maxProfiles = 5;
    int maxTasks = 3;
    int maxSeconds = 180;
    int improvementThreshold = 5;
    int maximumContext = 32768;
    int maximumOutput = 1024;
    bool isBusy;
    string statusText = string.Empty;
    ProviderModelBenchmarkReport? report;
    CancellationTokenSource? benchmarkCts;
    Guid? activeRunId;
    string modelSignature = string.Empty;

    string BenchmarkChatUrl => activeRunId is Guid runId
        ? $"/Chat?rejoinCouncilRunId={runId:D}"
        : "/Chat";

    bool CanApply => report?.Targets.Any(target => string.IsNullOrWhiteSpace(target.Error)
        && !string.IsNullOrWhiteSpace(target.Recommendation.ProfileName)) == true;

    protected override void OnParametersSet()
    {
        var nextSignature = CouncilText.ProviderModelBenchmarkCouncilSignature(Models, Logger);
        if (nextSignature.Equals(modelSignature, StringComparison.Ordinal))
            return;

        if (!string.IsNullOrWhiteSpace(modelSignature))
        {
            benchmarkCts?.Cancel();
            report = null;
            activeRunId = null;
            statusText = "Selection changed. Run Benchmark Council again before applying recommendations.";
        }
        modelSignature = nextSignature;
    }

    async Task RunAsync()
    {
        benchmarkCts?.Cancel();
        benchmarkCts?.Dispose();
        benchmarkCts = new CancellationTokenSource();
        isBusy = true;
        report = null;
        activeRunId = Guid.NewGuid();
        statusText = $"Benchmark Council {activeRunId.Value.ToString("N")[..8]} is running. Open its Chat transcript to watch or stop the live session.";
        try
        {
            var benchmarkTask = BenchmarkService.RunAsync(new ProviderModelBenchmarkRequest
            {
                RunId = activeRunId.Value,
                Targets = Models.ToList(),
                CouncilReviewers = Models.ToList(),
                MaxProfilesPerModel = maxProfiles,
                MaxTasks = maxTasks,
                MaxCouncilReviewers = Math.Min(3, Math.Max(1, Models.Count - 1)),
                MaxSecondsPerCall = maxSeconds,
                ImprovementThresholdPercent = improvementThreshold,
                MaximumContextTokens = maximumContext,
                MaximumOutputTokens = maximumOutput,
                IncludeCouncilReview = true
            }, benchmarkCts.Token);
            await InvokeAsync(() => BenchmarkStarted.InvokeAsync(activeRunId.Value)).ConfigureAwait(false);
            var completedReport = await benchmarkTask.ConfigureAwait(false);
            await InvokeAsync(() =>
            {
                report = completedReport;
                var succeeded = report.Targets.Count(target => string.IsNullOrWhiteSpace(target.Error));
                statusText = $"Benchmark Council completed: {succeeded}/{report.Targets.Count} model(s) produced recommendations. The full transcript remains available in Chat for this LocalGPT process.";
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() => statusText = "Benchmark Council cancelled. No settings were applied.").ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Provider Benchmark Council failed; prompts and model output were omitted.");
            await InvokeAsync(() => statusText = "Benchmark Council failed. Existing provider and preset settings were not changed.").ConfigureAwait(false);
        }
        finally
        {
            await InvokeAsync(() => isBusy = false).ConfigureAwait(false);
        }
    }

    async Task ApplyAsync()
    {
        if (report is null || !CanApply)
            return;
        isBusy = true;
        statusText = "Applying all successful provider-qualified recommendations as one user-approved preset…";
        try
        {
            var presets = await BenchmarkService.ApplyRecommendationsAsync(
                report,
                $"Benchmark Council · {DateTimeOffset.Now:yyyy-MM-dd HHmm}",
                makeDefault: false,
                userConfirmed: true).ConfigureAwait(false);
            var preset = presets.Single();
            var routes = JsonSerializer.Deserialize<List<OneWireCouncilModelRoute>>(preset.ModelRoutesJson) ?? [];
            var appliedModels = report.Targets
                .Where(target => string.IsNullOrWhiteSpace(target.Error)
                    && !string.IsNullOrWhiteSpace(target.Recommendation.ProfileName))
                .Select(target => target.Model)
                .ToList();
            await BenchmarkApplied.InvokeAsync(new ProviderModelBenchmarkBatchAppliedEvent(
                appliedModels, routes, preset)).ConfigureAwait(false);
            statusText = $"Applied {routes.Count} provider-qualified route(s) as preset “{preset.Name}”.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Applying Benchmark Council recommendations failed.");
            statusText = "The recommendations could not be applied. Existing settings were left unchanged.";
        }
        finally
        {
            isBusy = false;
        }
    }

    void Cancel() => benchmarkCts?.Cancel();

    public void Dispose()
    {
        benchmarkCts?.Cancel();
        benchmarkCts?.Dispose();
    }
}
