@* Inherits the InteractiveServer circuit from the containing page. *@
@using System.Text.Json
@implements IDisposable
@inject IProviderModelBenchmarkService BenchmarkService
@inject CouncilTextService CouncilText
@inject ILogger<ProviderModelBenchmarkCouncilPanel> Logger

<section class="benchmark-council-panel" aria-labelledby="@HeadingId">
    <header>
        <div>
            <strong id="@HeadingId">Benchmark Council</strong>
            <small>All selected provider-qualified models run the bounded benchmark. Other selected models review each recommendation.</small>
        </div>
        <span class="benchmark-count">@Models.Count selected</span>
    </header>

    <div class="benchmark-council-config">
        <label>
            <span>Profile plan</span>
            <select class="form-select" @bind="profileMode">
                <option value="@ProviderModelBenchmarkProfileMode.EvenlySpaced">Evenly spaced to maximum</option>
                <option value="@ProviderModelBenchmarkProfileMode.Adaptive">Adaptive named profiles (legacy)</option>
            </select>
        </label>
        <label>
            <span>@(profileMode == ProviderModelBenchmarkProfileMode.EvenlySpaced ? "Even steps per model" : "Adaptive profiles per model")</span>
            <input class="form-control" type="number" min="1" step="1" @bind="maxProfiles" />
        </label>
        <BoundedNumberEditor Label="Tasks per profile" Min="1" Max="4" Value="@maxTasks" ValueChanged="@(value => maxTasks = value)" />
        <BoundedNumberEditor Label="Timeout seconds" Min="10" Max="900" Step="10" Suffix=" s" Value="@maxSeconds" ValueChanged="@(value => maxSeconds = value)" />
        <BoundedNumberEditor Label="Stop threshold" Min="0" Max="50" Suffix="%" Value="@improvementThreshold" ValueChanged="@(value => improvementThreshold = value)" />
        @if (profileMode == ProviderModelBenchmarkProfileMode.EvenlySpaced)
        {
            <BoundedNumberEditor Label="Minimum context" Min="2048" Max="@maximumContext" Step="1024" Value="@minimumContext" ValueChanged="@(value => minimumContext = value)" />
            <BoundedNumberEditor Label="Minimum output" Min="128" Max="@maximumOutput" Step="128" Value="@minimumOutput" ValueChanged="@(value => minimumOutput = value)" />
        }
        <BoundedNumberEditor Label="Maximum context" Min="2048" Max="262144" Step="1024" Value="@maximumContext" ValueChanged="OnMaximumContextChanged" />
        <BoundedNumberEditor Label="Maximum output" Min="128" Max="8192" Step="128" Value="@maximumOutput" ValueChanged="OnMaximumOutputChanged" />
        <label class="benchmark-option">
            <input type="checkbox" @bind="stopWhenImprovementStalls" />
            <span>Allow improvement-based early stop</span>
        </label>
        @if (profileMode == ProviderModelBenchmarkProfileMode.Adaptive)
        {
            <label class="benchmark-option">
                <input type="checkbox" @bind="includeCpuSafeControl" />
                <span>Include Ollama CPU-safe control</span>
            </label>
        }
        <label>
            <span>Reviewers per recommendation</span>
            <input class="form-control" type="number" min="0" step="1" @bind="maxCouncilReviewers" />
        </label>
    </div>

    <details class="benchmark-reviewer-picker">
        <summary>Benchmark Council reviewer pool (@SelectedReviewerCount selected)</summary>
        <p>Provider-qualified reviewers are independent from benchmark targets. gpt-oss:20b is preferred by default when available; deepscaler/tiny models are not preferred unless you select them.</p>
        <div class="benchmark-reviewer-grid">
            @foreach (var reviewer in Models.OrderBy(DefaultReviewerPriority).ThenBy(model => model.DisplayName, StringComparer.OrdinalIgnoreCase))
            {
                <label>
                    <input type="checkbox"
                           checked="@reviewerSelectionKeys.Contains(reviewer.SelectionKey)"
                           @onchange="args => ToggleReviewer(reviewer.SelectionKey, args)" />
                    <span>@reviewer.DisplayName</span>
                </label>
            }
        </div>
    </details>

    <div class="benchmark-council-actions">
        <button type="button" class="btn btn-primary" disabled="@(isBusy || Models.Count == 0)" @onclick="RunAsync">Benchmark all selected models</button>
        @if (isBusy)
        {
            <button type="button" class="btn btn-outline-danger" @onclick="Cancel">Cancel</button>
        }
        @if (activeRunId is Guid)
        {
            <a class="benchmark-live-session-link"
               href="@BenchmarkChatUrl"
               target="_blank"
               rel="noopener">
                Open benchmark transcript in Chat
            </a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(statusText))
    {
        <p role="status" aria-live="polite" class="benchmark-council-status">@statusText</p>
    }

    @if (report is not null)
    {
        <div class="benchmark-council-results">
            @foreach (var target in report.Targets)
            {
                <details open="@string.IsNullOrWhiteSpace(target.Error)">
                    <summary>@target.Model.DisplayName · @(string.IsNullOrWhiteSpace(target.Error) ? $"{target.Recommendation.EmpiricalScore:0.0} empirical / {target.Recommendation.CouncilScore:0.0} council" : "failed")</summary>
                    @if (!string.IsNullOrWhiteSpace(target.Error))
                    {
                        <p>@target.Error</p>
                    }
                    else
                    {
                        <p>@target.Recommendation.ProfileName · context @target.Recommendation.ContextTokens.ToString("N0") · output @target.Recommendation.OutputTokens.ToString("N0")</p>
                        <small>@target.Recommendation.Rationale</small>
                    }
                </details>
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<ProviderModelReference> Models { get; set; } = [];
    [Parameter] public EventCallback<ProviderModelBenchmarkBatchAppliedEvent> BenchmarkApplied { get; set; }
    [Parameter] public EventCallback<HardwarePerformancePreset> PerformancePresetSaved { get; set; }
    [Parameter] public EventCallback<Guid> BenchmarkStarted { get; set; }

    readonly string HeadingId = $"benchmark-council-{Guid.NewGuid():N}";
    ProviderModelBenchmarkProfileMode profileMode = ProviderModelBenchmarkProfileMode.EvenlySpaced;
    int maxProfiles = 5;
    int maxTasks = 3;
    int maxSeconds = 180;
    int improvementThreshold = 5;
    int minimumContext = 2048;
    int minimumOutput = 128;
    int maximumContext = 32768;
    int maximumOutput = 1024;
    int maxCouncilReviewers = 2;
    bool includeCpuSafeControl = true;
    bool stopWhenImprovementStalls;
    readonly HashSet<string> reviewerSelectionKeys = new(StringComparer.OrdinalIgnoreCase);
    bool isBusy;
    string statusText = string.Empty;
    ProviderModelBenchmarkReport? report;
    CancellationTokenSource? benchmarkCts;
    Guid? activeRunId;
    string modelSignature = string.Empty;

    string BenchmarkChatUrl => activeRunId is Guid runId
        ? $"/Chat?rejoinCouncilRunId={runId:D}"
        : "/Chat";

    bool CanApply => report?.Targets.Any(target => string.IsNullOrWhiteSpace(target.Error)
        && !string.IsNullOrWhiteSpace(target.Recommendation.ProfileName)) == true;

    protected override void OnParametersSet()
    {
        var nextSignature = CouncilText.ProviderModelBenchmarkCouncilSignature(Models, Logger);
        if (nextSignature.Equals(modelSignature, StringComparison.Ordinal))
            return;

        if (!string.IsNullOrWhiteSpace(modelSignature))
        {
            benchmarkCts?.Cancel();
            report = null;
            activeRunId = null;
            statusText = "Selection changed. Run Benchmark Council again before applying recommendations.";
        }

        var availableReviewerKeys = Models.Select(model => model.SelectionKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        reviewerSelectionKeys.RemoveWhere(key => !availableReviewerKeys.Contains(key));
        if (reviewerSelectionKeys.Count == 0)
        {
            foreach (var reviewer in Models
                .OrderBy(DefaultReviewerPriority)
                .ThenBy(model => model.DisplayName, StringComparer.OrdinalIgnoreCase)
                .Take(Math.Min(2, Models.Count)))
            {
                reviewerSelectionKeys.Add(reviewer.SelectionKey);
            }
        }

        modelSignature = nextSignature;
    }

    async Task RunAsync()
    {
        benchmarkCts?.Cancel();
        benchmarkCts?.Dispose();
        benchmarkCts = new CancellationTokenSource();
        isBusy = true;
        report = null;
        activeRunId = Guid.NewGuid();
        statusText = $"Benchmark Council {activeRunId.Value.ToString("N")[..8]} is running. Open its Chat transcript to watch or stop the live session.";
        try
        {
            var benchmarkTask = BenchmarkService.RunAsync(new ProviderModelBenchmarkRequest
            {
                RunId = activeRunId.Value,
                Targets = Models.ToList(),
                CouncilReviewers = Models.Where(model => reviewerSelectionKeys.Contains(model.SelectionKey)).ToList(),
                MaxProfilesPerModel = Math.Max(1, maxProfiles),
                ProfileMode = profileMode,
                MinimumContextTokens = minimumContext,
                MinimumOutputTokens = minimumOutput,
                IncludeCpuSafeControl = includeCpuSafeControl,
                StopWhenImprovementStalls = stopWhenImprovementStalls,
                MaxTasks = maxTasks,
                MaxCouncilReviewers = Math.Max(0, maxCouncilReviewers),
                MaxSecondsPerCall = maxSeconds,
                ImprovementThresholdPercent = improvementThreshold,
                MaximumContextTokens = maximumContext,
                MaximumOutputTokens = maximumOutput,
                IncludeCouncilReview = maxCouncilReviewers > 0 && reviewerSelectionKeys.Count > 0
            }, benchmarkCts.Token);
            await InvokeAsync(() => BenchmarkStarted.InvokeAsync(activeRunId.Value)).ConfigureAwait(false);
            var completedReport = await benchmarkTask.ConfigureAwait(false);
            HardwarePerformancePreset? savedPerformancePreset = null;
            if (completedReport.Targets.Any(target => string.IsNullOrWhiteSpace(target.Error) && !string.IsNullOrWhiteSpace(target.Recommendation.ProfileName)))
            {
                savedPerformancePreset = await BenchmarkService.SavePerformancePresetAsync(
                    completedReport,
                    $"Benchmark performance · {DateTimeOffset.Now:yyyy-MM-dd HHmm}",
                    userConfirmed: true,
                    benchmarkCts.Token).ConfigureAwait(false);
            }
            await InvokeAsync(async () =>
            {
                report = completedReport;
                var succeeded = report.Targets.Count(target => string.IsNullOrWhiteSpace(target.Error));
                statusText = savedPerformancePreset is null
                    ? $"Benchmark Council completed: {succeeded}/{report.Targets.Count} model(s) produced recommendations."
                    : $"Benchmark Council completed: {succeeded}/{report.Targets.Count} model(s). Saved hardware performance profile “{savedPerformancePreset.Name}”; select it in Hardware spooler.";
                if (savedPerformancePreset is not null)
                    await PerformancePresetSaved.InvokeAsync(savedPerformancePreset).ConfigureAwait(false);
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            await InvokeAsync(() => statusText = "Benchmark Council cancelled. No settings were applied.").ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Provider Benchmark Council failed; prompts and model output were omitted.");
            await InvokeAsync(() => statusText = "Benchmark Council failed. Existing provider and preset settings were not changed.").ConfigureAwait(false);
        }
        finally
        {
            await InvokeAsync(() => isBusy = false).ConfigureAwait(false);
        }
    }

    async Task ApplyAsync()
    {
        if (report is null || !CanApply)
            return;
        isBusy = true;
        statusText = "Applying all successful provider-qualified recommendations as one user-approved preset…";
        try
        {
            var presets = await BenchmarkService.ApplyRecommendationsAsync(
                report,
                $"Benchmark Council · {DateTimeOffset.Now:yyyy-MM-dd HHmm}",
                makeDefault: false,
                userConfirmed: true).ConfigureAwait(false);
            var preset = presets.Single();
            var routes = JsonSerializer.Deserialize<List<OneWireCouncilModelRoute>>(preset.ModelRoutesJson) ?? [];
            var appliedModels = report.Targets
                .Where(target => string.IsNullOrWhiteSpace(target.Error)
                    && !string.IsNullOrWhiteSpace(target.Recommendation.ProfileName))
                .Select(target => target.Model)
                .ToList();
            await BenchmarkApplied.InvokeAsync(new ProviderModelBenchmarkBatchAppliedEvent(
                appliedModels, routes, preset)).ConfigureAwait(false);
            statusText = $"Applied {routes.Count} provider-qualified route(s) as preset “{preset.Name}”.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Applying Benchmark Council recommendations failed.");
            statusText = "The recommendations could not be applied. Existing settings were left unchanged.";
        }
        finally
        {
            isBusy = false;
        }
    }

    int SelectedReviewerCount => reviewerSelectionKeys.Count;

    void ToggleReviewer(string selectionKey, ChangeEventArgs args)
    {
        var selected = args.Value is bool value && value;
        if (selected)
            reviewerSelectionKeys.Add(selectionKey);
        else
            reviewerSelectionKeys.Remove(selectionKey);
    }

    Task OnMaximumContextChanged(int value)
    {
        maximumContext = value;
        minimumContext = Math.Min(minimumContext, maximumContext);
        return Task.CompletedTask;
    }

    Task OnMaximumOutputChanged(int value)
    {
        maximumOutput = value;
        minimumOutput = Math.Min(minimumOutput, maximumOutput);
        return Task.CompletedTask;
    }

    static int DefaultReviewerPriority(ProviderModelReference model)
    {
        var name = model.ModelName ?? string.Empty;
        if (name.Equals("gpt-oss:20b", StringComparison.OrdinalIgnoreCase))
            return 0;
        if (name.Contains("gpt-oss", StringComparison.OrdinalIgnoreCase))
            return 1;
        if (name.Contains("qwen", StringComparison.OrdinalIgnoreCase) && name.Contains("coder", StringComparison.OrdinalIgnoreCase))
            return 2;
        if (name.Contains("deepseek", StringComparison.OrdinalIgnoreCase) && name.Contains("coder", StringComparison.OrdinalIgnoreCase))
            return 3;
        if (name.Contains("deepscaler", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("1.5b", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("0.8b", StringComparison.OrdinalIgnoreCase))
            return 20;
        return 10;
    }

    void Cancel() => benchmarkCts?.Cancel();

    public void Dispose()
    {
        benchmarkCts?.Cancel();
        benchmarkCts?.Dispose();
    }
}
