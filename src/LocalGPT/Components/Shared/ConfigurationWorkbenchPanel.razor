@inject ILogger<ConfigurationWorkbenchPanel> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner ConfigurationWorkbenchPanel">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
@if (IsActive)
{
    <div class="configuration-workbench-panel" role="region" aria-label="@AriaLabel">
        @ChildContent
    </div>
}
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>


@code {
    /// <summary>
    /// Gets or sets the stable section key used to identify or correlate this configuration workbench panel instance with related application state.
    /// </summary>
    /// <value>The section key value exposed by <see cref="ConfigurationWorkbenchPanel"/>.</value>
    [Parameter, EditorRequired]
    public string SectionKey { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the stable active key used to identify or correlate this configuration workbench panel instance with related application state.
    /// </summary>
    /// <value>The active key value exposed by <see cref="ConfigurationWorkbenchPanel"/>.</value>
    [Parameter, EditorRequired]
    public string ActiveKey { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the aria label value that forms part of the configuration workbench panel state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The aria label value exposed by <see cref="ConfigurationWorkbenchPanel"/>.</value>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Gets or sets the child content value that forms part of the configuration workbench panel state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The child content value exposed by <see cref="ConfigurationWorkbenchPanel"/>.</value>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets a value indicating whether active applies to the configuration workbench panel state.
    /// </summary>
    /// <value>The is active value exposed by <see cref="ConfigurationWorkbenchPanel"/>.</value>
    private bool IsActive => GetIsActiveForRender();


    /// <summary>Computes IsActive for the render path with component-local diagnostics.</summary>
    /// <returns>A value indicating whether the requested condition or operation succeeded.</returns>
    private bool GetIsActiveForRender()
    {
        try
        {
            return string.Equals(SectionKey, ActiveKey, StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception __componentPropertyException)
        {
            Logger.LogError(__componentPropertyException, "Computed render property ConfigurationWorkbenchPanel.IsActive failed.");
            throw;
        }
    }
}
