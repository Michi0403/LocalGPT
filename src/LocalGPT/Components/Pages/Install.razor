@rendermode InteractiveServer
@page "/install"
@using LocalGPT.BusinessObjects.Enums
@inject CouncilTextService CouncilText
@inject IOptionsMonitor<LocalGPT.BusinessObjects.ConfigurationRoot> Opts
@inject IConfigurationWriter Writer
@inject IAiProviderConfigurationRegistryService ProviderConfigurationRegistry
@inject INetworkCertificateService NetworkCertificates
@inject IAiConnectivityProbe Probe
@inject IOllamaProcessService OllamaProcesses
@inject NavigationManager Nav
@inject ILogger<Install> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject ISupervisedTaskRunner TaskRunner
@inject IFirstRunOnboardingService Onboarding
@inject IProjectMaintenanceService ProjectMaintenance
@inject IConfiguredAiHostHardwareService HostHardware
@inject IFeaturePersistenceService FeaturePersistence
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization
@inject ILocalGptApplicationPathService ApplicationPaths
@inject ILocalAiRuntimeService LocalAiRuntime
@inject ILocalAiAcquisitionService LocalAiAcquisition
@inject IHuggingFaceModelCatalogService HuggingFaceCatalog
@inject IToolchainEnvironmentService ToolchainEnvironment
@inject IToolchainAcquisitionService ToolchainAcquisition
@inject IToolchainExecutionProfileService ToolchainExecutionProfiles
@inject IRuntimePluginService RuntimePlugins
@inject LocalGPT.Runtime.Plugins.RuntimePluginDefinitionSupport RuntimePluginDefinitionSupport

<PageTitle>AI Setup</PageTitle>

<span id="install-scroll-top" class="install-scroll-anchor" aria-hidden="true"></span>
<div class="main-container install-page-scroll-owner">
    <ToastWrapper Name="@toastName" />

    <div class="install-workbench">
        <WorkbenchHeader Eyebrow='@T("Install.Workbench.Eyebrow", "Configuration studio")'
                         Title='@T("Install.Workbench.Title", "LocalGPT setup")'
                         Subtitle='@T("Install.Workbench.Subtitle", "Configure AI providers, remote access, certificates, toolchains and language catalogs without leaving the application.")'>
            <Actions>
                <DxButton Text="@(IsSaving ? "Saving and refreshing..." : "Save setup settings")"
                          CssClass="provider-save-button"
                          Enabled="@(!IsSaving)"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          IconCssClass="save"
                          Click="Save" />
                <DxButton Text="Back to Chat"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          IconCssClass="chevron-left"
                          Click="GoChat" />
            </Actions>
        </WorkbenchHeader>

        <OperationStatusStrip Busy="@HasActiveInstallOperation"
                              Text="@CurrentInstallOperationText"
                              Detail="@(HasActiveInstallOperation ? T("Install.Workbench.OperationHelp", "Live provider, setup, command, and application activity is mirrored to Setup log and the shared ASCII operational console.") : string.Empty)" />

        @if (ApplicationPathLayout is not null)
        {
            <details class="provider-install-guide" data-testid="runtime-path-layout">
                <summary><strong>Runtime storage &amp; detected paths</strong> · @ApplicationPathLayout.Platform</summary>
                <p class="field-help">LocalGPT keeps mutable configuration and application state in the current user's data folder by default. Portable and system-wide locations are discovery/override candidates only.</p>
                <div class="provider-install-commands">
                    <div><span>User data</span><code>@ApplicationPathLayout.UserDataRoot</code></div>
                    <div><span>User configuration</span><code>@ApplicationPathLayout.ConfigurationFile</code></div>
                    <div><span>Database</span><code>@ApplicationPathLayout.DatabaseFile</code></div>
                    <div><span>Runtime report</span><code>@ApplicationPathLayout.LayoutReportFile</code></div>
                    <div><span>Application/portable root</span><code>@ApplicationPathLayout.PortableApplicationRoot</code></div>
                </div>
            </details>
        }

        <div class="install-workbench-layout">
            <ConfigurationWorkbenchNav Items="@InstallSections"
                                       ActiveKey="@ActiveInstallSection"
                                       ActiveKeyChanged="OnInstallSectionChanged"
                                       AriaLabel="Setup sections" />
            <div class="install-workbench-stage">
        <ConfigurationWorkbenchPanel SectionKey="providers" ActiveKey="@ActiveInstallSection" AriaLabel="AI providers">
        <section id="provider-studio" class="install-workbench-region install-provider-studio" aria-labelledby="provider-studio-heading">
            <header class="install-region-heading">
                <div>
                    <span class="install-region-kicker">@T("Install.Workbench.ProviderKicker", "Provider workbench")</span>
                    <h2 id="provider-studio-heading">@T("Install.Workbench.ProvidersTitle", "AI providers")</h2>
                    <p>@T("Install.Workbench.ProvidersHelp", "Discover reachable hosts, select the provider family, edit every existing option and verify connectivity before saving.")</p>
                </div>
            </header>

        <section class="provider-install-guide" aria-labelledby="provider-install-guide-heading">
            <header class="provider-install-guide-heading">
                <div>
                    <span class="install-region-kicker">@T("Install.ProviderInstall.Kicker", "Local runtime installation")</span>
                    <h3 id="provider-install-guide-heading">@T("Install.ProviderInstall.Title", "Need Ollama or LM Studio first?")</h3>
                    <p>@T("Install.ProviderInstall.Help", "Use the official installer for your operating system, start a local model server, then return here and refresh connectivity. Guided install/start/model actions run only after your explicit confirmation; if a guided action cannot install the vendor runtime, use the official download link and then click Detect again.")</p>
                </div>
                <DxButton CssClass="localgpt-native-button" Click="OpenGuidedRuntimeSetup">@T("Install.ProviderInstall.GuidedAction", "Open guided install actions")</DxButton>
            </header>
            <div class="provider-install-guide-grid">
                <article class="provider-install-guide-card">
                    <div class="provider-install-guide-card-heading">
                        <div>
                            <strong>Ollama</strong>
                            <small>@T("Install.ProviderInstall.OllamaHelp", "Best fit when you want a lightweight local model service that LocalGPT can also start, stop and restart after installation.")</small>
                        </div>
                        <a class="provider-install-link" href="https://ollama.com/download" target="_blank" rel="noopener noreferrer">@T("Install.ProviderInstall.OpenDownload", "Official download")</a>
                    </div>
                    <div class="provider-install-commands">
                        <div><span>Windows PowerShell</span><code>irm https://ollama.com/install.ps1 | iex</code></div>
                        <div><span>macOS / Linux</span><code>curl -fsSL https://ollama.com/install.sh | sh</code></div>
                    </div>
                    <ol>
                        <li>@T("Install.ProviderInstall.OllamaStep1", "Install Ollama, then start it if your installer did not start the service automatically. On macOS LocalGPT also detects the CLI inside /Applications/Ollama.app, so the vendor app can be installed manually even when no shell symlink exists.") <code>ollama serve</code></li>
                        <li>@T("Install.ProviderInstall.OllamaStep2", "Pull at least one model. The maintained quick preset can use") <code>ollama pull gpt-oss:20b</code></li>
                        <li>@T("Install.ProviderInstall.OllamaStep3", "Return to this page, refresh process/connectivity status and select the discovered model. Native Ollama normally listens on") <code>http://127.0.0.1:11434</code></li>
                    </ol>
                </article>
                <article class="provider-install-guide-card">
                    <div class="provider-install-guide-card-heading">
                        <div>
                            <strong>LM Studio</strong>
                            <small>@T("Install.ProviderInstall.LmStudioHelp", "Best fit when you want a desktop model catalog and an OpenAI-compatible local server. Headless llmster is also available for macOS and Linux.")</small>
                        </div>
                        <a class="provider-install-link" href="https://lmstudio.ai/download" target="_blank" rel="noopener noreferrer">@T("Install.ProviderInstall.OpenDownload", "Official download")</a>
                    </div>
                    <div class="provider-install-commands">
                        <div><span>macOS / Linux · llmster</span><code>curl -fsSL https://lmstudio.ai/install.sh | bash</code></div>
                        <div><span>Windows PowerShell · llmster</span><code>irm https://lmstudio.ai/install.ps1 | iex</code></div>
                    </div>
                    <ol>
                        <li>@T("Install.ProviderInstall.LmStudioStep1", "Install the desktop app or llmster. The guided model action downloads and loads the selected model; manual setup can use lms get <model> followed by lms load <model>, then start the local server.") <code>lms server start</code></li>
                        <li>@T("Install.ProviderInstall.LmStudioStep2", "LM Studio's OpenAI-compatible server normally listens on") <code>http://127.0.0.1:1234/v1</code></li>
                        <li>@T("Install.ProviderInstall.LmStudioStep3", "Return here, choose LM Studio / local OpenAI-compatible, test the endpoint and save the discovered model id.")</li>
                    </ol>
                </article>
            </div>
            <p class="provider-install-guide-note">@T("Install.ProviderInstall.SecurityNote", "Security note: review vendor installer scripts before running them. Manual snippets and download links are user-driven. Guided install/start/model actions execute only after explicit confirmation through LocalGPT's bounded console and never silently elevate privileges.")</p>
        </section>

        <div class="@ConnectivityAlertCss" role="status">
            <div class="d-flex flex-wrap align-items-center gap-2 justify-content-between">
                <div>
                    <strong>AI Provider Connectivity</strong>
                    <div>@ConnectivityStatus</div>
                    @if (LastConnectivityCheck is not null)
                    {
                        <small>@LastCheckedLabel</small>
                    }
                </div>
                <DxButton Text="Refresh Connectivity"
                          CssClass="provider-action-button"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!IsConnectivityChecking)"
                          Click="RefreshConnectivityStatusFromButton" />
            </div>
            <div class="ollama-process-panel" data-testid="ollama-process-controls">
                <div class="ollama-process-status">
                    <strong>Ollama process</strong>
                    <span>@OllamaProcessStatus.Message</span>
                    @if (OllamaProcessStatus.Processes.Count > 0)
                    {
                        <small>@OllamaProcessStatus.ProcessSummary</small>
                    }
                </div>
                <div class="ollama-process-actions">
                    <DxButton Text="Start Ollama"
                              CssClass="provider-action-button"
                              RenderStyle="ButtonRenderStyle.Success"
                              RenderStyleMode="ButtonRenderStyleMode.Contained"
                              Enabled="@(!IsOllamaProcessBusy && OllamaProcessStatus.IsInstalled && (!OllamaProcessStatus.IsRunning || !OllamaProcessStatus.IsResponsive))"
                              Click="StartOllamaAsync" />
                    <DxButton Text="Stop Ollama"
                              CssClass="provider-action-button"
                              RenderStyle="ButtonRenderStyle.Danger"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!IsOllamaProcessBusy && OllamaProcessStatus.IsRunning)"
                              Click="StopOllamaAsync" />
                    <DxButton Text="Restart Ollama"
                              CssClass="provider-action-button"
                              RenderStyle="ButtonRenderStyle.Warning"
                              RenderStyleMode="ButtonRenderStyleMode.Contained"
                              Enabled="@(!IsOllamaProcessBusy && OllamaProcessStatus.IsInstalled)"
                              Click="RestartOllamaAsync" />
                    <DxButton Text="Refresh process status"
                              CssClass="provider-action-button"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!IsOllamaProcessBusy)"
                              Click="RefreshOllamaProcessStatusAsync" />
                </div>
            </div>
        </div>

        <div class="top-container">
            <DxButton Text="Find configured / local AI hosts"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Enabled="@(!IsDiscovering)"
                      Click="DiscoverLocalAiHosts" />
            <DxButton Text="Use Ollama gpt-oss:20b"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="UseOllamaGptOss20b" />
        </div>

        @if (!HasLocalLoopbackOllamaBinding)
        {
            <section class="local-ollama-candidate" aria-label="This computer's Ollama host">
                <div>
                    <strong>This computer's Ollama</strong>
                    <code>http://127.0.0.1:11434</code>
                    <small>Save the loopback endpoint independently from remote Council hosts. A remote PC being offline does not block configuring or using Ollama on this computer.</small>
                </div>
                <DxButton Text="Add this computer's Ollama"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!IsSaving)"
                          Click="RegisterLocalOllamaHostAsync" />
            </section>
        }

        <section class="configured-provider-catalog" aria-label="Configured AI providers" data-testid="configured-provider-catalog">
            <header>
                <div>
                    <strong>Configured AI hosts</strong>
                    <small>@ConfiguredProviderSummary</small>
                </div>
                <span class="configured-provider-count">@ConfiguredProviderHosts.Count</span>
            </header>
            @if (ConfiguredProviderHosts.Count == 0)
            {
                <p class="field-help">No provider host is stored yet. Discover a local host or add Ollama / LM Studio / another OpenAI-compatible endpoint below.</p>
            }
            else
            {
                <div class="configured-provider-grid">
                    @foreach (var configured in ConfiguredProviderHosts)
                    {
                        <article class="configured-provider-card" @key="configured.Key">
                            <div class="configured-provider-card-heading">
                                <div>
                                    <strong>@configured.Provider</strong>
                                    <small>@configured.Origin</small>
                                </div>
                                <span class="configured-host-badge">saved</span>
                            </div>
                            <code>@configured.Endpoint</code>
                            <span>@(string.IsNullOrWhiteSpace(configured.ModelName) ? "No preferred model selected" : configured.ModelName)</span>
                            @if (configured.OpenAiHost is not null || configured.OllamaHost is not null)
                            {
                                var hardwareDraft = GetHostHardwareDraft(configured.Endpoint);
                            <details class="configured-host-hardware">
                                <summary>Host hardware · @hardwareDraft.HostKey</summary>
                                <p class="field-help">This definition belongs to the physical configured host and is shared by provider/model bindings on that host. Confirmed/imported values are stored in the LocalGPT database and are not overwritten by weak discovery.</p>
                                <div class="configured-host-hardware-grid">
                                    <label>Host name<DxTextBox @bind-Text="hardwareDraft.HostName" CssClass="localgpt-editor" /></label>
                                    <label>Operating system<DxTextBox @bind-Text="hardwareDraft.OperatingSystem" CssClass="localgpt-editor" /></label>
                                    <label>CPU<DxTextBox @bind-Text="hardwareDraft.CpuName" CssClass="localgpt-editor" /></label>
                                    <label>System RAM (GiB)<InvariantDoubleEditor @bind-Value="hardwareDraft.SystemMemoryGiB" Min="0" Step="0.5" DecimalPlaces="2" /></label>
                                    <label>GPU<DxTextBox @bind-Text="hardwareDraft.GpuName" CssClass="localgpt-editor" /></label>
                                    <label>GPU vendor<DxTextBox @bind-Text="hardwareDraft.GpuVendor" CssClass="localgpt-editor" /></label>
                                    <label>Dedicated VRAM (GiB)<InvariantDoubleEditor @bind-Value="hardwareDraft.DedicatedVramGiB" Min="0" Step="0.25" DecimalPlaces="2" /></label>
                                    <label>Source<DxTextBox Text="@hardwareDraft.SourceKind" ReadOnly="true" CssClass="localgpt-editor" /></label>
                                </div>
                                <label class="configured-host-report">HWiNFO text report (optional deterministic import)
                                    <DxMemo @bind-Text="hardwareDraft.HwInfoReportText" Rows="5" NullText="Paste an HWiNFO text report here. LocalGPT parses GPU VRAM deterministically; the report is not sent to an AI." />
                                </label>
                                <label class="configured-host-report">Or choose an HWiNFO text report
                                    <DxFileInput FilesUploading="@(args => ImportHostHardwareFileAsync(configured.Endpoint, args))"
                                                 UploadMode="UploadMode.OnButtonClick"
                                                 MaxFileCount="1"
                                                 MaxFileSize="8388608"
                                                 AcceptedFileTypes="@HwInfoAcceptedTypes"
                                                 AllowedFileExtensions="@HwInfoAllowedExtensions" />
                                </label>
                                <div class="configured-provider-actions">
                                    <DxButton Text="Save host hardware" Enabled="@(!IsSavingHostHardware)" Click="@(() => SaveHostHardwareAsync(configured.Endpoint))" />
                                    @if (IsLoopbackProviderEndpoint(configured.Endpoint))
                                    {
                                        <DxButton Text="Detect local hardware" Enabled="@(!IsSavingHostHardware)" Click="@(() => DetectHostHardwareAsync(configured.Endpoint))" />
                                    }
                                    <DxButton Text="Import HWiNFO report" Enabled="@(!IsSavingHostHardware && !string.IsNullOrWhiteSpace(hardwareDraft.HwInfoReportText))" Click="@(() => ImportHostHardwareAsync(configured.Endpoint))" />
                                </div>
                            </details>
                            }
                            <div class="configured-provider-actions">
                                @if (configured.OpenAiHost is not null)
                                {
                                    <DxButton Text="Test" Click="@(() => TestOpenAiCompatibleHostAsync(configured.OpenAiHost))" />
                                }
                                else if (configured.OllamaHost is not null)
                                {
                                    <DxButton Text="Test" Click="@(() => TestOllamaHostAsync(configured.OllamaHost))" />
                                }
                                @if (!configured.IsPrimary && (configured.OpenAiHost is not null || configured.OllamaHost is not null))
                                {
                                    <DxButton Text="Make primary"
                                              Enabled="@(!IsSaving)"
                                              RenderStyle="ButtonRenderStyle.Secondary"
                                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                                              Click="@(() => MakeConfiguredProviderPrimaryAsync(configured))" />
                                }
                                <DxButton Text="Delete"
                                          Enabled="@(!IsSaving)"
                                          RenderStyle="ButtonRenderStyle.Danger"
                                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                                          Click="@(() => RemoveConfiguredProviderHostAsync(configured))" />
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        @if (DiscoveredHosts.Count > 0)
        {
            <DxFormLayout>
                <DxFormLayoutGroup Caption="Reachable AI hosts (discovery; configuration is saved separately)" ColSpanMd="12">
                    @foreach (var host in DiscoveredHosts)
                    {
                        <DxFormLayoutItem Caption="@($"{host.Provider} - {host.Endpoint}")" ColSpanMd="12">
                            <div class="discovered-ai-host">
                                <div class="discovered-host-status-row">
                                    <div>
                                        <strong>@(host.IsReachable ? "Reachable" : "Unavailable")</strong>: @host.Status
                                        @if (IsConfiguredHost(host))
                                        {
                                            <span class="configured-host-badge">configured</span>
                                        }
                                    </div>
                                    @if (IsConfiguredHost(host))
                                    {
                                        <DxButton Text="Remove saved host"
                                                  RenderStyle="ButtonRenderStyle.Danger"
                                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                  Click="@(() => RemoveConfiguredHostAsync(host))" />
                                    }
                                </div>
                                <p class="field-help">Discovery only verifies reachability. Use a model below to load it into setup, then press Save provider settings. Existing provider values stay editable in the provider tabs.</p>
                                @if (host.Models.Count > 0)
                                {
                                    <div class="install-provider-model-grid">
                                        @foreach (var model in host.Models)
                                        {
                                            <ProviderModelPanel @key="model" Model="ToProviderModel(host, model)"
                                                                ShowSelection="false"
                                                                ShowUseAction="true"
                                                                UseActionText="Use in setup"
                                                                Activated="@(_ => ApplyDiscoveredModel(host, model))"
                                                                CouncilModels="DiscoveredProviderModels"
                                                                BenchmarkApplied="OnInstallBenchmarkAppliedAsync" />
                                        }
                                    </div>
                                }
                            </div>
                        </DxFormLayoutItem>
                    }
                </DxFormLayoutGroup>
            </DxFormLayout>
        }

        <DxFormLayout>
            <DxFormLayoutTabPages>

                <DxFormLayoutTabPage Caption="LM Studio / local OpenAI-compatible">
                    <p class="field-help">Local OpenAI-compatible servers are detected automatically. Ollama normally uses http://localhost:11434/v1; LM Studio normally uses http://localhost:1234/v1. Test Connection verifies the selected endpoint and discovers the active model id.</p>
                    <DxFormLayoutItem Caption="Endpoint (OpenAI-compatible base URL, usually /v1)">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.Endpoint" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="API Key">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.ApiKey" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Model Name">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.ModelName" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem>
                        <DxCheckBox @bind-Checked="Model.ChatGPTLocalCore.AutoStartServer"
                                    Text="Auto start server if not running" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Working Directory">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.WorkingDir" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Start Command (bat/exe)">
                        <DxTextBox @bind-Text="Model.ChatGPTLocalCore.StartCommand" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Health Timeout (s)">
                        <DxSpinEdit @bind-Value="Model.ChatGPTLocalCore.HealthTimeoutSeconds" Min="5" Max="300" />
                    </DxFormLayoutItem>

                    <div class="top-container">
                  @*       <DxButton Text="Check Python" Click="CheckPython" />
                        <DxButton Text="Install Dependencies" Click="InstallDependencies" />
                        <DxButton Text="Download Model" Click="DownloadModel" /> *@
                        <DxButton Text="Start Local Server" Click="StartLocal" />
                        <DxButton Text="Test Connection" Click="TestLocal" />
                        <DxButton Text="Save provider settings"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Click="Save" />
                    </div>

                    <DxFormLayoutItem Caption="Additional OpenAI-compatible hosts">
                        <DxButton Text="Add Host"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Click="AddOpenAiCompatibleHost" />
                    </DxFormLayoutItem>
                    @foreach (var host in AdditionalOpenAiCompatibleHosts)
                    {
                        <DxFormLayoutItem Caption="Endpoint">
                            <DxTextBox @bind-Text="host.Endpoint" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="API Key">
                            <DxTextBox @bind-Text="host.ApiKey" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Preferred model">
                            <DxTextBox @bind-Text="host.ModelName" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem>
                            <div class="configured-provider-actions">
                                <DxButton Text="Test connection" Click="@(() => TestOpenAiCompatibleHostAsync(host))" />
                                <DxButton Text="Save provider settings"
                                          RenderStyle="ButtonRenderStyle.Primary"
                                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                                          Click="Save" />
                                <DxButton Text="Remove"
                                          RenderStyle="ButtonRenderStyle.Danger"
                                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                                          Click="@(() => RemoveOpenAiCompatibleHostAsync(host))" />
                            </div>
                        </DxFormLayoutItem>
                    }
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="Ollama">
                    <p class="field-help">@T("Install.Ollama.AdditiveHostHelp", "The fields below describe the current primary Ollama host. Adding or selecting another endpoint is additive; an existing host is removed only by an explicit Remove action. Use Make primary in the configured host catalog to change the default host.")</p>
                    <DxFormLayoutItem Caption="URI">
                        <DxTextBox @bind-Text="Model.OllamaCore.Uri" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Model">
                        <DxTextBox @bind-Text="Model.OllamaCore.ModelName" />
                    </DxFormLayoutItem>
                    <div class="configured-provider-actions">
                        <DxButton Text="Test Connection" Click="TestOllama" />
                        <DxButton Text="Save provider settings"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Click="Save" />
                    </div>

                    <DxFormLayoutItem Caption="Additional Ollama hosts / preferred models">
                        <DxButton Text="Add Ollama host"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Click="AddOllamaModel" />
                    </DxFormLayoutItem>

                    @foreach (var ollama in AdditionalOllamaModels)
                    {
                        <DxFormLayoutItem Caption="URI">
                            <DxTextBox @bind-Text="ollama.Uri" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Model">
                            <DxTextBox @bind-Text="ollama.ModelName" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem>
                            <div class="configured-provider-actions">
                                <DxButton Text="Test connection" Click="@(() => TestOllamaHostAsync(ollama))" />
                                <DxButton Text="Save provider settings"
                                          RenderStyle="ButtonRenderStyle.Primary"
                                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                                          Click="Save" />
                                <DxButton Text="Remove"
                                          RenderStyle="ButtonRenderStyle.Danger"
                                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                                          Click="@(() => RemoveOllamaModelAsync(ollama))" />
                            </div>
                        </DxFormLayoutItem>
                    }
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="OpenAI (Cloud)">
                    <DxFormLayoutItem Caption="API Key">
                        <DxTextBox @bind-Text="Model.OpenAICore.ApiKey" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Model">
                        <DxTextBox @bind-Text="Model.OpenAICore.ModelName" />
                    </DxFormLayoutItem>
                    <DxButton Text="Test Connection" Click="TestOpenAI" />
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="Azure OpenAI">
                    <DxFormLayoutItem Caption="Endpoint">
                        <DxTextBox @bind-Text="Model.OpenAIServiceCore.Endpoint" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Key">
                        <DxTextBox @bind-Text="Model.OpenAIServiceCore.Key" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Deployment Name">
                        <DxTextBox @bind-Text="Model.OpenAIServiceCore.DeploymentName" />
                    </DxFormLayoutItem>
                    <DxButton Text="Test Connection" Click="TestAzure" />
                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="App Logging">
                    <DxFormLayoutItem Caption="Global Log Level">
                        <DxComboBox Data="@LogLevels"
                                    @bind-Value="LoggingModel.CoreLogLevel" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="SQLite Log Level">
                        <DxComboBox Data="@LogLevels"
                                    @bind-Value="DatabaseLoggerModel.CoreLogLevel" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Queue Length">
                        <DxSpinEdit @bind-Value="DatabaseLoggerModel.MaxQueueLength" Min="100" Max="50000" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Batch Size">
                        <DxSpinEdit @bind-Value="DatabaseLoggerModel.BatchSize" Min="1" Max="500" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Flush Interval (s)">
                        <DxSpinEdit @bind-Value="DatabaseLoggerModel.FlushIntervalSeconds" Min="1" Max="30" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Retention (days)">
                        <DxSpinEdit @bind-Value="DatabaseLoggerModel.RetentionDays" Min="1" Max="3660" />
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>

            </DxFormLayoutTabPages>
        </DxFormLayout>
        </section>
        </ConfigurationWorkbenchPanel>

        <ConfigurationWorkbenchPanel SectionKey="remote" ActiveKey="@ActiveInstallSection" AriaLabel="Remote endpoint">
        <section id="network-endpoint" class="installer-workbench-card install-workbench-region" aria-labelledby="network-endpoint-heading">
            <div class="installer-card-heading">
                <div>
                    <h3 id="network-endpoint-heading">Remote web endpoint (LAN / VPN / smartphone)</h3>
                    <p class="field-help">This is an optional second Kestrel listener. The existing http://127.0.0.1 LocalGPT endpoint remains unchanged. Saving these settings requires a LocalGPT restart before the listener is rebound.</p>
                </div>
            </div>
            <DxFormLayout>
                <DxFormLayoutItem Caption="Enable remote endpoint">
                    <DxCheckBox @bind-Checked="NetworkModel.Enabled" Text="Listen on a second network endpoint" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Bind address">
                    <DxTextBox @bind-Text="NetworkModel.Address" />
                    <p class="field-help">Use 0.0.0.0 for all IPv4 interfaces, :: for all IPv6 interfaces, or one concrete local interface IP.</p>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Port">
                    <DxSpinEdit @bind-Value="NetworkModel.Port" Min="0" Max="65535" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="PFX certificate path">
                    <DxTextBox @bind-Text="NetworkModel.CertificatePath" />
                    <p class="field-help">Leave empty for HTTP. Select or create a PFX below for HTTPS.</p>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="PFX password">
                    <DxTextBox @bind-Text="NetworkModel.CertificatePassword" />
                    <p class="field-help">For reusable deployments prefer LOCALGPT_NETWORK_CERTIFICATE_PASSWORD instead of persisting a production password.</p>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Effective after restart">
                    <div class="installer-status-line"><code>@NetworkEndpointPreview</code></div>
                </DxFormLayoutItem>
            </DxFormLayout>
        </section>
        </ConfigurationWorkbenchPanel>

        <ConfigurationWorkbenchPanel SectionKey="tls" ActiveKey="@ActiveInstallSection" AriaLabel="TLS certificate">
        <section id="tls-certificate" class="installer-workbench-card install-workbench-region" aria-labelledby="certificate-heading">
            <div class="installer-card-heading">
                <div>
                    <h3 id="certificate-heading">Create TLS certificate</h3>
                    <p class="field-help">Creates a user-requested self-signed server certificate with Server Authentication EKU and SAN entries. A self-signed certificate is encrypted traffic, but browsers still require the certificate or issuing authority to be trusted.</p>
                </div>
            </div>
            <DxFormLayout>
                <DxFormLayoutItem Caption="Common name">
                    <DxTextBox @bind-Text="CertificateRequest.CommonName" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Subject alternative names">
                    <DxMemo Rows="3" @bind-Text="CertificateRequest.SubjectAlternativeNames" />
                    <p class="field-help">Separate DNS names and IP addresses with semicolons. The current machine name and detected local addresses are prefilled.</p>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="RSA key size">
                    <DxComboBox Data="@CertificateKeySizes" @bind-Value="CertificateRequest.KeySize" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Hash algorithm">
                    <DxComboBox Data="@CertificateHashes" @bind-Value="CertificateRequest.Hash" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Validity (days)">
                    <DxSpinEdit @bind-Value="CertificateRequest.ValidityDays" Min="1" Max="3650" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Save PFX to">
                    <DxTextBox @bind-Text="CertificateRequest.OutputPath" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="PFX password">
                    <DxTextBox @bind-Text="CertificateRequest.Password" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Certificate store">
                    <DxCheckBox @bind-Checked="CertificateRequest.InstallToStore" Text="Install the generated certificate into a Windows/.NET certificate store" />
                </DxFormLayoutItem>
                @if (CertificateRequest.InstallToStore)
                {
                    <DxFormLayoutItem Caption="Store location">
                        <DxComboBox Data="@CertificateStoreLocations" @bind-Value="CertificateRequest.StoreLocation" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Store name">
                        <DxComboBox Data="@CertificateStoreNames" @bind-Value="CertificateRequest.StoreName" />
                    </DxFormLayoutItem>
                }
                <DxFormLayoutItem>
                    <DxCheckBox @bind-Checked="UseCreatedCertificateForRemoteEndpoint" Text="Use the generated PFX for the remote Kestrel endpoint" />
                </DxFormLayoutItem>
                <DxFormLayoutItem>
                    <DxButton Text="@(IsCertificateBusy ? "Creating certificate..." : "Create certificate")"
                              Enabled="@(!IsCertificateBusy)"
                              RenderStyle="ButtonRenderStyle.Primary"
                              RenderStyleMode="ButtonRenderStyleMode.Contained"
                              Click="CreateNetworkCertificateAsync" />
                </DxFormLayoutItem>
                @if (!string.IsNullOrWhiteSpace(CertificateStatus))
                {
                    <DxFormLayoutItem Caption="Certificate status">
                        <div class="installer-status-line">@CertificateStatus</div>
                    </DxFormLayoutItem>
                }
            </DxFormLayout>
        </section>
        </ConfigurationWorkbenchPanel>

        <ConfigurationWorkbenchPanel SectionKey="guide" ActiveKey="@ActiveInstallSection" AriaLabel="Setup guide">
        <section id="setup-guide" class="installer-workbench-card install-workbench-region" aria-labelledby="onboarding-heading">
            <div class="installer-card-heading">
                <div>
                    <h3 id="onboarding-heading">@T("Install.Onboarding.Title", "Setup guide, benchmark council and quick starts")</h3>
                    <p>@T("Install.Onboarding.PersistentHelp", "The guide remains available here after it has been reviewed. It does not disappear when completion is recorded.")</p>
                </div>
                <div class="top-container">
                    <DxButton Text='@T("Install.Onboarding.OpenDocumentation", "Open documentation")' Click="OpenDocumentation" />
                    <DxButton Text='@T("Install.Onboarding.EditTeams", "Edit Council teams")' Click="OpenCouncilTeams" />
                    <DxButton Text='@T("Install.Onboarding.Refresh", "Refresh setup guide")' Enabled="@(!IsOnboardingLoading)" Click="RefreshOnboardingAsync" />
                </div>
            </div>
            <InitialSetupAssistantPanel />

            @if (OnboardingStatus is null)
            {
                <p>@T("Install.Onboarding.Loading", "Loading installer profiles and Council quick starts...")</p>
            }
            else
            {
                <div class="installer-status-line">
                    <strong>@T("Install.Onboarding.ReviewStatus", "Review status:")</strong> @(OnboardingStatus.IsCompleted ? T("Install.Onboarding.Reviewed", "Reviewed — available for reopening") : T("Install.Onboarding.NotReviewed", "Not reviewed"))
                    <span>@T("Install.Onboarding.DetectedModels", "Detected models:") @OnboardingStatus.InstalledModels.Count</span>
                    <span>@T("Install.Onboarding.CouncilTeams", "Council teams:") @OnboardingStatus.CouncilTeamKeys.Count</span>
                </div>
                <div class="installer-quickstart-grid">
                    @foreach (var quickStart in OnboardingStatus.QuickStarts)
                    {
                        <article class="installer-quickstart-card">
                            <h4>@quickStart.DisplayName</h4>
                            <p>@quickStart.Description</p>
                            <small>Team: @quickStart.CouncilTeamKey<br />Preset: @quickStart.ModelPresetName</small>
                            <span class="installer-direct-starter-hint">@T("Install.Onboarding.DirectStarterHint", "Direct Council starter: opens a fresh AI Council chat and submits the maintained starter prompt automatically.")</span>
                            <DxButton Text='@T("Install.Onboarding.OpenInChat", "Open in Chat")' RenderStyle="ButtonRenderStyle.Primary" Click="@(() => OpenQuickStartInChat(quickStart))" />
                        </article>
                    }
                </div>
                <details class="installer-profile-details" open="@(!OnboardingStatus.IsCompleted)">
                    <summary>@T("Install.Onboarding.InstallerProfiles", "Installer profiles and recommended models/repositories")</summary>
                    <div class="installer-quickstart-grid">
                        @foreach (var profile in OnboardingStatus.InstallerProfiles)
                        {
                            <article class="installer-quickstart-card">
                                <h4>@profile.DisplayName</h4>
                                <p>@profile.Purpose</p>
                                <code>@profile.Command</code>
                                <small>@T("Install.Onboarding.Models", "Models:") @(string.IsNullOrWhiteSpace(profile.ModelSummary) ? T("Install.Onboarding.None", "none") : profile.ModelSummary)</small>
                                <small>@T("Install.Onboarding.Repositories", "Repositories:") @profile.RepositorySummary</small>
                            </article>
                        }
                    </div>
                </details>
                @if (!OnboardingStatus.IsCompleted)
                {
                    <DxButton Text='@T("Install.Onboarding.MarkReviewed", "I reviewed this setup guide")' RenderStyle="ButtonRenderStyle.Success" Enabled="@(!IsOnboardingLoading)" Click="CompleteOnboardingAsync" />
                }
            }
        </section>
        </ConfigurationWorkbenchPanel>

        <ConfigurationWorkbenchPanel SectionKey="toolchains" ActiveKey="@ActiveInstallSection" AriaLabel="Toolchains">
        <section id="toolchains" class="installer-workbench-card install-workbench-region" aria-labelledby="toolchain-heading">
            <div class="installer-card-heading">
                <div>
                    <h3 id="toolchain-heading">@T("Install.Toolchains.Title", "Compilers and runtime toolchains")</h3>
                    <p>@T("Install.Toolchains.Description", "Discover compilers, runtimes and build tools from PATH first, then Knowledge Database profiles for Windows, Linux and macOS, environment roots, and optional user roots. No online lookup runs automatically.")</p>
                </div>
                <div class="top-container">
                    <DxButton Text='@T("Install.Toolchains.Discover", "Discover and save toolchains")' RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!IsToolchainBusy)" Click="DiscoverToolchainsAsync" />
                    <DxButton Text='@T("Install.Toolchains.Refresh", "Refresh stored toolchains")' Enabled="@(!IsToolchainBusy)" Click="RefreshCompilerInstallationsAsync" />
                </div>
            </div>
            <label class="toolchain-search-roots">
                @T("Install.Toolchains.CustomRoots", "Additional search roots (one path per line)")
                <DxMemo @bind-Text="ToolchainSearchRoots" Rows="3" NullText="/opt/custom-toolchains&#10;C:\Toolchains" />
            </label>
            <details class="provider-install-guide">
                <summary><strong>Manual / custom compiler</strong> · configure any executable LocalGPT did not discover</summary>
                <p class="field-help">Autodiscovery covers the maintained common profiles, including .NET, Java/JDK, Maven/Gradle, Python, Node.js, PowerShell, GCC/G++, Clang/LLVM, CMake, Rust/Cargo, Go, PlatformIO and Arduino CLI. For vendor SDKs, alternate C/C++ toolchains, cross-compilers or private runtimes, save the executable directly here. The same persisted profile is then available to Project Maintenance, process profiles and runtime extensions.</p>
                <div class="toolchain-environment-editor-grid">
                    <label>Name<DxTextBox @bind-Text="ManualToolchainName" NullText="ARM GCC 14 / custom SDK" /></label>
                    <label>Language / family<DxTextBox @bind-Text="ManualToolchainLanguage" NullText="Cpp, DotNet, JavaScript, Custom..." /></label>
                    <label class="local-ai-runtime-policy-wide">Executable path<DxTextBox @bind-Text="ManualToolchainExecutablePath" NullText="Absolute path to compiler/runtime executable" /></label>
                    <label>Optional home path<DxTextBox @bind-Text="ManualToolchainHomePath" NullText="SDK/toolchain root" /></label>
                    <label>Kind<DxTextBox @bind-Text="ManualToolchainKind" NullText="compiler, runtime, sdk, build-tool..." /></label>
                    <label>Validation arguments<DxTextBox @bind-Text="ManualToolchainValidationArguments" NullText="--version" /></label>
                    <label>Optional knowledge profile key<DxTextBox @bind-Text="ManualToolchainKnowledgeProfileKey" NullText="custom-vendor-sdk" /></label>
                    <label class="local-ai-trust-toggle"><DxCheckBox @bind-Checked="ManualToolchainDefault" /> Default for this language/family</label>
                    <DxButton Text="Save custom toolchain" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!IsToolchainBusy && !string.IsNullOrWhiteSpace(ManualToolchainName) && !string.IsNullOrWhiteSpace(ManualToolchainLanguage) && !string.IsNullOrWhiteSpace(ManualToolchainExecutablePath))" Click="SaveManualToolchainAsync" />
                </div>
            </details>

            @if (!string.IsNullOrWhiteSpace(ToolchainStatus))
            {
                <div class="installer-status-line"><span>@ToolchainStatus</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(ToolchainRuntimeStatus))
            {
                <div class="installer-status-line"><span>@ToolchainRuntimeStatus</span></div>
            }

            <details class="provider-install-guide" open>
                <summary><strong>Python for embedded AI</strong> · discovery and LocalGPT-managed environment</summary>
                <p class="field-help">The Python finder and linker live with the other toolchains. Discovery uses the same local knowledge profiles as .NET, Node.js, Java and native tools. Linking Python does not require a machine-wide PATH rewrite.</p>
                <div class="toolchain-actions">
                    <DxButton Text="Discover Python runtimes" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!LocalAiBusy && !ToolchainRuntimeBusy)" Click="DiscoverLocalAiPythonAsync" />
                    <DxButton Text="Create managed Python environment + core" Enabled="@(!LocalAiBusy && !ToolchainRuntimeBusy)" Click="CreateLocalAiEnvironmentAsync" />
                    <DxButton Text="Refresh toolchain helpers" Enabled="@(!ToolchainRuntimeBusy)" Click="RefreshToolchainRuntimeManagementAsync" />
                </div>
                @if (LocalAiPythonCandidates.Count > 0)
                {
                    <div class="toolchain-grid local-ai-candidate-grid">
                        @foreach (var candidate in LocalAiPythonCandidates)
                        {
                            <article class="toolchain-card">
                                <header><div><h4>Python @candidate.Version</h4><small>@candidate.DiscoverySource</small></div></header>
                                <code>@candidate.ExecutablePath</code>
                                <small>Home: @candidate.PythonHome</small>
                                <small>CPython shared runtime: @(candidate.RuntimeLibraryDetected ? candidate.PythonRuntimeLibrary : "not resolved")</small>
                                <DxButton Text="Use this Python for Local AI" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!LocalAiBusy && !ToolchainRuntimeBusy && candidate.RuntimeLibraryDetected)" Click="@(() => SelectLocalAiPythonAsync(candidate))" />
                            </article>
                        }
                    </div>
                }
            </details>

            <details class="provider-install-guide" open>
                <summary><strong>Reviewed online acquisition</strong> · direct manufacturer/GitHub downloads, never auto-executed</summary>
                <p class="field-help">LocalGPT can download reviewed toolchain artifacts directly over HTTPS without GitHub CLI. Python, .NET and Node.js are first-class entries; additional upstream source archives are available for build tools. Downloads require approval and are never executed automatically.</p>
                <div class="toolchain-grid toolchain-acquisition-grid">
                    @foreach (var source in ToolchainAcquisitionSources)
                    {
                        <article class="toolchain-card @(source.SupportedOnCurrentPlatform ? string.Empty : "toolchain-card-muted")">
                            <header><div><h4>@source.DisplayName</h4><small>@source.Publisher · @source.SourceKind · @source.Version</small></div></header>
                            <small>Profile: <code>@source.ProfileKey</code> · target: @source.Platform</small>
                            <code>@source.DownloadUri</code>
                            <p>@source.InstallHint</p>
                            <DxButton Text="Download reviewed artifact" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!ToolchainRuntimeBusy && source.SupportedOnCurrentPlatform)" Click="@(() => DownloadToolchainSourceAsync(source))" />
                        </article>
                    }
                </div>
            </details>

            <details class="provider-install-guide" open>
                <summary><strong>Reusable process profiles</strong> · database-backed runtime commands and AI capability bindings</summary>
                <p class="field-help">Profiles bind a registered toolchain to a module, script or executable without a command shell. Python/Whisper, .NET, Java/Maven, Node.js, C/C++, Go and custom executables use the same persisted contract. AI functions can list, save and run these profiles through the normal approval/permission UI.</p>
                <div class="toolchain-environment-editor-grid">
                    <label>Profile key
                        <DxTextBox @bind-Text="ToolchainProfileKey" NullText="speech.whisper" />
                    </label>
                    <label>Name
                        <DxTextBox @bind-Text="ToolchainProfileName" NullText="Whisper transcription" />
                    </label>
                    <label>Capability
                        <DxTextBox @bind-Text="ToolchainProfileCapability" NullText="speech.transcribe" />
                    </label>
                    <label>Execution kind
                        <DxComboBox Data="@ToolchainExecutionKinds" @bind-Value="ToolchainProfileExecutionKind" />
                    </label>
                    <label>Toolchain installation
                        <DxComboBox Data="@CompilerInstallations" TextFieldName="@nameof(ProjectCompilerInstallation.Name)" ValueFieldName="@nameof(ProjectCompilerInstallation.Id)" @bind-Value="ToolchainProfileInstallationId" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </label>
                    <label>Module / script / executable entry point
                        <DxTextBox @bind-Text="ToolchainProfileEntryPoint" NullText="whisper" />
                    </label>
                    <label>Working directory
                        <DxTextBox @bind-Text="ToolchainProfileWorkingDirectory" NullText="optional" />
                    </label>
                    <label>Arguments JSON array
                        <DxMemo @bind-Text="ToolchainProfileArgumentsJson" Rows="2" />
                    </label>
                    <label>Environment JSON object
                        <DxMemo @bind-Text="ToolchainProfileEnvironmentJson" Rows="2" />
                    </label>
                    <label>Capability configuration JSON
                        <DxMemo @bind-Text="ToolchainProfileConfigurationJson" Rows="3" />
                    </label>
                    <label class="local-ai-trust-toggle"><DxCheckBox @bind-Checked="ToolchainProfileIsDefault" /> Default for capability</label>
                    <label class="local-ai-trust-toggle"><DxCheckBox @bind-Checked="ToolchainProfileRequiresApproval" /> Require approval before execution</label>
                    <DxButton Text="Save process profile" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!ToolchainRuntimeBusy && !string.IsNullOrWhiteSpace(ToolchainProfileKey) && !string.IsNullOrWhiteSpace(ToolchainProfileName))" Click="SaveToolchainExecutionProfileAsync" />
                </div>
                @if (ToolchainProfiles.Count > 0)
                {
                    <div class="toolchain-grid">
                        @foreach (var profile in ToolchainProfiles)
                        {
                            <article class="toolchain-card">
                                <header><div><h4>@profile.Name</h4><small>@profile.ProfileKey · @profile.CapabilityKey</small></div></header>
                                <small>@profile.ExecutionKind · @(profile.ToolchainInstallationId?.ToString() ?? "standalone")</small>
                                <code>@profile.EntryPoint</code>
                                <div class="toolchain-actions">
                                    <DxButton Text="Edit" Enabled="@(!ToolchainRuntimeBusy)" Click="@(() => EditToolchainExecutionProfile(profile))" />
                                    <DxButton Text="Run" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!ToolchainRuntimeBusy)" Click="@(() => RunToolchainExecutionProfileAsync(profile))" />
                                </div>
                            </article>
                        }
                    </div>
                }
            </details>

            <details class="provider-install-guide" open>
                <summary><strong>Environment variables</strong> · effective, process, LocalGPT application, user and machine scopes</summary>
                <p class="field-help">Credential-like values are redacted in the list. Application overrides are persisted by LocalGPT and applied to its process without rewriting global environment settings. User/Machine mutation is exposed only where the runtime supports it.</p>
                <div class="toolchain-environment-editor-grid">
                    <label>Filter visible variables
                        <DxTextBox @bind-Text="ToolchainEnvironmentSearch" NullText="PATH, PYTHON, DOTNET, NODE..." />
                    </label>
                    <label>Variable name
                        <DxTextBox @bind-Text="ToolchainEnvironmentName" NullText="MY_TOOL_HOME" />
                    </label>
                    <label>Scope
                        <DxComboBox Data="@ToolchainEnvironmentWritableScopes" @bind-Value="ToolchainEnvironmentEditScope" />
                    </label>
                    <label>Optional toolchain owner (Application scope)
                        <DxComboBox Data="@CompilerInstallations" TextFieldName="@nameof(ProjectCompilerInstallation.Name)" ValueFieldName="@nameof(ProjectCompilerInstallation.Id)" @bind-Value="ToolchainEnvironmentToolchainId" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </label>
                    <label>Value
                        <DxTextBox @bind-Text="ToolchainEnvironmentValue" NullText="New value" />
                    </label>
                    <label class="local-ai-trust-toggle"><DxCheckBox @bind-Checked="ToolchainEnvironmentRemove" /> Remove from selected scope</label>
                    <DxButton Text="Apply environment change" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!ToolchainRuntimeBusy && !string.IsNullOrWhiteSpace(ToolchainEnvironmentName))" Click="ChangeToolchainEnvironmentAsync" />
                </div>
                @if (ToolchainEnvironmentSnapshot is not null)
                {
                    <div class="toolchain-environment-list">
                        @foreach (var entry in VisibleToolchainEnvironmentEntries)
                        {
                            <div class="toolchain-environment-row">
                                <strong>@entry.Name</strong>
                                <code>@entry.Value</code>
                                <small>@entry.Scope · @entry.Source@(entry.IsOverridden ? " · overridden" : string.Empty)@(entry.IsSensitive ? " · redacted" : string.Empty)</small>
                            </div>
                        }
                    </div>
                    @if (VisibleToolchainEnvironmentEntries.Count >= 300)
                    {
                        <p class="field-help">Showing the first 300 matching rows. Narrow the filter to inspect a specific variable.</p>
                    }
                }
            </details>

            <details class="provider-install-guide" open>
                <summary><strong>Embedded / ESP32 / Arduino</strong> · existing firmware planning and compiler integration</summary>
                <p class="field-help">LocalGPT still includes ESP32/Arduino board and GPIO planning, Arduino sketch generation, transport-neutral telemetry contracts, the embedded wiring Council starter, and DXFunctions. Arduino CLI and PlatformIO are normal Toolchain profiles: discover them from PATH or configure another compatible compiler/runtime manually, then use Project Maintenance for approved build verification.</p>
            </details>

            @if (CompilerInstallations.Count == 0)
            {
                <p class="field-help">@T("Install.Toolchains.None", "No stored toolchains yet. Discovery is explicit and only saves detected executable paths after you press the button.")</p>
            }
            else
            {
                <div class="toolchain-grid">
                    @foreach (var compiler in CompilerInstallations)
                    {
                        <article class="toolchain-card">
                            <header>
                                <div>
                                    <h4>@compiler.Name</h4>
                                    <small>@compiler.Language · @(string.IsNullOrWhiteSpace(compiler.Version) ? T("Install.Toolchains.VersionUnknown", "version not validated") : compiler.Version)</small>
                                </div>
                                @if (compiler.IsDefaultForLanguage)
                                {
                                    <strong class="toolchain-default-badge">@T("Install.Toolchains.Default", "Default")</strong>
                                }
                            </header>
                            <code>@compiler.ExecutablePath</code>
                            <small>@compiler.DiscoverySource · @(compiler.LastValidationSucceeded ? T("Install.Toolchains.Valid", "validated") : T("Install.Toolchains.Unvalidated", "not validated"))</small>
                            @if (!string.IsNullOrWhiteSpace(compiler.ToolchainKind) || !string.IsNullOrWhiteSpace(compiler.DetectedPlatform))
                            {
                                <small>Kind/platform: <strong>@(string.IsNullOrWhiteSpace(compiler.ToolchainKind) ? "toolchain" : compiler.ToolchainKind)</strong> · @(string.IsNullOrWhiteSpace(compiler.DetectedPlatform) ? "unknown" : compiler.DetectedPlatform)</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(compiler.KnowledgeProfileKey))
                            {
                                <small>Knowledge profile: <code>@compiler.KnowledgeProfileKey</code>@(compiler.VersionKnowledgeEntryId is null ? string.Empty : " · exact version knowledge linked")</small>
                            }
                            <ToolchainEnvironmentEditor Compiler="compiler" Changed="RefreshCompilerInstallationsAsync" />
                            @if (!string.IsNullOrWhiteSpace(compiler.LastValidationMessage))
                            {
                                <p class="toolchain-validation-message">@compiler.LastValidationMessage</p>
                            }
                            <div class="toolchain-actions">
                                <DxButton Text='@T("Install.Toolchains.Validate", "Validate")' Enabled="@(!IsToolchainBusy)" Click="@(() => ValidateCompilerAsync(compiler.Id))" />
                                <DxButton Text='@T("Install.Toolchains.MakeDefault", "Use as language default")' Enabled="@(!IsToolchainBusy && !compiler.IsDefaultForLanguage)" Click="@(() => MakeCompilerDefaultAsync(compiler))" />
                                <DxButton Text='@T("Install.Toolchains.Remove", "Remove")' RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline" Enabled="@(!IsToolchainBusy)" Click="@(() => DeleteCompilerAsync(compiler.Id))" />
                            </div>
                        </article>
                    }
                </div>
            }

            <details class="provider-install-guide" open>
                <summary><strong>Runtime extensions</strong> · database-backed C# scripts, JavaScript and isolated .NET plugins</summary>
                <p class="field-help">Definitions and source/package payloads live in LocalGPT persistence. C# scripts compile through a configured .NET toolchain; JavaScript uses a configured Node-compatible runtime. Trusted compiled plugins are materialized from their database payload and loaded into a collectible AssemblyLoadContext. All exposed plugin.* functions still pass through the central DXFunction schema, catalog policy and human-approval/deferred-execution gate.</p>
                <div class="toolchain-actions">
                    <DxButton Text="New runtime extension" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!RuntimePluginBusy)" Click="NewRuntimePlugin" />
                    <DxButton Text="Refresh extensions" Enabled="@(!RuntimePluginBusy)" Click="RefreshRuntimePluginsAsync" />
                </div>
                @if (!string.IsNullOrWhiteSpace(RuntimePluginStatus))
                {
                    <p class="field-help">@RuntimePluginStatus</p>
                }
                @if (RuntimePluginDefinitions.Count == 0)
                {
                    <p class="field-help">No user runtime extensions are persisted yet.</p>
                }
                else
                {
                    <div class="toolchain-grid">
                        @foreach (var plugin in RuntimePluginDefinitions)
                        {
                            <article class="toolchain-card">
                                <header><div><h4>@plugin.Name</h4><small>@plugin.Kind · <code>@plugin.FunctionName</code></small></div></header>
                                <p>@plugin.Purpose</p>
                                <small>@plugin.LastBuildStatus@(plugin.LastLoadedAtUtc is null ? string.Empty : $" · loaded {plugin.LastLoadedAtUtc:u}")</small>
                                @if (!string.IsNullOrWhiteSpace(plugin.LastBuildMessage))
                                {
                                    <p class="toolchain-validation-message">@plugin.LastBuildMessage</p>
                                }
                                <div class="toolchain-actions">
                                    <DxButton Text="Edit" Enabled="@(!RuntimePluginBusy)" Click="@(() => EditRuntimePlugin(plugin))" />
                                    <DxButton Text="Build / load" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!RuntimePluginBusy && plugin.IsEnabled)" Click="@(() => BuildRuntimePluginAsync(plugin.Id))" />
                                    <DxButton Text="Remove" RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline" Enabled="@(!RuntimePluginBusy)" Click="@(() => DeleteRuntimePluginAsync(plugin.Id))" />
                                </div>
                            </article>
                        }
                    </div>
                }
            </details>

            <DxPopup @bind-Visible="RuntimePluginEditorVisible"
                     HeaderText="Runtime extension editor"
                     Width="min(92rem, 97vw)"
                     MaxHeight="94dvh"
                     CloseOnOutsideClick="false">
                <BodyContentTemplate Context="runtimePluginPopupContext">
                    <div class="runtime-plugin-editor-shell">
                        <div class="execution-boundary">Executable extension content is persisted in the LocalGPT database. Saving does not execute it. Build / load is a separate explicit action. Compiled .NET plugins are trusted in-process code and are not a security boundary.</div>
                        <DxFormLayout CssClass="runtime-plugin-form">
                            <DxFormLayoutItem Caption="Name" ColSpanMd="3">
                                <DxTextBox @bind-Text="RuntimePluginDraft.Name" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Function name" ColSpanMd="3">
                                <DxTextBox @bind-Text="RuntimePluginDraft.FunctionName" NullText="plugin.example" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Kind" ColSpanMd="3">
                                <DxComboBox Data="@RuntimePluginKinds"
                                            Value="@RuntimePluginDraft.Kind"
                                            ValueChanged="@((RuntimePluginKind kind) => RuntimePluginKindChanged(kind))" />
                            </DxFormLayoutItem>
                            @if (RuntimePluginDraft.Kind is RuntimePluginKind.CSharpScript or RuntimePluginKind.JavaScript)
                            {
                                <DxFormLayoutItem Caption="Compiler/runtime" ColSpanMd="3">
                                    <DxComboBox Data="@RuntimePluginCompilerInstallations"
                                                TextFieldName="@nameof(ProjectCompilerInstallation.Name)"
                                                ValueFieldName="@nameof(ProjectCompilerInstallation.Id)"
                                                @bind-Value="RuntimePluginDraft.CompilerInstallationId"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                NullText="Use validated default" />
                                </DxFormLayoutItem>
                            }
                            <DxFormLayoutItem Caption="Purpose" ColSpanMd="6">
                                <DxMemo @bind-Text="RuntimePluginDraft.Purpose" Rows="3" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Safety notes" ColSpanMd="6">
                                <DxMemo @bind-Text="RuntimePluginDraft.SafetyNotes" Rows="3" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Parameter JSON Schema" ColSpanMd="12">
                                <DxMemo @bind-Text="RuntimePluginDraft.ParameterSchemaJson" Rows="4" />
                            </DxFormLayoutItem>

                            @if (RuntimePluginDraft.Kind is RuntimePluginKind.CSharpScript or RuntimePluginKind.JavaScript)
                            {
                                <DxFormLayoutItem Caption="Script source" ColSpanMd="12">
                                    <DxHtmlEditor @bind-Markup="RuntimePluginSourceMarkup"
                                                  BindMarkupMode="HtmlEditorBindMarkupMode.OnDelayedInput"
                                                  InputDelay="120"
                                                  CustomizeToolbar="CustomizeRuntimePluginEditorToolbar"
                                                  Width="100%"
                                                  Height="min(48dvh, 34rem)"
                                                  CssClass="runtime-plugin-source-editor" />
                                </DxFormLayoutItem>
                                <DxFormLayoutGroup Caption="IDE helper · runtime contract and script entry-point hints" ColSpanMd="12">
                                    <DxFormLayoutItem ColSpanMd="12">
                                        @if (RuntimePluginDraft.Kind == RuntimePluginKind.CSharpScript)
                                        {
                                            <div class="field-help">Write the body of <code>Task&lt;string&gt; ExecuteAsync(JsonElement parameters, CancellationToken cancellationToken)</code>. LocalGPT generates the contract wrapper, compiles it through a validated configured .NET SDK, and keeps <code>LocalGPT.PluginContracts</code> host-owned.</div>
                                        }
                                        else
                                        {
                                            <div class="field-help">The JavaScript file receives validated parameters JSON on stdin and returns text or JSON on stdout. It runs through a validated configured Node-compatible runtime.</div>
                                        }
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem ColSpanMd="12">
                                        <DxButton Text="Insert starter template" Enabled="@(!RuntimePluginBusy)" Click="InsertRuntimePluginTemplate" />
                                    </DxFormLayoutItem>
                                </DxFormLayoutGroup>
                            }
                            else
                            {
                                <DxFormLayoutItem Caption="Entry assembly" ColSpanMd="6">
                                    <DxTextBox @bind-Text="RuntimePluginDraft.EntryAssemblyName" NullText="MyPlugin.dll" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Entry type" ColSpanMd="6">
                                    <DxTextBox @bind-Text="RuntimePluginDraft.EntryTypeName" NullText="MyPlugin.EntryPoint" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Plugin ZIP as base64" ColSpanMd="12">
                                    <DxMemo @bind-Text="RuntimePluginDraft.PackagePayloadBase64" Rows="8" NullText="Persisted package payload" />
                                </DxFormLayoutItem>
                            }

                            <DxFormLayoutItem Caption="Enabled" ColSpanMd="3">
                                <DxCheckBox @bind-Checked="RuntimePluginDraft.IsEnabled" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Expose to AI" ColSpanMd="3">
                                <DxCheckBox @bind-Checked="RuntimePluginDraft.AvailableToAi" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Declares read-only behavior" ColSpanMd="3">
                                <DxCheckBox @bind-Checked="RuntimePluginDraft.IsReadOnly" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Require human confirmation" ColSpanMd="3">
                                <DxCheckBox @bind-Checked="RuntimePluginDraft.RequiresHumanConfirmation" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Permit automatic invocation when policy allows" ColSpanMd="12">
                                <DxCheckBox @bind-Checked="RuntimePluginDraft.SupportsAutomaticInvocation" />
                            </DxFormLayoutItem>
                        </DxFormLayout>

                        @if (!string.IsNullOrWhiteSpace(RuntimePluginStatus))
                        {
                            <div class="toolchain-validation-message">@RuntimePluginStatus</div>
                        }

                        <div class="toolchain-actions runtime-plugin-editor-actions">
                            <DxButton Text="Save definition"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      Enabled="@(!RuntimePluginBusy)"
                                      Click="SaveRuntimePluginAsync" />
                            <DxButton Text="Save + Build / load"
                                      RenderStyle="ButtonRenderStyle.Primary"
                                      Enabled="@(!RuntimePluginBusy && RuntimePluginDraft.IsEnabled)"
                                      Click="SaveAndBuildRuntimePluginAsync" />
                            <DxButton Text="Close"
                                      Enabled="@(!RuntimePluginBusy)"
                                      Click="CloseRuntimePluginEditor" />
                        </div>
                    </div>
                </BodyContentTemplate>
            </DxPopup>
        </section>
        </ConfigurationWorkbenchPanel>

        <ConfigurationWorkbenchPanel SectionKey="local-ai" ActiveKey="@ActiveInstallSection" AriaLabel="Local AI runtimes">
        <section id="local-ai-runtime" class="installer-workbench-card install-workbench-region local-ai-runtime-workbench" aria-labelledby="local-ai-runtime-heading">
            <div class="installer-card-heading">
                <div>
                    <span class="install-region-kicker">Specialized model runtime</span>
                    <h3 id="local-ai-runtime-heading">Local AI models &amp; Python capabilities</h3>
                    <p>Direct reviewed upstream projects and Python installation are the primary path. Provider-bound model hubs such as Hugging Face remain optional integrations. Specialized image/video/speech models are exposed through bounded DXFunctions rather than pretending to be conversational LLM Council members.</p>
                </div>
                <div class="top-container">
                    <DxButton Text="Refresh" Enabled="@(!LocalAiBusy)" Click="RefreshLocalAiRuntimeAsync" />
                    <DxButton Text="Probe Python.NET" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!LocalAiBusy)" Click="ProbeLocalAiRuntimeAsync" />
                    <DxButton Text="Unload cached models" Enabled="@(!LocalAiBusy)" Click="ClearLocalAiModelCacheAsync" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(LocalAiStatusText))
            {
                <div class="installer-status-line"><span>@LocalAiStatusText</span></div>
            }

            @if (LocalAiStatus is not null)
            {
                <div class="local-ai-status-grid">
                    <span><strong>Configured</strong><small>@LocalAiStatus.Configured</small></span>
                    <span><strong>Python.NET</strong><small>@(LocalAiStatus.PythonNetAvailable ? "available" : "not installed")</small></span>
                    <span><strong>Interpreter</strong><small>@(LocalAiStatus.InterpreterInitialized ? "initialized" : "not started")</small></span>
                    <span><strong>Queue</strong><small>@LocalAiStatus.QueueLength job(s)</small></span>
                    <span><strong>Models</strong><small>@LocalAiStatus.InstalledModelCount installed</small></span>
                    <span><strong>Device</strong><small>@(string.IsNullOrWhiteSpace(LocalAiStatus.DeviceSummary) ? "probe to detect" : LocalAiStatus.DeviceSummary)</small></span>
                </div>
                @if (LocalAiStatus.RestartRequired)
                {
                    <p class="local-ai-warning"><strong>Restart required:</strong> the Python binding changed after Python.NET initialization. LocalGPT will not attempt unsafe in-process rebinding.</p>
                }
            }

            @if (LocalAiRuntimePolicy is not null)
            {
                <details class="provider-install-guide" open>
                    <summary><strong>Python / Whisper execution policy</strong> · user- and AI-team configurable</summary>
                    <p class="field-help">These values are persisted in LocalGPT configuration and are also exposed through approval-aware DXFunctions and controller endpoints. They control the bounded Python job lane; arbitrary Python source is still not accepted. Queue-capacity changes after Python.NET has initialized require a restart.</p>
                    <div class="local-ai-runtime-policy-grid">
                        <label>Default device
                            <DxComboBox Data="@LocalAiDeviceOptions" @bind-Value="LocalAiRuntimePolicy.DefaultDevice" />
                        </label>
                        <label>Default Whisper model
                            <DxComboBox Data="@LocalAiWhisperVariantOptions" @bind-Value="LocalAiRuntimePolicy.DefaultWhisperModel" />
                        </label>
                        <label>Speech task
                            <DxComboBox Data="@LocalAiSpeechTaskOptions" @bind-Value="LocalAiRuntimePolicy.DefaultSpeechTask" />
                        </label>
                        <label>Speech language
                            <DxTextBox @bind-Text="LocalAiRuntimePolicy.DefaultSpeechLanguage" NullText="auto-detect" />
                        </label>
                        <label>Queue capacity
                            <DxSpinEdit @bind-Value="LocalAiRuntimePolicy.QueueCapacity" Min="1" Max="1024" />
                        </label>
                        <label>Maximum input MiB
                            <DxSpinEdit @bind-Value="LocalAiRuntimePolicy.MaximumInputMegabytes" Min="1" Max="4096" />
                        </label>
                        <label>Maximum audio seconds
                            <DxSpinEdit @bind-Value="LocalAiRuntimePolicy.MaximumAudioSeconds" Min="1" Max="86400" />
                        </label>
                        <label>Minimum audio bytes/second
                            <DxSpinEdit @bind-Value="LocalAiRuntimePolicy.MinimumAudioBytesPerSecond" Min="1" Max="1048576" />
                        </label>
                        <label class="local-ai-runtime-policy-wide">Default speech prompt
                            <DxMemo @bind-Text="LocalAiRuntimePolicy.DefaultSpeechInitialPrompt" Rows="3" NullText="Optional transcription vocabulary/context hint" />
                        </label>
                        <label class="local-ai-trust-toggle"><DxCheckBox @bind-Checked="LocalAiRuntimePolicy.CacheModels" /> Cache loaded specialized models between jobs</label>
                        <DxButton Text="Save Python / Whisper policy" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!LocalAiBusy)" Click="SaveLocalAiRuntimePolicyAsync" />
                    </div>
                    @if (LocalAiRuntimePolicy.RestartRequired)
                    {
                        <p class="local-ai-warning"><strong>Restart required:</strong> @LocalAiRuntimePolicy.RestartReason</p>
                    }
                </details>
            }

            <details class="provider-install-guide" open>
                <summary><strong>1 · Known direct model sources</strong> · GitHub/upstream first, Python runtime execution</summary>
                <p class="field-help">This is LocalGPT's primary local-AI acquisition path. Sources are pre-seeded in a reviewed catalog and downloaded directly over HTTPS without Git/GitHub CLI or a model-hub client. Python discovery/linking lives in Toolchains. OpenAI Whisper can be installed as a real executable speech model in this release; other projects remain source-download-only until their bounded adapters exist.</p>
                <div class="local-ai-model-grid">
                    @foreach (var source in LocalAiKnownModels)
                    {
                        <article class="toolchain-card">
                            <header><div><h4>@source.DisplayName</h4><small>@source.Publisher · @(source.CanInstall ? "runtime adapter available" : "source download")</small></div></header>
                            <p>@source.Description</p>
                            <small>Capabilities: @LocalAiRuntime.FormatCapabilities(source.Capabilities)</small>
                            <small>@source.RuntimePrerequisites</small>
                            <code>@source.RepositoryUri</code>
                            @if (source.Key.Equals("openai-whisper", StringComparison.OrdinalIgnoreCase))
                            {
                                <label>Whisper variant
                                    <DxComboBox Data="@source.Variants.Select(item => item.Key).ToList()" @bind-Value="LocalAiWhisperVariant" />
                                </label>
                            }
                            <div class="toolchain-actions">
                                <DxButton Text="Download upstream source" Enabled="@(!LocalAiBusy)" Click="@(() => DownloadKnownLocalAiSourceAsync(source.Key))" />
                                @if (source.CanInstall)
                                {
                                    <DxButton Text="Install real model via Python" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!LocalAiBusy)" Click="@(() => InstallKnownLocalAiModelAsync(source.Key))" />
                                }
                            </div>
                        </article>
                    }
                </div>
                <p class="field-help">Python runtime discovery, managed-environment creation, .NET/Node.js helpers and environment-variable management are intentionally centralized under <strong>Toolchains</strong>.</p>
            </details>

            <details class="provider-install-guide" open>
                <summary><strong>2 · Python capability packages</strong> · isolated profiles, no global package pollution</summary>
                <p class="field-help">The core profile supplies the Python.NET bridge only. PyTorch stays separate so CUDA, ROCm, Apple/MPS or other vendor-specific installs are never silently replaced by a generic wheel. OpenAI Whisper dependencies also avoid installing PyTorch. Model-hub clients are optional profiles. Install or change packages before probing/running the embedded interpreter; after Python.NET initializes, LocalGPT requires a restart before mutating that environment.</p>
                <div class="local-ai-profile-grid">
                    @foreach (var profile in LocalAiPackageProfiles)
                    {
                        <article class="toolchain-card">
                            <header><div><h4>@profile.DisplayName</h4><small>@profile.Key</small></div></header>
                            <p>@profile.Description</p>
                            <small>@LocalAiRuntime.FormatPackageList(profile.Packages)</small>
                            @if (profile.IncludesTorch)
                            {
                                <p class="local-ai-warning">This profile changes the PyTorch installation. Use it only when the default PyPI backend is the one you actually want.</p>
                            }
                            <DxButton Text="Install profile" Enabled="@(!LocalAiBusy)" Click="@(() => InstallLocalAiPackageProfileAsync(profile.Key))" />
                        </article>
                    }
                </div>
            </details>

            <details class="provider-install-guide" open>
                <summary><strong>3 · Optional model hubs</strong> · Hugging Face provider integration</summary>
                <p class="field-help">Hugging Face is optional, provider-bound functionality rather than LocalGPT's default model source. Search is metadata-only. Snapshot installation is available only when you explicitly choose it and install the optional hub client profile; it does not git-clone or execute repository setup scripts. Gated/private models use the configured token environment variable and custom repository code stays disabled unless explicitly approved.</p>
                <div class="local-ai-search-row">
                    <label>Search
                        <DxTextBox @bind-Text="LocalAiSearchQuery" NullText="Qwen Image, Wan, Whisper..." />
                    </label>
                    <label>Search capability filter
                        <DxComboBox Data="@LocalAiCapabilityOptions" @bind-Value="LocalAiSearchCapability" />
                    </label>
                    <label>Explicit install capability
                        <DxComboBox Data="@LocalAiCapabilityOptions" @bind-Value="LocalAiManualCapability" />
                    </label>
                    <label class="local-ai-trust-toggle"><DxCheckBox @bind-Checked="LocalAiTrustRemoteCode" /> Allow <code>trust_remote_code</code> for the model I explicitly install</label>
                    <DxButton Text="Search Hugging Face" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!LocalAiBusy)" Click="SearchHuggingFaceAsync" />
                </div>
                @if (LocalAiSearchResults.Count > 0)
                {
                    <div class="local-ai-model-grid">
                        @foreach (var model in LocalAiSearchResults)
                        {
                            <article class="toolchain-card">
                                <header><div><h4>@model.ModelId</h4><small>@(string.IsNullOrWhiteSpace(model.PipelineTag) ? model.LibraryName : model.PipelineTag)</small></div></header>
                                <small>Capabilities: @LocalAiRuntime.FormatCapabilities(model.Capabilities)</small>
                                <small>@model.Downloads downloads · @model.Likes likes@(model.IsGated ? " · gated" : string.Empty)@(model.IsPrivate ? " · private" : string.Empty)</small>
                                <DxButton Text="Install snapshot" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!LocalAiBusy && CanInstallLocalAiModel(model))" Click="@(() => InstallHuggingFaceModelAsync(model))" />
                            </article>
                        }
                    </div>
                }
            </details>

            <details class="provider-install-guide" open>
                <summary><strong>4 · Installed specialized models</strong> · Council/DXFunction capability inventory</summary>
                @if (LocalAiInstalledModels.Count == 0)
                {
                    <p class="field-help">No specialized models are installed yet.</p>
                }
                else
                {
                    <div class="local-ai-model-grid">
                        @foreach (var model in LocalAiInstalledModels)
                        {
                            <article class="toolchain-card">
                                <header><div><h4>@model.ModelId</h4><small>@model.Adapter · @model.Revision</small></div></header>
                                <small>Capabilities: @LocalAiRuntime.FormatCapabilities(model.Capabilities)</small>
                                @if (!string.IsNullOrWhiteSpace(model.SourceProvider))
                                {
                                    <small>Source: @model.SourceProvider@(string.IsNullOrWhiteSpace(model.RuntimeModelName) ? string.Empty : $" · {model.RuntimeModelName}")</small>
                                }
                                <small>Custom code: @(model.TrustRemoteCode ? "explicitly enabled" : "disabled")</small>
                                <small>Installed @(model.InstalledAtUtc.ToLocalTime().ToString("g"))</small>
                                <DxButton Text="Remove model" RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline" Enabled="@(!LocalAiBusy)" Click="@(() => RemoveLocalAiModelAsync(model.InstallationId))" />
                            </article>
                        }
                    </div>
                }
                <p class="field-help">Installed image/video/speech models become discoverable through <code>localai.*</code> DXFunctions. Image/video generation is approval-gated; workspace audio transcription is read-only and its private runtime copy is deleted after every job.</p>
            </details>
        </section>
        </ConfigurationWorkbenchPanel>

        <ConfigurationWorkbenchPanel SectionKey="languages" ActiveKey="@ActiveInstallSection" AriaLabel="Languages">
        <section id="localization" class="installer-workbench-card install-workbench-region" aria-labelledby="localization-heading">
            <div class="installer-card-heading">
                <div>
                    <h3 id="localization-heading">@T("Install.Localization.Title", "Languages and localization catalogs")</h3>
                    <p>@T("Install.Localization.Description", "English and German are shipped defaults. Any valid .NET culture can be added as a persistent JSON catalog; missing keys fall back to English.")</p>
                </div>
            </div>
            <div class="localization-catalog-list">
                @foreach (var catalog in LocalizationCatalogs)
                {
                    <span class="localization-catalog-pill">
                        @catalog.DisplayName (@catalog.Culture) · @catalog.StringCount strings
                        @if (catalog.HasUserOverride)
                        {
                            <strong>@T("Install.Localization.UserOverride", "user override")</strong>
                        }
                    </span>
                }
            </div>
            <div class="localization-import-grid">
                <label>
                    @T("Install.Localization.CultureName", "Culture name")
                    <DxTextBox @bind-Text="LocalizationCulture" NullText="fr-FR" />
                </label>
                <label class="localization-file-input">
                    @T("Install.Localization.JsonFile", "Language JSON file")
                    <DxFileInput FilesUploading="ImportLocalizationFileAsync"
                                 UploadMode="UploadMode.OnButtonClick"
                                 MaxFileCount="1"
                                 MaxFileSize="4194304"
                                 AcceptedFileTypes="@LocalizationAcceptedTypes"
                                 AllowedFileExtensions="@LocalizationAllowedExtensions" />
                </label>
                <label class="localization-overwrite">
                    <DxCheckBox @bind-Checked="OverwriteLocalizationCatalog" />
                    @T("Install.Localization.Overwrite", "Replace an existing user catalog for this culture")
                </label>
            </div>
            @if (!string.IsNullOrWhiteSpace(LocalizationImportStatus))
            {
                <div class="installer-status-line">
                    <span>@LocalizationImportStatus</span>
                    <DxButton Text='@T("Install.Localization.Activate", "Activate selected language")' Click="ActivateSelectedCulture" />
                </div>
            }
            <p class="field-help">@T("Install.Localization.FormatHelp", "Catalog format: a flat JSON object. User catalogs are stored under the current user's LocalGPT application-data directory and survive rebuilds.") <code>{ "Nav.Home": "Accueil", "Nav.Chat": "Discussion IA" }</code></p>
        </section>
        </ConfigurationWorkbenchPanel>

        <ConfigurationWorkbenchPanel SectionKey="log" ActiveKey="@ActiveInstallSection" AriaLabel="Setup activity">
        <section id="setup-log" class="installer-workbench-card install-workbench-region setup-log-card" aria-labelledby="setup-log-heading">
            <div class="installer-card-heading">
                <div>
                    <h3 id="setup-log-heading">@T("Install.Workbench.LogTitle", "Setup activity")</h3>
                    <p class="field-help">@T("Install.Workbench.LogHelp", "Operational setup messages stay visible here while technical details continue to use the application logging pipeline.")</p>
                </div>
            </div>
            <OperationalActivityFeed LocalText="@_log" Rows="16" CssClass="setup-log-editor" MaxConsoleLines="220" />
        </section>
        </ConfigurationWorkbenchPanel>
            </div>
        </div>
    </div>
    <span id="install-scroll-bottom" class="install-scroll-anchor" aria-hidden="true"></span>
</div>
