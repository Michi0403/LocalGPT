    private void AddOpenAiCompatibleHost()
    {
        Model.ChatGPTLocalCores ??= new List<ChatGPTLocalCoreOptions>();
        Model.ChatGPTLocalCores.Add(new ChatGPTLocalCoreOptions
        {
            Endpoint = "http://127.0.0.1:1234/v1",
