    /// <returns>The string produced by the operation.</returns>
    string GetEditorKind(SqliteColumnSummary column, string? value)
    {
        if (SessionEditorKinds.TryGetValue(column.Name, out var sessionKind) && !sessionKind.Equals("Automatic", StringComparison.OrdinalIgnoreCase))
