    /// <summary>
    /// Applies knowledge review preset for <see cref="Database"/>, keeping the operation consistent with the state and invariants of the surrounding database workflow.
    /// </summary>
    /// <param name="reviewStatus">Review status value supplied to the database operation and used when producing its result.</param>
    void ApplyKnowledgeReviewPreset(string reviewStatus)
    {
        try
        {
            var now = DateTime.UtcNow;
            KnowledgeEdit.ReviewStatus = reviewStatus;
            switch (reviewStatus)
            {
                case "Current":
                    KnowledgeEdit.IsArchived = false;
                    KnowledgeEdit.IsUserApproved = true;
                    KnowledgeEdit.VerificationStatus = KnowledgeEdit.VerificationStatus == "SourceBacked"
                        ? "SourceBacked"
                        : "UserVerified";
                    KnowledgeEdit.LastVerifiedAtUtc = now;
                    KnowledgeEdit.ExpiresAtUtc = null;
                    KnowledgeEdit.StalenessReason = string.Empty;
                    KnowledgeEdit.StalenessDetectedAtUtc = null;
                    KnowledgeEdit.StalenessDetectedBy = string.Empty;
                    break;
                case "NeedsUserReview":
                    KnowledgeEdit.IsArchived = false;
                    KnowledgeEdit.IsUserApproved = false;
                    if (KnowledgeEdit.VerificationStatus is "SourceBacked" or "UserVerified")
                        KnowledgeEdit.VerificationStatus = "NeedsVerification";
                    KnowledgeEdit.ExpiresAtUtc ??= now.AddDays(30);
                    KnowledgeEdit.StalenessReason = CouncilText.Fallback(KnowledgeEdit.StalenessReason, "Needs user review before the council treats it as trusted knowledge.", Logger);
                    KnowledgeEdit.StalenessDetectedAtUtc ??= now;
                    KnowledgeEdit.StalenessDetectedBy = CouncilText.Fallback(KnowledgeEdit.StalenessDetectedBy, "Database editor", Logger);
                    break;
                case "NeedsSourceRefresh":
                    KnowledgeEdit.IsArchived = false;
                    KnowledgeEdit.ExpiresAtUtc ??= now.AddDays(14);
                    KnowledgeEdit.StalenessReason = CouncilText.Fallback(KnowledgeEdit.StalenessReason, "Source should be refreshed before reuse in generation.", Logger);
                    KnowledgeEdit.StalenessDetectedAtUtc ??= now;
                    KnowledgeEdit.StalenessDetectedBy = CouncilText.Fallback(KnowledgeEdit.StalenessDetectedBy, "Database editor", Logger);
                    break;
                case "Expired":
                    KnowledgeEdit.IsUserApproved = false;
                    KnowledgeEdit.ExpiresAtUtc = now;
                    KnowledgeEdit.StalenessReason = CouncilText.Fallback(KnowledgeEdit.StalenessReason, "Marked expired by the database editor.", Logger);
                    KnowledgeEdit.StalenessDetectedAtUtc ??= now;
                    KnowledgeEdit.StalenessDetectedBy = CouncilText.Fallback(KnowledgeEdit.StalenessDetectedBy, "Database editor", Logger);
                    break;
            }

            statusText = $"Knowledge review status set to {reviewStatus}. Save the note to persist it.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
        }
    }

