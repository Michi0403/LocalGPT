    /// <summary>
    /// Persists sqlite row for <see cref="Database"/>, keeping the operation consistent with the state and invariants of the surrounding database workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task SaveSqliteRowAsync()
    {
        try
        {
            if (CurrentTable is null)
                return;

            await RunUiActionAsync(async () =>
            {
                var editableValues = CurrentTable.Columns
                    .Where(column => SelectedRow is null || !column.IsPrimaryKey)
                    .ToDictionary(
                        column => column.Name,
                        column => CouncilText.NormalizeDBNullStringValue(GetEditValue(column.Name), Logger),
                        StringComparer.OrdinalIgnoreCase);

                if (SelectedRow is null)
                {
                    await TableEditor.InsertRowAsync(CurrentTable.TableName, editableValues).ConfigureAwait(true);
                    statusText = $"Inserted row into {CurrentTable.TableName}.";
                }
                else
                {
                    var updates = editableValues
                        .Select(pair => new SqliteCellUpdate { ColumnName = pair.Key, Value = pair.Value })
                        .ToList();
                    await TableEditor.UpdateRowAsync(CurrentTable.TableName, SelectedRow.RowId, updates).ConfigureAwait(true);
                    statusText = $"Updated row {SelectedRow.RowId} in {CurrentTable.TableName}.";
                }

                await RefreshTablesOnlyAsync(loadSelectedTable: true).ConfigureAwait(true);
                Notifier.ShowSuccess(toastName, "SQLite row saved.", "Database saved");
            }, "SaveSqliteRowAsync").ConfigureAwait(true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
