@rendermode InteractiveServer
@page "/database"
@inject CouncilRuntimeService CouncilRuntime
@inject CouncilTextService CouncilText
@inject LocalGptCatalogService Catalog
@inject SqliteGridPresentationService GridPresentation
@inject IChatMemoryService ChatMemory
@inject IApplicationLogReaderService ApplicationLogs
@inject ICouncilKnowledgeService CouncilKnowledge
@inject ISqliteTableEditorService TableEditor
@inject ISqliteEditorPreferenceService EditorPreferences
@inject IKnowledgeRatingService KnowledgeRatings
@inject IRegexPatternService RegexPatterns
@inject IKnowledgeRegexLinkService KnowledgeRegexLinks
@inject ILocalGptProjectService ProjectService
@inject ILogger<Database> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<PageTitle>SQLite Database</PageTitle>

<main class="database-page localgpt-surface">
    <ToastWrapper Name="@toastName" />

    <div class="database-workbench">
        <WorkbenchHeader Eyebrow="Data studio"
                         Title="SQLite Database &amp; knowledge"
                         Subtitle="Inspect LocalGPT persistence, curate grounded knowledge and maintain explicit project/regex relationships from one responsive workbench.">
            <Actions>
                <DxButton Text="Refresh"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isBusy)"
                          Click="RefreshAllAsync" />
            </Actions>
        </WorkbenchHeader>

        @if (!string.IsNullOrWhiteSpace(statusText))
        {
            <div class="alert alert-info database-status" role="status" aria-live="polite">@statusText</div>
        }

        <div class="database-workbench-layout" aria-busy="@isBusy">
            <ConfigurationWorkbenchNav Items="@DatabaseSections"
                                       ActiveKey="@ActiveDatabaseSection"
                                       ActiveKeyChanged="OnDatabaseSectionChanged"
                                       AriaLabel="SQLite Database sections" />
            <div class="database-workbench-stage">
                <ConfigurationWorkbenchPanel SectionKey="knowledge" ActiveKey="@ActiveDatabaseSection" AriaLabel="Council knowledge and relationships">
                    <section class="knowledge-panel">
        <div class="panel-heading">
            <div>
                <h2>Council Knowledge</h2>
                <p>Shared notes the council can reuse in future prompts. Edit this like a grounded project notebook.</p>
                <p class="hint">@KnowledgeReviewSummary</p>
            </div>
            <DxButton Text="New Knowledge"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Enabled="@(!isBusy)"
                      Click="NewKnowledgeEntry" />
        </div>

        <div class="knowledge-layout">
            <div>
                <DxGrid Data="@KnowledgeEntries"
                        PageSize="8"
                        ShowSearchBox="true"
                        TextWrapEnabled="true"
                        CssClass="database-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.Topic)" Caption="Topic" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.Scope)" Caption="Scope" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.Tags)" Caption="Tags" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.Confidence)" Caption="Confidence" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.VerificationStatus)" Caption="Status" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.ReviewStatus)" Caption="Review" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.ExpiresAtUtc)" Caption="Expires UTC" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.LastVerifiedAtUtc)" Caption="Verified UTC" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.LastUsedAtUtc)" Caption="Used UTC" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.UpdatedAtUtc)" Caption="Updated UTC" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.IsUserApproved)" Caption="User Approved" />
                        <DxGridDataColumn FieldName="@nameof(CouncilKnowledgeEntry.IsPinned)" Caption="Pinned" />
                    </Columns>
                </DxGrid>
                <div class="selector-row">
                    <span title="Choose a knowledge entry to edit in the form.">
                        <DxComboBox Data="@KnowledgeEntries"
                                    Value="@SelectedKnowledgeEntry"
                                    TextFieldName="@nameof(CouncilKnowledgeEntry.DisplayName)"
                                    CssClass="knowledge-selector"
                                    ValueChanged="@((CouncilKnowledgeEntry entry) => SelectKnowledgeEntryAsync(entry))" />
                    </span>
                </div>
            </div>

            <div class="editor-panel">
                <label title="Short name used by the council briefing.">
                    Topic
                    <DxTextBox @bind-Text="KnowledgeEdit.Topic" />
                </label>
                <label title="Use a scope such as AI Council, Minecraft Builder, DevExpress, setup, or diagnostics.">
                    Scope
                    <DxTextBox @bind-Text="KnowledgeEdit.Scope" />
                </label>
                <label title="The actual reusable note. Keep facts grounded and correct stale notes later.">
                    Content
                    <DxMemo @bind-Text="KnowledgeEdit.Content" Rows="7" />
                </label>
                <label title="Docs, official references, sample repositories, or URLs the council wants next time.">
                    Helpful Sources
                    <DxMemo @bind-Text="KnowledgeEdit.HelpfulSources" Rows="3" />
                </label>
                <label title="Semicolon-separated tags help the council and humans filter notes.">
                    Tags
                    <DxTextBox @bind-Text="KnowledgeEdit.Tags" />
                </label>
                <label title="Trust bucket used by the council. Suggested values: SourceBacked, UserVerified, ModelSuggested, NeedsVerification, Archived.">
                    Verification Status
                    <DxTextBox @bind-Text="KnowledgeEdit.VerificationStatus" />
                </label>
                <label title="Lifecycle bucket shown to humans and used by the council briefing filter.">
                    Review Status
                    <DxComboBox Data="@ReviewStatusOptions"
                                @bind-Value="KnowledgeEdit.ReviewStatus" />
                </label>
                <label title="Optional UTC date after which this note should stop influencing the council. Use ISO format such as 2026-06-30T12:00:00Z.">
                    Expires At UTC
                    <DxTextBox Text="@CouncilText.FormatNullableUtc(KnowledgeEdit.ExpiresAtUtc, Logger)"
                               TextChanged="@((string value) => KnowledgeEdit.ExpiresAtUtc = CouncilText.ParseNullableUtc(value,Logger))" />
                </label>
                <label title="UTC date when a human or source-backed import last verified this note.">
                    Last Verified UTC
                    <DxTextBox Text="@CouncilText.FormatNullableUtc(KnowledgeEdit.LastVerifiedAtUtc, Logger)"
                               TextChanged="@((string value) => KnowledgeEdit.LastVerifiedAtUtc = CouncilText.ParseNullableUtc(value,Logger))" />
                </label>
                <label title="Optional knowledge id that replaces this entry when Review Status is Superseded.">
                    Superseded By Knowledge Id
                    <DxTextBox Text="@CouncilText.FormatNullableGuid(KnowledgeEdit.SupersededByKnowledgeId, Logger)"
                               TextChanged="@((string value) => KnowledgeEdit.SupersededByKnowledgeId = CouncilText.ParseNullableGuid(value,Logger))" />
                </label>
                <label title="Why this note needs refresh, diagnostics, expiry, or replacement.">
                    Staleness Reason
                    <DxMemo @bind-Text="KnowledgeEdit.StalenessReason" Rows="2" />
                </label>
                <label title="Who or what detected the stale state. Examples: user, LocalGPT importer, DXAiChat parser, diagnostic route.">
                    Staleness Detected By
                    <DxTextBox @bind-Text="KnowledgeEdit.StalenessDetectedBy" />
                </label>
                <label title="Source fingerprint. Source-backed imports fill this automatically; humans can paste a source hash when needed.">
                    Source Hash
                    <DxTextBox @bind-Text="KnowledgeEdit.SourceHash" />
                </label>
                <label title="Optional UTC date of the source material this knowledge summarizes.">
                    Source Date UTC
                    <DxTextBox Text="@CouncilText.FormatNullableUtc(KnowledgeEdit.SourceDateUtc, Logger)"
                               TextChanged="@((string value) => KnowledgeEdit.SourceDateUtc = CouncilText.ParseNullableUtc(value,Logger))" />
                </label>
                <div class="form-row">
                    <label title="How reliable the note currently is.">
                        Confidence
                        <DxSpinEdit @bind-Value="KnowledgeEdit.Confidence" MinValue="0" MaxValue="100" />
                    </label>
                    <DxCheckBox @bind-Checked="KnowledgeEdit.IsUserApproved" Text="User approved" />
                    <DxCheckBox @bind-Checked="KnowledgeEdit.IsPinned" Text="Pinned" />
                    <DxCheckBox @bind-Checked="KnowledgeEdit.IsArchived" Text="Archived" />
                </div>
                <fieldset class="knowledge-rating-panel">
                    <legend>Human knowledge rating</legend>
                    <p class="hint">Rate and explicitly approve collected knowledge before the council treats it as grounded input.</p>
                    <div class="form-row">
                        <label>Accuracy
                            <DxComboBox Data="@KnowledgeAccuracyOptions" @bind-Value="KnowledgeRatingEdit.AccuracyStatus" />
                        </label>
                        <label>Rating
                            <DxSpinEdit @bind-Value="KnowledgeRatingEdit.Rating" MinValue="0" MaxValue="100" />
                        </label>
                        <DxCheckBox @bind-Checked="KnowledgeRatingEdit.ApprovedForCouncilUse" Text="Approve for council use" />
                    </div>
                    <label>Rating notes
                        <DxMemo @bind-Text="KnowledgeRatingEdit.Notes" Rows="2" />
                    </label>
                    <DxButton Text="Save human rating"
                              RenderStyle="ButtonRenderStyle.Success"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy && SelectedKnowledgeEntry is not null)"
                              Click="SaveKnowledgeRatingAsync" />
                </fieldset>

                <fieldset class="knowledge-relationship-panel">
                    <legend>Knowledge recognition patterns</legend>
                    <p class="hint">Connect reusable RegEx rules to this note with an explicit meaning instead of hiding aliases, names and recognition structure inside free-form tags.</p>
                    @if (SelectedKnowledgeEntry is null)
                    {
                        <p class="hint">Save the knowledge note first, then connect recognition patterns.</p>
                    }
                    else
                    {
                        <div class="relationship-editor-grid">
                            <label title="Choose an existing pattern from the user-maintained RegEx system.">
                                RegEx pattern
                                <DxComboBox Data="@RelationshipRegexPatterns"
                                            Value="@SelectedRelationshipRegexPattern"
                                            TextFieldName="@nameof(RegexPattern.Name)"
                                            ValueChanged="@((RegexPattern value) => SelectedRelationshipRegexPattern = value)" />
                            </label>
                            <label title="Describe how this pattern participates in knowledge recognition.">
                                Meaning type
                                <DxComboBox Data="@RegexRelationshipPurposeOptions" @bind-Value="KnowledgeRegexPurpose" />
                            </label>
                            <DxCheckBox @bind-Checked="KnowledgeRegexEnabled" Text="Recognition link enabled" />
                        </div>
                        <label title="Explain what a successful match means in the context of this knowledge entry.">
                            Match meaning
                            <DxMemo @bind-Text="KnowledgeRegexMeaning" Rows="2" />
                        </label>
                        <div class="run-row">
                            <DxButton Text="Link / update RegEx"
                                      RenderStyle="ButtonRenderStyle.Primary"
                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                      Enabled="@(!isBusy && SelectedRelationshipRegexPattern is not null)"
                                      Click="SaveKnowledgeRegexRelationshipAsync" />
                        </div>

                        <div class="recognition-test-panel">
                            <label title="Transient test text is evaluated locally and is not persisted by the relationship service.">
                                Test recognition text
                                <DxMemo @bind-Text="KnowledgeRecognitionTestText" Rows="2" />
                            </label>
                            <DxButton Text="Test linked patterns"
                                      RenderStyle="ButtonRenderStyle.Secondary"
                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                      Enabled="@(!isBusy && !string.IsNullOrWhiteSpace(KnowledgeRecognitionTestText) && KnowledgeRegexRelationships.Count > 0)"
                                      Click="TestKnowledgeRecognitionAsync" />
                            @if (KnowledgeRecognitionMatches.Count > 0)
                            {
                                <div class="recognition-match-list" aria-label="Recognition matches">
                                    @foreach (var match in KnowledgeRecognitionMatches)
                                    {
                                        <span class="recognition-match">@match.DisplayName</span>
                                    }
                                </div>
                            }
                        </div>

                        @if (KnowledgeRegexRelationships.Count > 0)
                        {
                            <div class="relationship-list" aria-label="Linked RegEx patterns">
                                @foreach (var link in KnowledgeRegexRelationships)
                                {
                                    <article class="relationship-card">
                                        <div>
                                            <strong>@link.DisplayName</strong>
                                            @if (!string.IsNullOrWhiteSpace(link.Meaning))
                                            {
                                                <small>@link.Meaning</small>
                                            }
                                        </div>
                                        <div class="relationship-actions">
                                            <DxButton Text="Edit"
                                                      RenderStyle="ButtonRenderStyle.Secondary"
                                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                      Enabled="@(!isBusy)"
                                                      Click="@(() => EditKnowledgeRegexRelationship(link))" />
                                            <DxButton Text="Unlink"
                                                      RenderStyle="ButtonRenderStyle.Danger"
                                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                      Enabled="@(!isBusy)"
                                                      Click="@(() => RemoveKnowledgeRegexRelationshipAsync(link))" />
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    }
                </fieldset>

                <fieldset class="knowledge-relationship-panel">
                    <legend>Project knowledge scope</legend>
                    <p class="hint">The database already owns project-topic-to-knowledge links. This editor makes that relationship reachable instead of relying on Council runs to create it indirectly.</p>
                    @if (SelectedKnowledgeEntry is null)
                    {
                        <p class="hint">Save the knowledge note first, then connect it to a project topic.</p>
                    }
                    else
                    {
                        <div class="relationship-editor-grid">
                            <label>
                                Project
                                <DxComboBox Data="@RelationshipProjects"
                                            Value="@SelectedRelationshipProject"
                                            TextFieldName="@nameof(LocalGptProjectSummary.DisplayName)"
                                            ValueChanged="@((LocalGptProjectSummary value) => LoadRelationshipProjectTopicsAsync(value))" />
                            </label>
                            <label>
                                Topic
                                <DxComboBox Data="@RelationshipProjectTopics"
                                            Value="@SelectedRelationshipProjectTopic"
                                            TextFieldName="@nameof(LocalGptProjectTopic.Name)"
                                            ValueChanged="@((LocalGptProjectTopic value) => SelectedRelationshipProjectTopic = value)" />
                            </label>
                        </div>
                        <label>
                            Link reason
                            <DxTextBox @bind-Text="ProjectKnowledgeLinkReason" />
                        </label>
                        <div class="run-row">
                            <DxButton Text="Link to project topic"
                                      RenderStyle="ButtonRenderStyle.Primary"
                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                      Enabled="@(!isBusy && SelectedRelationshipProjectTopic is not null)"
                                      Click="LinkKnowledgeToProjectTopicAsync" />
                        </div>

                        @if (KnowledgeProjectRelationships.Count > 0)
                        {
                            <div class="relationship-list" aria-label="Linked project topics">
                                @foreach (var link in KnowledgeProjectRelationships)
                                {
                                    <article class="relationship-card">
                                        <div>
                                            <strong>@link.DisplayName</strong>
                                            @if (!string.IsNullOrWhiteSpace(link.LinkReason))
                                            {
                                                <small>@link.LinkReason</small>
                                            }
                                        </div>
                                        <DxButton Text="Unlink"
                                                  RenderStyle="ButtonRenderStyle.Danger"
                                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                                  Enabled="@(!isBusy)"
                                                  Click="@(() => RemoveKnowledgeProjectRelationshipAsync(link))" />
                                    </article>
                                }
                            </div>
                        }
                    }
                </fieldset>

                <div class="run-row">
                    <DxButton Text="Mark Current"
                              RenderStyle="ButtonRenderStyle.Success"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="MarkKnowledgeCurrent" />
                    <DxButton Text="Needs Review"
                              RenderStyle="ButtonRenderStyle.Warning"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="MarkKnowledgeNeedsUserReview" />
                    <DxButton Text="Source Refresh"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="MarkKnowledgeNeedsSourceRefresh" />
                    <DxButton Text="Expired"
                              RenderStyle="ButtonRenderStyle.Danger"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="MarkKnowledgeExpired" />
                </div>
                <div class="run-row">
                    <DxButton Text="Save Knowledge"
                              RenderStyle="ButtonRenderStyle.Primary"
                              RenderStyleMode="ButtonRenderStyleMode.Contained"
                              Enabled="@(!isBusy)"
                              Click="SaveKnowledgeAsync" />
                    <DxButton Text="Delete Knowledge"
                              RenderStyle="ButtonRenderStyle.Danger"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy && SelectedKnowledgeEntry is not null)"
                              Click="DeleteKnowledgeAsync" />
                </div>
            </div>
        </div>
                    </section>
                </ConfigurationWorkbenchPanel>

                <ConfigurationWorkbenchPanel SectionKey="tables" ActiveKey="@ActiveDatabaseSection" AriaLabel="Live SQLite tables">
                    <section class="table-panel">
        <div class="panel-heading">
            <div>
                <h2>Live SQLite Tables</h2>
                <p>@TableEditor.DatabasePath</p>
            </div>
        </div>

        <div class="table-toolbar">
            <span title="Select any LocalGPT SQLite table except internal sqlite_* tables.">
                <DxComboBox Data="@Tables"
                            Value="@SelectedTable"
                            TextFieldName="@nameof(SqliteTableSummary.Name)"
                            CssClass="table-selector"
                            ValueChanged="@((SqliteTableSummary table) => SelectTableAsync(table))" />
            </span>
            <span title="Limit the preview size so large logs and chat history stay responsive.">
                <DxSpinEdit @bind-Value="RowLimit" MinValue="10" MaxValue="500" Increment="10" />
            </span>
            <DxButton Text="Load Table"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Enabled="@(!isBusy && SelectedTable is not null)"
                      Click="LoadSelectedTableAsync" />
            <DxButton Text="New Row"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Enabled="@(!isBusy && CurrentTable is not null)"
                      Click="NewSqliteRow" />
        </div>

        @if (Tables.Count > 0)
        {
            <DxGrid Data="@Tables"
                    PageSize="8"
                    TextWrapEnabled="true"
                    CssClass="database-grid table-list">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(SqliteTableSummary.Name)" Caption="Table" />
                    <DxGridDataColumn FieldName="@nameof(SqliteTableSummary.RowCount)" Caption="Rows" />
                    <DxGridDataColumn FieldName="@nameof(SqliteTableSummary.ColumnCount)" Caption="Columns" />
                    <DxGridDataColumn FieldName="@nameof(SqliteTableSummary.HasPrimaryKey)" Caption="Primary Key" />
                </Columns>
            </DxGrid>
        }

        @if (CurrentTable is not null)
        {
            <div class="table-workspace">
                <div class="table-preview">
                    <h3>@CurrentTable.TableName</h3>
                    <DxGrid Data="@GridRows"
                            PageSize="15"
                            ShowSearchBox="true"
                            TextWrapEnabled="true"
                            CssClass="database-grid database-grid-preview">
                        <Columns>
                            <DxGridDataColumn FieldName="__record" Caption="Record" />
                            @foreach (var column in CurrentTable.Columns)
                            {
                                <DxGridDataColumn FieldName="@column.Name" Caption="@column.Name" />
                            }
                            <DxGridDataColumn FieldName="__rowid" Caption="rowid" />
                        </Columns>
                    </DxGrid>
                </div>

                <div class="editor-panel">
                    <label title="Select a row to edit. Use New Row for insertion.">
                        Row
                        <DxComboBox Data="@CurrentTable.Rows"
                                    Value="@SelectedRow"
                                    TextFieldName="@nameof(SqliteRowSnapshot.DisplayName)"
                                    ValueChanged="@((SqliteRowSnapshot row) => SelectSqliteRow(row))" />
                    </label>
                    <p class="hint">Primary-key columns are editable only for a new row. Type <code>[null]</code> to save NULL in editable columns.</p>
                    @foreach (var column in CurrentTable.Columns)
                    {
                        var value = GetEditValue(column.Name);
                        var editorKind = GetEditorKind(column, value);
                        var readOnly = column.IsPrimaryKey && SelectedRow is not null;
                        <div class="sqlite-field-editor" title="@GridPresentation.BuildColumnTitle(column, Logger)">
                            <div class="sqlite-field-heading">
                                <label>@column.Name <small>@column.Type@if (column.IsPrimaryKey) { <text> primary key</text> }</small></label>
                                <div class="sqlite-editor-choice">
                                    <DxComboBox Data="@EditorKindOptions" Value="@editorKind" ValueChanged="@((string kind) => SetEditorKind(column, kind))" />
                                    <DxButton Text="Remember" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Enabled="@(!isBusy)" Click="@(() => SaveEditorPreferenceAsync(column))" />
                                </div>
                            </div>
                            @switch (editorKind)
                            {
                                case "LongText":
                                case "Json":
                                    <DxMemo Text="@value" TextChanged="@((string newValue) => SetEditValue(column.Name, newValue))" Rows="4" ReadOnly="@readOnly" />
                                    break;
                                case "Boolean":
                                    <DxComboBox Data="@BooleanValueOptions" Value="@value" ValueChanged="@((string newValue) => SetEditValue(column.Name, newValue))" ReadOnly="@readOnly" />
                                    break;
                                case "Secret":
                                    <input type="password" value="@value" readonly="@readOnly" @onchange="@((ChangeEventArgs args) => SetEditValue(column.Name, args.Value?.ToString() ?? string.Empty))" />
                                    break;
                                case "Number":
                                    <input type="number" step="any" value="@value" readonly="@readOnly" @onchange="@((ChangeEventArgs args) => SetEditValue(column.Name, args.Value?.ToString() ?? string.Empty))" />
                                    break;
                                case "DateTime":
                                    <input type="datetime-local" value="@ToDateTimeLocalValue(value)" readonly="@readOnly" @onchange="@((ChangeEventArgs args) => SetEditValue(column.Name, args.Value?.ToString() ?? string.Empty))" />
                                    break;
                                default:
                                    <DxTextBox Text="@value" TextChanged="@((string newValue) => SetEditValue(column.Name, newValue))" ReadOnly="@readOnly" />
                                    break;
                            }
                            @if (EditorOverrides.TryGetValue(column.Name, out var preference) && !string.IsNullOrWhiteSpace(preference.InputMask))
                            {
                                <small class="hint">Mask hint: @preference.InputMask</small>
                            }
                        </div>
                    }
                    <div class="run-row">
                        <DxButton Text="Save Row"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Enabled="@(!isBusy && CurrentTable is not null)"
                                  Click="SaveSqliteRowAsync" />
                        <DxButton Text="Delete Row"
                                  RenderStyle="ButtonRenderStyle.Danger"
                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                  Enabled="@(!isBusy && SelectedRow is not null)"
                                  Click="DeleteSqliteRowAsync" />
                    </div>
                </div>
            </div>
        }
                    </section>
                </ConfigurationWorkbenchPanel>
            </div>
        </div>
    </div>
</main>

@code {
    /// <summary>
    /// Stores the internal toast name state used by <see cref="Database"/> while executing its surrounding workflow.
    /// </summary>
    readonly string toastName = "DatabaseToasts";
    /// <summary>
    /// Stores the internal review status options state used by <see cref="Database"/> while executing its surrounding workflow.
    /// </summary>
    readonly string[] ReviewStatusOptions =
    [
        "Current",
        "NeedsUserReview",
        "NeedsSourceRefresh",
        "NeedsDiagnosticVerification",
        "Expired",
        "Deprecated",
        "Superseded",
        "Archived"
    ];
    /// <summary>
    /// Stores the internal knowledge accuracy options state used by <see cref="Database"/> while executing its surrounding workflow.
    /// </summary>
    readonly string[] KnowledgeAccuracyOptions = ["Unrated", "Supported", "Mixed", "NeedsCorrection", "Rejected"];
    /// <summary>
    /// Stores the internal editor kind options state used by <see cref="Database"/> while executing its surrounding workflow.
    /// </summary>
    readonly string[] EditorKindOptions = ["Automatic", "Text", "LongText", "Number", "Boolean", "DateTime", "Guid", "Json", "Secret"];
    /// <summary>
    /// Stores the internal boolean value options state used by <see cref="Database"/> while executing its surrounding workflow.
    /// </summary>
    readonly string[] BooleanValueOptions = ["true", "false", "1", "0", "[null]"];

    /// <summary>
    /// Gets or sets the knowledge entries collection maintained or exposed by this database instance for downstream processing.
    /// </summary>
    /// <value>The knowledge entries value exposed by <see cref="Database"/>.</value>
    List<CouncilKnowledgeEntry> KnowledgeEntries { get; set; } = [];
    /// <summary>
    /// Gets or sets the selected knowledge entry value that forms part of the database state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The selected knowledge entry value exposed by <see cref="Database"/>.</value>
    CouncilKnowledgeEntry? SelectedKnowledgeEntry { get; set; }
    /// <summary>
    /// Gets or sets the knowledge edit value that forms part of the database state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The knowledge edit value exposed by <see cref="Database"/>.</value>
    CouncilKnowledgeEntry KnowledgeEdit { get; set; } = new();
    /// <summary>
    /// Gets or sets the knowledge rating edit value that forms part of the database state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The knowledge rating edit value exposed by <see cref="Database"/>.</value>
    CouncilKnowledgeUserRating KnowledgeRatingEdit { get; set; } = new();

    /// <summary>
    /// Gets or sets the tables collection maintained or exposed by this database instance for downstream processing.
    /// </summary>
    /// <value>The tables value exposed by <see cref="Database"/>.</value>
    List<SqliteTableSummary> Tables { get; set; } = [];
    /// <summary>
    /// Gets or sets the selected table value that forms part of the database state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The selected table value exposed by <see cref="Database"/>.</value>
    SqliteTableSummary? SelectedTable { get; set; }
    /// <summary>
    /// Gets or sets the current table value that forms part of the database state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The current table value exposed by <see cref="Database"/>.</value>
    SqliteTableSnapshot? CurrentTable { get; set; }
    /// <summary>
    /// Gets or sets the selected row value that forms part of the database state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The selected row value exposed by <see cref="Database"/>.</value>
    SqliteRowSnapshot? SelectedRow { get; set; }
    /// <summary>
    /// Gets or sets the row edit values collection maintained or exposed by this database instance for downstream processing.
