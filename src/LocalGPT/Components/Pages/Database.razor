            return;
        var kind = SessionEditorKinds.TryGetValue(column.Name, out var selected) ? selected : "Automatic";
        var existing = EditorOverrides.GetValueOrDefault(column.Name);
        var saved = await EditorPreferences.SaveOverrideAsync(new SqliteEditorFieldOverride
        {
            Id = existing?.Id ?? Guid.NewGuid(),
            TableName = CurrentTable.TableName,
            ColumnName = column.Name,
            EditorKind = kind,
            InputMask = existing?.InputMask ?? string.Empty,
            FormatString = existing?.FormatString ?? string.Empty,
            NullText = existing?.NullText ?? "[null]",
            IsSensitive = kind.Equals("Secret", StringComparison.OrdinalIgnoreCase) || existing?.IsSensitive == true,
            RequireHumanApproval = existing?.RequireHumanApproval == true
        }, userConfirmed: true).ConfigureAwait(true);
        EditorOverrides[column.Name] = saved;
        statusText = $"Remembered {kind} editor for {CurrentTable.TableName}.{column.Name}.";
        Notifier.ShowSuccess(toastName, statusText, "Editor preference saved");
    }

    /// <summary>
    /// Performs to date time local value for <see cref="Database"/>, keeping the operation consistent with the state and invariants of the surrounding database workflow.
    /// </summary>
    /// <param name="value">Value value supplied to the database operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    string ToDateTimeLocalValue(string? value)
    {
        return DateTimeOffset.TryParse(value, out var parsed)
            ? parsed.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")
            : string.Empty;
    }

    /// <summary>
    /// Persists knowledge rating for <see cref="Database"/>, keeping the operation consistent with the state and invariants of the surrounding database workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task SaveKnowledgeRatingAsync()
    {
        if (SelectedKnowledgeEntry is null)
            return;
        KnowledgeRatingEdit.KnowledgeEntryId = SelectedKnowledgeEntry.Id;
        KnowledgeRatingEdit = await KnowledgeRatings.SaveRatingAsync(KnowledgeRatingEdit, userConfirmed: true).ConfigureAwait(true);
        KnowledgeEdit.Confidence = KnowledgeRatingEdit.Rating;
        KnowledgeEdit.IsUserApproved = KnowledgeRatingEdit.ApprovedForCouncilUse;
        KnowledgeEdit.ReviewStatus = KnowledgeRatingEdit.ApprovedForCouncilUse ? "Current" : "NeedsUserReview";
        statusText = "Human knowledge rating saved.";
        Notifier.ShowSuccess(toastName, statusText, "Knowledge rated");
    }

    /// <summary>
    /// Performs run UI action for <see cref="Database"/>, keeping the operation consistent with the state and invariants of the surrounding database workflow.
    /// </summary>
    /// <param name="action">Action value supplied to the database operation and used when producing its result.</param>
    /// <param name="operation">Operation value supplied to the database operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task RunUiActionAsync(Func<Task> action, string operation)
    {
        ArgumentNullException.ThrowIfNull(action);
        isBusy = true;
        ComponentActivity.RecordInformation(nameof(Database), operation, "The database UI operation started.");
        await InvokeAsync(StateHasChanged).ConfigureAwait(true) /* renderer-affine busy-state refresh */;
        try
        {
            await action().ConfigureAwait(true);
            ComponentActivity.RecordInformation(nameof(Database), operation, "The database UI operation completed.");
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("Database UI operation {Operation} was cancelled.", operation);
            statusText = "The operation was cancelled.";
            ComponentActivity.RecordWarning(nameof(Database), operation, "The database UI operation was cancelled.");
            Notifier.ShowWarning(toastName, statusText, "Operation cancelled");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Database UI operation {Operation} failed; row and query content were omitted from logs.", operation);
            statusText = "The operation failed. See local application logs for technical details.";
            ComponentActivity.RecordFailure(nameof(Database), operation, ex);
            Notifier.ShowError(toastName, statusText, "Operation failed");
        }
        finally
        {
            isBusy = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(true) /* renderer-affine completion refresh */;
        }
    }
}
