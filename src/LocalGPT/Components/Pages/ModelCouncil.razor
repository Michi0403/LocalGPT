@rendermode InteractiveServer
@page "/model-council"
@inject CouncilTextService CouncilText
@inject IMultiModelCouncilService CouncilService
@inject IChatMemoryService ChatMemory
@inject ILocalGptProjectService ProjectService
@inject ICodeGenerationWorkflowService CodeGenerationWorkflow
@inject NavigationManager Navigation
@inject ILogger<ModelCouncil> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject IChatContentRenderer ChatContentRenderer

<PageTitle>AI Council</PageTitle>

<main class="council-page">
    <ToastWrapper Name="@toastName" />

    <section class="council-header">
        <div>
            <h1>AI Council</h1>
            <p>Combine local and cloud models from different providers while keeping every participant bound to its provider endpoint.</p>
        </div>
        <DxButton Text="Refresh Models"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Enabled="@(!isBusy)"
                  Click="LoadCandidatesAsync" />
    </section>

    <section class="council-layout">
        <div class="council-controls">
            <div class="control-group">
                <div class="control-title">Council Models</div>
                @if (Candidates.Count == 0)
                {
                    <p class="muted">No provider models detected yet. Connect Ollama, LM Studio, OpenAI, Azure OpenAI, or another configured OpenAI-compatible provider.</p>
                }
                else
                {
                    <div class="candidate-list provider-model-list">
                        @foreach (var candidate in Candidates)
                        {
                            <ProviderModelPanel @key="candidate.SelectionKey" Model="candidate.ToReference()"
                                                Selected="@SelectedModels.Contains(candidate.SelectionKey)"
                                                SelectedChanged="@(selected => ToggleModel(candidate.SelectionKey, selected))"
                                                CouncilModels="SelectedProviderModels"
                                                BenchmarkApplied="OnBenchmarkAppliedAsync" />
                        }
                    </div>
                }
                @if (SelectedModels.Count < 2)
                {
                    <p class="hint">Select at least two provider-qualified models for real negotiation. The same model name may safely be selected from different providers.</p>
                }
                <ProviderModelBenchmarkCouncilPanel Models="SelectedProviderModels"
                                                    BenchmarkApplied="OnBenchmarkCouncilAppliedAsync" />
            </div>

            <div class="control-group">
                <label class="manual-model">
                    Add legacy Ollama model name
                    <span>
                        <input @bind="ManualModelName" placeholder="qwen3-coder:30b" />
                        <DxButton Text="Add"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Click="AddManualModel" />
                    </span>
                </label>
            </div>

            <div class="control-grid">
                <label>
                    Review rounds
                    <input type="number" min="0" max="3" @bind="Request.MaxRounds" />
                </label>
                <label>
                    Parallel models per AI host
                    <input type="number" min="1" max="4" @bind="Request.MaxParallelModels" />
                    <small>Each participating Ollama/AI PC gets this concurrency budget; the next Council phase still waits for every assigned member.</small>
                </label>
                <label>
                    Max output tokens
                    <input type="number" min="64" max="262144" step="1024" @bind="Request.MaxOutputTokens" />
                </label>
                <label>
                    Context tokens
                    <input type="number" min="2048" max="262144" step="2048" @bind="Request.MaxContextTokens" />
                </label>
                <label>
                    Timeout seconds
                    <input type="number" min="30" max="1800" step="30" @bind="Request.ModelTimeoutSeconds" />
                </label>
                <label>
                    Ollama keep-alive
                    <input @bind="KeepAliveText" placeholder="auto" />
                </label>
                <label class="council-load-setting" title="Each model receives min + this percentage of its own configured min/max road range.">
                    Hardware load
                    <span class="range-with-output">
                        <input type="range" min="0" max="100" step="5" @bind="Request.ResourceLoadPercent" @bind:event="oninput" />
                        <output>@Request.ResourceLoadPercent%</output>
                    </span>
                </label>
            </div>
            <div class="run-row">
                <DxButton Text="Low GPU Preset"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isBusy)"
                          Click="ApplyLowResourcePreset" />
                <DxButton Text="Balanced Preset"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isBusy)"
                          Click="ApplyBalancedPreset" />
                <DxButton Text="Generation Preset"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isBusy)"
                          Click="ApplyGenerationPreset" />
            </div>
            <p class="hint">Default scheduling runs one large model at a time and can unload between models. Low GPU Preset is for diagnostics only. Real source or solution generation should use at least 64K output/context, and the Generation Preset uses 256K when the model/runtime supports it.</p>

            <details class="council-road-details" open>
                <summary>Spooler roads and per-model limits</summary>
                <CouncilHardwareRoadEditor ModelNames="SelectedModels"
                                           Routes="Request.ModelRoutes"
                                           ResourceLoadPercent="Request.ResourceLoadPercent" />
            </details>
            <div class="run-row">
                <DxButton Text="Join running Council in Chat"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Enabled="@(!isBusy)"
                          Click="JoinRunningCouncil" />
            </div>

            <div class="check-row">
                <label title="Passes Ollama num_gpu=0 for this council run. This is slower, but reduces GPU pressure while debugging.">
                    <input type="checkbox" @bind="ForceCpuOnlyOllama" />
                    CPU-only Ollama
                </label>
                <label title="Shares saved LocalGPT memory and AI project guidance with every council participant.">
                    <input type="checkbox" @bind="Request.IncludeMemory" />
                    Shared memory
                </label>
                <label title="Stores the full council transcript in SQLite chat memory after the run.">
                    <input type="checkbox" @bind="Request.SaveToMemory" />
                    Memorize transcript
                </label>
                <label title="Ask the council to prepare an immutable change-review heartbeat. No files are written and no build is started until a later explicit approval of the exact review hash.">
                    <input type="checkbox"
                           checked="@Request.GenerateImplementationArtifact"
                           @onchange="ToggleArtifactGeneration" />
                    Prepare code-generation change review
                </label>
            </div>

            <div class="control-group">
                <div class="control-title">Project cooperation</div>
                <label>
                    Project
                    <select value="@SelectedProjectValue" @onchange="SelectProjectAsync">
                        <option value="">No project selected</option>
                        @foreach (var project in ProjectSummaries)
                        {
                            <option value="@project.Id">@project.DisplayName</option>
                        }
                    </select>
                </label>

                <label>
                    Topic
                    <select value="@SelectedTopicValue"
                            @onchange="SelectProjectTopic"
                            disabled="@(SelectedProjectDetails is null)">
                        <option value="">No topic selected</option>
                        @if (SelectedProjectDetails is not null)
                        {
                            @foreach (var topic in SelectedProjectDetails.Topics)
                            {
                                <option value="@topic.Id">@topic.Name</option>
                            }
                        }
                    </select>
                </label>

                <label title="After this run, link the generated council knowledge entry to the selected topic. This confirmation is cleared after every run.">
                    <input type="checkbox"
                           @bind="Request.UserConfirmedProjectLink"
                           disabled="@(Request.ProjectTopicId is null)" />
                    Link this run's knowledge to the selected topic
                </label>
                <p class="hint">The project path is context only. Council members do not access files, initialize Git, commit, push, or execute anything from it without a separate user-approved action.</p>
            </div>

            <div class="control-group">
                <div class="control-title">Continue Council Memory</div>
                @if (SavedCouncilConversations.Count == 0)
                {
                    <p class="muted">No saved council conversations yet.</p>
                }
                else
                {
                    <DxComboBox Data="@SavedCouncilConversations"
                                Value="@SelectedCouncilConversation"
                                CssClass="memory-selector"
                                TextFieldName="@nameof(ChatMemoryConversationSummary.DisplayName)"
                                ValueChanged="@((ChatMemoryConversationSummary conversation) => SelectCouncilConversation(conversation))" />
                }
                <div class="run-row">
                    <DxButton Text="New Thread"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="StartNewCouncilThread" />
                    <DxButton Text="Feature Request Chat"
                              RenderStyle="ButtonRenderStyle.Primary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="StartFeatureRequestChat" />
                    <DxButton Text="Refresh Memory"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy)"
                              Click="LoadSavedCouncilConversationsAsync" />
                </div>
                @if (SelectedCouncilConversation is not null)
                {
                    <p class="hint">Continuing: @SelectedCouncilConversation.DisplayName</p>
                }
            </div>
        </div>

        <div class="prompt-panel">
            <label>
                Council prompt
                <textarea @bind="Request.Prompt" rows="14"></textarea>
            </label>
            <div class="run-row">
                <DxButton Text="Run Council"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@CanRun"
                          Click="RunCouncilAsync" />
                @if (isBusy)
                {
                    <span class="muted">Models are negotiating. This can take a while on 20B/30B models.</span>
                }
                else if (!string.IsNullOrWhiteSpace(statusText))
                {
                    <span class="status-text">@statusText</span>
                }
            </div>
        </div>
    </section>

    @if (LastResult is not null)
    {
        <section class="result-meta">
            <div>
                <strong>Participants</strong>
                <span>@CouncilText.FormatJoinedList(LastResult.ModelNames, " + ")</span>
            </div>
            @if (LastResult.MemoryConversationId is Guid memoryId)
            {
                <div>
                    <strong>Memory</strong>
                    <span>@memoryId</span>
                </div>
            }
            @if (LastResult.KnowledgeEntryId is Guid knowledgeId)
            {
                <div>
                    <strong>Knowledge</strong>
                    <span>@knowledgeId</span>
                </div>
            }
            @if (LastResult.ProjectId is Guid projectId)
            {
                <div>
                    <strong>Project</strong>
                    <span>@projectId</span>
                </div>
            }
            @if (LastResult.ProjectTopicId is Guid projectTopicId)
            {
                <div>
                    <strong>Project Topic</strong>
                    <span>@projectTopicId</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(LastResult.LogPath))
            {
                <div>
                    <strong>Log</strong>
                    <span>@LastResult.LogPath</span>
                </div>
            }
            @if (LastResult.ContinuedFromConversationId is Guid continuedFrom)
            {
                <div>
                    <strong>Continued From</strong>
                    <span>@continuedFrom</span>
                </div>
            }
        </section>

        <section class="result-meta">
            @foreach (var model in LastResult.ModelNames)
            {
                <div>
                    <strong>@model</strong>
                    <DxButton Text="Exclude Next Round"
                              RenderStyle="ButtonRenderStyle.Danger"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Enabled="@(!isBusy && SelectedModels.Count > 1)"
                              Click="@(() => ExcludeModel(model))" />
                </div>
            }
        </section>

        @if (LastResult.Warnings.Count > 0)
        {
            <section class="warning-panel">
                @foreach (var warning in LastResult.Warnings)
                {
                    <p>@warning</p>
                }
            </section>
        }

        @if (LastResult.UserPoll is not null)
        {
            <section class="poll-panel">
                <h2>User Decision Poll</h2>
                <p>@LastResult.UserPoll.Reason</p>
                <strong>@LastResult.UserPoll.Question</strong>
                <div class="poll-options">
                    @foreach (var option in LastResult.UserPoll.Options)
                    {
                        <button type="button"
                                title="@option.FollowUpPrompt"
                                @onclick="@(() => ApplyPollOption(option))">
                            @option.Label
                        </button>
                    }
                </div>
                <div class="poll-feedback">
                    <label for="custom-poll-feedback">Custom direction for the next round</label>
                    <textarea id="custom-poll-feedback"
                              @bind="CustomPollFeedback"
                              rows="3"
                              placeholder="Describe exactly what or how the council should implement..."></textarea>
                    <DxButton Text="Use Custom Feedback"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Contained"
                              Enabled="@(!string.IsNullOrWhiteSpace(CustomPollFeedback))"
                              Click="ApplyCustomPollFeedback" />
                </div>
            </section>
        }

        @if (LastResult.ChangeReview is not null)
        {
            <section class="final-panel change-review-panel">
                <h2>Change Review Heartbeat</h2>
                <p>
                    The council prepared an exact, database-backed proposal. Review the goal, current project state,
                    files, CodeDOM types, outputs, and safety boundary before making a fresh decision.
                </p>
                <dl>
                    <dt>Status</dt>
                    <dd>@LastResult.ChangeReview.Status</dd>
                    <dt>Review ID</dt>
                    <dd>@LastResult.ChangeReview.Id</dd>
                    <dt>Review hash</dt>
                    <dd><code>@LastResult.ChangeReview.ReviewHash</code></dd>
                    <dt>Goal</dt>
                    <dd>@LastResult.ChangeReview.Goal</dd>
                    <dt>Change summary</dt>
                    <dd>@LastResult.ChangeReview.ChangeSummary</dd>
                    <dt>Safety boundary</dt>
                    <dd>@LastResult.ChangeReview.SafetySummary</dd>
                </dl>

                @if (LastResult.ChangeReview.Files.Count > 0)
                {
                    <h3>Reviewed files</h3>
                    <ul>
                        @foreach (var file in LastResult.ChangeReview.Files)
                        {
                            <li><code>@file.RelativePath</code> — @file.Purpose — @file.CharacterCount characters — SHA-256 @file.ContentHash</li>
                        }
                    </ul>
                }

                @if (LastResult.ChangeReview.CodeDomTypes.Count > 0)
                {
                    <h3>CodeDOM types</h3>
                    <ul>
                        @foreach (var type in LastResult.ChangeReview.CodeDomTypes)
                        {
                            <li><code>@type.RelativePath</code> — <code>@type.Namespace.@type.TypeName</code> / <code>@($"{type.MethodName}()")</code></li>
                        }
                    </ul>
                }

                <h3>Output targets</h3>
                <ul>
                    @foreach (var output in LastResult.ChangeReview.Outputs)
                    {
                        <li><code>@output.Kind</code> — <code>@output.RelativeDirectory/@output.Name</code> — @output.TargetFramework</li>
                    }
                </ul>

                @if (LastResult.ChangeReview.Status == CodeGenerationReviewStatuses.AwaitingUserDecision && !LastResult.ChangeReview.ApprovalConsumed)
                {
                    <label class="review-build-choice" title="This is a separate confirmation for the bounded dotnet build after reviewed files are generated.">
                        <input type="checkbox" @bind="BuildApprovedReview" disabled="@isBusy" />
                        Also run the bounded .NET build after generation
                    </label>
                    <div class="run-row">
                        <DxButton Text="Approve Exact Review"
                                  RenderStyle="ButtonRenderStyle.Success"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Enabled="@(!isBusy)"
                                  Click="ApproveChangeReviewAsync" />
                        <DxButton Text="Reject Review"
                                  RenderStyle="ButtonRenderStyle.Danger"
                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                  Enabled="@(!isBusy)"
                                  Click="RejectChangeReviewAsync" />
                    </div>
                    <p class="hint">Approval is one-use and bound to the displayed review hash. Generated scripts, DLLs, and executables are not run or loaded automatically.</p>
                }

                @if (LastGenerationExecution is not null && LastGenerationExecution.ReviewId == LastResult.ChangeReview.Id)
                {
                    <div class="artifact-download">
                        <strong>Generation result: @LastGenerationExecution.Status</strong>
                        @if (!string.IsNullOrWhiteSpace(LastGenerationExecution.BuildStatus))
                        {
                            <span class="muted"> — build: @LastGenerationExecution.BuildStatus</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(LastGenerationExecution.DownloadUrl))
                        {
                            <p><a href="@GetGenerationDownloadUrl(LastGenerationExecution)" target="_blank" rel="noopener">Download reviewed generated workspace</a></p>
                        }
                    </div>
                }
            </section>
        }

        @if (LastResult.Artifacts.Count > 0)
        {
            <section class="final-panel">
                <h2>Downloadable Examples</h2>
                @foreach (var artifact in LastResult.Artifacts)
                {
                    <div class="artifact-download">
                        <a href="@GetArtifactUrl(artifact)" target="_blank" rel="noopener" download="@artifact.Name">@artifact.Name</a>
                        <span class="muted"> - @artifact.Kind - @artifact.Summary</span>
                        <dl>
                            <dt>HTTP GET</dt>
                            <dd><a href="@GetArtifactUrl(artifact)" target="_blank" rel="noopener">@GetArtifactUrl(artifact)</a></dd>
                            <dt>Local file</dt>
                            <dd>@artifact.FilePath</dd>
                        </dl>
                    </div>
                }
            </section>
        }

        <section class="final-panel">
            <h2>Original Prompt</h2>
            <details class="council-prompt" open>
                <summary>Prompt sent to the AI Council</summary>
                <pre>@CouncilText.DecodeHumanVisibleText(CouncilText.TrimForDisplay(LastResult.Prompt, 12000, Logger))</pre>
            </details>
        </section>

        <section class="final-panel">
            <h2>Consensus Answer</h2>
            <div class="markdown-output">@((MarkupString)ChatContentRenderer.Render(LastResult.FinalAnswer))</div>
        </section>

        <section class="transcript-panel">
            <h2>Conversation And Visible Thought Process</h2>
            @foreach (var step in LastResult.Steps.OrderBy(step => step.SortOrder))
            {
                <article class="council-step @(string.IsNullOrWhiteSpace(step.Error) ? string.Empty : "has-error")">
                    <header>
                        <span>@step.Phase</span>
                        <strong>@step.ModelName</strong>
                        <small>@step.Role - @step.DurationSeconds.ToString("0.0")s</small>
                        <small>Members: @CouncilText.FormatJoinedList(step.CouncilMembers.Count > 0 ? step.CouncilMembers : LastResult.ModelNames, " + ")</small>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(step.Error))
                    {
                        <DxButton Text="@($"Exclude {step.ModelName}")"
                                  RenderStyle="ButtonRenderStyle.Danger"
                                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                                  Enabled="@(!isBusy && SelectedModels.Count > 1)"
                                  Click="@(() => ExcludeModel(step.ModelName))" />
                    }
                    @if (!string.IsNullOrWhiteSpace(step.Thinking))
                    {
                        <details class="thinking-box" open>
                            <summary>Visible model thinking</summary>
                            <pre>@CouncilText.DecodeHumanVisibleText(step.Thinking)</pre>
                        </details>
                    }
                    <div class="markdown-output">@((MarkupString)ChatContentRenderer.Render(step.VisibleContent))</div>
                </article>
            }
        </section>
    }
</main>
