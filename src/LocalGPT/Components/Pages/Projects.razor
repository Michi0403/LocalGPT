@rendermode InteractiveServer
@page "/projects"
@inject ILocalGptProjectService ProjectService
@inject IProjectArchitectureService ProjectArchitecture
@inject IGameProjectService GameProjects
@inject ILocalGptRequestFactoryService RequestFactory
@inject ILogger<Projects> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject CouncilTextService CouncilText

<PageTitle>Projects</PageTitle>

<main class="projects-page">
    <ToastWrapper Name="@toastName" />

    <section class="projects-header">
        <div class="projects-heading">
            <span class="projects-heading-icon" aria-hidden="true"></span>
            <div>
            <h1>Human-guided projects</h1>
            <p>Store project purpose, a user-selected file path, versions, and council topics. LocalGPT records the path but does not scan, modify, initialize Git, commit, push, or run files automatically.</p>
            </div>
        </div>
        <DxButton Text="Refresh"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Enabled="@(!isBusy)"
                  Click="LoadProjectsAsync" />
    </section>

    <section class="projects-layout">
        <aside class="project-list">
            <DxButton Text="New Project"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Enabled="@(!isBusy)"
                      Click="NewProject" />

            @if (ProjectSummaries.Count == 0)
            {
                <p class="muted">No projects saved yet.</p>
            }
            else
            {
                @foreach (var project in ProjectSummaries)
                {
                    <DxButton
                            CssClass="@(SelectedProject?.Project.Id == project.Id ? "project-select selected" : "project-select")"
                            Click="@(() => SelectProjectAsync(project.Id))">
                        <strong>@project.DisplayName</strong>
                        <span>@project.ProjectType · @project.Status · @project.TopicCount topic(s) · @project.VersionCount version(s)</span>
                    </DxButton>
                }
            }
        </aside>

        <section class="project-editor">
            <h2>@(ProjectEdit.Id is null ? "New project" : "Edit project")</h2>

            <label>
                Name
                <DxTextBox @bind-Text="ProjectEdit.Name" MaxLength="200" />
            </label>

            <label>
                Purpose
                <DxMemo @bind-Text="ProjectEdit.Purpose" Rows="4" />
            </label>

            <label title="This is stored as path metadata. Scanning or building still requires a separate explicit approval.">
                Project directory
                <DxTextBox @bind-Text="ProjectEdit.RootPath" MaxLength="2048" NullText="C:\Projects\MyProject" />
            </label>

            <div class="form-grid">
                <label>
                    Project type
                    <DxTextBox @bind-Text="ProjectEdit.ProjectType" MaxLength="120" NullText="DotNetSolution, Game, Java, Python, Cpp..." />
                </label>
                <label>
                    Solution file path
                    <DxTextBox @bind-Text="ProjectEdit.SolutionPath" MaxLength="2048" NullText="C:\Projects\MyProject\MyProject.sln" />
                </label>
            </div>
            <details>
                <summary>Solution and file discovery regular expressions</summary>
                <label>Solution regex<DxTextBox @bind-Text="ProjectEdit.SolutionSearchPattern" /></label>
                <label>Included files regex<DxMemo @bind-Text="ProjectEdit.FileIncludePattern" Rows="2" /></label>
                <label>Excluded paths regex<DxMemo @bind-Text="ProjectEdit.FileExcludePattern" Rows="2" /></label>
            </details>

            <div class="form-grid">
                <label>
                    Current version
                    <DxTextBox @bind-Text="ProjectEdit.CurrentVersion" MaxLength="120" />
                </label>
                <label>
                    Status
                    <DxTextBox @bind-Text="ProjectEdit.Status" MaxLength="80" />
                </label>
            </div>

            <div class="check-row">
                <label>
                    <DxCheckBox @bind-Checked="ProjectEdit.RecommendGit" />
                    Recommend Git for revision history
                </label>
                <label>
                    <DxCheckBox @bind-Checked="ProjectEdit.IsArchived" />
                    Archive project
                </label>
            </div>

            <p class="hint">Git is only a recommendation. LocalGPT does not implement a Git helper here and never initializes, commits, resets, cleans, or pushes automatically.</p>

            <DxButton Text="Save Project"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Enabled="@(!isBusy && !string.IsNullOrWhiteSpace(ProjectEdit.Name))"
                      Click="SaveProjectAsync" />

            @if (SelectedProject is not null)
            {
                @if (SelectedProject.Project.IsGameProject)
                {
                    <hr />
                    <h2>Game project build</h2>
                    <p class="hint">The Project system owns the editable game profile, user requirements, revisions and build artifacts. GameDirector only consumes an approved build at runtime. Save the design while requirements are being collected, build a requirement-traceable definition when ready, then launch it from /Chat with <code>:game project &lt;project name or id&gt;</code> or through the project.game.start AI function.</p>
                    <p class="hint">Project requirements currently linked to this game: @SelectedProject.Requirements.Count. Requirement discovery teams persist agreed requirements through the normal Project requirement system instead of hiding them inside the runtime profile.</p>
                    <div class="form-grid">
                        <label>
                            Game key
                            <DxTextBox @bind-Text="GameProfileEdit.GameKey" MaxLength="160" NullText="neon-relay-arena" />
                        </label>
                        <label>
                            Display name
                            <DxTextBox @bind-Text="GameProfileEdit.DisplayName" MaxLength="240" />
                        </label>
                        <label>
                            Runtime profile
                            <DxComboBox Data="@GameRuntimeProfileOptions"
                                        @bind-Value="GameProfileEdit.RuntimeProfile"
                                        ValueFieldName="@nameof(LocalGptSelectionOption<CouncilGameRuntimeProfile>.Value)"
                                        TextFieldName="@nameof(LocalGptSelectionOption<CouncilGameRuntimeProfile>.Label)" />
                        </label>
                        <label>
                            Default Council team
                            <DxTextBox @bind-Text="GameProfileEdit.DefaultTeamKey" MaxLength="160" />
                        </label>
                        <label>
                            Default control mode
                            <DxComboBox Data="@GameControlModeOptions"
                                        @bind-Value="GameProfileEdit.DefaultControlMode"
                                        ValueFieldName="@nameof(LocalGptSelectionOption<CouncilGameControlMode>.Value)"
                                        TextFieldName="@nameof(LocalGptSelectionOption<CouncilGameControlMode>.Label)" />
                        </label>
                        <label>
                            Director mode
                            <DxComboBox Data="@GameDirectorModeOptions"
                                        @bind-Value="GameProfileEdit.DirectorMode"
                                        ValueFieldName="@nameof(LocalGptSelectionOption<CouncilGameDirectorMode>.Value)"
                                        TextFieldName="@nameof(LocalGptSelectionOption<CouncilGameDirectorMode>.Label)" />
                        </label>
                        <label>
                            GameDirector model
                            <DxTextBox @bind-Text="GameProfileEdit.GameDirectorModelName" MaxLength="240" />
                        </label>
                        <label>
                            Creature directors
                            <DxSpinEdit @bind-Value="GameProfileEdit.CreatureDirectorCount" MinValue="1" MaxValue="8" />
                        </label>
                        <label>
                            Frame width
                            <DxSpinEdit @bind-Value="GameProfileEdit.FrameWidth" MinValue="20" MaxValue="240" />
                        </label>
                        <label>
                            Frame height
                            <DxSpinEdit @bind-Value="GameProfileEdit.FrameHeight" MinValue="8" MaxValue="100" />
                        </label>
                        <label>
                            ASCII color mode
                            <DxComboBox Data="@AsciiColorModeOptions"
                                        @bind-Value="GameProfileEdit.AsciiColorMode"
                                        ValueFieldName="@nameof(LocalGptSelectionOption<CouncilAsciiColorMode>.Value)"
                                        TextFieldName="@nameof(LocalGptSelectionOption<CouncilAsciiColorMode>.Label)" />
                        </label>
                        <label>
                            Default foreground index
                            <DxSpinEdit @bind-Value="GameProfileEdit.DefaultForegroundColor" MinValue="0" MaxValue="@(GameProfileEdit.AsciiColorMode == CouncilAsciiColorMode.Ansi16 ? 15 : 255)" />
                        </label>
                        <label>
                            Default background index
                            <DxSpinEdit @bind-Value="GameProfileEdit.DefaultBackgroundColor" MinValue="0" MaxValue="@(GameProfileEdit.AsciiColorMode == CouncilAsciiColorMode.Ansi16 ? 15 : 255)" />
                        </label>
                        <label>
                            Autoplay delay (ms)
                            <DxSpinEdit @bind-Value="GameProfileEdit.AutoplayDelayMilliseconds" MinValue="250" MaxValue="10000" />
                        </label>
                        <label>
                            Map seed
                            <DxSpinEdit @bind-Value="GameProfileEdit.MapSeed" MinValue="1" />
                        </label>
                    </div>
                    <p class="hint">Terminal default keeps the familiar black/green LocalGPT surface for unstyled cells. ANSI-16 uses indexes 0-15 (bright green is 10); indexed-256 uses 0-255 (green 46, black 0). Game renderers can still assign colors to individual ASCII runs without placing ANSI escapes in game text.</p>
                    <label>
                        Scenario / world description
                        <DxMemo @bind-Text="GameProfileEdit.ScenarioPrompt" Rows="4" MaxLength="240" />
                    </label>
                    <div class="button-row">
                        <DxButton Text="Save Game Design"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Enabled="@(!isBusy)"
                                  Click="SaveGameProjectProfileAsync" />
                        <DxButton Text="Build Game Definition"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                                  Enabled="@(!isBusy && CurrentGameProfile is not null)"
                                  Click="BuildGameProjectAsync" />
                    </div>
                    @if (CurrentGameProfile is not null)
                    {
                        <p class="hint">Saved authoring profile @CurrentGameProfile.Id · updated @CurrentGameProfile.UpdatedAtUtc.ToLocalTime()</p>
                    }
                    @if (CurrentGameBuild is not null)
                    {
                        <p class="hint">Built @CurrentGameBuild.Definition.DisplayName · profile @CurrentGameBuild.Definition.RuntimeProfile · project version @CurrentGameBuild.Definition.ProjectVersion · artifact @CurrentGameBuild.ArtifactId</p>
                    }
                }

                <hr />
                <h2>Topics</h2>
                <p class="hint">A topic is a user-approved unit of work. Selecting it in AI Council links the resulting knowledge entry after the run.</p>

                <div class="form-grid">
                    <label>
                        Topic name
                        <DxTextBox @bind-Text="TopicEdit.Name" MaxLength="240" />
                    </label>
                    <label>
                        Status
                        <DxTextBox @bind-Text="TopicEdit.Status" MaxLength="80" />
                    </label>
                </div>
                <label>
                    Topic description
                    <DxMemo @bind-Text="TopicEdit.Description" Rows="3" />
                </label>
                <DxButton Text="Add Topic"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isBusy && !string.IsNullOrWhiteSpace(TopicEdit.Name))"
                          Click="AddTopicAsync" />

                @if (SelectedProject.Topics.Count > 0)
                {
                    <ul class="record-list">
                        @foreach (var topic in SelectedProject.Topics)
                        {
                            <li>
                                <strong>@topic.Name</strong>
                                <span>@topic.Status</span>
                                <p>@topic.Description</p>
                            </li>
                        }
                    </ul>
                }

                <hr />
                <h2>Versions</h2>
                <div class="form-grid">
                    <label>
                        Version
                        <DxTextBox @bind-Text="VersionEdit.Version" MaxLength="120" />
                    </label>
                    <label>
                        Path snapshot
                        <DxTextBox @bind-Text="VersionEdit.PathSnapshot" MaxLength="1024" />
                    </label>
                </div>
                <label>
                    Notes
                    <DxMemo @bind-Text="VersionEdit.Notes" Rows="3" />
                </label>
                <label>
                    <DxCheckBox @bind-Checked="VersionEdit.IsCurrent" />
                    Mark as current version
                </label>
                <DxButton Text="Add Version"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isBusy && !string.IsNullOrWhiteSpace(VersionEdit.Version))"
                          Click="AddVersionAsync" />

                @if (SelectedProject.Versions.Count > 0)
                {
                    <ul class="record-list">
                        @foreach (var version in SelectedProject.Versions)
                        {
                            <li>
                                <strong>@version.Version</strong>
                                @if (version.IsCurrent)
                                {
                                    <span>Current</span>
                                }
                                <p>@version.Notes</p>
                            </li>
                        }
                    </ul>
                }

                <hr />
                <h2>Database revisions and branches</h2>
                <p class="hint">These revisions describe project structure in SQLite for any programming language. They do not modify Git or the filesystem. A later approved CodeDOM workflow may use the structure as input.</p>
                <div class="form-grid">
                    <label>
                        Branch name
                        <DxTextBox @bind-Text="RevisionEdit.BranchName" MaxLength="160" />
                    </label>
                    <label>
                        Revision name
                        <DxTextBox @bind-Text="RevisionEdit.RevisionName" MaxLength="160" />
                    </label>
                </div>
                <label>
                    Parent revision
                    <DxComboBox Data="@RevisionParentOptions"
                                @bind-Value="RevisionParentValue"
                                ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)" />
                </label>
                <label>
                    Revision summary
                    <DxMemo @bind-Text="RevisionEdit.Summary" Rows="3" />
                </label>
                <label title="JSON object or array describing folders, files, logical modules, services, controllers, functions, or other project nodes.">
                    Project structure JSON
                    <DxMemo @bind-Text="RevisionEdit.ProjectStructureJson" Rows="5" />
                </label>
                <label>
                    <DxCheckBox @bind-Checked="RevisionEdit.IsCurrent" />
                    Mark revision as current
                </label>
                <DxButton Text="Save Revision"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isBusy && !string.IsNullOrWhiteSpace(RevisionEdit.RevisionName))"
                          Click="SaveRevisionAsync" />
                @if (SelectedProject.Revisions.Count > 0)
                {
                    <ul class="record-list">
                        @foreach (var revision in SelectedProject.Revisions)
                        {
                            <li>
                                <strong>@revision.BranchName/@revision.RevisionName</strong>
                                @if (revision.IsCurrent)
                                {
                                    <span>Current</span>
                                }
                                <p>@revision.Summary</p>
                            </li>
                        }
                    </ul>
                }

                <hr />
                <h2>Requirements</h2>
                <p class="hint">Requirements give smaller models stable names for capabilities, knowledge, business objects, settings, and functions before they choose tools.</p>
                <div class="form-grid">
                    <label>
                        Requirement name
                        <DxTextBox @bind-Text="RequirementEdit.Name" MaxLength="240" />
                    </label>
                    <label>
                        Required capability
                        <DxTextBox @bind-Text="RequirementEdit.RequiredCapability" MaxLength="240" NullText="C#, local knowledge import, SQL maintenance..." />
                    </label>
                    <label>
                        Type
                        <DxTextBox @bind-Text="RequirementEdit.RequirementType" MaxLength="80" />
                    </label>
                    <label>
                        Status
                        <DxTextBox @bind-Text="RequirementEdit.Status" MaxLength="80" />
                    </label>
                    <label>
                        Priority
                        <DxTextBox @bind-Text="RequirementEdit.Priority" MaxLength="40" />
                    </label>
                    <label>
                        Council rating (0-100)
                        <DxSpinEdit @bind-Value="RequirementEdit.CouncilRating" MinValue="0" MaxValue="100" />
                    </label>
                </div>
                <label>
                    Requirement description
                    <DxMemo @bind-Text="RequirementEdit.Description" Rows="4" />
                </label>
                <DxButton Text="Save Requirement"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isBusy && !string.IsNullOrWhiteSpace(RequirementEdit.Name))"
                          Click="SaveRequirementAsync" />
                @if (SelectedProject.Requirements.Count > 0)
                {
                    <ul class="record-list">
                        @foreach (var requirement in SelectedProject.Requirements)
                        {
                            <li>
                                <strong>@requirement.Name</strong>
                                <span>@requirement.Status · @requirement.Priority · rating @requirement.CouncilRating</span>
                                <p>@requirement.Description</p>
                                @if (requirement.Links.Count > 0)
                                {
                                    <small>Links: @CouncilText.FormatInlineNameList(requirement.Links.Select(link => $"{link.TargetKind}:{link.TargetName}"))</small>
                                }
                            </li>
                        }
                    </ul>
                    <h3>Link requirement to a named capability</h3>
                    <div class="form-grid">
                        <label>Requirement
                            <DxComboBox Data="@RequirementLinkOptions"
                                        @bind-Value="RequirementLinkRequirementValue"
                                        ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                        TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)" />
                        </label>
                        <label>Target kind
                            <DxComboBox Data="@RequirementTargetKinds" @bind-Value="RequirementLinkEdit.TargetKind" />
                        </label>
                        <label>Stable target name
                            <DxTextBox @bind-Text="RequirementLinkEdit.TargetName" MaxLength="240" NullText="function/table/object/config name" />
                        </label>
                        <label>Target table
                            <DxTextBox @bind-Text="RequirementLinkEdit.TargetTable" MaxLength="160" />
                        </label>
                        <label>Target id
                            <DxTextBox @bind-Text="RequirementLinkEdit.TargetId" MaxLength="160" />
                        </label>
                    </div>
                    <label>Why this link is relevant
                        <DxMemo @bind-Text="RequirementLinkEdit.LinkPurpose" Rows="2" />
                    </label>
                    <DxButton Text="Save Requirement Link" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Contained" Enabled="@(!isBusy && RequirementLinkEdit.RequirementId != Guid.Empty && !string.IsNullOrWhiteSpace(RequirementLinkEdit.TargetName))" Click="SaveRequirementLinkAsync" />
                }

                <hr />
                <h2>Project-linked artifacts</h2>
                <p class="hint">Store named Regex, SystemVariable, Configuration, Prompt, KnowledgeReference, BusinessObjectReference, DXFunctionReference, or CodeDomTarget records. Sensitive values stay out of AI briefings and logs.</p>
                <div class="form-grid">
                    <label>
                        Kind
                        <DxComboBox Data="@ArtifactKinds" @bind-Value="ArtifactEdit.ArtifactKind" />
                    </label>
                    <label>
                        Name
                        <DxTextBox @bind-Text="ArtifactEdit.Name" MaxLength="240" />
                    </label>
                    <label>
                        Data type
                        <DxTextBox @bind-Text="ArtifactEdit.DataType" MaxLength="120" />
                    </label>
                    <label>
                        Flags / options
                        <DxTextBox @bind-Text="ArtifactEdit.Flags" MaxLength="160" />
                    </label>
                    <label>
                        Requirement link
                        <DxComboBox Data="@ArtifactRequirementOptions"
                                    @bind-Value="ArtifactRequirementValue"
                                    ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                    TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)" />
                    </label>
                    <label>
                        <DxCheckBox @bind-Checked="ArtifactEdit.IsSensitive" />
                        Sensitive value
                    </label>
                </div>
                <label>
                    Description
                    <DxMemo @bind-Text="ArtifactEdit.Description" Rows="3" />
                </label>
                <label>
                    Value
                    <DxMemo @bind-Text="ArtifactEdit.Value" Rows="5" />
                </label>
                <DxButton Text="Save Project Artifact"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Enabled="@(!isBusy && !string.IsNullOrWhiteSpace(ArtifactEdit.Name))"
                          Click="SaveArtifactAsync" />
                @if (SelectedProject.Artifacts.Count > 0)
                {
                    <ul class="record-list">
                        @foreach (var artifact in SelectedProject.Artifacts)
                        {
                            <li>
                                <strong>@artifact.ArtifactKind:@artifact.Name</strong>
                                <span>@artifact.DataType · @(artifact.IsSensitive ? "sensitive" : "non-sensitive") · @artifact.CouncilReviewStatus</span>
                                <p>@artifact.Description</p>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    </section>
</main>

@code {
    /// <summary>
    /// Defines the toast name constant used by <see cref="Projects"/> so callers and internal logic share the same stable value.
    /// </summary>
    const string toastName = "ProjectToasts";


    /// <summary>Gets the supported project-owned game runtime profiles.</summary>
    readonly IReadOnlyList<LocalGptSelectionOption<CouncilGameRuntimeProfile>> GameRuntimeProfileOptions =
    [
        new(CouncilGameRuntimeProfile.Corridor, "Corridor simulation"),
        new(CouncilGameRuntimeProfile.Story, "Story / choice simulation")
    ];

    /// <summary>Gets the supported default game control modes.</summary>
    readonly IReadOnlyList<LocalGptSelectionOption<CouncilGameControlMode>> GameControlModeOptions =
    [
        new(CouncilGameControlMode.Human, "Human"),
        new(CouncilGameControlMode.Shared, "Shared"),
        new(CouncilGameControlMode.Ai, "AI")
    ];

    /// <summary>Gets the supported game director modes.</summary>
    readonly IReadOnlyList<LocalGptSelectionOption<CouncilGameDirectorMode>> GameDirectorModeOptions =
    [
        new(CouncilGameDirectorMode.Deterministic, "Deterministic"),
        new(CouncilGameDirectorMode.CouncilModelPreferred, "Council model preferred")
    ];

    /// <summary>Gets the supported project game ASCII color modes.</summary>
    readonly IReadOnlyList<LocalGptSelectionOption<CouncilAsciiColorMode>> AsciiColorModeOptions =
    [
        new(CouncilAsciiColorMode.TerminalDefault, "Terminal default (LocalGPT black/green)"),
        new(CouncilAsciiColorMode.Ansi16, "ANSI 16 colors"),
        new(CouncilAsciiColorMode.Indexed256, "Indexed 256 colors")
    ];

    /// <summary>Gets revision-parent choices including the explicit no-parent state.</summary>
    IReadOnlyList<LocalGptSelectionOption<string>> RevisionParentOptions =>
        [new(string.Empty, "No parent"),
         .. (SelectedProject?.Revisions.Select(revision => new LocalGptSelectionOption<string>(revision.Id.ToString(), $"{revision.BranchName}/{revision.RevisionName}"))
             ?? Enumerable.Empty<LocalGptSelectionOption<string>>())];

    /// <summary>Gets requirement choices for capability links.</summary>
    IReadOnlyList<LocalGptSelectionOption<string>> RequirementLinkOptions =>
        [new(string.Empty, "Choose requirement"),
         .. (SelectedProject?.Requirements.Select(requirement => new LocalGptSelectionOption<string>(requirement.Id.ToString(), requirement.Name))
             ?? Enumerable.Empty<LocalGptSelectionOption<string>>())];

    /// <summary>Gets requirement choices for project-linked artifacts.</summary>
    IReadOnlyList<LocalGptSelectionOption<string>> ArtifactRequirementOptions =>
        [new(string.Empty, "No requirement"),
         .. (SelectedProject?.Requirements.Select(requirement => new LocalGptSelectionOption<string>(requirement.Id.ToString(), requirement.Name))
             ?? Enumerable.Empty<LocalGptSelectionOption<string>>())];

    /// <summary>
    /// Gets or sets the project summaries collection maintained or exposed by this projects instance for downstream processing.
    /// </summary>
    /// <value>The project summaries value exposed by <see cref="Projects"/>.</value>
    List<LocalGptProjectSummary> ProjectSummaries { get; set; } = [];

    /// <summary>
    /// Gets or sets the selected project value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The selected project value exposed by <see cref="Projects"/>.</value>
    LocalGptProjectDetails? SelectedProject { get; set; }

    /// <summary>
    /// Gets or sets the project edit value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The project edit value exposed by <see cref="Projects"/>.</value>
    SaveLocalGptProjectRequest ProjectEdit { get; set; } = null!;

    /// <summary>
    /// Gets or sets the topic edit value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The topic edit value exposed by <see cref="Projects"/>.</value>
    AddLocalGptProjectTopicRequest TopicEdit { get; set; } = null!;

    /// <summary>
    /// Gets or sets the version edit value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The version edit value exposed by <see cref="Projects"/>.</value>
    AddLocalGptProjectVersionRequest VersionEdit { get; set; } = null!;

    /// <summary>
    /// Gets or sets the revision edit value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The revision edit value exposed by <see cref="Projects"/>.</value>
    SaveProjectRevisionRequest RevisionEdit { get; set; } = null!;

    /// <summary>
    /// Gets or sets the requirement edit value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The requirement edit value exposed by <see cref="Projects"/>.</value>
    SaveProjectRequirementRequest RequirementEdit { get; set; } = null!;

    /// <summary>
    /// Gets or sets the requirement link edit value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The requirement link edit value exposed by <see cref="Projects"/>.</value>
    SaveProjectRequirementLinkRequest RequirementLinkEdit { get; set; } = null!;

    /// <summary>
    /// Gets or sets the artifact edit value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The artifact edit value exposed by <see cref="Projects"/>.</value>
    SaveProjectArtifactRequest ArtifactEdit { get; set; } = null!;

    /// <summary>Gets or sets the current Game-project authoring editor state.</summary>
    /// <value>The user-editable, project-owned Game design request.</value>
    SaveGameProjectProfileRequest GameProfileEdit { get; set; } = null!;

    /// <summary>Gets or sets the latest persisted build shown for the selected Game project.</summary>
    /// <value>The selected project's latest approved game build when one exists.</value>
    ProjectGameBuildResult? CurrentGameBuild { get; set; }

    /// <summary>Gets or sets the persisted authoring profile shown for the selected Game project.</summary>
    /// <value>The selected project's editable project-owned game profile when one exists.</value>
    LocalGptGameProjectProfile? CurrentGameProfile { get; set; }

    /// <summary>
    /// Gets or sets the revision parent value value that forms part of the projects state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The revision parent value value exposed by <see cref="Projects"/>.</value>
    string RevisionParentValue
    {
        get => RevisionEdit.ParentRevisionId?.ToString() ?? string.Empty;
