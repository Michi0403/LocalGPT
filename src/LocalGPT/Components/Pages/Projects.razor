    /// <summary>
    /// Performs select project for <see cref="Projects"/>, keeping the operation consistent with the state and invariants of the surrounding projects workflow.
    /// </summary>
    /// <param name="projectId">Identifier of the project to use for this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    async Task SelectProjectAsync(Guid projectId)
    {
        await RunUiActionAsync(async () =>
        {
            SelectedProject = await ProjectService.GetProjectAsync(projectId).ConfigureAwait(false);
            if (SelectedProject is null)
                throw new InvalidOperationException("The selected project no longer exists.");

            var project = SelectedProject.Project;
            ProjectEdit = new SaveLocalGptProjectRequest
            {
                Id = project.Id,
                Name = project.Name,
                Purpose = project.Purpose,
                RootPath = project.RootPath,
                ProjectType = project.ProjectType,
                SolutionPath = project.SolutionPath,
                SolutionSearchPattern = project.SolutionSearchPattern,
                FileIncludePattern = project.FileIncludePattern,
                FileExcludePattern = project.FileExcludePattern,
                CurrentVersion = project.CurrentVersion,
                Status = project.Status,
                RecommendGit = project.RecommendGit,
                IsArchived = project.IsArchived,
                UserConfirmed = false
            };
            TopicEdit = RequestFactory.CreateTopicRequest();
            VersionEdit = RequestFactory.CreateVersionRequest(project.RootPath);
            RevisionEdit = RequestFactory.CreateRevisionRequest();
            RequirementEdit = RequestFactory.CreateRequirementRequest();
            RequirementLinkEdit = RequestFactory.CreateRequirementLinkRequest();
            ArtifactEdit = RequestFactory.CreateArtifactRequest();
            GameProfileEdit = RequestFactory.CreateGameProjectProfileRequest();
            CurrentGameProfile = project.IsGameProject
                ? await GameProjects.GetProfileAsync(project.Id).ConfigureAwait(false)
                : null;
            CurrentGameBuild = project.IsGameProject
                ? await GameProjects.GetBuildAsync(project.Id).ConfigureAwait(false)
                : null;
            if (CurrentGameProfile is not null)
            {
                GameProfileEdit.GameKey = CurrentGameProfile.GameKey;
                GameProfileEdit.DisplayName = CurrentGameProfile.DisplayName;
                GameProfileEdit.RuntimeProfile = CurrentGameProfile.RuntimeProfile;
                GameProfileEdit.DefaultTeamKey = CurrentGameProfile.DefaultTeamKey;
                GameProfileEdit.DefaultControlMode = CurrentGameProfile.DefaultControlMode;
                GameProfileEdit.DirectorMode = CurrentGameProfile.DirectorMode;
                GameProfileEdit.GameDirectorModelName = CurrentGameProfile.GameDirectorModelName;
                GameProfileEdit.CreatureDirectorCount = CurrentGameProfile.CreatureDirectorCount;
                GameProfileEdit.AutoplayDelayMilliseconds = CurrentGameProfile.AutoplayDelayMilliseconds;
                GameProfileEdit.FrameWidth = CurrentGameProfile.FrameWidth;
                GameProfileEdit.FrameHeight = CurrentGameProfile.FrameHeight;
                GameProfileEdit.AsciiColorMode = CurrentGameProfile.AsciiColorMode;
                GameProfileEdit.DefaultForegroundColor = CurrentGameProfile.DefaultForegroundColor;
                GameProfileEdit.DefaultBackgroundColor = CurrentGameProfile.DefaultBackgroundColor;
                GameProfileEdit.MapSeed = CurrentGameProfile.MapSeed > 0 ? CurrentGameProfile.MapSeed : null;
                GameProfileEdit.ScenarioPrompt = CurrentGameProfile.ScenarioPrompt;
            }
            else if (CurrentGameBuild is not null)
            {
                var definition = CurrentGameBuild.Definition;
                GameProfileEdit.GameKey = definition.GameKey;
                GameProfileEdit.DisplayName = definition.DisplayName;
                GameProfileEdit.RuntimeProfile = definition.RuntimeProfile;
                GameProfileEdit.DefaultTeamKey = definition.DefaultTeamKey;
                GameProfileEdit.DefaultControlMode = definition.DefaultControlMode;
                GameProfileEdit.DirectorMode = definition.DirectorMode;
                GameProfileEdit.GameDirectorModelName = definition.GameDirectorModelName;
                GameProfileEdit.CreatureDirectorCount = definition.CreatureDirectorCount;
                GameProfileEdit.AutoplayDelayMilliseconds = definition.AutoplayDelayMilliseconds;
                GameProfileEdit.FrameWidth = definition.FrameWidth;
                GameProfileEdit.FrameHeight = definition.FrameHeight;
                GameProfileEdit.AsciiColorMode = definition.AsciiColorMode;
                GameProfileEdit.DefaultForegroundColor = definition.DefaultForegroundColor;
                GameProfileEdit.DefaultBackgroundColor = definition.DefaultBackgroundColor;
                GameProfileEdit.MapSeed = definition.MapSeed > 0 ? definition.MapSeed : null;
                GameProfileEdit.ScenarioPrompt = definition.ScenarioPrompt;
            }
        }, "Select project").ConfigureAwait(false);
    }

