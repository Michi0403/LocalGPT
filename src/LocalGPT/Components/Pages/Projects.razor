    /// <summary>Saves the selected Game project's editable project-owned authoring profile without producing a runtime build.</summary>
    /// <returns>A task that completes when the authoring profile has been persisted.</returns>
    async Task SaveGameProjectProfileAsync()
    {
        if (SelectedProject is null || !SelectedProject.Project.IsGameProject)
            return;

        await RunUiActionAsync(async () =>
        {
            GameProfileEdit.UserConfirmed = true;
            try
            {
                CurrentGameProfile = await GameProjects.SaveProfileAsync(SelectedProject.Project.Id, GameProfileEdit).ConfigureAwait(false);
                Notifier.ShowSuccess(toastName, "Game project authoring profile saved.", "Game design saved");
            }
            finally
            {
                GameProfileEdit.UserConfirmed = false;
            }
        }, "Save game project design").ConfigureAwait(false);
    }

    /// <summary>Builds the selected Game project into its approved project-owned runtime definition.</summary>
    /// <returns>A task that completes when the game build has been persisted.</returns>
    async Task BuildGameProjectAsync()
    {
        if (SelectedProject is null || !SelectedProject.Project.IsGameProject)
            return;

        await RunUiActionAsync(async () =>
        {
            var buildRequest = RequestFactory.CreateGameBuildRequest();
            buildRequest.UserConfirmed = true;
            CurrentGameBuild = await GameProjects.BuildAsync(SelectedProject.Project.Id, buildRequest).ConfigureAwait(false);
            await RefreshSelectedProjectAsync(SelectedProject.Project.Id).ConfigureAwait(false);
            Notifier.ShowSuccess(toastName, "Saved Game design compiled into the project runtime-definition artifact.", "Game project built");
        }, "Build game project").ConfigureAwait(false);
    }

