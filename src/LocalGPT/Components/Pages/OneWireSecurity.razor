@rendermode InteractiveServer
@page "/onewire-security"
@using System.Text.Json
@inject IOneWireRuntimeSecurityService Security
@inject IOneWireCapabilityCatalog CapabilityCatalog
@inject IOneWirePeerRegistry PeerRegistry
@inject IOneWireConnectionRegistry ConnectionRegistry
@inject IOptions<OneWireOptions> OneWireOptions
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject ILogger<OneWireSecurity> Logger
@inject IJSRuntime JS
@inject ISupervisedTaskRunner TaskRunner
@implements IDisposable

<PageTitle>1-Wire Security</PageTitle>
<ToastWrapper Name="OneWireSecurityToasts" />

<main class="onewire-security-page">
    <WorkbenchHeader Eyebrow="LOCALGPT · 1-WIRE WORKBENCH"
                     Title="Runtime 1-Wire identity and trust"
                     Subtitle="Identity, protocol surface, pairing and trusted peers are separated into focused work areas so large capability catalogs never paint over security controls.">
        <Actions>
            <span class="onewire-security-state">@(_status.HasSecret ? "Identity ready" : "Not initialized")</span>
        </Actions>
    </WorkbenchHeader>

    <div class="onewire-workbench-layout">
        <ConfigurationWorkbenchNav Items="@OneWireSections"
                                   ActiveKey="@ActiveOneWireSection"
                                   ActiveKeyChanged="OnOneWireSectionChangedAsync"
                                   AriaLabel="1-Wire security sections" />

        <div class="onewire-workbench-stage">
            <ConfigurationWorkbenchPanel SectionKey="identity" ActiveKey="@ActiveOneWireSection" AriaLabel="Runtime identity">
                <section class="onewire-security-card">
                    <div class="onewire-security-section-heading">
                        <div>
                            <span class="onewire-security-kicker">IDENTITY</span>
                            <h2>Local runtime identity</h2>
                            <p>Create or rotate the local identity without compiling private material into LocalGPT.</p>
                        </div>
                    </div>
                    <div class="onewire-security-facts">
                        <span><strong>Fingerprint</strong>@(_status.HasSecret ? _status.Fingerprint : "Not created")</span>
                        <span><strong>Trusted peers</strong>@_status.TrustedPeerCount</span>
                        <span><strong>Secret file</strong><code>@_status.SecretPath</code></span>
                    </div>
                    <div class="onewire-security-actions">
                        <DxButton Text="Create identity" Enabled="@(!_status.HasSecret)" Click="CreateAsync" RenderStyle="ButtonRenderStyle.Primary" />
                        <DxButton Text="Create pairing material" Enabled="@_status.HasSecret" Click="CreatePairingMaterialAsync" />
                        <DxButton Text="Regenerate identity" Enabled="@(_status.HasSecret && _allowReset)" Click="RegenerateAsync" RenderStyle="ButtonRenderStyle.Warning" />
                        <DxButton Text="Delete identity" Enabled="@(_status.HasSecret && _allowReset)" Click="DeleteAsync" RenderStyle="ButtonRenderStyle.Danger" />
                        <label><input type="checkbox" @bind="_allowReset" /> allow trust reset</label>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_status.Warning))
                    {
                        <p class="onewire-security-error">@_status.Warning</p>
                    }
                </section>
            </ConfigurationWorkbenchPanel>

            <ConfigurationWorkbenchPanel SectionKey="protocol" ActiveKey="@ActiveOneWireSection" AriaLabel="Active 1-Wire protocol surface">
                <section class="onewire-security-card onewire-protocol-card">
                    <div class="onewire-security-section-heading">
                        <div>
                            <span class="onewire-security-kicker">PROTOCOL</span>
                            <h2>Active 1-Wire protocol surface</h2>
                            <p>LocalGPT and connected organic peers publish the exact methods, routes and configuration keys used for Council and PublisherStudio capability negotiation.</p>
                        </div>
                        <span class="onewire-count-badge">@_localCapabilities.Count local methods</span>
                    </div>
                    <div class="onewire-security-facts">
                        <span><strong>Protocol</strong>@OneWireProtocol.Version (minimum @OneWireProtocol.MinimumCompatibleVersion)</span>
                        <span><strong>Runtime</strong>@(OneWireOptions.Value.Enabled ? "enabled" : "disabled") · discovery @(OneWireOptions.Value.EnableDiscovery ? "enabled" : "disabled") · LAN @(OneWireOptions.Value.EnableLanTransport ? "enabled" : "disabled")</span>
                        <span><strong>Transport</strong>@OneWireOptions.Value.ListenAddress:@OneWireOptions.Value.ServicePort · discovery UDP @OneWireOptions.Value.DiscoveryPort</span>
                        <span><strong>Limits</strong>@OneWireOptions.Value.MaximumMessageBytes bytes · broadcast @OneWireOptions.Value.BroadcastIntervalSeconds seconds · peer expiry @OneWireOptions.Value.PeerExpirySeconds seconds</span>
                        <span><strong>HTTP/JSON profile</strong><code>/api/onewire/http-json/profile</code></span>
                    </div>
                    <details open>
                        <summary>LocalGPT methods (@_localCapabilities.Count)</summary>
                        <div class="onewire-protocol-table-wrap" role="region" aria-label="Active LocalGPT 1-Wire methods" tabindex="0">
                            <table class="onewire-protocol-table">
                                <thead><tr><th>Capability</th><th>Method and route</th><th>Configuration</th><th>Approval</th></tr></thead>
                                <tbody>
                                    @foreach (var capability in _localCapabilities.OrderBy(item => item.Key))
                                    {
                                        <tr @key="capability.Key">
                                            <td><strong>@capability.DisplayName</strong><small>@capability.Key</small></td>
                                            <td><code>@capability.Method @capability.Route</code></td>
                                            <td><code>@capability.ConfigurationKey</code></td>
                                            <td>@(capability.RequiresFrontendUserConfirmation ? "Receiving frontend" : capability.RequiresHumanConfirmation ? "Required" : "Read-only / policy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                    @foreach (var peer in _advertisedPeers.OrderBy(item => item.DisplayName))
                    {
                        <details class="onewire-peer-surface" @key="peer.PeerId">
                            <summary>@peer.DisplayName · @(ConnectionRegistry.IsConnected(peer.PeerId) ? "connected" : "discovered") · @peer.Capabilities.Count method(s)</summary>
                            <div class="onewire-protocol-table-wrap" role="region" aria-label="@peer.DisplayName active 1-Wire methods" tabindex="0">
                                <table class="onewire-protocol-table">
                                    <thead><tr><th>Capability</th><th>Method and route</th><th>Configuration</th><th>Source</th></tr></thead>
                                    <tbody>
                                        @foreach (var capability in peer.Capabilities.Where(item => item.IsEnabled && item.IsOnline).OrderBy(item => item.Key))
                                        {
                                            <tr @key="capability.Key">
                                                <td><strong>@capability.DisplayName</strong><small>@capability.Key</small></td>
                                                <td><code>@capability.Method @capability.Route</code></td>
                                                <td><code>@capability.ConfigurationKey</code></td>
                                                <td>@capability.Source</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                    <p class="onewire-ocr-status"><strong>OCR check:</strong> @OcrCapabilityStatus</p>
                </section>
            </ConfigurationWorkbenchPanel>

            <ConfigurationWorkbenchPanel SectionKey="pairing" ActiveKey="@ActiveOneWireSection" AriaLabel="Pairing and trust establishment">
                <div class="onewire-panel-stack">
                    <section class="onewire-security-card">
                        <div class="onewire-security-section-heading">
                            <div>
                                <span class="onewire-security-kicker">PAIRING</span>
                                <h2>Pairing material</h2>
                                <p>Generate public pairing material from the Identity section, then enroll MFA or exchange the public ticket here.</p>
                            </div>
                        </div>
                        @if (string.IsNullOrWhiteSpace(_pairingTicketJson) && string.IsNullOrWhiteSpace(_otpUri))
                        {
                            <div class="onewire-empty-state">
                                <strong>No pairing material generated.</strong>
                                <span>Open Identity and choose “Create pairing material”.</span>
                                <DxButton Text="Open identity" Click="OpenIdentitySectionAsync" />
                            </div>
                        }
                        else
                        {
                            <div class="onewire-security-grid">
                                <article class="onewire-security-subcard">
                                    <h3>Authenticator enrollment</h3>
                                    <p>Scan this QR code with an Authenticator-compatible app.</p>
                                    <div id="localgpt-security-otp-qr" class="onewire-security-qr" aria-label="LocalGPT Authenticator QR code"></div>
                                    <textarea rows="5" readonly>@_otpUri</textarea>
                                </article>
                                <article class="onewire-security-subcard">
                                    <h3>Public pairing ticket</h3>
                                    <p>The short-lived ticket contains public keys and a signature only.</p>
                                    <div id="localgpt-security-ticket-qr" class="onewire-security-qr" aria-label="LocalGPT public pairing ticket QR code"></div>
                                    <textarea rows="12" readonly>@_pairingTicketJson</textarea>
                                </article>
                            </div>
                        }
                    </section>

                    <section class="onewire-security-card">
                        <div class="onewire-security-section-heading">
                            <div>
                                <span class="onewire-security-kicker">REMOTE TRUST</span>
                                <h2>Trust a remote peer</h2>
                                <p>Paste the remote public ticket and confirm with the current LocalGPT MFA code.</p>
                            </div>
                        </div>
                        <label>Remote public pairing ticket
                            <textarea rows="11" @bind="_remoteTicketJson" @bind:event="oninput" placeholder="Paste the PublisherStudio, ESP32 gateway or custom add-on pairing-ticket JSON."></textarea>
                        </label>
                        <div class="onewire-security-inline">
                            <label>Current LocalGPT MFA code <input inputmode="numeric" maxlength="8" @bind="_mfaCode" /></label>
                            <label>Validity in minutes <input type="number" min="5" max="525600" @bind="_validForMinutes" /></label>
                        </div>
                        <DxButton Text="Verify MFA and trust peer" Click="EstablishTrustAsync" RenderStyle="ButtonRenderStyle.Primary" />
                        <p>Trust is reciprocal. Repeat the process in the remote application with LocalGPT's public ticket. Private material never crosses the wire.</p>
                    </section>
                </div>
            </ConfigurationWorkbenchPanel>

            <ConfigurationWorkbenchPanel SectionKey="peers" ActiveKey="@ActiveOneWireSection" AriaLabel="Trusted peers">
                <section class="onewire-security-card">
                    <div class="onewire-security-section-heading">
                        <div>
                            <span class="onewire-security-kicker">TRUST STORE</span>
                            <h2>Trusted peers</h2>
                            <p>Review and revoke encrypted peer trust without mixing the list with the protocol catalog.</p>
                        </div>
                        <span class="onewire-count-badge">@_trustedPeers.Count trusted</span>
                    </div>
                    @if (_trustedPeers.Count == 0)
                    {
                        <div class="onewire-empty-state">
                            <strong>No encrypted peer trust exists yet.</strong>
                            <span>Discovery and explicit frontend link approval remain available without encrypted payloads.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var peer in _trustedPeers)
                        {
                            <div class="onewire-security-peer" @key="peer.PeerId">
                                <div>
                                    <strong>@peer.DisplayName</strong>
                                    <span>@peer.PeerId</span>
                                    <small>@peer.TrustLevel · valid until @(peer.ValidUntilUtc?.LocalDateTime.ToString("g") ?? "manual revocation")</small>
                                </div>
                                <DxButton Text="Revoke" Click="() => RevokeAsync(peer.PeerId)" RenderStyle="ButtonRenderStyle.Danger" />
                            </div>
                        }
                    }
                </section>
            </ConfigurationWorkbenchPanel>
        </div>
    </div>
</main>

@code {
    /// <summary>
    /// Stores the internal JSON options state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    /// <summary>
    /// Stores the cancellation source used by <see cref="OneWireSecurity"/> to stop its current background or asynchronous operation.
    /// </summary>
    private readonly CancellationTokenSource lifetimeCts = new();
    /// <summary>
    /// Gets or sets the active one wire section value that forms part of the one wire security state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The active one wire section value exposed by <see cref="OneWireSecurity"/>.</value>
    private string ActiveOneWireSection { get; set; } = "identity";
    /// <summary>
    /// Gets the one wire sections collection maintained or exposed by this one wire security instance for downstream processing.
    /// </summary>
    /// <value>The one wire sections value exposed by <see cref="OneWireSecurity"/>.</value>
    private IReadOnlyList<WorkbenchNavItem> OneWireSections =>
    [
        new("identity", "Identity", "Create, rotate and inspect the local runtime identity.", _status.HasSecret ? "ready" : "new"),
        new("protocol", "Protocol surface", "Browse LocalGPT and peer methods without crowding the trust controls.", _localCapabilities.Count.ToString()),
        new("pairing", "Pairing & trust", "Generate QR material and establish encrypted remote trust."),
        new("peers", "Trusted peers", "Review and revoke stored peer trust.", _trustedPeers.Count.ToString())
    ];
    /// <summary>
    /// Stores the internal status state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private OneWireRuntimeSecurityStatus _status = new();
    /// <summary>
    /// Stores the in-memory trusted peers collection maintained internally by <see cref="OneWireSecurity"/> for its current workflow state.
    /// </summary>
    private IReadOnlyList<OneWireTrustedPeerDescriptor> _trustedPeers = [];
    /// <summary>
    /// Stores the in-memory local capabilities collection maintained internally by <see cref="OneWireSecurity"/> for its current workflow state.
    /// </summary>
    private IReadOnlyList<OneWireCapabilityDescriptor> _localCapabilities = [];
    /// <summary>
    /// Stores the in-memory advertised peers collection maintained internally by <see cref="OneWireSecurity"/> for its current workflow state.
    /// </summary>
    private IReadOnlyList<OneWirePeerAdvertisement> _advertisedPeers = [];
    /// <summary>
    /// Stores the internal otp URI state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private string _otpUri = string.Empty;
    /// <summary>
    /// Stores the internal pairing ticket JSON state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private string _pairingTicketJson = string.Empty;
    /// <summary>
    /// Stores the internal remote ticket JSON state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private string _remoteTicketJson = string.Empty;
    /// <summary>
    /// Stores the internal MFA code state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private string _mfaCode = string.Empty;
    /// <summary>
    /// Stores the internal valid for minutes state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private int _validForMinutes = 1440;
    /// <summary>
    /// Stores the internal allow reset state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private bool _allowReset;
    /// <summary>
    /// Stores the internal render QR state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private bool _renderQr;
    /// <summary>
    /// Stores the internal initialization started state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private bool initializationStarted;
    /// <summary>
    /// Stores the internal is disposed state used by <see cref="OneWireSecurity"/> while executing its surrounding workflow.
    /// </summary>
    private bool isDisposed;

    /// <summary>
    /// Handles the one wire section changed async lifecycle or event notification for <see cref="OneWireSecurity"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="key">Key value supplied to the one wire security operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task OnOneWireSectionChangedAsync(string key)
    {
        ActiveOneWireSection = key;
        if (string.Equals(key, "pairing", StringComparison.OrdinalIgnoreCase) &&
            (!string.IsNullOrWhiteSpace(_pairingTicketJson) || !string.IsNullOrWhiteSpace(_otpUri)))
        {
            _renderQr = true;
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Opens identity section for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task OpenIdentitySectionAsync()
    {
        ActiveOneWireSection = "identity";
        return Task.CompletedTask;
    }

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="OneWireSecurity"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        ComponentActivity.RecordInformation(nameof(OneWireSecurity), nameof(OnInitialized), "The 1-Wire Security page rendered its interactive shell; runtime state will load after the first render.");
    }

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="OneWireSecurity"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initializationStarted && !isDisposed)
        {
            initializationStarted = true;
            TaskRunner.Run(
                nameof(OneWireSecurity),
                "InitialSecurityRefresh",
                InitializeAfterRenderAsync,
                lifetimeCts.Token);
        }

        if (!_renderQr || isDisposed || !string.Equals(ActiveOneWireSection, "pairing", StringComparison.OrdinalIgnoreCase))
            return;

        _renderQr = false;
        try
        {
            await JS.InvokeVoidAsync(
                "localGptOneWireSecurity.renderQr",
                "localgpt-security-otp-qr",
                _otpUri,
                "LocalGPT Authenticator enrollment").ConfigureAwait(true) /* renderer-affine lifecycle continuation */;
            await JS.InvokeVoidAsync(
                "localGptOneWireSecurity.renderQr",
                "localgpt-security-ticket-qr",
                _pairingTicketJson,
                "LocalGPT public 1-Wire pairing ticket").ConfigureAwait(true) /* renderer-affine lifecycle continuation */;
            Logger.LogDebug("Rendered current 1-Wire pairing QR material.");
        }
        catch (OperationCanceledException) when (isDisposed)
        {
            // Normal circuit teardown.
        }
        catch (JSDisconnectedException) when (isDisposed)
        {
            // Normal circuit teardown.
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not render the 1-Wire Security QR material.");
            ComponentActivity.RecordFailure(nameof(OneWireSecurity), nameof(OnAfterRenderAsync), ex);
            Notifier.ShowError("OneWireSecurityToasts", "QR rendering failed. The text pairing material remains available.", "1-Wire Security");
        }
    }

    /// <summary>
    /// Performs initialize after render for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <param name="cancellationToken">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task InitializeAfterRenderAsync(CancellationToken cancellationToken)
    {
        try
        {
            // Read runtime state outside the renderer dispatcher. The previous implementation
            // wrapped the entire security I/O sequence in InvokeAsync, which could monopolize the
            // circuit until the timeout fired. Only the final state assignment belongs on the UI.
            var state = await LoadSecurityStateAsync(cancellationToken).ConfigureAwait(false);
            await InvokeAsync(() =>
            {
                _status = state.Status;
                _trustedPeers = state.TrustedPeers;
                _localCapabilities = state.LocalCapabilities;
                _advertisedPeers = state.AdvertisedPeers;
                Logger.LogInformation("1-Wire Security page initialized with {TrustedPeerCount} trusted peer(s).", _trustedPeers.Count);
                ComponentActivity.RecordInformation(nameof(OneWireSecurity), nameof(InitializeAfterRenderAsync), "The 1-Wire Security runtime state finished loading after the interactive shell rendered.");
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (!isDisposed)
        {
            await InvokeAsync(() =>
            {
                _status = new OneWireRuntimeSecurityStatus
                {
                    HasSecret = false,
                    Warning = "The runtime security state did not respond within eight seconds. The page remains usable; retry the action or review the local log."
                };
                Logger.LogWarning("1-Wire Security initialization timed out instead of blocking the Blazor circuit.");
                ComponentActivity.RecordWarning(nameof(OneWireSecurity), nameof(InitializeAfterRenderAsync), "Runtime security initialization timed out without blocking the UI.");
                Notifier.ShowWarning("OneWireSecurityToasts", _status.Warning, "1-Wire Security timeout");
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException) when (isDisposed)
        {
            // Normal navigation or shutdown.
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _status = new OneWireRuntimeSecurityStatus
                {
                    HasSecret = false,
                    Warning = "The runtime security state could not be loaded. The page remains available; see local logs for details."
                };
                Logger.LogError(ex, "Could not initialize the 1-Wire Security page.");
                ComponentActivity.RecordFailure(nameof(OneWireSecurity), nameof(InitializeAfterRenderAsync), ex);
                Notifier.ShowError("OneWireSecurityToasts", _status.Warning, "1-Wire Security");
                StateHasChanged();
            }).ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Loads security state for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <param name="cancellationToken">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <returns>The collection produced by the operation.</returns>
    private async Task<(OneWireRuntimeSecurityStatus Status, IReadOnlyList<OneWireTrustedPeerDescriptor> TrustedPeers, IReadOnlyList<OneWireCapabilityDescriptor> LocalCapabilities, IReadOnlyList<OneWirePeerAdvertisement> AdvertisedPeers)> LoadSecurityStateAsync(CancellationToken cancellationToken)
    {
        using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        timeoutCts.CancelAfter(TimeSpan.FromSeconds(8));
        var status = await Security.GetStatusAsync(timeoutCts.Token).ConfigureAwait(false);
        var trustedPeers = await Security.GetTrustedPeersAsync(timeoutCts.Token).ConfigureAwait(false);
        var localCapabilities = await CapabilityCatalog.GetLocalCapabilitiesAsync(timeoutCts.Token).ConfigureAwait(false);
        var advertisedPeers = PeerRegistry.GetPeers();
        return (status, trustedPeers, localCapabilities, advertisedPeers);
    }

    /// <summary>
    /// Performs refresh for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <param name="cancellationToken">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RefreshAsync(CancellationToken cancellationToken = default)
    {
        var state = await LoadSecurityStateAsync(cancellationToken).ConfigureAwait(false);
        await InvokeAsync(() =>
        {
            _status = state.Status;
            _trustedPeers = state.TrustedPeers;
            _localCapabilities = state.LocalCapabilities;
            _advertisedPeers = state.AdvertisedPeers;
            StateHasChanged();
        }).ConfigureAwait(false);
    }

    /// <summary>
    /// Performs create for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task CreateAsync() => await RunAsync(async cancellationToken =>
    {
        await Security.EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        Notifier.ShowSuccess("OneWireSecurityToasts", "Runtime 1-Wire identity created.", "1-Wire Security");
    }, "CreateIdentity", "Could not create the runtime 1-Wire identity.").ConfigureAwait(false);

    /// <summary>
    /// Creates pairing material for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task CreatePairingMaterialAsync() => await RunAsync(async cancellationToken =>
    {
        await Security.EnsureCreatedAsync(cancellationToken).ConfigureAwait(false);
        _otpUri = await Security.GetOtpAuthUriAsync(cancellationToken).ConfigureAwait(false);
        var ticket = await Security.CreatePairingTicketAsync(TimeSpan.FromMinutes(15), cancellationToken).ConfigureAwait(false);
        _pairingTicketJson = JsonSerializer.Serialize(ticket, JsonOptions);
        ActiveOneWireSection = "pairing";
        _renderQr = true;
        Notifier.ShowSuccess("OneWireSecurityToasts", "Authenticator enrollment and public pairing material created.", "1-Wire Security");
    }, "CreatePairingMaterial", "Could not create 1-Wire pairing material.").ConfigureAwait(false);

    /// <summary>
    /// Performs regenerate for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RegenerateAsync() => await RunAsync(async cancellationToken =>
    {
        if (!_allowReset)
            return;
        await Security.RegenerateAsync(cancellationToken).ConfigureAwait(false);
        ClearMaterial();
        Notifier.ShowWarning("OneWireSecurityToasts", "The LocalGPT runtime identity was regenerated. Previous encrypted trust is invalid.", "1-Wire trust reset");
    }, "RegenerateIdentity", "Could not regenerate the runtime 1-Wire identity.").ConfigureAwait(false);

    /// <summary>
    /// Performs delete for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task DeleteAsync() => await RunAsync(async cancellationToken =>
    {
        if (!_allowReset)
            return;
        await Security.DeleteAsync(cancellationToken).ConfigureAwait(false);
        ClearMaterial();
        Notifier.ShowWarning("OneWireSecurityToasts", "The LocalGPT runtime identity and local trust bindings were deleted.", "1-Wire trust reset");
    }, "DeleteIdentity", "Could not delete the runtime 1-Wire identity.").ConfigureAwait(false);

    /// <summary>
    /// Performs establish trust for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task EstablishTrustAsync() => await RunAsync(async cancellationToken =>
    {
        var ticket = JsonSerializer.Deserialize<OneWirePairingTicket>(_remoteTicketJson, JsonOptions)
            ?? throw new InvalidDataException("The remote pairing ticket is empty or invalid.");
        var accepted = await Security.EstablishTrustAsync(new OneWireTrustEstablishmentRequest
        {
            Ticket = ticket,
            MfaCode = _mfaCode.Trim(),
            ValidForMinutes = _validForMinutes
        }, cancellationToken).ConfigureAwait(false);
        if (!accepted)
        {
            Notifier.ShowWarning("OneWireSecurityToasts", "The current LocalGPT MFA code was not accepted.", "1-Wire trust");
            return;
        }
        _mfaCode = string.Empty;
        Notifier.ShowSuccess("OneWireSecurityToasts", $"Trusted {ticket.DisplayName} for the selected validity period.", "1-Wire trust");
    }, "EstablishTrust", "Could not establish trust for the remote 1-Wire peer.").ConfigureAwait(false);

    /// <summary>
    /// Performs revoke for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <param name="peerId">Identifier of the peer to use for this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RevokeAsync(string peerId) => await RunAsync(async cancellationToken =>
    {
        await Security.RevokeTrustAsync(peerId, cancellationToken).ConfigureAwait(false);
        Notifier.ShowWarning("OneWireSecurityToasts", $"Trust for {peerId} was revoked.", "1-Wire trust");
    }, "RevokeTrust", "Could not revoke the selected 1-Wire trust binding.").ConfigureAwait(false);

    /// <summary>
    /// Performs run for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    /// <param name="action">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <param name="operation">Operation value supplied to the one wire security operation and used when producing its result.</param>
    /// <param name="message">Message value supplied to the one wire security operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RunAsync(Func<CancellationToken, Task> action, string operation, string message)
    {
        ArgumentNullException.ThrowIfNull(action);
        if (isDisposed)
            return;

        ComponentActivity.RecordInformation(nameof(OneWireSecurity), operation, "A runtime 1-Wire Security UI operation started.");
        using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(lifetimeCts.Token);
        timeoutCts.CancelAfter(TimeSpan.FromSeconds(15));
        try
        {
            await action(timeoutCts.Token).ConfigureAwait(false);
            await RefreshAsync(timeoutCts.Token).ConfigureAwait(false);
            ComponentActivity.RecordInformation(nameof(OneWireSecurity), operation, "The runtime 1-Wire Security UI operation completed.");
        }
        catch (OperationCanceledException) when (!isDisposed)
        {
            Logger.LogWarning("1-Wire Security operation {Operation} timed out instead of blocking the Blazor circuit.", operation);
            ComponentActivity.RecordWarning(nameof(OneWireSecurity), operation, "The runtime security operation timed out without blocking the UI.");
            Notifier.ShowWarning("OneWireSecurityToasts", "The operation timed out. The page remains responsive; retry or inspect local logs.", "1-Wire Security timeout");
        }
        catch (Exception ex)
        {
            ComponentActivity.RecordFailure(nameof(OneWireSecurity), operation, ex);
            Logger.LogError(ex, "{Message}", message);
            Notifier.ShowError("OneWireSecurityToasts", $"{message} {ex.Message}", "1-Wire Security");
        }
    }

    /// <summary>
    /// Gets the OCR capability status value that forms part of the one wire security state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The OCR capability status value exposed by <see cref="OneWireSecurity"/>.</value>
    private string OcrCapabilityStatus
    {
        get
        {
            var local = _localCapabilities.FirstOrDefault(item => string.Equals(item.Key, "localgpt.vision.ocr", StringComparison.OrdinalIgnoreCase));
            if (local is null) return "Local OCR is not advertised.";
            var publisher = _advertisedPeers.SelectMany(item => item.Capabilities)
                .FirstOrDefault(item => string.Equals(item.Key, "publisher.documentation.profile", StringComparison.OrdinalIgnoreCase) ||
                                        item.UiActivationKeys.Contains("publisherstudio.picture.ocr", StringComparer.OrdinalIgnoreCase));
            return publisher is null
                ? $"Local DeepSeek-compatible OCR is active at {local.Method} {local.Route}; no PublisherStudio OCR consumer is currently advertised."
                : $"Local DeepSeek-compatible OCR is active at {local.Method} {local.Route}, and PublisherStudio advertises the matching picture/documentation surface.";
        }
    }

    /// <summary>
    /// Performs clear material for <see cref="OneWireSecurity"/>, keeping the operation consistent with the state and invariants of the surrounding one wire security workflow.
    /// </summary>
    private void ClearMaterial()
    {
        _otpUri = string.Empty;
        _pairingTicketJson = string.Empty;
        _allowReset = false;
        _renderQr = false;
    }

    /// <summary>
    /// Releases resources owned by <see cref="OneWireSecurity"/> and leaves the one wire security workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        if (isDisposed)
            return;
        isDisposed = true;
        lifetimeCts.Cancel();
        lifetimeCts.Dispose();
    }
}
