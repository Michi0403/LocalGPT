    private List<TestLabDownloadLink> ExtractDownloadLinks(string text)
    {
        try
        {
            var links = new List<TestLabDownloadLink>();
            if (string.IsNullOrWhiteSpace(text))
            {
                return links;
            }

            foreach (Match match in Catalog.DownloadUrlPattern.Matches(text))
            {
                var relativeUrl = match.Groups["url"].Value.Replace("\\/", "/", StringComparison.Ordinal);
                if (!relativeUrl.StartsWith("/__artifacts", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var absoluteUrl = NavigationManager.ToAbsoluteUri(relativeUrl).ToString();
                var label = relativeUrl.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? relativeUrl;
                links.Add(new TestLabDownloadLink(label, absoluteUrl));
            }

            return links
                .DistinctBy(link => link.AbsoluteUrl)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
            statusText = "The operation failed. See local application logs for technical details.";
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
            return new();
        }
     
    }


    private async Task RunUiActionAsync(Func<Task> action, string operation)
    {
        ArgumentNullException.ThrowIfNull(action);
        isBusy = true;
        ComponentActivity.RecordInformation(nameof(TestLab), operation, "The Test Lab UI operation started.");
        try
        {
            await action().ConfigureAwait(true) /* renderer-affine loading continuation */;
            ComponentActivity.RecordInformation(nameof(TestLab), operation, "The Test Lab UI operation completed.");
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("Test Lab UI operation {Operation} was cancelled.", operation);
            statusText = "The requested operation was cancelled.";
            resultText = statusText;
            ComponentActivity.RecordWarning(nameof(TestLab), operation, "The Test Lab UI operation was cancelled.");
            Notifier.ShowWarning(toastName, statusText, "Operation cancelled");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Test Lab UI operation {Operation} failed; operation delegates and user content were omitted from logs.", operation);
            statusText = "The requested operation failed. See local application logs for technical details.";
            resultText = "The operation failed. See local application logs for technical details.";
            ComponentActivity.RecordFailure(nameof(TestLab), operation, ex);
            Notifier.ShowError(toastName, statusText, "Operation failed");
        }
        finally
        {
            isBusy = false;
        }
    }

 
