    private async Task SaveWorkspaceFileAsync()
    {
        try
        {
            await RunUiActionAsync(async () =>
    {
        if (selectedArtifactWorkspace is null || string.IsNullOrWhiteSpace(openSourceRelativePath))
            return;

        using var http = new HttpClient { Timeout = TimeSpan.FromMinutes(5) };
        var route = $"/__diag/artifact-workspace/{Uri.EscapeDataString(selectedArtifactWorkspace.WorkspaceName)}/file";
        var response = await http.PostAsJsonAsync(
            NavigationManager.ToAbsoluteUri(route),
            new ArtifactWorkspaceFileSaveRequest(openSourceRelativePath, openSourceContent)).ConfigureAwait(false);
        var text = await response.Content.ReadAsStringAsync().ConfigureAwait(false);
        statusText = response.IsSuccessStatusCode
            ? $"Saved {openSourceRelativePath}. Refresh the zip when the source is ready."
            : $"Save failed: {(int)response.StatusCode} {response.ReasonPhrase}";
        resultText = CouncilText.PrettyPrintJson(text, Logger);
        openSourcePreviewMarkup = CouncilText.BuildSourcePreviewMarkup(openSourceRelativePath, openSourceContent, Logger);
        await LoadSelectedWorkspaceFilesAsync().ConfigureAwait(false);
    }, "SaveWorkspaceFileAsync").ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
            statusText = "The operation failed. See local application logs for technical details.";
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
        }

    }

    private async Task RefreshWorkspaceZipAsync()
    {
        try
        {
            await RunUiActionAsync(async () =>
      {
          if (selectedArtifactWorkspace is null)
              return;

          var route = $"/__diag/artifact-workspace/{Uri.EscapeDataString(selectedArtifactWorkspace.WorkspaceName)}/zip";
          using var http = new HttpClient { Timeout = TimeSpan.FromMinutes(5) };
          var response = await http.GetAsync(NavigationManager.ToAbsoluteUri(route)).ConfigureAwait(true) /* renderer-affine loading continuation */;
          var text = await response.Content.ReadAsStringAsync().ConfigureAwait(true) /* renderer-affine loading continuation */;
          statusText = response.IsSuccessStatusCode
              ? $"Workspace zip refreshed for {selectedArtifactWorkspace.WorkspaceName}."
              : $"Zip refresh failed: {(int)response.StatusCode} {response.ReasonPhrase}";
          resultText = CouncilText.PrettyPrintJson(text, Logger);
          downloadLinks = ExtractDownloadLinks(text);
          await LoadArtifactWorkspacesAsync().ConfigureAwait(true) /* renderer-affine loading continuation */;
      }, "RefreshWorkspaceZipAsync").ConfigureAwait(true) /* renderer-affine loading continuation */;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "UI operation failed; user and model content were omitted from logs.");
            statusText = "The operation failed. See local application logs for technical details.";
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
        }

    }

    private async Task TryRefreshArtifactWorkspacesAfterRouteAsync(string responseText)
    {
        try
        {
            if (responseText.Contains("ArtifactRoot", StringComparison.OrdinalIgnoreCase) ||
           responseText.Contains("\"artifacts\"", StringComparison.OrdinalIgnoreCase))
            {
                try
                {
                    await LoadArtifactWorkspacesAsync().ConfigureAwait(false);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Could not refresh generated artifact workspaces after route run.");
                    ComponentActivity.RecordFailure(nameof(TestLab), "RefreshArtifactWorkspaces", ex);
                    Notifier.ShowWarning(toastName, "The route completed, but the generated artifact list could not refresh.", "Artifact refresh warning");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not refresh artifact workspaces; response content was omitted from logs.");
            statusText = "The operation failed. See local application logs for technical details.";
            Notifier.ShowError(toastName, "The operation failed. See local application logs for technical details.", "Operation failed");
        }

    }

