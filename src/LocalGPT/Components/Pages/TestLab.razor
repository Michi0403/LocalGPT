    /// Handles the after render async lifecycle or event notification for <see cref="TestLab"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialRoleCatalogLoadStarted)
        {
            initialRoleCatalogLoadStarted = true;
            TaskRunner.Run(nameof(TestLab), "PreloadRemoteRoleCatalog", PreloadRemoteRoleCatalogAsync);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Performs preload remote role catalog for <see cref="TestLab"/>, keeping the operation consistent with the state and invariants of the surrounding test lab workflow.
    /// </summary>
    /// <param name="cancellationToken">Cancellation token that allows the caller to stop the asynchronous operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task PreloadRemoteRoleCatalogAsync(CancellationToken cancellationToken)
    {
        try
        {
            var roleKeys = (await CouncilTeams.GetTeamsAsync().ConfigureAwait(false))
                .SelectMany(team => team.Roles)
                .Select(role => role.Role)
                .Where(role => !string.IsNullOrWhiteSpace(role))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(role => role, StringComparer.OrdinalIgnoreCase)
                .ToList();
            cancellationToken.ThrowIfCancellationRequested();
            await InvokeAsync(() =>
            {
                availableRemoteRoleKeys = roleKeys;
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Test Lab role catalog preload was cancelled.");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not preload Council role choices for remote knowledge import; free-text role entry remains available.");
        }
    }


