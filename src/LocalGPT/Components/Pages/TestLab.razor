    /// Performs run UI action for <see cref="TestLab"/>, keeping the operation consistent with the state and invariants of the surrounding test lab workflow.
    /// </summary>
    /// <param name="action">Action value supplied to the test lab operation and used when producing its result.</param>
    /// <param name="operation">Operation value supplied to the test lab operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task RunUiActionAsync(Func<Task> action, string operation)
    {
        ArgumentNullException.ThrowIfNull(action);
        isBusy = true;
        ComponentActivity.RecordInformation(nameof(TestLab), operation, "The Test Lab UI operation started.");
        try
        {
            await action().ConfigureAwait(false);
            ComponentActivity.RecordInformation(nameof(TestLab), operation, "The Test Lab UI operation completed.");
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("Test Lab UI operation {Operation} was cancelled.", operation);
            statusText = "The requested operation was cancelled.";
            resultText = statusText;
            ComponentActivity.RecordWarning(nameof(TestLab), operation, "The Test Lab UI operation was cancelled.");
            Notifier.ShowWarning(toastName, statusText, "Operation cancelled");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Test Lab UI operation {Operation} failed; operation delegates and user content were omitted from logs.", operation);
            statusText = "The requested operation failed. See local application logs for technical details.";
            resultText = "The operation failed. See local application logs for technical details.";
            ComponentActivity.RecordFailure(nameof(TestLab), operation, ex);
            Notifier.ShowError(toastName, statusText, "Operation failed");
        }
        finally
        {
            isBusy = false;
        }
    }

 
}
