@rendermode InteractiveServer
@page "/help"
@inject ICustomVersion Version
@inject IDocumentationCatalogService Documentation
@inject ILogger<Help> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization
@inject IDocumentationViewerService Viewer

<PageTitle>Documentation</PageTitle>

<main class="help-page">
    <section class="help-hero">
        <div>
            <p class="help-kicker">LocalGPT @Version.Version</p>
            <h1>Documentation</h1>
            <p>The maintained DocFX documentation and XML-backed API reference open inside LocalGPT, without navigating the application shell away from the current session.</p>
            <div class="help-status" aria-label="Documentation status">
                <span class="badge text-bg-@(documentationStatus.HtmlAvailable ? "success" : "warning")">HTML @(documentationStatus.HtmlAvailable ? "ready" : "not built")</span>
                <span class="badge text-bg-@(documentationStatus.PdfAvailable ? "success" : "warning")">PDF @(documentationStatus.PdfAvailable ? "ready" : "not included")</span>
                <span class="badge text-bg-secondary">@documentationStatus.CommentCount XML members</span>
                @if (documentationStatus.GeneratedAtUtc is DateTime generated)
                {
                    <span>Generated @generated.ToLocalTime().ToString("g")</span>
                }
            </div>
        </div>
        <div class="help-actions" aria-label="Documentation actions">
            <button class="btn btn-primary" type="button" @onclick="OpenHtmlDocumentation">Open HTML documentation</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="OpenPdfDocumentation">@Localization.GetText("Open PDF documentation")</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="OpenBuildStatus">Build status JSON</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="OpenXmlComments">Browse XML comments</button>
        </div>
    </section>

    <section class="help-grid">
        <article class="help-panel">
            <h2>Chat and AI Council</h2>
            <p>Provider selection, Council teams, model routes, human participation, memory and responsive configuration surfaces.</p>
            <button type="button" @onclick="OpenChatAndCouncil">Read chapter</button>
        </article>
        <article class="help-panel">
            <h2>Embedded firmware</h2>
            <p>ESP32/Arduino pin planning, transport-neutral wiring, firmware artifacts and approval-gated compiler boundaries.</p>
            <button type="button" @onclick="OpenEmbeddedFirmware">Read chapter</button>
        </article>
        <article class="help-panel">
            <h2>Workspaces</h2>
            <p>Local environments, compiler profiles, expected structures, regex policies and Approved/Warning/Danger findings.</p>
            <button type="button" @onclick="OpenWorkspaces">Read chapter</button>
        </article>
        <article class="help-panel">
            <h2>GameDirector runtime</h2>
            <p>Authoritative move validation, controller proposals, creature/object subdirectors and runtime-class factories.</p>
            <button type="button" @onclick="OpenGameDirector">Read chapter</button>
        </article>
        <article class="help-panel">
            <h2>Security</h2>
            <p>Local-first execution, untrusted inputs, bounded writes, protected transports and explicit approval boundaries.</p>
            <button type="button" @onclick="OpenSecurity">Read chapter</button>
        </article>
        <article class="help-panel help-api-panel">
            <h2>API reference</h2>
            <p>Public services, controllers, business contracts and runtime capabilities generated from XML documentation.</p>
            <button type="button" @onclick="OpenApiReference">Open API reference</button>
        </article>
    </section>

    <section class="help-panel help-wide">
        <h2>Build behavior</h2>
        <p>Normal Windows builds restore the repository-local DocFX tool, generate the complete modern HTML site and XML-backed API reference, and require one versioned PDF containing the same root table of contents. PDF generation requires Node.js 20 or later. Set <code>BuildLocalGptDocumentation=false</code> or <code>RequireLocalGptDocumentationPdf=false</code> only for an explicit infrastructure diagnosis.</p>
    </section>
</main>

<DocumentationViewerHost />

@code {
    /// <summary>
    /// Stores the internal documentation status state used by <see cref="Help"/> while executing its surrounding workflow.
    /// </summary>
    private LocalGptDocumentationStatus documentationStatus = new();

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="Help"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        try
        {
            documentationStatus = Documentation.GetStatus();
            ComponentActivity.RecordInformation(nameof(Help), nameof(OnInitialized), "The generated documentation catalog status was loaded.", "/help");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Loading generated LocalGPT documentation status failed.");
            ComponentActivity.RecordFailure(nameof(Help), nameof(OnInitialized), exception, "/help");
            Notifier.ShowWarning(nameof(Help), "Documentation status is unavailable; build-generated files may not exist yet.", "Documentation");
        }
    }

    /// <summary>
    /// Opens HTML documentation for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenHtmlDocumentation() => OpenDocumentation(documentationStatus.HtmlUrl, "LocalGPT HTML documentation", documentationStatus.HtmlAvailable);

    /// <summary>
    /// Opens PDF documentation for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenPdfDocumentation() => OpenDocumentation(documentationStatus.PdfUrl, "LocalGPT PDF documentation", documentationStatus.PdfAvailable);

    /// <summary>
    /// Opens build status for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenBuildStatus() => OpenDocumentation("/api/documentation/status", "LocalGPT documentation build status");

    /// <summary>
    /// Opens XML comments for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenXmlComments() => OpenDocumentation("/api/documentation/comments?limit=100", "LocalGPT XML documentation comments");

    /// <summary>
    /// Opens chat and council for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenChatAndCouncil() => OpenDocumentation("/help-docs/guide/chat-and-council.html", "Chat and AI Council");

    /// <summary>
    /// Opens embedded firmware for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenEmbeddedFirmware() => OpenDocumentation("/help-docs/guide/embedded-and-games.html", "Embedded firmware");

    /// <summary>
    /// Opens workspaces for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenWorkspaces() => OpenDocumentation("/help-docs/guide/projects-and-workspaces.html", "Workspaces");

    /// <summary>
    /// Opens game director for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenGameDirector() => OpenDocumentation("/help-docs/guide/embedded-and-games.html", "GameDirector runtime");

    /// <summary>
    /// Opens security for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenSecurity() => OpenDocumentation("/help-docs/architecture/onewire-security.html", "Security");

    /// <summary>
    /// Opens API reference for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    private void OpenApiReference() => OpenDocumentation("/help-docs/api/index.html", "LocalGPT API reference");

    /// <summary>
    /// Opens documentation for <see cref="Help"/>, keeping the operation consistent with the state and invariants of the surrounding help workflow.
    /// </summary>
    /// <param name="url">Url value supplied to the help operation and used when producing its result.</param>
    /// <param name="title">Title value supplied to the help operation and used when producing its result.</param>
    /// <param name="available">Value indicating whether available should apply to this operation.</param>
    private void OpenDocumentation(string url, string title, bool available = true)
    {
        try
        {
            if (!available)
            {
                Notifier.ShowWarning(nameof(Help), "The requested documentation artifact is not available in this build.", "Documentation");
                return;
            }

            Viewer.Open(new LocalGptDocumentationViewerRequest { Url = url, Title = title });
            ComponentActivity.RecordInformation(nameof(Help), nameof(OpenDocumentation), $"Opened {title}.", url);
            Logger.LogInformation("Opened LocalGPT documentation view {DocumentationTitle} at {DocumentationUrl}.", title, url);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Opening LocalGPT documentation failed for {DocumentationUrl}.", url);
            ComponentActivity.RecordFailure(nameof(Help), nameof(OpenDocumentation), exception, url);
            Notifier.ShowWarning(nameof(Help), "The documentation viewer could not be opened.", "Documentation viewer");
        }
    }

}
