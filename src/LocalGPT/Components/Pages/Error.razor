@page "/Error"
@using System.Diagnostics
@inject ILogger<Error> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>Development Mode</h3>
<p>
    Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
</p>
<p>
    <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
    It can result in displaying sensitive information from exceptions to end users.
    For local debugging, enable the <strong>Development</strong> environment by setting the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
    and restarting the app.
</p>

@code{
    /// <summary>
    /// Gets or sets the HTTP context value that forms part of the error state consumed or produced by the surrounding workflow.
    /// </summary>
    /// <value>The HTTP context value exposed by <see cref="Error"/>.</value>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// Gets or sets the stable request identifier used to identify or correlate this error instance with related application state.
    /// </summary>
    /// <value>The request identifier value exposed by <see cref="Error"/>.</value>
    private string? RequestId { get; set; }
    /// <summary>
    /// Gets a value indicating whether show request identifier applies to the error state.
    /// </summary>
    /// <value>The show request identifier value exposed by <see cref="Error"/>.</value>
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    /// <summary>
    /// Handles the initialized lifecycle or event notification for <see cref="Error"/>, updating the state required by the surrounding workflow.
    /// </summary>
    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        Logger.LogError("The LocalGPT error page was displayed for request {RequestId}.", RequestId ?? "unknown");
        ComponentActivity.RecordWarning(nameof(Error), "ErrorPage", "The application error page was displayed.");
        Notifier.ShowError("ComponentSafetyToasts", "LocalGPT encountered an application error. Review local application logs for details.", "Application error");
    }
}
