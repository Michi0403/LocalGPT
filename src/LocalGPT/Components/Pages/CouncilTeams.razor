@rendermode InteractiveServer
@page "/council-teams"
@inject ICouncilTeamConfigurationService TeamConfigurations
@inject IMultiModelCouncilService CouncilService
@inject ICouncilRuntimeClassService RuntimeClasses
@inject IDxAiFunctionCatalogService FunctionCatalog
@inject ILogger<CouncilTeams> Logger
@inject CouncilTextService CouncilText
@inject IComponentActivityService ComponentActivity
@inject INotificationService Notifier

<PageTitle>AI Council Teams</PageTitle>

<main class="council-team-page localgpt-surface">
    <header class="council-team-header">
        <div>
            <h1>AI Council social structures</h1>
            <p>The supplied LocalGPT council remains available as the default. Create or duplicate a team to define any role set and any workflow from one round up to the technical run limit.</p>
        </div>
        <button type="button" class="btn btn-secondary" @onclick="ReloadAsync" disabled="@_busy">Reload</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert @(_hasError ? "alert-danger" : "alert-info")" role="status">@_status</div>
    }

    <section class="council-team-grid">
        <aside class="council-team-list">
            <label>
                <span>Team</span>
                <select class="form-select" value="@_selectedKey" @onchange="OnTeamChanged">
                    @foreach (var team in _teams)
                    {
                        <option value="@team.Key">@team.DisplayName (@team.Key)</option>
                    }
                </select>
            </label>
            @foreach (var team in _teams)
            {
                <button type="button" class="council-team-list-item @(team.Key == _selectedKey ? "active" : string.Empty)" @onclick="() => SelectTeam(team)">
                    <strong>@team.DisplayName</strong>
                    <small>@team.Key · @(team.IsDeleted ? "deleted" : team.IsEnabled ? "enabled" : "disabled") · @WorkflowLabel(team)</small>
                    <span>@team.Purpose</span>
                </button>
            }
            <div class="council-team-list-actions">
                <button type="button" class="btn btn-outline-primary" @onclick="CreateTeam">Create empty structure</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="DuplicateTeam" disabled="@(_teams.Count == 0 || _editor.IsDeleted)">Duplicate selected</button>
                <label>
                    <span>Supplied reset template</span>
                    <select class="form-select" @bind="_resetTemplateKey">
                        @foreach (var template in _defaultTemplates)
                        {
                            <option value="@template.Key">@template.DisplayName (@template.Key)</option>
                        }
                    </select>
                </label>
                <button type="button" class="btn btn-outline-warning" @onclick="ResetSelectedFromTemplateAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_selectedKey) || string.IsNullOrWhiteSpace(_resetTemplateKey))">Reset selected from template</button>
                <button type="button" class="btn btn-outline-danger" @onclick="DeleteSelectedAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_selectedKey) || _editor.IsDeleted)">Delete selected preset</button>
                <small class="hint">Delete/reset require the review-confirmation checkbox in the editor. Deleted presets remain as tombstones here so you can restore them from any supplied template; they cannot run.</small>
            </div>
        </aside>

        <section class="council-team-editor">
            <div class="council-structure-mode @(UsesDefaultWorkflow(_editor) ? "default-mode" : "custom-mode")">
                <strong>@WorkflowLabel(_editor)</strong>
                <span>Untouched supplied teams use the established LocalGPT orchestration. Saving any edit creates a user-owned literal workflow; duplicating keeps the supplied default untouched.</span>
            </div>
            @if (_editor.IsDeleted)
            {
                <div class="alert alert-warning">This configured preset is deleted and cannot run. Choose any supplied reset template in the left panel and reset it to restore the same key.</div>
            }

            <div class="council-team-fields">
                <label><span>Key</span><input class="form-control" @bind="_editor.Key" /></label>
                <label><span>Display name</span><input class="form-control" @bind="_editor.DisplayName" /></label>
                <label class="wide"><span>Purpose</span><textarea class="form-control" rows="3" @bind="_editor.Purpose"></textarea></label>
            </div>

            <details class="council-advanced-section" open="@(_editor.AllMembersReadinessPreflightMode != CouncilAllMembersReadinessPreflightMode.LegacyWorkflowDefault)">
                <summary>All-members readiness preflight · @PreflightModeLabel</summary>
                <p class="hint">Optional team-level preflight before substantive role work. Legacy compatibility preserves the historical behavior: supplied built-in orchestration keeps its established readiness phase while literal custom workflows add none. The benchmark seed disables this by default. A role-aware probe checks every selected member against its assigned role responsibilities without asking it to solve the original user request.</p>
                <div class="council-workflow-fields">
                    <label>
                        <span>Preflight mode</span>
                        <select class="form-select" @bind="_editor.AllMembersReadinessPreflightMode">
                            @foreach (var mode in AllMembersReadinessPreflightModes)
                            {
                                <option value="@mode.Value">@mode.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Maximum output tokens per member</span>
                        <input class="form-control" type="number" min="32" max="2048" @bind="_editor.AllMembersReadinessPreflightMaxOutputTokens" disabled="@(_editor.AllMembersReadinessPreflightMode != CouncilAllMembersReadinessPreflightMode.RoleAwareProbe)" />
                    </label>
                    <label class="wide">
                        <span>Role-aware preflight prompt override (optional)</span>
                        <textarea class="form-control council-script" rows="5" @bind="_editor.AllMembersReadinessPreflightPromptTemplate" disabled="@(_editor.AllMembersReadinessPreflightMode != CouncilAllMembersReadinessPreflightMode.RoleAwareProbe)" placeholder="Blank uses the maintained compact probe. Placeholders: {{ModelName}}, {{TeamName}}, {{AssignedRoles}}, {{RoleResponsibilities}}"></textarea>
                    </label>
                </div>
                <label class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" @bind="_editor.IncludeAllMembersReadinessPreflightInWorkflowContext" disabled="@(_editor.AllMembersReadinessPreflightMode != CouncilAllMembersReadinessPreflightMode.RoleAwareProbe)" />
                    <span>Include all preflight member output in later workflow model context (can be very large on big Councils)</span>
                </label>
                <p class="hint mb-0">When this context option is off, preflight responses remain visible and persisted as run evidence but are filtered out of later model transcript context. This prevents 100+ member readiness chatter from consuming the task budget.</p>
            </details>

            <details class="council-best-use-functions">
                <summary @onclick="ToggleDxFunctionPickerAsync">Best-use DXFunctions (@_editor.PreferredCapabilities.Count selected)</summary>
                @if (!_dxFunctionPickerExpanded)
                {
                    <p class="hint">Open this section to load the DXFunction catalog. The large catalog is intentionally not rendered during Council Teams startup.</p>
                }
                else if (_dxFunctionsLoading)
                {
                    <p class="hint">Loading DXFunctions…</p>
                }
                else
                {
                    <p class="hint">Select the functions this team should prefer. The list is grouped by function namespace; entries recommended by assigned runtime classes are marked.</p>
                    @foreach (var group in AvailableDxFunctions.GroupBy(FunctionNamespace).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <fieldset class="council-runtime-class-group">
                            <legend>@group.Key</legend>
                            @foreach (var entry in group.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                var recommended = RecommendedRuntimeFunctions.Contains(entry.FunctionName);
                                <label class="form-check council-runtime-class-option">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@_editor.PreferredCapabilities.Contains(entry.FunctionName, StringComparer.OrdinalIgnoreCase)"
                                           @onchange="args => TogglePreferredCapability(entry.FunctionName, args)" />
                                    <span><strong>@entry.DisplayName</strong> <small>@entry.FunctionName@(recommended ? " · runtime-class recommendation" : string.Empty)</small></span>
                                </label>
                            }
                        </fieldset>
                    }
                }
            </details>

            <details class="council-best-use-functions" open>
                <summary>Automatic/native functions allowed by this team (@_editor.AllowedAutomaticFunctions.Count selected)</summary>
                <p class="hint">This is runtime policy, not a recommendation. Workflow steps using “Team allow-list” receive only these registered functions. The persisted team configuration is authoritative; supplied templates are resettable starting points.</p>
                @if (!_dxFunctionsLoaded)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadDxFunctionCatalogAsync" disabled="@_dxFunctionsLoading">@(_dxFunctionsLoading ? "Loading DXFunctions…" : "Load DXFunction catalog")</button>
                }
                else
                {
                    @foreach (var group in AvailableDxFunctions.GroupBy(FunctionNamespace).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <fieldset class="council-runtime-class-group">
                            <legend>@group.Key</legend>
                            @foreach (var entry in group.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                <label class="form-check council-runtime-class-option">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@_editor.AllowedAutomaticFunctions.Contains(entry.FunctionName, StringComparer.OrdinalIgnoreCase)"
                                           @onchange="args => ToggleTeamAutomaticFunction(entry.FunctionName, args)" />
                                    <span><strong>@entry.DisplayName</strong> <small>@entry.FunctionName</small></span>
                                </label>
                            }
                        </fieldset>
                    }
                }
            </details>

            <section class="council-structure-section">
                <header>
                    <div>
                        <h2>Roles</h2>
                        <p>Roles are free-form social responsibilities. They do not need to match LocalGPT's supplied role names.</p>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddRole">Add role</button>
                </header>
                @if (_editor.Roles.Count == 0)
                {
                    <div class="council-empty-structure">No roles are defined. The workflow can still run, but named roles make the structure easier to understand.</div>
                }
                @for (var index = 0; index < _editor.Roles.Count; index++)
                {
                    var roleIndex = index;
                    var role = _editor.Roles[roleIndex];
                    <article class="council-role-card" @key="role">
                        <header class="council-role-card-header wide">
                            <strong>@(string.IsNullOrWhiteSpace(role.Role) ? $"Role {roleIndex + 1}" : role.Role)</strong>
                            <div class="council-role-badges">
                                <span class="council-role-badge ai">@RoleAiBadge(role)</span>
                                <span class="@($"council-role-badge {RoleHumanBadgeClass(role)}")">@RoleHumanBadge(role)</span>
                                <span class="council-role-badge performance">@RolePerformanceBadge(role)</span>
                                <span class="council-role-badge boundary">@RoleBoundaryBadge(role)</span>
                                <span class="council-role-badge language">@RoleLanguageBadge(role)</span>
                                @if (!string.IsNullOrWhiteSpace(role.PairedRole))
                                {
                                    <span class="council-role-badge pairing">Paired with @role.PairedRole</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(role.DistinctAiAssignmentGroup))
                                {
                                    <span class="council-role-badge distinct">Distinct group @role.DistinctAiAssignmentGroup</span>
                                }
                            </div>
                        </header>
                        <label><span>Role name</span><input class="form-control" @bind="role.Role" /></label>
                        <label><span>Expertise or viewpoint</span><input class="form-control" @bind="role.Expertise" /></label>
                        <label class="wide"><span>Responsibility</span><textarea class="form-control" rows="2" @bind="role.Responsibility"></textarea></label>
                        <div class="wide council-role-policy-grid">
                            <label>
                                <span>AI assignment</span>
                                <select class="form-select" @bind="role.AiSelectionMode" disabled="@(role.HumanParticipationMode == HumanParticipationMode.HumanOnly)">
                                    @foreach (var mode in AiSelectionModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            @if (role.AiSelectionMode == CouncilRoleAiSelectionMode.AssignedModelsRandomRange && role.HumanParticipationMode != HumanParticipationMode.HumanOnly)
                            {
                                <label>
                                    <span>Exact role invocations</span>
                                    <input class="form-control"
                                           type="number"
                                           min="1"
                                           value="@(role.MinimumAiParticipants == role.MaximumAiParticipants ? role.MinimumAiParticipants.ToString() : string.Empty)"
                                           placeholder="Optional · use range below"
                                           @onchange="args => SetExactRoleInvocationCount(roleIndex, args)" />
                                </label>
                            }
                            <label>
                                <span>@(role.AiSelectionMode == CouncilRoleAiSelectionMode.AssignedModelsRandomRange ? "Minimum pool invocations" : "Minimum random AI participants")</span>
                                <input class="form-control" type="number" min="1" @bind="role.MinimumAiParticipants" disabled="@(!UsesRandomParticipantCount(role) || role.HumanParticipationMode == HumanParticipationMode.HumanOnly)" />
                            </label>
                            <label>
                                <span>@(role.AiSelectionMode == CouncilRoleAiSelectionMode.AssignedModelsRandomRange ? "Maximum pool invocations" : "Maximum random AI participants")</span>
                                <input class="form-control" type="number" min="1" @bind="role.MaximumAiParticipants" disabled="@(!UsesRandomParticipantCount(role) || role.HumanParticipationMode == HumanParticipationMode.HumanOnly)" />
                            </label>
                            <label>
                                <span>Human participation</span>
                                <select class="form-select" @bind="role.HumanParticipationMode">
                                    @foreach (var mode in HumanParticipationModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Role performance</span>
                                <select class="form-select" @bind="role.PerformanceMode">
                                    @foreach (var mode in PerformanceModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Role boundary</span>
                                <select class="form-select" @bind="role.BoundaryMode">
                                    @foreach (var mode in BoundaryModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Response language</span>
                                <select class="form-select" @bind="role.LanguageMode">
                                    @foreach (var mode in LanguageModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                        </div>
                        @if (UsesRandomParticipantCount(role) && role.HumanParticipationMode != HumanParticipationMode.HumanOnly)
                        {
                            <p class="wide hint">@(role.AiSelectionMode == CouncilRoleAiSelectionMode.AssignedModelsRandomRange
                                ? "Set Exact role invocations for a fixed count, or use the minimum/maximum fields for a random count per run. A count larger than the provider-bound pool deliberately reuses members in fair shuffled cycles. "
                                : string.Empty)The count selects role participants/invocations. The workflow execution mode still decides whether all selected members run or one leader/round-robin member is chosen for that step.</p>
                        }
                        @if (UsesProviderBoundRolePool(role) && role.HumanParticipationMode != HumanParticipationMode.HumanOnly)
                        {
                            <details class="wide council-provider-model-picker" open>
                                <summary>Provider-bound role models (@role.AssignedModelKeys.Count selected)</summary>
                                <p class="hint">The provider, endpoint and model are one identity. These saved members are automatically added to the run and LocalGPT will not substitute a same-name model from another host. In random-pool mode, the saved models form the eligible pool; requesting more invocations than the pool size cycles through another deterministic shuffle instead of imposing a hard ceiling.</p>
                                @if (_providerModels.Count == 0)
                                {
                                    <div class="alert alert-warning mb-2">No provider model catalog is currently available. Existing saved bindings remain visible below and are not deleted.</div>
                                }
                                @foreach (var providerGroup in _providerModels
                                    .GroupBy(candidate => new { candidate.Provider, candidate.Endpoint })
                                    .OrderBy(group => group.Key.Provider, StringComparer.OrdinalIgnoreCase)
                                    .ThenBy(group => group.Key.Endpoint, StringComparer.OrdinalIgnoreCase))
                                {
                                    <details class="council-provider-host-group">
                                        <summary>@providerGroup.Key.Provider · @providerGroup.Key.Endpoint (@providerGroup.Count() models)</summary>
                                        <div class="council-provider-model-grid">
                                            @foreach (var candidate in providerGroup.OrderBy(candidate => candidate.ModelName, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <label class="form-check council-provider-model-option">
                                                    <input class="form-check-input" type="checkbox"
                                                           checked="@role.AssignedModelKeys.Contains(candidate.SelectionKey, StringComparer.OrdinalIgnoreCase)"
                                                           @onchange="args => ToggleRoleModel(roleIndex, candidate.SelectionKey, args)" />
                                                    <span>
                                                        <strong>@candidate.ModelName</strong>
                                                        <small>@(candidate.IsInstalled ? "reachable" : candidate.IsConfigured ? "configured" : "discovered")</small>
                                                    </span>
                                                </label>
                                            }
                                        </div>
                                    </details>
                                }
                                @foreach (var savedModelKey in UnavailableRoleModelKeys(role))
                                {
                                    <div class="council-stale-model-binding">
                                        <span><strong>Saved but unavailable:</strong> @savedModelKey</span>
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveRoleModel(roleIndex, savedModelKey)">Remove binding</button>
                                    </div>
                                }
                            </details>
                        }
                        <div class="wide council-role-coordination-grid">
                            <label>
                                <span>Distinct AI assignment group</span>
                                <input class="form-control" @bind="role.DistinctAiAssignmentGroup" placeholder="Optional shared group key" />
                            </label>
                            <label>
                                <span>Match AI count to role</span>
                                <input class="form-control" list="council-role-names" @bind="role.MatchAiParticipantCountToRole" placeholder="Optional role name" />
                            </label>
                            <label>
                                <span>Pair one-to-one with role</span>
                                <input class="form-control" list="council-role-names" @bind="role.PairedRole" placeholder="Optional role name" />
                            </label>
                        </div>
                        <details class="wide council-runtime-class-picker">
                            <summary>Runtime classes (@role.RuntimeClassKeys.Count selected)</summary>
                            <p class="hint">Assign database-backed runtime classes to this role. Every field remains visible with AI/human ownership, blocking behavior and keyboard/gamepad bindings.</p>
                            @foreach (var group in _runtimeClasses.GroupBy(item => item.Namespace).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                            {
                                <fieldset class="council-runtime-class-group">
                                    <legend>@group.Key</legend>
                                    @foreach (var runtimeClass in group.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <label class="form-check council-runtime-class-option">
                                            <input class="form-check-input" type="checkbox"
                                                   checked="@role.RuntimeClassKeys.Contains(runtimeClass.Key, StringComparer.OrdinalIgnoreCase)"
                                                   @onchange="args => ToggleRuntimeClass(roleIndex, runtimeClass.Key, args)" />
                                            <span><strong>@runtimeClass.DisplayName</strong> <small>@runtimeClass.Key · @runtimeClass.Kind</small></span>
                                        </label>
                                    }
                                </fieldset>
                            }
                            @foreach (var runtimeClass in RuntimeClassesFor(role))
                            {
                                <article class="council-runtime-class-preview">
                                    <header><strong>@runtimeClass.DisplayName</strong><small>@runtimeClass.Key</small></header>
                                    <p>@runtimeClass.Description</p>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle">
                                            <thead><tr><th>Field</th><th>Type/default</th><th>Input</th><th>AI</th><th>Human</th><th>Blocks next round</th><th>Keyboard</th><th>Gamepad</th></tr></thead>
                                            <tbody>
                                            @foreach (var field in runtimeClass.Fields)
                                            {
                                                <tr>
                                                    <td><strong>@field.DisplayName</strong><br /><small>@field.Name</small></td>
                                                    <td>@field.DataType<br /><small>@field.DefaultValue</small></td>
                                                    <td>@field.InputMode</td>
                                                    <td>@(field.AiAssignable ? "yes" : "no")</td>
                                                    <td>@(field.HumanAssignable ? "yes" : "no")</td>
                                                    <td>@(field.BlocksNextRoundUntilHumanInput ? "required gate" : "no")</td>
                                                    <td>@field.KeyboardKey</td>
                                                    <td>@field.GamepadButton</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                </article>
                            }
                        </details>
                        <p class="wide council-role-policy-help">@RolePolicyExplanation(role) @RolePerformanceExplanation(role) @RoleBoundaryExplanation(role) @RoleLanguageExplanation(role) @RoleCoordinationExplanation(role)</p>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveRole(roleIndex)">Remove role</button>
                    </article>
                }
                <datalist id="council-role-names">
                    @foreach (var role in _editor.Roles.Where(role => !string.IsNullOrWhiteSpace(role.Role)))
                    {
                        <option value="@role.Role"></option>
                    }
                </datalist>
            </section>

            <section class="council-structure-section">
                <header>
                    <div>
                        <h2>Rounds and workflow</h2>
                        <p>Each enabled entry is a workflow step. Multiple steps may share one logical Council round, and every role/model binding is authoritative for that run. Repeat count expands one step. Consecutive steps with the same loop group repeat together until their completion marker appears or the safety limit is reached. Placeholders include <code>{{UserPrompt}}</code>, <code>{{Transcript}}</code>, <code>{{PreviousStep}}</code>, <code>{{ModelName}}</code>, <code>{{CouncilMembers}}</code>, <code>{{RoleMembers}}</code>, <code>{{ExecutingRoleMember}}</code>, <code>{{RolePeerMembers}}</code>, <code>{{RuntimeClasses}}</code>, <code>{{PairedParticipant}}</code>, <code>{{PairedRole}}</code>, <code>{{RolePairings}}</code>, <code>{{HumanParticipationMode}}</code>, <code>{{RolePerformanceMode}}</code>, <code>{{RoleBoundaryMode}}</code>, <code>{{RoleLanguageMode}}</code>, <code>{{RolePerformanceInstruction}}</code>, <code>{{RoleBoundaryInstruction}}</code>, <code>{{RoleLanguageInstruction}}</code>, <code>{{LoopGroup}}</code>, <code>{{LoopIteration}}</code>, <code>{{LoopMaximumIterations}}</code>, <code>{{TeamName}}</code>, <code>{{Role}}</code>, <code>{{Phase}}</code>, and <code>{{RoundNumber}}</code>.</p>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddWorkflowStep">Add round</button>
                </header>
                @if (_editor.WorkflowSteps.Count == 0)
                {
                    <div class="council-empty-structure">No rounds are defined. Add at least one enabled round before saving.</div>
                }
                @for (var index = 0; index < _editor.WorkflowSteps.Count; index++)
                {
                    var stepIndex = index;
                    var step = _editor.WorkflowSteps[stepIndex];
                    <article class="council-workflow-card" @key="step">
                        <header>
                            <div>
                                <strong>@(string.IsNullOrWhiteSpace(step.DisplayName) ? $"Round {stepIndex + 1}" : step.DisplayName)</strong>
                                <small>@step.ExecutionMode · repeat @step.RepeatCount · @WorkflowLoopLabel(step) · @WorkflowRolePolicyLabel(step.Role)</small>
                            </div>
                            <div class="council-step-actions">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWorkflowStep(stepIndex, -1)" disabled="@(stepIndex == 0)">Up</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWorkflowStep(stepIndex, 1)" disabled="@(stepIndex == _editor.WorkflowSteps.Count - 1)">Down</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveWorkflowStep(stepIndex)">Remove</button>
                            </div>
                        </header>
                        <div class="council-workflow-fields">
                            <label><span>Key</span><input class="form-control" @bind="step.Key" /></label>
                            <label><span>Display name</span><input class="form-control" @bind="step.DisplayName" /></label>
                            <label><span>Phase</span><input class="form-control" @bind="step.Phase" /></label>
                            <label><span>Role for this round</span><input class="form-control" list="council-role-names" @bind="step.Role" /></label>
                            <label>
                                <span>Execution</span>
                                <select class="form-select" @bind="step.ExecutionMode">
                                    @foreach (var mode in ExecutionModes)
                                    {
                                        <option value="@mode.Value">@mode.Label</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Exact provider model</span>
                                <select class="form-select" @bind="step.AssignedModelName" disabled="@(step.ExecutionMode != "AssignedModelSingle")">
                                    <option value="">Select provider / host / model</option>
                                    @if (!string.IsNullOrWhiteSpace(step.AssignedModelName) && !IsWorkflowModelAvailable(step.AssignedModelName))
                                    {
                                        <option value="@step.AssignedModelName">Saved but unavailable · @step.AssignedModelName</option>
                                    }
                                    @foreach (var candidate in WorkflowModelCandidates(step))
                                    {
                                        <option value="@candidate.SelectionKey">@candidate.Provider · @candidate.ModelName · @candidate.Endpoint</option>
                                    }
                                </select>
                            </label>
                            <label><span>Logical Council round (0 = automatic)</span><input class="form-control" type="number" min="0" max="1000" @bind="step.LogicalRoundNumber" /></label>
                            <label>
                                <span>Prior transcript visibility</span>
                                <select class="form-select" @bind="step.TranscriptVisibility" disabled="@(!step.IncludePriorTranscript)">
                                    @foreach (var visibility in TranscriptVisibilityModes)
                                    {
                                        <option value="@visibility.Value">@visibility.Label</option>
                                    }
                                </select>
                            </label>
                            <label><span>Repeat count inside this step</span><input class="form-control" type="number" min="1" max="100" @bind="step.RepeatCount" /></label>
                            <label><span>Sort order</span><input class="form-control" type="number" @bind="step.SortOrder" /></label>
                            <label>
                                <span>Loop group (optional)</span>
                                <input class="form-control" @bind="step.LoopGroup" placeholder="Same key on consecutive steps" />
                            </label>
                            <label>
                                <span>Maximum loop iterations</span>
                                <input class="form-control" type="number" min="1" max="100" @bind="step.MaximumLoopIterations" disabled="@(string.IsNullOrWhiteSpace(step.LoopGroup))" />
                            </label>
                            <label class="wide">
                                <span>Loop completion marker (optional)</span>
                                <input class="form-control" @bind="step.LoopCompletionMarker" placeholder="Example: [[TOURNAMENT_COMPLETE]]" disabled="@(string.IsNullOrWhiteSpace(step.LoopGroup))" />
                            </label>
                            @if (step.ProducesAsciiFrame)
                            {
                                <label><span>ASCII frame width</span><input class="form-control" type="number" min="20" max="240" @bind="step.AsciiFrameWidth" /></label>
                                <label><span>ASCII frame height</span><input class="form-control" type="number" min="8" max="120" @bind="step.AsciiFrameHeight" /></label>
                                <label><span>World step scale</span><input class="form-control" type="number" min="1" max="1000" @bind="step.WorldStepScale" /></label>
                                <div class="wide alert alert-info mb-0">Exactly one AI must own the complete frame. Use LeaderSingle, RoundRobinSingle or AssignedModelSingle and emit <code>[[ASCII_FRAME]]...[[/ASCII_FRAME]]</code>.</div>
                            }
                            <label class="wide"><span>Round prompt</span><textarea class="form-control council-script" rows="7" @bind="step.PromptTemplate"></textarea></label>
                        </div>
                        <details class="council-advanced-section" open="@(step.EnableRolePeerReview || step.SummarizeRoleResults)">
                            <summary>Role-member coordination @(step.EnableRolePeerReview || step.SummarizeRoleResults ? "· enabled" : "· disabled")</summary>
                            <p class="hint">Optional and off by default. Primary role members still execute exactly as configured above. Peer review adds a small role-local usefulness/vote pass without DX side effects. Role synthesis can then ask one assigned role member to merge the primary answers into one authoritative result for this role before the next workflow step.</p>
                            <div class="council-step-options">
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.EnableRolePeerReview" /><span>Peer-review role-member answers, report usefulness and vote for the strongest role result</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.SummarizeRoleResults" /><span>Summarize multiple role-member answers into one final result of this role</span></label>
                            </div>
                            @if (step.SummarizeRoleResults)
                            {
                                <div class="council-workflow-fields">
                                    <label>
                                        <span>Role result summarizer</span>
                                        <select class="form-select" @bind="step.RoleResultSynthesisMemberMode">
                                            @foreach (var mode in RoleResultSynthesisMemberModes)
                                            {
                                                <option value="@mode.Value">@mode.Label</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        <span>Selected role member</span>
                                        <select class="form-select" @bind="step.RoleResultSynthesisModelName" disabled="@(step.RoleResultSynthesisMemberMode != CouncilRoleResultSynthesisMemberMode.AssignedRoleMember)">
                                            <option value="">Choose one exact role member</option>
                                            @if (!string.IsNullOrWhiteSpace(step.RoleResultSynthesisModelName) && !IsWorkflowModelAvailable(step.RoleResultSynthesisModelName))
                                            {
                                                <option value="@step.RoleResultSynthesisModelName">Saved but unavailable · @step.RoleResultSynthesisModelName</option>
                                            }
                                            @foreach (var candidate in WorkflowModelCandidates(step))
                                            {
                                                <option value="@candidate.SelectionKey">@candidate.Provider · @candidate.ModelName · @candidate.Endpoint</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                                <p class="hint mb-0">Random selection is stable for one run/round so rejoin and replay diagnostics stay understandable. A selected model is used only when it is actually assigned to this role in the run; otherwise LocalGPT safely falls back to a deterministic role member and records a warning.</p>
                            }
                        </details>
                        <div class="council-step-options">
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.IsEnabled" /><span>Enabled</span></label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.IncludePriorTranscript" /><span>Include prior transcript according to visibility policy</span></label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.ProducesFinalAnswer" /><span>Can become final answer</span></label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.RequiresHumanCheckpoint" /><span>Respect human gate before round</span></label>
                            <label>
                                <span>Automatic/native function policy</span>
                                <select class="form-select" value="@step.AutomaticFunctionPolicyMode" @onchange="args => SetAutomaticFunctionPolicy(step, args)">
                                    @foreach (var policy in AutomaticFunctionPolicyModes)
                                    {
                                        <option value="@policy.Value">@policy.Label</option>
                                    }
                                </select>
                            </label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.ProducesAsciiFrame" /><span>Produces one AI-owned ASCII frame</span></label>
                        </div>
                        @if (step.AutomaticFunctionPolicyMode == CouncilAutomaticFunctionPolicyMode.TeamAllowList)
                        {
                            <p class="hint">This step uses the team's persisted allow-list: @(step.CanUseOrganicFunctions && _editor.AllowedAutomaticFunctions.Count > 0 ? CouncilText.FormatInlineNameList(_editor.AllowedAutomaticFunctions) : "no functions selected")</p>
                        }
                        else if (step.AutomaticFunctionPolicyMode == CouncilAutomaticFunctionPolicyMode.ExactAllowList)
                        {
                            <label class="wide">
                                <span>Exact automatic/native function names · one per line</span>
                                <textarea class="form-control council-script" rows="4" value="@CouncilText.FormatMultilineNameList(step.AllowedAutomaticFunctions)" @onchange="args => SetStepAutomaticFunctions(step, args)"></textarea>
                            </label>
                        }
                        <details class="council-advanced-section">
                            <summary>Member result recovery · @step.RoleComplianceRetryCount role retry(s) · final-answer recovery @(step.FinalAnswerRecoveryEnabled ? "on" : "off")</summary>
                            <p class="hint">These are social execution policies and are persisted with this workflow step. Recovery runs on the same provider-qualified member and is model work, not UI rendering.</p>
                            <div class="council-workflow-fields">
                                <label><span>Role-compliance corrective retries</span><input class="form-control" type="number" min="0" max="3" @bind="step.RoleComplianceRetryCount" /></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.FinalAnswerRecoveryEnabled" /><span>Recover a final answer when only thinking/non-final content was returned</span></label>
                                <label><span>Final-answer recovery max output tokens</span><input class="form-control" type="number" min="128" max="32768" @bind="step.FinalAnswerRecoveryMaxOutputTokens" disabled="@(!step.FinalAnswerRecoveryEnabled)" /></label>
                            </div>
                        </details>
                        <details class="council-advanced-section">
                            <summary>X-Rounds / revisable control flow @(step.XFunctionsEnabled ? "· enabled" : "· disabled")</summary>
                            <p class="hint">X-Rounds do not erase history. A revisit creates a new workflow-step revision caused by the requesting step. Reconsider suppresses DX/organic side effects; Reexecute deliberately runs the target's normal function policy again.</p>
                            <div class="d-flex flex-wrap gap-2 mb-2" aria-label="X-Round workflow presets">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ApplyXRoundPreset(step, CouncilXRoundPreset.Gatekeeper)">Gatekeeper</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ApplyXRoundPreset(step, CouncilXRoundPreset.ReactiveRevisit)">Reactive revisit</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ApplyXRoundPreset(step, CouncilXRoundPreset.DerivedSingleModel)">Derived single model</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ApplyXRoundPreset(step, CouncilXRoundPreset.DerivedCouncil)">Derived Council</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => ApplyXRoundPreset(step, CouncilXRoundPreset.Disabled)">Clear X policy</button>
                            </div>
                            <div class="council-step-options">
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.XFunctionsEnabled" /><span>Enable X-Functions for this step</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.XCanRevisit" disabled="@(!step.XFunctionsEnabled)" /><span>May revisit another step</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.XCanReturnText" disabled="@(!step.XFunctionsEnabled)" /><span>May return text and finish parent workflow</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.XCanStartSingleModel" disabled="@(!step.XFunctionsEnabled)" /><span>May start one selected model subtask</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.XCanStartCouncil" disabled="@(!step.XFunctionsEnabled)" /><span>May start another Council team</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="step.XRequiresHumanApproval" disabled="@(!step.XFunctionsEnabled)" /><span>Human must approve every accepted X control request</span></label>
                            </div>
                            <div class="council-workflow-fields">
                                <label><span>X transition budget for this source step</span><input class="form-control" type="number" min="1" max="100" @bind="step.XMaximumTransitions" disabled="@(!step.XFunctionsEnabled)" /></label>
                                <label>
                                    <span>Default revisit target</span>
                                    <select class="form-select" @bind="step.XDefaultTargetStepKey" disabled="@(!step.XFunctionsEnabled || !step.XCanRevisit)">
                                        <option value="">Require the AI to name a target</option>
                                        @foreach (var targetStep in _editor.WorkflowSteps.Take(stepIndex + 1))
                                        {
                                            <option value="@targetStep.Key">@targetStep.DisplayName · @targetStep.Key</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    <span>Default child Council team</span>
                                    <select class="form-select" @bind="step.XChildCouncilTeamKey" disabled="@(!step.XFunctionsEnabled || !step.XCanStartCouncil)">
                                        <option value="">Require teamKey in the X call</option>
                                        @if (!string.IsNullOrWhiteSpace(step.XChildCouncilTeamKey) && !_teams.Any(team => team.Key.Equals(step.XChildCouncilTeamKey, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@step.XChildCouncilTeamKey">Saved but unavailable · @step.XChildCouncilTeamKey</option>
                                        }
                                        @foreach (var availableTeam in _teams.Where(team => team.IsEnabled))
                                        {
                                            <option value="@availableTeam.Key">@availableTeam.DisplayName · @availableTeam.Key</option>
                                        }
                                    </select>
                                </label>
                                <label><span>Maximum child-Council nesting depth</span><input class="form-control" type="number" min="1" max="10" @bind="step.XMaximumChildCouncilDepth" disabled="@(!step.XFunctionsEnabled || !step.XCanStartCouncil)" /></label>
                                <label class="wide">
                                    <span>Default single-model target</span>
                                    <select class="form-select" @bind="step.XChildModelName" disabled="@(!step.XFunctionsEnabled || !step.XCanStartSingleModel)">
                                        <option value="">Use the current Council leader</option>
                                        @if (!string.IsNullOrWhiteSpace(step.XChildModelName) && !_providerModels.Any(model => model.SelectionKey.Equals(step.XChildModelName, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@step.XChildModelName">Saved but unavailable · @step.XChildModelName</option>
                                        }
                                        @foreach (var candidate in _providerModels.Where(model => model.IsInstalled || model.IsConfigured).OrderBy(model => model.Provider).ThenBy(model => model.ModelName))
                                        {
                                            <option value="@candidate.SelectionKey">@candidate.Provider · @candidate.ModelName · @candidate.Endpoint</option>
                                        }
                                    </select>
                                </label>
                                <div class="wide alert alert-info mb-0">X functions exposed to the role are <code>council.x.status</code>, <code>council.x.revisit</code>, <code>council.x.return_text</code>, <code>council.x.start_single_model</code> and <code>council.x.start_council</code>. X-Rounds also require a function policy that exposes the corresponding X functions because they are explicit DXFunctions.</div>
                            </div>
                        </details>
                    </article>
                }
            </section>

            <details class="council-advanced-section">
                <summary>Advanced prompt compatibility and JSON import/export</summary>
                <div class="council-team-fields">
                    <label class="wide"><span>Legacy expert preparation prompt</span><textarea class="form-control council-script" rows="6" @bind="_editor.ExpertPreparationPromptTemplate"></textarea></label>
                    <label class="wide"><span>Legacy leader synthesis prompt</span><textarea class="form-control council-script" rows="6" @bind="_editor.LeaderSynthesisPromptTemplate"></textarea></label>
                    <label class="wide"><span>Legacy main-round instruction</span><textarea class="form-control council-script" rows="4" @bind="_editor.MainRoundInstructionTemplate"></textarea></label>
                    <label class="wide"><span>Roles JSON</span><textarea class="form-control council-script" rows="8" @bind="_rolesJson"></textarea></label>
                    <label class="wide"><span>Workflow steps JSON</span><textarea class="form-control council-script" rows="12" @bind="_workflowJson"></textarea></label>
                    <div class="wide council-json-actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshAdvancedJson">Refresh JSON from editor</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ApplyAdvancedJson">Apply JSON to editor</button>
                    </div>
                    <label class="wide"><span>Preferred organic capabilities JSON</span><textarea class="form-control council-script" rows="5" @bind="_capabilitiesJson"></textarea></label>
                    <label class="wide"><span>Team automatic/native function allow-list JSON</span><textarea class="form-control council-script" rows="5" @bind="_allowedFunctionsJson"></textarea></label>
                    <label class="wide"><span>Architecture contracts JSON</span><textarea class="form-control council-script" rows="5" @bind="_contractsJson"></textarea></label>
                </div>
            </details>

            <div class="council-team-savebar">
                <span class="council-expanded-count">@EnabledRoundCount enabled step(s), up to @ExpandedRoundCount expanded round(s)</span>
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_editor.IsEnabled" /><span>Enabled</span></label>
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_confirmed" @bind:after="ReviewConfirmationChanged" /><span>I reviewed this social structure and its prompts</span></label>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(_busy || _editor.IsDeleted)">Save reviewed team</button>
            </div>
        </section>
    </section>
</main>
