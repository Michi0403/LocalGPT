@rendermode InteractiveServer
@page "/council-teams"
@attribute [LocalGptUiLayoutSurface("page", "Council Teams", "/council-teams", CanHide = false)]
@attribute [LocalGptUiLayoutSurface("editor", "Council Teams · editor", "/council-teams")]
@inject ICouncilTeamConfigurationService TeamConfigurations
@inject IMultiModelCouncilService CouncilService
@inject ICouncilRuntimeClassService RuntimeClasses
@inject IDxAiFunctionCatalogService FunctionCatalog
@inject ILogger<CouncilTeams> Logger
@inject ISupervisedTaskRunner TaskRunner
@inject CouncilTextService CouncilText
@inject IComponentActivityService ComponentActivity
@inject INotificationService Notifier
@inject IOneWirePeerRegistry WirePeers
@inject IOneWireConnectionRegistry WireConnections

<div class="razor-component-boundary">
<DxFormLayout CssClass="razor-component-layout-owner CouncilTeams">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext001">
<PageTitle>AI Council Teams</PageTitle>

<LocalGptFormLayoutSurface OwnerType="@typeof(CouncilTeams)" SectionName="page" CanHide="false" CssClass="localgpt-route-layout-surface">

<main class="council-team-page localgpt-surface">
    <header class="council-team-header">
        <div>
            <h1>AI Council social structures</h1>
            <p>The supplied LocalGPT council remains available as the default. Create or duplicate a team to define any role set and any workflow from one round up to the technical run limit.</p>
        </div>
        <DxButton CssClass="btn btn-secondary" Click="ReloadAsync" Enabled="@(!_busy)">Reload</DxButton>
    </header>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert @(_hasError ? "alert-danger" : "alert-info")" role="status">@_status</div>
    }

    <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext002">
        <div class="council-team-grid">
        <aside class="council-team-list">
            <label>
                <span>Team</span>
                <DxComboBox Data="@TeamSelectionOptions"
                            Value="@_selectedKey"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnTeamChanged(new ChangeEventArgs { Value = value }))"
                            CssClass="localgpt-dx-combo" />
            </label>
            @foreach (var team in _teams)
            {
                <DxButton CssClass="@(team.Key == _selectedKey ? "council-team-list-item active" : "council-team-list-item")" Click="() => SelectTeam(team)">
                    <strong>@team.DisplayName</strong>
                    <small>@team.Key · @(team.IsDeleted ? "deleted" : team.IsEnabled ? "enabled" : "disabled") · @WorkflowLabel(team)</small>
                    <span>@team.Purpose</span>
                </DxButton>
            }
            <div class="council-team-list-actions">
                <DxButton CssClass="btn btn-outline-primary" Click="CreateTeam">Create empty structure</DxButton>
                <DxButton CssClass="btn btn-outline-secondary" Click="DuplicateTeam" Enabled="@(!(_teams.Count == 0 || _editor.IsDeleted))">Duplicate selected</DxButton>
                <label>
                    <span>Supplied reset template</span>
                    <DxComboBox Data="@ResetTemplateOptions"
                                @bind-Value="_resetTemplateKey"
                                ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                CssClass="localgpt-dx-combo" />
                </label>
                <DxButton CssClass="btn btn-outline-warning" Click="ResetSelectedFromTemplateAsync" Enabled="@(!(_busy || string.IsNullOrWhiteSpace(_selectedKey) || string.IsNullOrWhiteSpace(_resetTemplateKey)))">Reset selected from template</DxButton>
                <DxButton CssClass="btn btn-outline-danger" Click="DeleteSelectedAsync" Enabled="@(!(_busy || string.IsNullOrWhiteSpace(_selectedKey) || _editor.IsDeleted))">Delete selected preset</DxButton>
                <small class="hint">Delete/reset require the review-confirmation checkbox in the editor. Deleted presets remain as tombstones here so you can restore them from any supplied template; they cannot run.</small>
            </div>
        </aside>

        <LocalGptFormLayoutSurface OwnerType="@typeof(CouncilTeams)" SectionName="editor" CanHide="true">
<DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext003">
        <div class="council-team-editor">
            <div class="council-structure-mode @(UsesDefaultWorkflow(_editor) ? "default-mode" : "custom-mode")">
                <strong>@WorkflowLabel(_editor)</strong>
                <span>Untouched supplied teams use the established LocalGPT orchestration. Saving any edit creates a user-owned literal workflow; duplicating keeps the supplied default untouched.</span>
            </div>
            @if (_editor.IsDeleted)
            {
                <div class="alert alert-warning">This configured preset is deleted and cannot run. Choose any supplied reset template in the left panel and reset it to restore the same key.</div>
            }

            <div class="council-team-fields">
                <label><span>Key</span><DxTextBox @bind-Text="_editor.Key" CssClass="localgpt-editor" /></label>
                <label><span>Display name</span><DxTextBox @bind-Text="_editor.DisplayName" CssClass="localgpt-editor" /></label>
                <label class="wide"><span>Purpose</span><DxMemo @bind-Text="_editor.Purpose" CssClass="localgpt-editor" Rows="3" /></label>
            </div>

            <details class="council-advanced-section" open="@(_editor.AllMembersReadinessPreflightMode != CouncilAllMembersReadinessPreflightMode.LegacyWorkflowDefault)">
                <summary>All-members readiness preflight · @PreflightModeLabel</summary>
                <p class="hint">Optional team-level preflight before substantive role work. Legacy compatibility preserves the historical behavior: supplied built-in orchestration keeps its established readiness phase while literal custom workflows add none. The benchmark seed disables this by default. A role-aware probe checks every selected member against its assigned role responsibilities without asking it to solve the original user request.</p>
                <div class="council-workflow-fields">
                    <label>
                        <span>Preflight mode</span>
                        <DxComboBox Data="@AllMembersReadinessPreflightModes"
                                    @bind-Value="_editor.AllMembersReadinessPreflightMode"
                                    ValueFieldName="@nameof(LocalGptSelectionOption<CouncilAllMembersReadinessPreflightMode>.Value)"
                                    TextFieldName="@nameof(LocalGptSelectionOption<CouncilAllMembersReadinessPreflightMode>.Label)"
                                    CssClass="localgpt-dx-combo" />
                    </label>
                    <label>
                        <span>Maximum output tokens per member</span>
                        <DxSpinEdit @bind-Value="_editor.AllMembersReadinessPreflightMaxOutputTokens" CssClass="localgpt-editor" MinValue="32" MaxValue="2048" Enabled="@(!(_editor.AllMembersReadinessPreflightMode != CouncilAllMembersReadinessPreflightMode.RoleAwareProbe))" />
                    </label>
                    <label class="wide">
                        <span>Role-aware preflight prompt override (optional)</span>
                        <DxMemo @bind-Text="_editor.AllMembersReadinessPreflightPromptTemplate" CssClass="localgpt-editor council-script" Rows="5" Enabled="@(!(_editor.AllMembersReadinessPreflightMode != CouncilAllMembersReadinessPreflightMode.RoleAwareProbe))" NullText="Blank uses the maintained compact probe. Placeholders: {{ModelName}}, {{TeamName}}, {{AssignedRoles}}, {{RoleResponsibilities}}" />
                    </label>
                </div>
                <label class="localgpt-check-row mt-2">
                    <DxCheckBox @bind-Checked="_editor.IncludeAllMembersReadinessPreflightInWorkflowContext" CssClass="localgpt-check" Enabled="@(!(_editor.AllMembersReadinessPreflightMode != CouncilAllMembersReadinessPreflightMode.RoleAwareProbe))" />
                    <span>Include all preflight member output in later workflow model context (can be very large on big Councils)</span>
                </label>
                <p class="hint mb-0">When this context option is off, preflight responses remain visible and persisted as run evidence but are filtered out of later model transcript context. This prevents 100+ member readiness chatter from consuming the task budget.</p>
            </details>

            <details class="council-best-use-functions">
                <summary @onclick="ToggleDxFunctionPickerAsync">Best-use DXFunctions (@_editor.PreferredCapabilities.Count selected)</summary>
                @if (!_dxFunctionPickerExpanded)
                {
                    <p class="hint">Open this section to load the DXFunction catalog. The large catalog is intentionally not rendered during Council Teams startup.</p>
                }
                else if (_dxFunctionsLoading)
                {
                    <p class="hint">Loading DXFunctions…</p>
                }
                else
                {
                    <p class="hint">Select the functions this team should prefer. The list is grouped by function namespace; entries recommended by assigned runtime classes are marked.</p>
                    @foreach (var group in AvailableDxFunctions.GroupBy(FunctionNamespace).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <fieldset class="council-runtime-class-group">
                            <legend>@group.Key</legend>
                            @foreach (var entry in group.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                var recommended = RecommendedRuntimeFunctions.Contains(entry.FunctionName);
                                <label class="council-runtime-class-option">
                                    <DxCheckBox ValidationEnabled="false" CssClass="council-runtime-class-checkbox"
                                                Checked="@_editor.PreferredCapabilities.Contains(entry.FunctionName, StringComparer.OrdinalIgnoreCase)"
                                                CheckedChanged="@((bool value) => TogglePreferredCapability(entry.FunctionName, new ChangeEventArgs { Value = value }))" />
                                    <span><strong>@entry.DisplayName</strong> <small>@entry.FunctionName@(recommended ? " · runtime-class recommendation" : string.Empty)</small></span>
                                </label>
                            }
                        </fieldset>
                    }
                }
            </details>

            <details class="council-best-use-functions" open>
                <summary>PublisherStudio organic capability routing</summary>
                <p class="hint">Bind individual PublisherStudio organic functions to this team by enabling its preferred capabilities, then save the team. PublisherStudio clients can select this team key for 1-Wire requests; approval and function permission checks still apply.</p>
                <p class="hint">Current team key: <code>@_editor.Key</code>. Use dedicated teams for spreadsheets and OpenSCAD, or apply a single verified model to all AI roles below.</p>
                <fieldset class="council-runtime-class-group">
                    <legend>PublisherStudio capability affinity</legend>
                    @foreach (var capabilityKey in PublisherOrganicCapabilityKeys)
                    {
                        <label class="council-runtime-class-option" @key="capabilityKey">
                            <DxCheckBox ValidationEnabled="false" Checked="@_editor.PreferredCapabilities.Contains(capabilityKey, StringComparer.OrdinalIgnoreCase)"
                                        CheckedChanged="@((bool enabled) => TogglePreferredCapability(capabilityKey, new ChangeEventArgs { Value = enabled }))" />
                            <span>@capabilityKey</span>
                        </label>
                    }
                </fieldset>
                <label>
                    <span>One currently installed and configured AI model for this team</span>
                    <DxComboBox Data="@PublisherOrganicLiveModelOptions"
                                @bind-Value="_publisherSingleModelKey"
                                ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                CssClass="localgpt-dx-combo" />
                </label>
                <DxButton Text="Bind this live model to all AI roles" Click="BindPublisherOrganicSingleModel" Enabled="@(!string.IsNullOrWhiteSpace(_publisherSingleModelKey))" />
                <DxButton Text="Remove unavailable saved role-model bindings" Click="RemoveUnavailablePublisherModels" />
                <p class="hint">Offline or merely configured machines are not offered by this quick binder. Previously saved unavailable model bindings remain visible in individual role settings until replaced. Binding this model changes the unsaved editor; review and save with confirmation.</p>
            </details>

            <details class="council-best-use-functions" open>
                <summary>Project and verified execution behavior</summary>
                <label>
                    <span>Project provisioning mode (saved per team, never inferred from its name)</span>
                    <DxComboBox Data="@ProjectProvisioningModes"
                                @bind-Value="_editor.ProjectProvisioningMode"
                                ValueFieldName="@nameof(LocalGptSelectionOption<CouncilProjectProvisioningMode>.Value)"
                                TextFieldName="@nameof(LocalGptSelectionOption<CouncilProjectProvisioningMode>.Label)"
                                CssClass="localgpt-dx-combo" />
                </label>
                <label class="wide">
                    <span>Required successful DXFunction results for a complete handoff (one name per line)</span>
                    <DxMemo Text="@CouncilText.FormatMultilineNameList(_editor.RequiredCompletedFunctions)"
                            TextChanged="@SetCompletionFunctionsText"
                            CssClass="localgpt-editor council-script" Rows="4"
                            NullText="For example: project.game.build and project.game.start. Empty = no extra completion gate." />
                </label>
                <p class="hint">The completion gate checks function execution evidence, not AI claims. It does not execute unauthorized operations on behalf of the model.</p>
                <label class="wide"><span>Optional completion notice template</span>
                    <DxMemo @bind-Text="_editor.CompletionNoticeTemplate" CssClass="localgpt-editor council-script" Rows="2" NullText="Use {{RunId}}, {{ExpandedStepCount}}, and {{TeamName}}. Blank = no special notice." />
                </label>
                <details class="council-advanced-section">
                    <summary>Required-function recovery rules (@_editor.CompletionRecovery.Rules.Count)</summary>
                    <p class="hint">Each rule selects an enabled, function-capable step and a required DXFunction. Zero extra attempts disables recovery. Dependencies require successful function receipts, never model claims.</p>
                    @foreach (var recoveryRule in _editor.CompletionRecovery.Rules)
                    {
                        <div class="council-workflow-fields" @key="recoveryRule">
                            <label><span>Required DXFunction</span>
                                <DxComboBox Data="@RecoveryRequiredFunctionOptions" @bind-Value="recoveryRule.FunctionName"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)" CssClass="localgpt-dx-combo" />
                            </label>
                            <label><span>Workflow step</span>
                                <DxComboBox Data="@RecoveryWorkflowStepOptions" @bind-Value="recoveryRule.WorkflowStepKey"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)" CssClass="localgpt-dx-combo" />
                            </label>
                            <label><span>Extra attempts</span><DxSpinEdit @bind-Value="recoveryRule.MaximumAttempts" CssClass="localgpt-editor" MinValue="0" MaxValue="100" /></label>
                            <label class="wide"><span>Prerequisite successful functions (one per line)</span>
                                <DxMemo Text="@CouncilText.FormatMultilineNameList(recoveryRule.PrerequisiteFunctions)" TextChanged="@((string value) => SetRecoveryRulePrerequisites(recoveryRule, value))" CssClass="localgpt-editor" Rows="2" />
                            </label>
                            <label class="wide"><span>Retry instruction</span><DxMemo @bind-Text="recoveryRule.RecoveryPromptTemplate" CssClass="localgpt-editor council-script" Rows="3" /></label>
                            <DxButton CssClass="btn btn-outline-danger btn-sm" Click="() => RemoveCompletionRecoveryRule(recoveryRule)">Remove rule</DxButton>
                        </div>
                    }
                    <DxButton CssClass="btn btn-outline-primary btn-sm" Click="AddCompletionRecoveryRule">Add recovery rule</DxButton>
                    <label class="localgpt-check-row"><DxCheckBox @bind-Checked="_editor.CompletionRecovery.RepeatFinalAnswerAfterRecovery" CssClass="localgpt-check" /><span>Repeat the final-answer step after a recovery attempt</span></label>
                    <label class="wide"><span>Post-recovery final review prompt</span><DxMemo @bind-Text="_editor.CompletionRecovery.FinalReviewPromptTemplate" CssClass="localgpt-editor council-script" Rows="3" /></label>
                </details>
                <details class="council-advanced-section">
                    <summary>Next Council team · configurable follow-on workflow</summary>
                    <p class="hint">A saved team may start another saved team with the same project, models and uploaded workspaces. Empty target disables chaining; successful tool evidence, approval and bounded depth remain enforced.</p>
                    <label><span>Follow-on team</span>
                        <DxComboBox Data="@FollowOnTeamOptions" @bind-Value="_editor.FollowOn.TeamKey"
                                    ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                    TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)" CssClass="localgpt-dx-combo" />
                    </label>
                    <label><span>Maximum chain depth</span><DxSpinEdit @bind-Value="_editor.FollowOn.MaximumDepth" CssClass="localgpt-editor" MinValue="1" MaxValue="10" /></label>
                    <label class="localgpt-check-row"><DxCheckBox @bind-Checked="_editor.FollowOn.RequireVerifiedCompletion" CssClass="localgpt-check" /><span>Run next team only when required functions are verified</span></label>
                    <label class="localgpt-check-row"><DxCheckBox @bind-Checked="_editor.FollowOn.RequiresHumanApproval" CssClass="localgpt-check" /><span>Ask for approval before starting the next team</span></label>
                    <label class="wide"><span>Follow-on team task prompt</span><DxMemo @bind-Text="_editor.FollowOn.PromptTemplate" CssClass="localgpt-editor council-script" Rows="4" NullText="Use {{ParentAnswer}}, {{OriginalPrompt}}, {{ParentTeamKey}}, and {{ParentRunId}} to pass context." /></label>
                </details>
            </details>

            <details class="council-best-use-functions" open>
                <summary>Automatic/native function preferences (@_editor.AllowedAutomaticFunctions.Count selected)</summary>
                <p class="hint">Named functions are preferences unless the workflow step explicitly selects Strict team/step allow-list. Read-only upload workspace tools are available to all non-strict function-enabled roles. Explicit strict selections narrow tools only within that workflow step. The separate DXFunction/skill permission and approval system still governs every call.</p>
                @if (!_dxFunctionsLoaded)
                {
                    <DxButton CssClass="btn btn-outline-secondary btn-sm" Click="LoadDxFunctionCatalogAsync" Enabled="@(!_dxFunctionsLoading)">@(_dxFunctionsLoading ? "Loading DXFunctions…" : "Load DXFunction catalog")</DxButton>
                }
                else
                {
                    @foreach (var group in AvailableDxFunctions.GroupBy(FunctionNamespace).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <fieldset class="council-runtime-class-group">
                            <legend>@group.Key</legend>
                            @foreach (var entry in group.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                <label class="council-runtime-class-option">
                                    <DxCheckBox ValidationEnabled="false" CssClass="council-runtime-class-checkbox"
                                                Checked="@_editor.AllowedAutomaticFunctions.Contains(entry.FunctionName, StringComparer.OrdinalIgnoreCase)"
                                                CheckedChanged="@((bool value) => ToggleTeamAutomaticFunction(entry.FunctionName, new ChangeEventArgs { Value = value }))" />
                                    <span><strong>@entry.DisplayName</strong> <small>@entry.FunctionName</small></span>
                                </label>
                            }
                        </fieldset>
                    }
                }
            </details>

            <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext004">
        <div class="council-structure-section">
                <header>
                    <div>
                        <h2>Roles</h2>
                        <p>Roles are free-form social responsibilities. They do not need to match LocalGPT's supplied role names.</p>
                    </div>
                    <DxButton CssClass="btn btn-outline-primary btn-sm" Click="AddRole">Add role</DxButton>
                </header>
                @if (_editor.Roles.Count == 0)
                {
                    <div class="council-empty-structure">No roles are defined. The workflow can still run, but named roles make the structure easier to understand.</div>
                }
                @for (var index = 0; index < _editor.Roles.Count; index++)
                {
                    var roleIndex = index;
                    var role = _editor.Roles[roleIndex];
                    <article class="council-role-card" @key="role">
                        <header class="council-role-card-header wide">
                            <strong>@(string.IsNullOrWhiteSpace(role.Role) ? $"Role {roleIndex + 1}" : role.Role)</strong>
                            <div class="council-role-badges">
                                <span class="council-role-badge ai">@RoleAiBadge(role)</span>
                                <span class="@($"council-role-badge {RoleHumanBadgeClass(role)}")">@RoleHumanBadge(role)</span>
                                <span class="council-role-badge performance">@RolePerformanceBadge(role)</span>
                                <span class="council-role-badge boundary">@RoleBoundaryBadge(role)</span>
                                <span class="council-role-badge language">@RoleLanguageBadge(role)</span>
                                @if (!string.IsNullOrWhiteSpace(role.PairedRole))
                                {
                                    <span class="council-role-badge pairing">Paired with @role.PairedRole</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(role.DistinctAiAssignmentGroup))
                                {
                                    <span class="council-role-badge distinct">Distinct group @role.DistinctAiAssignmentGroup</span>
                                }
                            </div>
                        </header>
                        <label><span>Role name</span><DxTextBox @bind-Text="role.Role" CssClass="localgpt-editor" /></label>
                        <label><span>Expertise or viewpoint</span><DxTextBox @bind-Text="role.Expertise" CssClass="localgpt-editor" /></label>
                        <label class="wide"><span>Responsibility</span><DxMemo @bind-Text="role.Responsibility" CssClass="localgpt-editor" Rows="2" /></label>
                        <div class="wide council-role-policy-grid">
                            <label>
                                <span>AI assignment</span>
                                <DxComboBox Data="@AiSelectionModes"
                                            @bind-Value="role.AiSelectionMode"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<CouncilRoleAiSelectionMode>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<CouncilRoleAiSelectionMode>.Label)"
                                            CssClass="localgpt-dx-combo"
                                            Enabled="@(role.HumanParticipationMode != HumanParticipationMode.HumanOnly)" />
                            </label>
                            @if (role.AiSelectionMode == CouncilRoleAiSelectionMode.AssignedModelsRandomRange && role.HumanParticipationMode != HumanParticipationMode.HumanOnly)
                            {
                                <label>
                                    <span>Exact role invocations</span>
                                    <DxSpinEdit Value="@ExactRoleInvocationCount(role)"
                                                ValueChanged="@((int? value) => SetExactRoleInvocationCount(roleIndex, value))"
                                                CssClass="localgpt-editor"
                                                MinValue="1"
                                                NullText="Optional · use range below" />
                                </label>
                            }
                            @if (UsesRandomParticipantCount(role) && role.HumanParticipationMode != HumanParticipationMode.HumanOnly)
                            {
                                <label>
                                    <span>@(role.AiSelectionMode == CouncilRoleAiSelectionMode.AssignedModelsRandomRange ? "Minimum pool invocations" : "Minimum random AI participants")</span>
                                    <DxSpinEdit @bind-Value="role.MinimumAiParticipants" CssClass="localgpt-editor" MinValue="1" />
                                </label>
                                <label>
                                    <span>@(role.AiSelectionMode == CouncilRoleAiSelectionMode.AssignedModelsRandomRange ? "Maximum pool invocations" : "Maximum random AI participants")</span>
                                    <DxSpinEdit @bind-Value="role.MaximumAiParticipants" CssClass="localgpt-editor" MinValue="1" />
                                </label>
                            }
                            else if (role.AiSelectionMode == CouncilRoleAiSelectionMode.AllSelected && role.HumanParticipationMode != HumanParticipationMode.HumanOnly)
                            {
                                <p class="hint council-role-all-subjects">Every selected Council AI participates. There is no random minimum, maximum or representative sampling for this role.</p>
                            }
                            <label>
                                <span>Human participation</span>
                                <DxComboBox Data="@HumanParticipationModes"
                                            @bind-Value="role.HumanParticipationMode"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<HumanParticipationMode>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<HumanParticipationMode>.Label)"
                                            CssClass="localgpt-dx-combo" />
                            </label>
                            <label>
                                <span>Role performance</span>
                                <DxComboBox Data="@PerformanceModes"
                                            @bind-Value="role.PerformanceMode"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<CouncilRolePerformanceMode>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<CouncilRolePerformanceMode>.Label)"
                                            CssClass="localgpt-dx-combo" />
                            </label>
                            <label>
                                <span>Role boundary</span>
                                <DxComboBox Data="@BoundaryModes"
                                            @bind-Value="role.BoundaryMode"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<CouncilRoleBoundaryMode>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<CouncilRoleBoundaryMode>.Label)"
                                            CssClass="localgpt-dx-combo" />
                            </label>
                            <label>
                                <span>Response language</span>
                                <DxComboBox Data="@LanguageModes"
                                            @bind-Value="role.LanguageMode"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<CouncilRoleLanguageMode>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<CouncilRoleLanguageMode>.Label)"
                                            CssClass="localgpt-dx-combo" />
                            </label>
                        </div>
                        @if (UsesRandomParticipantCount(role) && role.HumanParticipationMode != HumanParticipationMode.HumanOnly)
                        {
                            <p class="wide hint">@(role.AiSelectionMode == CouncilRoleAiSelectionMode.AssignedModelsRandomRange
                                ? "Set Exact role invocations for a fixed count, or use the minimum/maximum fields for a random count per run. A count larger than the provider-bound pool deliberately reuses members in fair shuffled cycles. "
                                : string.Empty)The count selects role participants/invocations. The workflow execution mode still decides whether all selected members run or one leader/round-robin member is chosen for that step.</p>
                        }
                        @if (UsesProviderBoundRolePool(role) && role.HumanParticipationMode != HumanParticipationMode.HumanOnly)
                        {
                            <details class="wide council-provider-model-picker" open>
                                <summary>Provider-bound role models (@role.AssignedModelKeys.Count selected)</summary>
                                <p class="hint">The provider, endpoint and model are one identity. These saved members are automatically added to the run and LocalGPT will not substitute a same-name model from another host. In random-pool mode, the saved models form the eligible pool; requesting more invocations than the pool size cycles through another deterministic shuffle instead of imposing a hard ceiling.</p>
                                @if (_providerModels.Count == 0)
                                {
                                    <div class="alert alert-warning mb-2">No provider model catalog is currently available. Existing saved bindings remain visible below and are not deleted.</div>
                                }
                                @foreach (var providerGroup in _providerModels
                                    .GroupBy(candidate => new { candidate.Provider, candidate.Endpoint })
                                    .OrderBy(group => group.Key.Provider, StringComparer.OrdinalIgnoreCase)
                                    .ThenBy(group => group.Key.Endpoint, StringComparer.OrdinalIgnoreCase))
                                {
                                    <details class="council-provider-host-group">
                                        <summary>@providerGroup.Key.Provider · @providerGroup.Key.Endpoint (@providerGroup.Count() models)</summary>
                                        <div class="council-provider-model-list">
                                            <DxListBox TData="CouncilRoleModelOption" TValue="string"
                                                       Data="@ProviderModelOptions(providerGroup)"
                                                       Values="@SelectedProviderModelKeys(role, providerGroup)"
                                                       ValuesChanged="@((IEnumerable<string> values) => SetProviderRoleModels(roleIndex, providerGroup.Select(candidate => candidate.SelectionKey).ToArray(), values))"
                                                       ValueFieldName="@nameof(CouncilRoleModelOption.SelectionKey)"
                                                       TextFieldName="@nameof(CouncilRoleModelOption.DisplayName)"
                                                       SelectionMode="ListBoxSelectionMode.Multiple"
                                                       ShowCheckboxes="true"
                                                       ShowSearchBox="true"
                                                       SearchBoxNullText="Search models on this provider..."
                                                       ListRenderMode="ListRenderMode.Virtual"
                                                       Height="260px" />
                                        </div>
                                    </details>
                                }
                                @foreach (var savedModelKey in UnavailableRoleModelKeys(role))
                                {
                                    <div class="council-stale-model-binding">
                                        <span><strong>Saved but unavailable:</strong> @savedModelKey</span>
                                        <DxButton CssClass="btn btn-outline-danger btn-sm" Click="() => RemoveRoleModel(roleIndex, savedModelKey)">Remove binding</DxButton>
                                    </div>
                                }
                            </details>
                        }
                        <div class="wide council-role-coordination-grid">
                            <label>
                                <span>Distinct AI assignment group</span>
                                <DxTextBox @bind-Text="role.DistinctAiAssignmentGroup" CssClass="localgpt-editor" NullText="Optional shared group key" />
                            </label>
                            <label>
                                <span>Match AI count to role</span>
                                <DxTextBox @bind-Text="role.MatchAiParticipantCountToRole" CssClass="localgpt-editor" NullText="Optional role name" />
                            </label>
                            <label>
                                <span>Pair one-to-one with role</span>
                                <DxTextBox @bind-Text="role.PairedRole" CssClass="localgpt-editor" NullText="Optional role name" />
                            </label>
                        </div>
                        <details class="wide council-runtime-class-picker">
                            <summary>Runtime classes (@role.RuntimeClassKeys.Count selected)</summary>
                            <p class="hint">Assign database-backed runtime classes to this role. Every field remains visible with AI/human ownership, blocking behavior and keyboard/gamepad bindings.</p>
                            @foreach (var group in _runtimeClasses.GroupBy(item => item.Namespace).OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase))
                            {
                                <fieldset class="council-runtime-class-group">
                                    <legend>@group.Key</legend>
                                    @foreach (var runtimeClass in group.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <label class="council-runtime-class-option">
                                            <DxCheckBox ValidationEnabled="false" CssClass="council-runtime-class-checkbox"
                                                        Checked="@role.RuntimeClassKeys.Contains(runtimeClass.Key, StringComparer.OrdinalIgnoreCase)"
                                                        CheckedChanged="@((bool value) => ToggleRuntimeClass(roleIndex, runtimeClass.Key, new ChangeEventArgs { Value = value }))" />
                                            <span><strong>@runtimeClass.DisplayName</strong> <small>@runtimeClass.Key · @runtimeClass.Kind</small></span>
                                        </label>
                                    }
                                </fieldset>
                            }
                            @foreach (var runtimeClass in RuntimeClassesFor(role))
                            {
                                <article class="council-runtime-class-preview">
                                    <header><strong>@runtimeClass.DisplayName</strong><small>@runtimeClass.Key</small></header>
                                    <p>@runtimeClass.Description</p>
                                    <div class="council-runtime-field-list">
                                        @foreach (var field in runtimeClass.Fields)
                                        {
                                            <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext005">
        <div class="council-runtime-field-card">
                                                <header>
                                                    <strong>@field.DisplayName</strong>
                                                    <small>@field.Name</small>
                                                </header>
                                                <dl>
                                                    <div><dt>Type / default</dt><dd>@field.DataType · @field.DefaultValue</dd></div>
                                                    <div><dt>Input</dt><dd>@field.InputMode</dd></div>
                                                    <div><dt>AI ownership</dt><dd>@(field.AiAssignable ? "allowed" : "not allowed")</dd></div>
                                                    <div><dt>Human ownership</dt><dd>@(field.HumanAssignable ? "allowed" : "not allowed")</dd></div>
                                                    <div><dt>Round gate</dt><dd>@(field.BlocksNextRoundUntilHumanInput ? "human input required" : "non-blocking")</dd></div>
                                                    <div><dt>Keyboard</dt><dd>@(string.IsNullOrWhiteSpace(field.KeyboardKey) ? "—" : field.KeyboardKey)</dd></div>
                                                    <div><dt>Gamepad</dt><dd>@(string.IsNullOrWhiteSpace(field.GamepadButton) ? "—" : field.GamepadButton)</dd></div>
                                                </dl>
                                            </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
                                        }
                                    </div>
                                </article>
                            }
                        </details>
                        <p class="wide council-role-policy-help">@RolePolicyExplanation(role) @RolePerformanceExplanation(role) @RoleBoundaryExplanation(role) @RoleLanguageExplanation(role) @RoleCoordinationExplanation(role)</p>
                        <DxButton CssClass="btn btn-outline-danger btn-sm" Click="() => RemoveRole(roleIndex)">Remove role</DxButton>
                    </article>
                }

            </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>

            <DxFormLayout CssClass="razor-section-layout-owner">
    <DxFormLayoutItem ColSpanMd="12">
        <Template Context="formItemContext006">
        <div id="x-functions-automation" class="council-structure-section">
                <header>
                    <div>
                        <h2>Rounds, workflow &amp; automated X Functions</h2>
                        <p>Each enabled entry is a workflow step. Multiple steps may share one logical Council round, and every role/model binding is authoritative for that run. Repeat count expands one step. Consecutive steps with the same loop group repeat together until their completion marker appears or the safety limit is reached. Placeholders include <code>{{UserPrompt}}</code>, <code>{{Transcript}}</code>, <code>{{PreviousStep}}</code>, <code>{{ModelName}}</code>, <code>{{CouncilMembers}}</code>, <code>{{RoleMembers}}</code>, <code>{{ExecutingRoleMember}}</code>, <code>{{RolePeerMembers}}</code>, <code>{{RuntimeClasses}}</code>, <code>{{PairedParticipant}}</code>, <code>{{PairedRole}}</code>, <code>{{RolePairings}}</code>, <code>{{HumanParticipationMode}}</code>, <code>{{RolePerformanceMode}}</code>, <code>{{RoleBoundaryMode}}</code>, <code>{{RoleLanguageMode}}</code>, <code>{{RolePerformanceInstruction}}</code>, <code>{{RoleBoundaryInstruction}}</code>, <code>{{RoleLanguageInstruction}}</code>, <code>{{LoopGroup}}</code>, <code>{{LoopIteration}}</code>, <code>{{LoopMaximumIterations}}</code>, <code>{{TeamName}}</code>, <code>{{Role}}</code>, <code>{{Phase}}</code>, and <code>{{RoundNumber}}</code>.</p>
                    </div>
                    <DxButton CssClass="btn btn-outline-primary btn-sm" Click="AddWorkflowStep">Add round</DxButton>
                </header>
                @if (_editor.WorkflowSteps.Count == 0)
                {
                    <div class="council-empty-structure">No rounds are defined. Add at least one enabled round before saving.</div>
                }
                @for (var index = 0; index < _editor.WorkflowSteps.Count; index++)
                {
                    var stepIndex = index;
                    var step = _editor.WorkflowSteps[stepIndex];
                    <article class="council-workflow-card" @key="step">
                        <header>
                            <div>
                                <strong>@(string.IsNullOrWhiteSpace(step.DisplayName) ? $"Round {stepIndex + 1}" : step.DisplayName)</strong>
                                <small>@step.ExecutionMode · repeat @step.RepeatCount · @WorkflowLoopLabel(step) · @WorkflowRolePolicyLabel(step.Role)</small>
                            </div>
                            <div class="council-step-actions">
                                <DxButton CssClass="btn btn-outline-secondary btn-sm" Click="() => MoveWorkflowStep(stepIndex, -1)" Enabled="@(stepIndex != 0)">Up</DxButton>
                                <DxButton CssClass="btn btn-outline-secondary btn-sm" Click="() => MoveWorkflowStep(stepIndex, 1)" Enabled="@(stepIndex != _editor.WorkflowSteps.Count - 1)">Down</DxButton>
                                <DxButton CssClass="btn btn-outline-danger btn-sm" Click="() => RemoveWorkflowStep(stepIndex)">Remove</DxButton>
                            </div>
                        </header>
                        <div class="council-workflow-fields">
                            <label><span>Key</span><DxTextBox @bind-Text="step.Key" CssClass="localgpt-editor" /></label>
                            <label><span>Display name</span><DxTextBox @bind-Text="step.DisplayName" CssClass="localgpt-editor" /></label>
                            <label><span>Phase</span><DxTextBox @bind-Text="step.Phase" CssClass="localgpt-editor" /></label>
                            <label><span>Role for this round</span><DxTextBox @bind-Text="step.Role" CssClass="localgpt-editor" /></label>
                            <label>
                                <span>Execution</span>
                                <DxComboBox Data="@ExecutionModes"
                                            @bind-Value="step.ExecutionMode"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                            CssClass="localgpt-dx-combo" />
                            </label>
                            <label>
                                <span>Exact provider model</span>
                                <DxComboBox Data="@WorkflowAssignedModelOptions(step)"
                                            @bind-Value="step.AssignedModelName"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                            CssClass="localgpt-dx-combo"
                                            Enabled="@(step.ExecutionMode == "AssignedModelSingle")" />
                            </label>
                            <label><span>Logical Council round (0 = automatic)</span><DxSpinEdit @bind-Value="step.LogicalRoundNumber" CssClass="localgpt-editor" MinValue="0" MaxValue="1000" /></label>
                            <label>
                                <span>Prior transcript visibility</span>
                                <DxComboBox Data="@TranscriptVisibilityModes"
                                            @bind-Value="step.TranscriptVisibility"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<CouncilTranscriptVisibilityMode>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<CouncilTranscriptVisibilityMode>.Label)"
                                            CssClass="localgpt-dx-combo"
                                            Enabled="@step.IncludePriorTranscript" />
                            </label>
                            <label><span>Repeat count inside this step</span><DxSpinEdit @bind-Value="step.RepeatCount" CssClass="localgpt-editor" MinValue="1" MaxValue="100" /></label>
                            <label><span>Sort order</span><DxSpinEdit @bind-Value="step.SortOrder" CssClass="localgpt-editor" /></label>
                            <label>
                                <span>Loop group (optional)</span>
                                <DxTextBox @bind-Text="step.LoopGroup" CssClass="localgpt-editor" NullText="Same key on consecutive steps" />
                            </label>
                            <label>
                                <span>Maximum loop iterations</span>
                                <DxSpinEdit @bind-Value="step.MaximumLoopIterations" CssClass="localgpt-editor" MinValue="1" MaxValue="100" Enabled="@(!(string.IsNullOrWhiteSpace(step.LoopGroup)))" />
                            </label>
                            <label class="wide">
                                <span>Loop completion marker (optional)</span>
                                <DxTextBox @bind-Text="step.LoopCompletionMarker" CssClass="localgpt-editor" NullText="Example: [[TOURNAMENT_COMPLETE]]" Enabled="@(!(string.IsNullOrWhiteSpace(step.LoopGroup)))" />
                            </label>
                            @if (step.ProducesAsciiFrame)
                            {
                                <label><span>ASCII frame width</span><DxSpinEdit @bind-Value="step.AsciiFrameWidth" CssClass="localgpt-editor" MinValue="20" MaxValue="240" /></label>
                                <label><span>ASCII frame height</span><DxSpinEdit @bind-Value="step.AsciiFrameHeight" CssClass="localgpt-editor" MinValue="8" MaxValue="120" /></label>
                                <label><span>World step scale</span><DxSpinEdit @bind-Value="step.WorldStepScale" CssClass="localgpt-editor" MinValue="1" MaxValue="1000" /></label>
                                <div class="wide alert alert-info mb-0">Exactly one AI must own the complete frame. Use LeaderSingle, RoundRobinSingle or AssignedModelSingle and emit <code>[[ASCII_FRAME]]...[[/ASCII_FRAME]]</code>.</div>
                            }
                            <label class="wide"><span>Round prompt</span><DxMemo @bind-Text="step.PromptTemplate" CssClass="localgpt-editor council-script" Rows="7" /></label>
                        </div>
                        <details class="council-advanced-section" open="@(step.EnableRolePeerReview || step.SummarizeRoleResults)">
                            <summary>Role-member coordination @(step.EnableRolePeerReview || step.SummarizeRoleResults ? "· enabled" : "· disabled")</summary>
                            <p class="hint">Optional and off by default. Primary role members still execute exactly as configured above. Peer review adds a small role-local usefulness/vote pass without DX side effects. Role synthesis can then ask one assigned role member to merge the primary answers into one authoritative result for this role before the next workflow step.</p>
                            <div class="council-step-options">
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.EnableRolePeerReview" CssClass="localgpt-check" /><span>Peer-review role-member answers, report usefulness and vote for the strongest role result</span></label>
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.SummarizeRoleResults" CssClass="localgpt-check" /><span>Summarize multiple role-member answers into one final result of this role</span></label>
                            </div>
                            @if (step.SummarizeRoleResults)
                            {
                                <div class="council-workflow-fields">
                                    <label>
                                        <span>Role result summarizer</span>
                                        <DxComboBox Data="@RoleResultSynthesisMemberModes"
                                                    @bind-Value="step.RoleResultSynthesisMemberMode"
                                                    ValueFieldName="@nameof(LocalGptSelectionOption<CouncilRoleResultSynthesisMemberMode>.Value)"
                                                    TextFieldName="@nameof(LocalGptSelectionOption<CouncilRoleResultSynthesisMemberMode>.Label)"
                                                    CssClass="localgpt-dx-combo" />
                                    </label>
                                    <label>
                                        <span>Selected role member</span>
                                        <DxComboBox Data="@RoleResultSynthesisModelOptions(step)"
                                                    @bind-Value="step.RoleResultSynthesisModelName"
                                                    ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                                    TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                                    CssClass="localgpt-dx-combo"
                                                    Enabled="@(step.RoleResultSynthesisMemberMode == CouncilRoleResultSynthesisMemberMode.AssignedRoleMember)" />
                                    </label>
                                </div>
                                <label class="wide">
                                    <span>Role-result synthesis prompt override (optional)</span>
                                    <DxMemo @bind-Text="step.RoleResultSynthesisPromptTemplate" CssClass="localgpt-editor council-script" Rows="9" NullText="Blank = database-backed global default. Placeholders: {{SynthesisParticipant}}, {{RoleName}}, {{TeamName}}, {{UserPrompt}}, {{StepDisplayName}}, {{StepPhase}}, {{RoleExpertise}}, {{RoleResponsibility}}, {{AssignedMembers}}, {{RoleEvidence}}, {{PeerReviewEvidence}}" />
                                </label>
                                <p class="hint mb-0">Random selection is stable for one run/round so rejoin and replay diagnostics stay understandable. A selected model is used only when it is actually assigned to this role in the run; otherwise LocalGPT safely falls back to a deterministic role member and records a warning.</p>
                            }
                            @if (step.EnableRolePeerReview)
                            {
                                <label class="wide">
                                    <span>Role peer-review prompt override (optional)</span>
                                    <DxMemo @bind-Text="step.RolePeerReviewPromptTemplate" CssClass="localgpt-editor council-script" Rows="9" NullText="Blank = database-backed global default. Placeholders: {{ReviewerModelName}}, {{RoleName}}, {{TeamName}}, {{UserPrompt}}, {{StepDisplayName}}, {{StepPhase}}, {{RoleExpertise}}, {{RoleResponsibility}}, {{PeerMembers}}, {{RoleEvidence}}" />
                                </label>
                            }
                        </details>
                        <div class="council-step-options">
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.IsEnabled" CssClass="localgpt-check" /><span>Enabled</span></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.IncludePriorTranscript" CssClass="localgpt-check" /><span>Include prior transcript according to visibility policy</span></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.ProducesFinalAnswer" CssClass="localgpt-check" /><span>Can become final answer</span></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.RequiresHumanCheckpoint" CssClass="localgpt-check" /><span>Respect human gate before round</span></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.RequiresCompleteUploadWorkspaceCuration" CssClass="localgpt-check" /><span>Require complete upload-workspace curation before round</span></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.RequiresVerifiedWorkspaceFileRead" CssClass="localgpt-check" /><span>Require evidence that this AI actually read an uploaded file (not just a hash inventory)</span></label>
                            <label><span>Minimum distinct fully read workspace files (0 = one)</span><DxSpinEdit @bind-Value="step.RequiredCompletedWorkspaceFiles" CssClass="localgpt-editor" MinValue="0" MaxValue="100000" Enabled="@step.RequiresVerifiedWorkspaceFileRead" /></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.RequireEachWorkspaceArchiveRead" CssClass="localgpt-check" Enabled="@step.RequiresVerifiedWorkspaceFileRead" /><span>Require at least one complete read from each extracted archive root</span></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.ContinueWorkspaceReviewOnlyOnProgress" CssClass="localgpt-check" Enabled="@step.RequiresVerifiedWorkspaceFileRead" /><span>Continue source review while new source pages or complete files are read; stop if a retry makes no progress</span></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.RetryMissingWorkspaceFileReadOnce" CssClass="localgpt-check" Enabled="@step.RequiresVerifiedWorkspaceFileRead" /><span>Legacy single source-read retry (used only when the advanced attempt count is zero)</span></label>
                            <label><span>Verified workspace-read recovery attempts</span><DxSpinEdit @bind-Value="step.MissingWorkspaceFileReadRecoveryAttempts" CssClass="localgpt-editor" MinValue="0" MaxValue="100" Enabled="@step.RequiresVerifiedWorkspaceFileRead" /></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.IncludeWorkspaceSourceExcerptsOnRecovery" CssClass="localgpt-check" Enabled="@step.RequiresVerifiedWorkspaceFileRead" /><span>Supply bounded source excerpts for corrective retry (not a verified model read)</span></label>
                            <label class="wide"><span>Workspace-read retry instruction</span><DxMemo @bind-Text="step.WorkspaceFileReadRecoveryPromptTemplate" CssClass="localgpt-editor council-script" Rows="3" /></label>
                            <label class="wide"><span>Source excerpt filename priorities (one term per line, optional)</span>
                                <DxMemo Text="@CouncilText.FormatMultilineNameList(step.WorkspaceSourcePriorityTerms)"
                                        TextChanged="@((string value) => SetWorkspaceSourcePriorityTerms(step, value))"
                                        CssClass="localgpt-editor" Rows="3" />
                            </label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.IncludeLocalResearchEvidence" CssClass="localgpt-check" /><span>Preload local Knowledge/regex inventory for this step</span></label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.WaitForDeferredApprovalsBeforeNextStep" CssClass="localgpt-check" /><span>Wait for approval-gated DXFunctions before next round</span></label>
                            <label>
                                <span>Automatic/native function policy</span>
                                <DxComboBox Data="@AutomaticFunctionPolicyModes"
                                            Value="@step.AutomaticFunctionPolicyMode"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<CouncilAutomaticFunctionPolicyMode>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<CouncilAutomaticFunctionPolicyMode>.Label)"
                                            ValueChanged="@((CouncilAutomaticFunctionPolicyMode value) => SetAutomaticFunctionPolicy(step, new ChangeEventArgs { Value = value.ToString() }))"
                                            CssClass="localgpt-dx-combo" />
                            </label>
                            <label>
                                <span>Function-result processing</span>
                                <DxComboBox Data="@ToolResultContinuationModes"
                                            @bind-Value="step.ToolResultContinuationMode"
                                            ValueFieldName="@nameof(LocalGptSelectionOption<CouncilToolResultContinuationMode>.Value)"
                                            TextFieldName="@nameof(LocalGptSelectionOption<CouncilToolResultContinuationMode>.Label)"
                                            CssClass="localgpt-dx-combo" />
                            </label>
                            <label>
                                <span>Function-result continuation rounds</span>
                                <DxSpinEdit @bind-Value="step.ToolResultContinuationRounds"
                                            CssClass="localgpt-editor"
                                            MinValue="1"
                                            MaxValue="6"
                                            Enabled="@(step.ToolResultContinuationMode != CouncilToolResultContinuationMode.Disabled)" />
                            </label>
                            <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.ProducesAsciiFrame" CssClass="localgpt-check" /><span>Produces one AI-owned ASCII frame</span></label>
                        </div>
                        <p class="hint">Function results are intermediate evidence. Bounded continuation sends text-gateway results back to the same assigned model so it can analyze web, compiler, formula, file, or other function evidence instead of presenting the raw payload as the task result.</p>
                        <p class="hint">Normal workflows can discover, preview and invoke any policy-approved function. Lists prioritize native callable tools but do not restrict the catalog; choose a strict mode only for an intentional isolation boundary. Strict selection applies only to the current workflow step and never changes any function or skill permission. No team category or runtime class automatically enables strict mode. Function-specific permission and human approval requirements always apply.</p>
                        @if (step.AutomaticFunctionPolicyMode is CouncilAutomaticFunctionPolicyMode.TeamAllowList or CouncilAutomaticFunctionPolicyMode.StrictTeamAllowList)
                        {
                            <p class="hint">Team tools (@(step.AutomaticFunctionPolicyMode == CouncilAutomaticFunctionPolicyMode.StrictTeamAllowList ? "exclusive" : "preferred")): @(step.CanUseOrganicFunctions && _editor.AllowedAutomaticFunctions.Count > 0 ? CouncilText.FormatInlineNameList(_editor.AllowedAutomaticFunctions) : "no functions selected")</p>
                        }
                        else if (step.AutomaticFunctionPolicyMode is CouncilAutomaticFunctionPolicyMode.ExactAllowList or CouncilAutomaticFunctionPolicyMode.StrictStepAllowList)
                        {
                            <label class="wide">
                                <span>@(step.AutomaticFunctionPolicyMode == CouncilAutomaticFunctionPolicyMode.StrictStepAllowList ? "Strict step function allow-list" : "Preferred step function names") · one per line</span>
                                <DxMemo Text="@CouncilText.FormatMultilineNameList(step.AllowedAutomaticFunctions)"
                                        TextChanged="@((string value) => SetStepAutomaticFunctions(step, new ChangeEventArgs { Value = value }))"
                                        CssClass="localgpt-editor council-script" Rows="4" />
                            </label>
                        }
                        @if (step.AutomaticFunctionPolicyMode == CouncilAutomaticFunctionPolicyMode.AllPolicyApproved &&
                            (step.AllowedAutomaticFunctions.Count > 0 || _editor.AllowedAutomaticFunctions.Count > 0))
                        {
                            <p class="hint">Direct-tool preferences: step @(CouncilText.FormatInlineNameList(step.AllowedAutomaticFunctions)); team @(CouncilText.FormatInlineNameList(_editor.AllowedAutomaticFunctions)). All other policy-approved functions remain available through the broker.</p>
                        }
                        <details class="council-advanced-section">
                            <summary>Member result recovery · @step.MemberFailureRecoveryAttempts round repair turn(s) · @step.RoleComplianceRetryCount role retry(s) · final-answer recovery @(step.FinalAnswerRecoveryEnabled ? "on" : "off")</summary>
                            <p class="hint">These are persisted Social Team execution policies. A provider crash, timeout, or unusable member result is preserved as evidence; required work is then repeated according to this round policy. Substitute models can only come from the role's existing saved model-selection pool, so recovery never invents a second hidden scheduler.</p>
                            <div class="council-workflow-fields">
                                <label>
                                    <span>Provider/member failure recovery</span>
                                    <DxComboBox Data="@MemberFailureRecoveryModes"
                                                @bind-Value="step.MemberFailureRecoveryMode"
                                                ValueFieldName="@nameof(LocalGptSelectionOption<CouncilMemberFailureRecoveryMode>.Value)"
                                                TextFieldName="@nameof(LocalGptSelectionOption<CouncilMemberFailureRecoveryMode>.Label)"
                                                CssClass="localgpt-dx-combo" />
                                </label>
                                <label><span>Round-level recovery turns after built-in safe fallback</span><DxSpinEdit @bind-Value="step.MemberFailureRecoveryAttempts" CssClass="localgpt-editor" MinValue="0" MaxValue="8" Enabled="@(!(step.MemberFailureRecoveryMode == CouncilMemberFailureRecoveryMode.Disabled))" /></label>
                                <label><span>Role-compliance corrective retries</span><DxSpinEdit @bind-Value="step.RoleComplianceRetryCount" CssClass="localgpt-editor" MinValue="0" MaxValue="3" /></label>
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.FinalAnswerRecoveryEnabled" CssClass="localgpt-check" /><span>Recover a final answer when only thinking/non-final content was returned</span></label>
                                <label><span>Final-answer recovery max output tokens</span><DxSpinEdit @bind-Value="step.FinalAnswerRecoveryMaxOutputTokens" CssClass="localgpt-editor" MinValue="128" MaxValue="32768" Enabled="@(!(!step.FinalAnswerRecoveryEnabled))" /></label>
                            </div>
                        </details>
                        <details class="council-advanced-section">
                            <summary>X-Rounds / revisable control flow · X Functions &amp; automation @(step.XFunctionsEnabled ? "· enabled" : "· disabled")</summary>
                            <p class="hint"><strong>Automated X Functions:</strong> enable and authorize the X actions for this workflow step here. The existing X-Round engine remains the execution layer. X-Rounds do not erase history. A revisit creates a new workflow-step revision caused by the requesting step. Reconsider suppresses DX/organic side effects; Reexecute deliberately runs the target's normal function policy again.</p>
                            <div class="d-flex flex-wrap gap-2 mb-2" aria-label="X-Round workflow presets">
                                <DxButton CssClass="btn btn-outline-secondary btn-sm" Click="() => ApplyXRoundPreset(step, CouncilXRoundPreset.Gatekeeper)">Gatekeeper</DxButton>
                                <DxButton CssClass="btn btn-outline-secondary btn-sm" Click="() => ApplyXRoundPreset(step, CouncilXRoundPreset.ReactiveRevisit)">Reactive revisit</DxButton>
                                <DxButton CssClass="btn btn-outline-secondary btn-sm" Click="() => ApplyXRoundPreset(step, CouncilXRoundPreset.DerivedSingleModel)">Derived single model</DxButton>
                                <DxButton CssClass="btn btn-outline-secondary btn-sm" Click="() => ApplyXRoundPreset(step, CouncilXRoundPreset.DerivedCouncil)">Derived Council</DxButton>
                                <DxButton CssClass="btn btn-outline-danger btn-sm" Click="() => ApplyXRoundPreset(step, CouncilXRoundPreset.Disabled)">Clear X policy</DxButton>
                            </div>
                            <div class="council-step-options">
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.XFunctionsEnabled" CssClass="localgpt-check" /><span>Enable X-Functions for this step</span></label>
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.XCanRevisit" CssClass="localgpt-check" Enabled="@(!(!step.XFunctionsEnabled))" /><span>May revisit another step</span></label>
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.XCanReturnText" CssClass="localgpt-check" Enabled="@(!(!step.XFunctionsEnabled))" /><span>May return text and finish parent workflow</span></label>
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.XCanStartSingleModel" CssClass="localgpt-check" Enabled="@(!(!step.XFunctionsEnabled))" /><span>May start one selected model subtask</span></label>
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.XCanStartCouncil" CssClass="localgpt-check" Enabled="@(!(!step.XFunctionsEnabled))" /><span>May start another Council team</span></label>
                                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="step.XRequiresHumanApproval" CssClass="localgpt-check" Enabled="@(!(!step.XFunctionsEnabled))" /><span>Human must approve every accepted X control request</span></label>
                            </div>
                            <div class="council-workflow-fields">
                                <label><span>X transition budget for this source step</span><DxSpinEdit @bind-Value="step.XMaximumTransitions" CssClass="localgpt-editor" MinValue="1" MaxValue="100" Enabled="@(!(!step.XFunctionsEnabled))" /></label>
                                <label>
                                    <span>Default revisit target</span>
                                    <DxComboBox Data="@XRevisitTargetOptions(stepIndex)"
                                                @bind-Value="step.XDefaultTargetStepKey"
                                                ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                                TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                                CssClass="localgpt-dx-combo"
                                                Enabled="@(step.XFunctionsEnabled && step.XCanRevisit)" />
                                </label>
                                <label>
                                    <span>Default child Council team</span>
                                    <DxComboBox Data="@XChildCouncilTeamOptions(step)"
                                                @bind-Value="step.XChildCouncilTeamKey"
                                                ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                                TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                                CssClass="localgpt-dx-combo"
                                                Enabled="@(step.XFunctionsEnabled && step.XCanStartCouncil)" />
                                </label>
                                <label><span>Maximum child-Council nesting depth</span><DxSpinEdit @bind-Value="step.XMaximumChildCouncilDepth" CssClass="localgpt-editor" MinValue="1" MaxValue="10" Enabled="@(!(!step.XFunctionsEnabled || !step.XCanStartCouncil))" /></label>
                                <label class="wide">
                                    <span>Default single-model target</span>
                                    <DxComboBox Data="@XChildModelOptions(step)"
                                                @bind-Value="step.XChildModelName"
                                                ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                                TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                                CssClass="localgpt-dx-combo"
                                                Enabled="@(step.XFunctionsEnabled && step.XCanStartSingleModel)" />
                                </label>
                                <div class="wide alert alert-info mb-0">X functions exposed to the role are <code>council.x.status</code>, <code>council.x.revisit</code>, <code>council.x.return_text</code>, <code>council.x.start_single_model</code> and <code>council.x.start_council</code>. X-Rounds also require a function policy that exposes the corresponding X functions because they are explicit DXFunctions.</div>
                            </div>
                        </details>
                    </article>
                }
            </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>

            <details class="council-advanced-section">
                <summary>Advanced prompt compatibility and JSON import/export</summary>
                <div class="council-team-fields">
                    <label class="wide"><span>Legacy expert preparation prompt</span><DxMemo @bind-Text="_editor.ExpertPreparationPromptTemplate" CssClass="localgpt-editor council-script" Rows="6" /></label>
                    <label class="wide"><span>Legacy leader synthesis prompt</span><DxMemo @bind-Text="_editor.LeaderSynthesisPromptTemplate" CssClass="localgpt-editor council-script" Rows="6" /></label>
                    <label class="wide"><span>Legacy main-round instruction</span><DxMemo @bind-Text="_editor.MainRoundInstructionTemplate" CssClass="localgpt-editor council-script" Rows="4" /></label>
                    <label class="wide"><span>Roles JSON</span><DxMemo @bind-Text="_rolesJson" CssClass="localgpt-editor council-script" Rows="8" /></label>
                    <label class="wide"><span>Workflow steps JSON</span><DxMemo @bind-Text="_workflowJson" CssClass="localgpt-editor council-script" Rows="12" /></label>
                    <div class="wide council-json-actions">
                        <DxButton CssClass="btn btn-outline-secondary btn-sm" Click="RefreshAdvancedJson">Refresh JSON from editor</DxButton>
                        <DxButton CssClass="btn btn-outline-primary btn-sm" Click="ApplyAdvancedJson">Apply JSON to editor</DxButton>
                    </div>
                    <label class="wide"><span>Preferred organic capabilities JSON</span><DxMemo @bind-Text="_capabilitiesJson" CssClass="localgpt-editor council-script" Rows="5" /></label>
                    <label class="wide"><span>Team automatic/native function preferences JSON · strict only for explicitly selected steps</span><DxMemo @bind-Text="_allowedFunctionsJson" CssClass="localgpt-editor council-script" Rows="5" /></label>
                    <label class="wide"><span>Architecture contracts JSON</span><DxMemo @bind-Text="_contractsJson" CssClass="localgpt-editor council-script" Rows="5" /></label>
                </div>
            </details>

            <div class="council-team-savebar">
                <span class="council-expanded-count">@EnabledRoundCount enabled step(s), up to @ExpandedRoundCount expanded round(s)</span>
                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="_editor.IsEnabled" CssClass="localgpt-check" /><span>Enabled</span></label>
                <label class="localgpt-check-row"><DxCheckBox @bind-Checked="_confirmed" @bind-Checked:after="ReviewConfirmationChanged" CssClass="localgpt-check" /><span>I reviewed this social structure and its prompts</span></label>
                <DxButton CssClass="btn btn-primary" Click="SaveAsync" Enabled="@(!(_busy || _editor.IsDeleted))">Save reviewed team</DxButton>
            </div>
        </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</LocalGptFormLayoutSurface>
    </div>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</main>
</LocalGptFormLayoutSurface>
    </Template>
    </DxFormLayoutItem>
</DxFormLayout>
</div>

