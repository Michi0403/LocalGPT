@rendermode InteractiveServer
@page "/chat"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using System.Text.Json
@inject CouncilRuntimeService CouncilRuntime
@inject ILocalGptRuntimePolicyDataService RuntimePolicy
@inject CouncilTextService CouncilText
@inject AsciiChatTextService AsciiText
@inject IConsoleOperatorService ConsoleOperator
@inject LocalGptCatalogService Catalog
@inject IChatMemoryService ChatMemory
@inject IChatUploadWorkspaceService ChatUploadWorkspaces
@inject IMultiModelCouncilService CouncilService
@inject IProviderModelRuntimeService ProviderModels
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IChatContentRenderer ChatContentRenderer
@inject IChatResponseFormatterFactory ChatResponseFormatterFactory
@inject IChatProtocolResolver ChatProtocolResolver
@inject IPromptConfigService PromptConfigService
@inject IDxAiFunctionRegistry DxAiFunctionRegistry
@inject IVariableStoreService VariableStore
@inject ISystemVariableDefinitionService SystemVariables
@inject ILocalGptProjectService ProjectService
@inject IFeaturePersistenceService FeaturePersistence
@inject IModelPresetService ModelPresetService
@inject IHardwarePerformancePresetService HardwarePerformancePresets
@inject ICouncilTeamConfigurationService CouncilTeamConfigurations
@inject IChatSessionContext SessionContext
@inject IChatAsciiExperienceState AsciiExperience
@inject IHumanCollaborationService HumanCollaboration
@inject IDeferredDxAiInvocationService DeferredDxInvocations
@inject ILocalGptVocabularyService Vocabulary
@inject ICouncilLiveSessionService CouncilLiveSessions
@inject ICouncilRunConfigurationService CouncilRunConfigurations
@inject ICouncilHardwareRoadConfigurationService CouncilHardwareRoads
@inject IServiceScopeFactory ServiceScopeFactory
@inject ILocalHumanInteractionContext HumanAmbientContext
@implements IDisposable
@inject ILogger<Chat> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject ISupervisedTaskRunner TaskRunner
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization

<PageTitle>@L("Home.LocalChat.Title", "Local Chat")</PageTitle>

<div class="main-container @(IsLiveCouncilInteractionAvailable ? "chat-session-active" : string.Empty)" data-testid="chat-page">
    @if (ChatClientProvider is not null)
    {
        <ToastWrapper Name="@toastName" />
        <div class="chat-primary-actions" data-testid="chat-primary-actions">
            <DxButton Text="Start new chat"
                      CssClass="chat-new-session-button localgpt-rounded-action localgpt-action-primary"
                      RenderStyle="ButtonRenderStyle.Primary"
                      RenderStyleMode="ButtonRenderStyleMode.Contained"
                      IconCssClass="oi oi-plus"
                      Click="ClearHistoryAsync" />
            <DxButton Text="@AsciiTerminalButtonText"
                      CssClass="@AsciiTerminalButtonCssClass"
                      RenderStyle="@AsciiTerminalButtonRenderStyle"
                      RenderStyleMode="@(IsAsciiGameHintAvailable ? ButtonRenderStyleMode.Contained : ButtonRenderStyleMode.Outline)"
                      IconCssClass="oi oi-monitor"
                      Title="@AsciiTerminalButtonTitle"
                      Click="ToggleGameConsoleAsync" />
            <DxButton Text="@(AsciiFunModeEnabled ? "Contextual ASCII fun: ON" : "Contextual ASCII fun: OFF")"
                      CssClass="@AsciiFunButtonCssClass"
                      RenderStyle="@(AsciiFunModeEnabled ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                      RenderStyleMode="@(AsciiFunModeEnabled ? ButtonRenderStyleMode.Contained : ButtonRenderStyleMode.Outline)"
                      IconCssClass="oi oi-sparkles"
                      Click="ToggleAsciiFunModeAsync" />
        </div>
        <details class="chat-configuration-ribbon" data-testid="chat-configuration-ribbon">
            <summary title="Open provider, council, memory, project and architecture controls without taking space from the conversation." @onclick="OnChatConfigurationSummaryClickedAsync">
                <span>Chat configuration</span>
                <small>@(ChatClientProvider.SelectedSession?.Name ?? "No provider") · @CouncilEditorModelNames.Count council model@(CouncilEditorModelNames.Count == 1 ? string.Empty : "s")</small>
            </summary>
            <div class="chat-configuration-content" role="region" aria-label="Chat configuration workspace" tabindex="0">
                <div class="chat-configuration-workbench">
                    <ConfigurationWorkbenchNav Items="@ChatConfigurationSections"
                                               ActiveKey="@ActiveChatConfigurationSection"
                                               ActiveKeyChanged="OnChatConfigurationSectionChangedAsync"
                                               AriaLabel="Chat configuration sections" />
                    <div class="chat-configuration-stage">
                        <ConfigurationWorkbenchPanel SectionKey="provider" ActiveKey="@ActiveChatConfigurationSection" AriaLabel="AI provider configuration">
        <nav class="chat-session-toolbar chat-navigation-actions" data-testid="chat-session-actions" aria-label="Chat actions">
            <strong>Chat actions</strong>
            <details class="chat-actions-menu">
                <summary class="btn btn-outline-secondary"><span class="oi oi-menu" aria-hidden="true"></span> Open actions</summary>
                <div class="chat-actions-menu-items" role="menu">
                    <a role="menuitem" href="/install" data-enhance-nav="false"><span class="oi oi-cog" aria-hidden="true"></span> Provider setup</a>
                    <DxButton role="menuitem" Enabled="@(!isModelRefreshBusy)" Click="RefreshOllamaModelsAsync"><span class="oi oi-reload" aria-hidden="true"></span> Refresh provider models</DxButton>
                    <a role="menuitem" href="/onewire-security" data-enhance-nav="false"><span class="oi oi-lock-locked" aria-hidden="true"></span> 1-Wire Security</a>
                    <a role="menuitem" href="/council-teams" data-enhance-nav="false"><span class="oi oi-people" aria-hidden="true"></span> Council Teams</a>
                    <a role="menuitem" href="/test-lab#remote-knowledge" data-enhance-nav="false"><span class="oi oi-cloud-download" aria-hidden="true"></span> Import knowledge</a>
                    <a role="menuitem" href="/database" data-enhance-nav="false"><span class="oi oi-spreadsheet" aria-hidden="true"></span> Clean up data</a>
                </div>
            </details>
            @if (isModelRefreshBusy)
            {
                <span class="memory-status">Refreshing provider models…</span>
            }
        </nav>

        <div id="chat-provider-controls" data-testid="chat-top-controls">
            <DxFormLayout CssClass="chat-provider-row">
                <DxFormLayoutItem Caption="AI provider" ColSpanMd="5">
                    <div class="chat-provider-selector" title="Choose the local or cloud model for the next response.">
                        <DxComboBox Data="@ProviderSessionOptions"
                                    Value="@SelectedProviderSessionName"
                                    ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                    TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                    ValueChanged="@((string selectedName) => OnProviderSelectionChanged(selectedName))"
                                    CssClass="selector-container-combo-editor chat-provider-combo"
                                    NullText="No configured AI provider"
                                    Enabled="@(ModelsList.Count > 0)" />
                    </div>
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="3">
                    <div class="inline-dx-check" title="Keeps the current chat visible when switching to another configured AI.">
                        <DxCheckBox @bind-Checked="ReuseContextWhenSwitching" />
                        <span>Reuse context when switching AI</span>
                    </div>
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="2">
                    <div class="inline-dx-check" title="Loads the most recent saved memory thread automatically when the Chat page opens. Leave off for a clean local-model context.">
                        <DxCheckBox @bind-Checked="AutoLoadLatestConversation" />
                        <span>Auto-load latest memory</span>
                    </div>
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="2">
                    <div class="inline-dx-check" title="When the ASCII terminal is open, models may occasionally add small contextual ASCII pictures or bounded frame sequences. Real interactive games continue through LocalGPT's Council game runtime.">
                        <DxCheckBox @bind-Checked="AsciiFunModeEnabled" />
                        <span>ASCII fun mode (contextual)</span>
                    </div>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
        @if (ModelsList.Any(session => !session.Name.Equals(Catalog.CouncilSessionName, StringComparison.OrdinalIgnoreCase)))
        {
            <details class="chat-individual-model-controls" data-testid="chat-individual-model-controls">
                <summary>Individual model properties and benchmarking</summary>
                <p class="memory-status">Each model stays bound to its provider and endpoint, even when another provider exposes the same model name.</p>
                <div class="chat-model-session-grid">
                    @foreach (var session in ModelsList.Where(session => !session.Name.Equals(Catalog.CouncilSessionName, StringComparison.OrdinalIgnoreCase)))
                    {
                        <ProviderModelPanel @key="session.SelectionKey" Model="ProviderModels.FromSession(session)"
                                            ShowSelection="false"
                                            ShowUseAction="true"
                                            UseActionText="Use in Chat"
                                            Activated="SelectProviderModelFromPanelAsync"
                                            CouncilModels="SelectedCouncilProviderModels"
                                            BenchmarkApplied="OnChatBenchmarkAppliedAsync"
                                            PerformancePresetSaved="OnBenchmarkPerformancePresetSavedAsync"
                                            BenchmarkStarted="OnBenchmarkStartedAsync" />
                    }
                </div>
            </details>
        }
                        </ConfigurationWorkbenchPanel>

                        <ConfigurationWorkbenchPanel SectionKey="council" ActiveKey="@ActiveChatConfigurationSection" AriaLabel="AI Council configuration">
        <details id="localgpt-council-controls" class="council-command-center" data-testid="council-command-center" open>
            <summary title="Open model, hardware, team and artifact settings for AI Council runs.">
                <span>AI Council controls</span>
                <small>@CouncilEditorModelNames.Count model@(CouncilEditorModelNames.Count == 1 ? string.Empty : "s") · @CouncilEditorResourceLoadPercent% power · @CouncilEditorMaxContextTokens.ToString("N0") context</small>
            </summary>
        <div class="model-toolbar" aria-label="DXAiChat model and council controls" data-testid="chat-model-toolbar">
            <label class="ollama-mode-setting" title="Controls Ollama's num_gpu option for DXAiChat and AI Council. Auto GPU lets Ollama use your GPU; Safe CPU forces num_gpu=0; Limited GPU uses a partial GPU-layer cap.">
                <span>Ollama acceleration</span>
                <DxComboBox Data="@OllamaAccelerationOptions"
                            Value="@OllamaAccelerationMode"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnOllamaAccelerationModeChanged(new ChangeEventArgs { Value = value }))" />
            </label>
            @if (OllamaAccelerationMode == Catalog.OllamaModeLimitedGpu)
            {
                <BoundedNumberEditor Label="GPU layers"
                                     HelpText="Ollama num_gpu layer cap used by Limited GPU mode."
                                     Min="1" Max="99"
                                     Value="@LimitedGpuLayers"
                                     ValueChanged="OnLimitedGpuLayersChanged" />
            }
            <label class="inline-dx-check" title="When the AI Council session is selected, it can generate downloadable code, DLL, solution, or datapack artifacts for implementation requests.">
                <DxCheckBox @bind-Checked="GenerateCouncilArtifacts" />
                <span>Council downloadable artifacts</span>
            </label>
            <label class="inline-dx-check" title="Adds saved chat memory, logs, and local project guidance to AI Council prompts. Turn off for small frontend smoke tests or narrow reviews.">
                <DxCheckBox @bind-Checked="IncludeCouncilMemory" />
                <span>Council uses memory</span>
            </label>
            <BoundedNumberEditor Label="Council answer tokens"
                                 HelpText="Maximum answer tokens for the DXAiChat AI Council session."
                                 Min="256" Max="262144" Step="1024"
                                 Value="@CouncilEditorMaxOutputTokens"
                                 ValueChanged="OnCouncilMaxOutputTokensChangedAsync" />
            <BoundedNumberEditor Label="Council context tokens"
                                 HelpText="Maximum context window requested for Council and detected model sessions."
                                 Min="2048" Max="262144" Step="2048"
                                 Value="@CouncilEditorMaxContextTokens"
                                 ValueChanged="OnCouncilMaxContextTokensChangedAsync" />
            <BoundedNumberEditor Label="Peer review rounds"
                                 HelpText="Number of peer critique/refinement rounds after the initial proposal."
                                 Min="0" Max="3"
                                 Value="@CouncilCritiqueRounds"
                                 ValueChanged="OnCouncilCritiqueRoundsChanged" />
            <BoundedNumberEditor Label="Hardware load"
                                 HelpText="Sets the session position between every selected model's own minimum and maximum CPU/GPU road values. 30% means min + 30% of that model's configured range."
                                 Min="0" Max="100" Step="5" Suffix="%"
                                 Value="@CouncilEditorResourceLoadPercent"
                                 ValueChanged="OnCouncilResourceLoadChanged" />
            <label class="council-scheduling-setting" title="Choose the simple scheduling policy. Host-balanced keeps each AI host single-flight while allowing different machines to work in parallel. Hardware-road parallel additionally uses the configured CPU/GPU lanes within a host.">
                <span>Load balancing</span>
                <DxComboBox Data="@CouncilSchedulingOptions"
                            Value="@CouncilEditorSchedulingMode"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnCouncilSchedulingModeChanged(new ChangeEventArgs { Value = value }))" />
                <small>@CouncilSchedulingSummary</small>
            </label>
            <BoundedNumberEditor Label="Parallel models per AI host"
                                 HelpText="Global per-host request ceiling used by hardware-road parallel scheduling. Per-model lane concurrency below can further constrain individual roads."
                                 Min="1" Max="64"
                                 Value="@CouncilEditorMaxParallelModels"
                                 ValueChanged="OnCouncilMaxParallelModelsChangedAsync" />
            <BoundedNumberEditor Label="Model response timeout (seconds)"
                                 HelpText="Maximum provider time for one Council member attempt before LocalGPT records a timeout and may perform its one bounded recovery attempt."
                                 Min="30" Max="1800" Step="30"
                                 Value="@CouncilEditorModelTimeoutSeconds"
                                 ValueChanged="OnCouncilModelTimeoutChangedAsync" />
            @if (!string.IsNullOrWhiteSpace(modelStatus))
            {
                <span class="memory-status">@modelStatus</span>
            }
        </div>
        @if (OllamaCandidates.Count > 0 || UnavailableCouncilSelections.Count > 0)
        {
            <div class="council-picker" aria-label="DXAiChat council model picker">
                <div>
                    <strong>DXAiChat Council Members</strong>
                    <span class="memory-status">Select models from any configured provider. Provider-qualified identities prevent same-name collisions.</span>
                </div>
                @if (UnavailableCouncilSelections.Count > 0)
                {
                    <section class="council-unavailable-routes" role="alert" aria-live="polite" data-testid="council-unavailable-routes">
                        <header>
                            <div>
                                <strong>@L("Chat.Council.UnavailableRoutes.Title", "Unavailable selected Council routes")</strong>
                                <small>@L("Chat.Council.UnavailableRoutes.Help", "These exact provider/host/model routes remain selected but are not currently configured or discoverable. LocalGPT will not substitute a same-name model from another host.")</small>
                            </div>
                            <DxButton CssClass="btn btn-sm btn-outline-danger" Click="RemoveAllUnavailableCouncilSelections">@L("Chat.Council.UnavailableRoutes.RemoveAll", "Remove all unavailable")</DxButton>
                        </header>
                        <div class="council-unavailable-route-list">
                            @foreach (var selectionKey in UnavailableCouncilSelections)
                            {
                                <article class="council-unavailable-route" @key="selectionKey">
                                    <div>
                                        <strong>@L("Chat.Council.UnavailableRoutes.Unreachable", "Unavailable")</strong>
                                        <code>@selectionKey</code>
                                    </div>
                                    <DxButton CssClass="btn btn-sm btn-outline-danger" Click="() => RemoveUnavailableCouncilSelection(selectionKey)">@L("Common.Remove", "Remove")</DxButton>
                                </article>
                            }
                        </div>
                    </section>
                }
                <div class="council-provider-hosts" data-testid="council-provider-hosts">
                    @foreach (var host in CouncilProviderHosts)
                    {
                        <section class="council-provider-host" @key="host.Key">
                            <header>
                                <div>
                                    <strong>@host.ProviderName</strong>
                                    <small>@host.EndpointLabel · @host.Models.Count model@(host.Models.Count == 1 ? string.Empty : "s")</small>
                                </div>
                                <div class="council-host-actions">
                                    <DxButton CssClass="btn btn-sm btn-outline-secondary" Click="() => SetCouncilHostSelection(host, true)">Select host</DxButton>
                                    <DxButton CssClass="btn btn-sm btn-outline-secondary" Click="() => SetCouncilHostSelection(host, false)">Clear host</DxButton>
                                </div>
                            </header>
                            <div class="council-member-list provider-model-list">
                                @foreach (var candidate in host.Models)
                                {
                                    <ProviderModelPanel @key="candidate.SelectionKey" Model="candidate.ToReference()"
                                                        Selected="@SelectedCouncilModelNames.Contains(candidate.SelectionKey, StringComparer.OrdinalIgnoreCase)"
                                                        SelectedChanged="@(selected => ToggleCouncilModel(candidate.SelectionKey, selected))"
                                                        CouncilModels="SelectedCouncilProviderModels"
                                                        BenchmarkApplied="OnChatBenchmarkAppliedAsync"
                                                        PerformancePresetSaved="OnBenchmarkPerformancePresetSavedAsync"
                                                        BenchmarkStarted="OnBenchmarkStartedAsync" />
                                }
                            </div>
                        </section>
                    }
                </div>
                <ProviderModelBenchmarkCouncilPanel Models="SelectedCouncilProviderModels"
                                                    BenchmarkApplied="OnChatBenchmarkCouncilAppliedAsync"
                                                    PerformancePresetSaved="OnBenchmarkPerformancePresetSavedAsync"
                                                    BenchmarkStarted="OnBenchmarkStartedAsync" />
            </div>
        }
        <details class="council-road-details" data-testid="council-hardware-road-editor">
            <summary>Hardware spooler and per-model CPU/GPU roads</summary>
            @if (EditingRunningCouncilConfiguration)
            {
                <p class="memory-status live-council-settings-status">
                    Editing only running Council @ActiveCouncilRunShortId, revision @ActiveCouncilConfigurationRevision.
                    Each model reads the newest revision immediately before its next provider request starts. Other runs and saved presets remain unchanged.
                </p>
            }
            <div class="hardware-performance-preset-toolbar" aria-label="Hardware performance presets" data-testid="hardware-performance-presets">
                <label title="Apply benchmarked token ranges and hardware roads to matching selected provider/model identities without changing Council membership.">
                    <span>@L("Chat.HardwarePerformancePreset.Label", "Performance preset")</span>
                    <DxComboBox Data="@HardwarePerformancePresetOptions"
                                Value="@SelectedHardwarePerformancePresetValue"
                                ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                ValueChanged="@((string value) => OnHardwarePerformancePresetChangedAsync(new ChangeEventArgs { Value = value }))"
                                Enabled="@(!isHardwarePerformancePresetBusy)" />
                </label>
                <label title="Save the currently visible per-model roads and token ranges as a reusable hardware performance profile.">
                    <span>@L("Chat.HardwarePerformancePreset.Name", "Performance preset name")</span>
                    <DxTextBox @bind-Text="HardwarePerformancePresetName" CssClass="localgpt-editor" MaxLength="160" NullText="My benchmark profile" />
                </label>
                <div class="hardware-performance-preset-actions">
                    <DxButton CssClass="btn btn-outline-secondary" Enabled="@(!(isHardwarePerformancePresetBusy || CouncilEditorRoutes.Count == 0 || string.IsNullOrWhiteSpace(HardwarePerformancePresetName)))" Click="SaveHardwarePerformancePresetAsync">@L("Chat.HardwarePerformancePreset.Save", "Save current")</DxButton>
                    <DxButton CssClass="btn btn-outline-danger" Enabled="@(!(isHardwarePerformancePresetBusy || SelectedHardwarePerformancePreset is null))" Click="DeleteHardwarePerformancePresetAsync">@L("Chat.HardwarePerformancePreset.Delete", "Delete preset")</DxButton>
                    <DxButton CssClass="btn btn-outline-secondary" Enabled="@(!isHardwarePerformancePresetBusy)" Click="RefreshHardwarePerformancePresetsAsync">@L("Common.Refresh", "Refresh")</DxButton>
                </div>
                <small class="memory-status">@L("Chat.HardwarePerformancePreset.Help", "Benchmark runs add profiles here automatically. Selecting one applies only matching provider/endpoint/model roads; selected Council members stay unchanged.")</small>
            </div>
            <CouncilHardwareRoadEditor ModelNames="CouncilEditorModelNames"
                                       Routes="@CouncilEditorRoutes"
                                       ResourceLoadPercent="CouncilEditorResourceLoadPercent"
                                       Changed="OnHardwareRoadsChanged" />
        </details>
        <div class="model-toolbar council-preset-toolbar" aria-label="AI Council model presets" data-testid="council-model-presets">
            <label title="Load a database-backed preset for council model selection and runtime limits.">
                <span>Model preset</span>
                <DxComboBox Data="@ModelPresetOptions"
                            Value="@SelectedModelPresetValue"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnModelPresetChangedAsync(new ChangeEventArgs { Value = value }))" />
            </label>
            <label title="Saving updates an existing preset with the same name instead of creating duplicates.">
                <span>Preset name</span>
                <DxTextBox @bind-Text="ModelPresetName" CssClass="localgpt-editor" MaxLength="160" NullText="My council team" />
            </label>
            <label class="inline-dx-check" title="Creates a database-first project/revision for each explicit AI Council run when no project is selected.">
                <DxCheckBox @bind-Checked="CreateProjectPerCouncilRun" />
                <span>New project per council run</span>
            </label>
            <details class="component-actions-menu">
                <summary class="btn btn-outline-secondary">Preset actions</summary>
                <div class="component-actions-menu-items" role="menu">
                    <DxButton role="menuitem" Enabled="@(!(isModelPresetBusy || SelectedCouncilModelNames.Count == 0 || string.IsNullOrWhiteSpace(ModelPresetName)))"
                            Click="SaveModelPresetAsync">Save preset</DxButton>
                    <DxButton role="menuitem" Enabled="@(!(isModelPresetBusy || SelectedModelPreset is null))"
                            Click="ArchiveModelPresetAsync">Archive preset</DxButton>
                </div>
            </details>
        </div>
        <div class="memory-toolbar council-team-toolbar" aria-label="AI Council team and heartbeat configuration" data-testid="council-team-picker">
            <label title="Selects the database-backed roles, prompts and heartbeat workflow for the next AI Council run.">
                <span>Council team</span>
                <DxComboBox Data="@CouncilTeamOptions"
                            Value="@SelectedCouncilTeamKey"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnCouncilTeamChanged(new ChangeEventArgs { Value = value }))" />
            </label>
            <span class="memory-status">Roles, preparation prompts and heartbeat scripts are stored in SQLite and can be adjusted without replacing compiled services.</span>
            <a class="btn btn-outline-secondary btn-sm" href="/council-teams" data-enhance-nav="false">Edit teams and workflow</a>
        </div>
        @if (CouncilStarterSuggestions.Count > 0)
        {
            <section class="council-direct-starters" aria-label="Direct Council starter prompts">
                <header>
                    <strong>Direct Council starters</strong>
                    <small>These prompts switch to AI Council, start a fresh Council chat and submit the selected pre-prompt automatically.</small>
                </header>
                <div class="council-direct-starter-grid">
                    @foreach (var starter in CouncilStarterSuggestions)
                    {
                        <DxButton CssClass="council-direct-starter" Click="() => StartCouncilPromptAsync(starter, startFresh: true)">
                            <span class="council-direct-starter-content">
                                <strong>@starter.Title</strong>
                                <span>@starter.Text</span>
                            </span>
                        </DxButton>
                    }
                </div>
            </section>
        }
        </details>
                        </ConfigurationWorkbenchPanel>

                        <ConfigurationWorkbenchPanel SectionKey="memory" ActiveKey="@ActiveChatConfigurationSection" AriaLabel="Memory and project context">
        <details id="localgpt-memory-controls" class="chat-memory-project-center" open>
            <summary title="Open saved memory and project-version controls.">
                <span>Memory & project context</span>
                <small>@(SelectedChatProjectDetails?.Project.Name ?? "No project selected")</small>
            </summary>
        <div class="memory-toolbar" aria-label="Chat memory controls">
            <details class="component-actions-menu">
                <summary class="btn btn-outline-secondary">Memory actions</summary>
                <div class="component-actions-menu-items" role="menu">
                    <DxButton role="menuitem" Enabled="@(!isMemoryBusy)" Click="SaveCurrentConversationAsync">Save memory</DxButton>
                    <DxButton role="menuitem" Enabled="@(!(isMemoryBusy || SavedConversations.Count == 0))" Click="LoadLatestConversationAsync">Recall latest</DxButton>
                    <DxButton role="menuitem" Enabled="@(!(isMemoryBusy || SelectedConversation is null))" Click="LoadSelectedConversationAsync">Recall selected chat</DxButton>
                </div>
            </details>
            <label class="memory-all-conversations" title="Pick any saved chat from the SQLite memory database and continue it in the chat window.">
                <span>All saved chats</span>
                <DxComboBox Data="@SavedConversationOptions"
                            Value="@(SelectedConversation?.Id.ToString() ?? string.Empty)"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnSavedConversationSelectionChangedAsync(new ChangeEventArgs { Value = value }))"
                            CssClass="memory-selector"
                            NullText="No saved chats"
                            Enabled="@(!isMemoryBusy && SavedConversations.Count > 0)" />
            </label>
            @if (!string.IsNullOrWhiteSpace(memoryStatus))
            {
                <span class="memory-status">@memoryStatus</span>
            }
        </div>
        <div class="memory-toolbar" aria-label="Chat project and release context" data-testid="chat-project-context">
            <label title="Optionally links this chat and its function calls to a LocalGPT project.">
                <span>Project</span>
                <DxComboBox Data="@ChatProjectOptions"
                            Value="@SelectedChatProjectValue"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnChatProjectChangedAsync(new ChangeEventArgs { Value = value }))" />
            </label>
            <label title="Links the chat to an exact saved project version for traceability.">
                <span>Project version</span>
                <DxComboBox Data="@ChatProjectVersionOptions"
                            Value="@SelectedChatProjectVersionValue"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnChatProjectVersionChangedAsync(new ChangeEventArgs { Value = value }))"
                            Enabled="@(SelectedChatProjectDetails is not null)" />
            </label>
            <span class="memory-status">LocalGPT @SessionContext.ApplicationVersion</span>
        </div>
        </details>
        @if (RecentThoughts.Count > 0)
        {
            <div class="memory-thoughts" data-localgpt-details-host>
                <div class="memory-thoughts-title">Former model thoughts</div>
                @foreach (var thought in RecentThoughts.Take(3))
                {
                    <details open data-localgpt-panel-key="@($"former-thought-{thought.ConversationId:N}")">
                        <summary>@thought.ConversationTitle</summary>
                        <div class="former-thought-content" data-localgpt-copyable="true">@CouncilText.NormalizeFormerThought(thought.Thinking, Logger)</div>
                    </details>
                }
            </div>
        }
                        </ConfigurationWorkbenchPanel>

                        <ConfigurationWorkbenchPanel SectionKey="architecture" ActiveKey="@ActiveChatConfigurationSection" AriaLabel="Architecture choices">
        <details id="architecture-options" class="architecture-poll" open>
            <summary>
                <span>Optional architecture choices</span>
                <small>Open only when you want to decide now. Otherwise the AI should ask with a runtime poll before coding.</small>
            </summary>
            <div class="architecture-poll-grid">
                <label title="Choose the target language and toolchain. The options are database-provisioned and do not force .NET when the repository or request uses another ecosystem.">
                    <span>Language / toolchain</span>
                    <DxComboBox Data="@Catalog.ArchitectureLanguageToolchainOptions" @bind-Value="ArchitectureLanguageToolchain" />
                </label>
                <label title="Choose whether generated UI should use DevExpress components, plain web/native UI, another target-specific stack, or ask at runtime.">
                    <span>UI stack</span>
                    <DxComboBox Data="@Catalog.ArchitectureUiStackOptions" @bind-Value="ArchitectureUiStack" />
                </label>
                <label title="Choose whether the generated work should be one solution, split into backend/frontend projects, or ask at runtime.">
                    <span>Solution shape</span>
                    <DxComboBox Data="@Catalog.ArchitectureSolutionShapeOptions" @bind-Value="ArchitectureSolutionShape" />
                </label>
                <label title="Choose the hosting/runtime model. This is not limited to Blazor; use Ask when the app target is unclear.">
                    <span>Runtime/rendering</span>
                    <DxComboBox Data="@Catalog.ArchitectureRenderModeOptions" @bind-Value="ArchitectureRenderMode" />
                </label>
                <label title="Choose how closely generated UI should recreate the reference application, or ask at runtime.">
                    <span>Reference look</span>
                    <DxComboBox Data="@Catalog.ArchitectureReferenceLookOptions" @bind-Value="ArchitectureReferenceLook" />
                </label>
            </div>
            <div class="architecture-poll-actions">
                <label class="architecture-consent" title="When checked, the council may choose remaining non-dangerous sandbox defaults if your prompt already describes the intended design well enough. It still may not integrate features into LocalGPT without explicit approval.">
                    <DxCheckBox @bind-Checked="AllowCouncilToChooseSandboxDetails" />
                    <span>Let council choose safe sandbox details when my design intent is clear</span>
                </label>
                <label title="Optional detail for the next council answer, for example an app to recode or special backend constraints.">
                    <span>Extra direction</span>
                    <DxTextBox @bind-Text="ArchitecturePollNotes" NullText="Example: ask me first if target platform, framework, data model, or deployment are unclear." />
                </label>
                <DxButton CssClass="localgpt-rounded-action localgpt-action-primary" Text="Add Decision To Chat"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="AddArchitecturePollToChatAsync" />
                <DxButton CssClass="localgpt-rounded-action localgpt-action-neutral" Text="Reset"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Click="ResetArchitecturePoll" />
            </div>
            @if (!string.IsNullOrWhiteSpace(ArchitecturePollStatus))
            {
                <p class="memory-status">@ArchitecturePollStatus</p>
            }
        </details>
                        </ConfigurationWorkbenchPanel>
                    </div>
                </div>
            </div>
        </details>
        @if (showGameConsole)
        {
            <DxPopup @key="gameConsoleRenderKey"
                     Visible="true"
                     VisibleChanged="OnGameConsoleVisibilityChangedAsync"
                     HeaderText="LocalGPT ASCII console"
                     Width="min(1680px, 97vw)"
                     Height="min(900px, 90vh)"
                     MaxHeight="95vh"
                     CloseOnOutsideClick="false">
                <BodyContentTemplate>
                    <div class="chat-game-popup-body" aria-label="Optional ASCII game console">
                        <ChatGameConsole ConversationId="@ActiveConversationId"
                                         CouncilRunId="@(AttachedLiveCouncilRunId ?? RejoinCouncilRunId ?? SelectedCouncilRunId)"
                                         SuggestedTeamKey="@SelectedCouncilTeamKey"
                                         ConversationMessages="@AsciiConversationMessages"
                                         CouncilParticipantActivities="@AsciiCouncilParticipantActivities"
                                         AssistantDisplayName="@AsciiAssistantDisplayName"
                                         FunModeEnabled="@AsciiFunModeEnabled"
                                         SavedConversations="@SavedConversations"
                                         ChatPromptRequested="SubmitOperatorChatPromptAsync"
                                         CouncilPromptRequested="SubmitOperatorCouncilPromptAsync"
                                         NewSessionRequested="ClearHistoryAsync"
                                         SessionOpenRequested="OpenOperatorSavedConversationAsync"
                                         CouncilStopRequested="StopSelectedCouncilSessionAsync"
                                         CouncilSkipRequested="SkipCurrentCouncilRoundAsync"
                                         GameAvailabilityChanged="OnAsciiGameAvailabilityChangedAsync"
                                         CloseRequested="CloseGameConsole" />
                    </div>
                </BodyContentTemplate>
            </DxPopup>
        }
        @if (RunningLiveCouncilSessions.Count > 0 && ActiveLiveCouncilSession is null)
        {
            var newestLiveSession = RunningLiveCouncilSessions[0];
            <div class="chat-live-session-inline-info" aria-live="off">
                <span><strong>Live Council @ShortCouncilRunId(newestLiveSession.RunId)</strong> is running and can be joined without stopping it.</span>
                <DxButton CssClass="localgpt-rounded-action localgpt-action-primary" Text="Join live transcript"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="@(() => JoinCouncilSessionAsync(newestLiveSession.RunId))" />
            </div>
        }
        <div id="localgpt-chat-host" data-testid="dxaichat-host">
            <DxAIChat Initialized="ChatInitialized"
                      MaxTokens="int.MaxValue"
                      ResponseContentFormat="ResponseContentFormat.Markdown"
                      UseStreaming="true"
                      FileUploadEnabled="true"
                      @ref="DxAiChat"
                      CssClass="demo-chat"
                      IncludeFunctionCallInfo="true">
                <PromptSuggestions>
                    @foreach (var suggestion in PromptSuggestions)
                    {
                        <DxAIChatPromptSuggestion Title="@suggestion.Title"
                                                  Text="@suggestion.Text"
                                                  PromptMessage="@suggestion.PromptMessage" />
                    }
                </PromptSuggestions>
                <MessageContentTemplate Context="messageContext">
                    @{
                        var liveCouncilMessage = ResolveLiveCouncilMessage(messageContext.Content);
                    }
                    <div class="demo-chat-content" data-localgpt-details-host data-localgpt-copyable="true">
                        @(new MarkupString(ChatContentRenderer.Render(
                            liveCouncilMessage is not null
                                ? LiveCouncilTranscript(liveCouncilMessage.RunId, messageContext.Content)
                                : messageContext.Content)))
                        @if (liveCouncilMessage is not null)
                        {
                            var participantActivities = LiveCouncilParticipantActivities(liveCouncilMessage.RunId);
                            @if (participantActivities.Count > 0)
                            {
                                <section class="localgpt-live-participant-board" aria-label="Live parallel Council activity">
                                    <header>
                                        <strong>Live Council lanes</strong>
                                        <small>Each AI host/model updates independently; the final transcript remains ordered.</small>
                                    </header>
                                    @foreach (var activity in participantActivities)
                                    {
                                        <details class="localgpt-live-participant-card" open="@activity.IsRunning" @key="activity.ActivityKey">
                                            <summary>
                                                <span class="localgpt-live-participant-state @(activity.IsRunning ? "is-running" : "is-complete")" aria-hidden="true"></span>
                                                <span>
                                                    <strong>@activity.ModelName</strong>
                                                    <small>@activity.Phase · @activity.Role · @activity.RouteLabel</small>
                                                </span>
                                                <em>@activity.StatusMessage</em>
                                                @if (!activity.IsRunning && !string.IsNullOrWhiteSpace(activity.FinalContent))
                                                {
                                                    <span class="localgpt-live-result-ready">Result ready · expand</span>
                                                }
                                            </summary>
                                            @if (activity.IsRunning)
                                            {
                                                @if (!string.IsNullOrWhiteSpace(activity.Content))
                                                {
                                                    <details class="localgpt-live-participant-stream-history" open>
                                                        <summary>Live thinking, functions and provider stream</summary>
                                                        <div class="localgpt-live-participant-content" data-localgpt-details-host>
                                                            @(new MarkupString(ChatContentRenderer.Render(activity.Content)))
                                                        </div>
                                                    </details>
                                                }
                                                else
                                                {
                                                    <p class="localgpt-live-participant-waiting">Waiting for streamed model output…</p>
                                                }
                                            }
                                            else if (!revealedCompletedCouncilActivityEvidence.Contains(activity.ActivityKey))
                                            {
                                                <DxButton
                                                        CssClass="localgpt-live-participant-evidence-button"
                                                        Click="@(() => revealedCompletedCouncilActivityEvidence.Add(activity.ActivityKey))">
                                                    Inspect completed answer and provider evidence
                                                </DxButton>
                                            }
                                            else
                                            {
                                                @if (!string.IsNullOrWhiteSpace(activity.FinalContent))
                                                {
                                                    <section class="localgpt-live-participant-final" aria-label="Completed Council member answer">
                                                        <strong>Completed answer</strong>
                                                        <div data-localgpt-details-host>
                                                            @(new MarkupString(ChatContentRenderer.Render(activity.FinalContent)))
                                                        </div>
                                                    </section>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(activity.Content))
                                                {
                                                    <details class="localgpt-live-participant-stream-history" open>
                                                        <summary>Thinking, functions and provider stream</summary>
                                                        <div class="localgpt-live-participant-content" data-localgpt-details-host>
                                                            @(new MarkupString(ChatContentRenderer.Render(activity.Content)))
                                                        </div>
                                                    </details>
                                                }
                                            }
                                        </details>
                                    }
                                </section>
                            }
                            <div class="localgpt-message-utility-row localgpt-live-update-footer">
                                <span class="localgpt-rejoined-live-status" role="status" aria-live="polite">
                                    @if (liveCouncilMessage.IsRunning)
                                    {
                                        <span class="localgpt-rejoined-live-spinner" aria-hidden="true"></span>
                                        <span>
                                            <strong>@LiveCouncilRunningTitle(liveCouncilMessage)</strong><br />
                                            <small>@LiveCouncilRunningDetail(liveCouncilMessage)</small>
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            <strong>Council @ShortCouncilRunId(liveCouncilMessage.RunId) is no longer running.</strong><br />
                                            <small>Completed model lanes and their final answers are preserved above for post-run inspection.</small>
                                        </span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </MessageContentTemplate>
                <AIChatSettings>
                    <DxAIChatFileUploadSettings
                        MaxFileCount="@Catalog.MaxUploadFiles"
                        MaxFileSize="@Catalog.MaxUploadBytes" />
                </AIChatSettings>

            </DxAIChat>
        </div>
        @if (InlineChatRequests.Count > 0)
        {
            <section class="chat-inline-ai-requests" aria-label="AI requests awaiting your review" data-testid="chat-inline-ai-requests">
                <header>
                    <div>
                        <strong>AI requests for this session</strong>
                        <small>Review function approvals and AI-seeded choices directly where the Council is working.</small>
                    </div>
                    <span>@InlineChatRequests.Count waiting</span>
                </header>
                @foreach (var request in InlineChatRequests)
                {
                    <article class="chat-inline-ai-request" @key="request.Id">
                        <div class="chat-inline-ai-request-heading">
                            <div>
                                <strong>@request.Title</strong>
                                <small>@request.RequestedRole · @request.RequestedBy · @request.OperationKey</small>
                            </div>
                            <span class="chat-inline-ai-request-risk">@request.RiskLevel</span>
                        </div>
                        <p>@(string.IsNullOrWhiteSpace(request.ResponsePrompt) ? request.Description : request.ResponsePrompt)</p>
                        @if (IsInlineApprovalRequest(request))
                        {
                            <div class="chat-inline-ai-request-actions">
                                <DxButton Text="Approve" RenderStyle="ButtonRenderStyle.Success" Enabled="@(!inlineRequestSubmissions.Contains(request.Id))" Click="@(() => ResolveInlineChatRequestAsync(request, true, GetInlineRequestText(request)))" />
                                <DxButton Text="Decline" RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Outline" Enabled="@(!inlineRequestSubmissions.Contains(request.Id))" Click="@(() => ResolveInlineChatRequestAsync(request, false, GetInlineRequestText(request)))" />
                            </div>
                        }
                        @if (request.SuggestedResponses.Count > 0)
                        {
                            <div class="chat-inline-ai-request-suggestions" aria-label="Suggested responses">
                                @foreach (var suggestion in request.SuggestedResponses)
                                {
                                    <DxButton Text="@suggestion" RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Outline" Enabled="@(!inlineRequestSubmissions.Contains(request.Id))" Click="@(() => ResolveInlineChatRequestAsync(request, null, suggestion))" />
                                }
                            </div>
                        }
                        @if (request.AllowFreeText || !IsInlineApprovalRequest(request))
                        {
                            <div class="chat-inline-ai-request-response">
                                <DxTextBox Text="@GetInlineRequestText(request)"
                                           TextChanged="@((string value) => SetInlineRequestText(request.Id, value))"
                                           BindValueMode="BindValueMode.OnInput"
                                           MaxLength="2000"
                                           NullText="Answer, add a review note, or explain a decline…"
                                           Enabled="@(!inlineRequestSubmissions.Contains(request.Id))" />
                                @if (!IsInlineApprovalRequest(request))
                                {
                                    <DxButton Text="Send" RenderStyle="ButtonRenderStyle.Primary" Enabled="@(!inlineRequestSubmissions.Contains(request.Id) && !string.IsNullOrWhiteSpace(GetInlineRequestText(request)))" Click="@(() => ResolveInlineChatRequestAsync(request, null, GetInlineRequestText(request)))" />
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }
        @* Quick selectors stay outside the DevExpress chat host. One normal-flow DevExpress form row
           sits directly below Chat and above Running session tools; no composer geometry is changed. *@
        <div class="w-100" data-testid="chat-quick-configuration-bar" aria-label="Quick Council configuration">
            <DxFormLayout>
                <DxFormLayoutItem Caption="Team" ColSpanMd="4">
                    <DxComboBox Data="@CouncilTeams"
                                Value="@SelectedQuickCouncilTeam"
                                TextFieldName="@nameof(OrganicCouncilTeamDefinition.DisplayName)"
                                ValueChanged="@((OrganicCouncilTeamDefinition team) => OnQuickCouncilTeamChangedAsync(team))"
                                NullText="Council team" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Models" ColSpanMd="4">
                    <DxComboBox Data="@ModelPresets"
                                Value="@SelectedQuickModelPreset"
                                TextFieldName="@nameof(CouncilModelPreset.Name)"
                                ValueChanged="@((CouncilModelPreset preset) => OnQuickModelPresetChangedAsync(preset))"
                                NullText="Model preset" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Performance" ColSpanMd="4">
                    <DxComboBox Data="@HardwarePerformancePresetItems"
                                Value="@SelectedQuickHardwarePerformancePreset"
                                TextFieldName="@nameof(HardwarePerformancePreset.Name)"
                                ValueChanged="@((HardwarePerformancePreset preset) => OnQuickHardwarePerformancePresetChangedAsync(preset))"
                                NullText="Performance preset" />
                </DxFormLayoutItem>
            </DxFormLayout>
            @if (string.Equals(SelectedCouncilTeamKey, "ascii-hot-seat-showcase", StringComparison.OrdinalIgnoreCase))
            {
                <div class="chat-game-latency-hint" role="status">
                    <span><strong>ASCII hot-seat:</strong> two distinct AI runtime roles are used. Smaller responsive models make each turn noticeably faster; the selected hardware performance profile still controls matching provider/model roads.</span>
                    <DxButton CssClass="btn btn-sm btn-outline-success" Click="ApplyReactiveAsciiGameplayPresetAsync">Use Reactive ASCII Gameplay preset</DxButton>
                </div>
            }
        </div>
        <details class="chat-session-tools-ribbon" data-testid="chat-session-tools-ribbon">
            <summary>
                <span>Running session tools</span>
                <small>@(ActiveCouncilRun is not null
                    ? $"Round {ActiveCouncilRun.CurrentRound} · {ActiveCouncilRun.Phase}"
                    : ActiveLiveCouncilSession is not null
                        ? $"Live run {ShortCouncilRunId(ActiveLiveCouncilSession.RunId)}"
                        : RunningLiveCouncilSessions.Count > 0
                            ? $"{RunningLiveCouncilSessions.Count} live Council run(s) available to rejoin"
                            : "No Council heartbeat is running")</small>
            </summary>
            <div class="chat-session-tools-content">
        <div class="memory-toolbar human-live-contribution" aria-label="Join and add information to a running AI Council" data-testid="live-council-participation">
            <label class="live-session-selector" title="Join any council heartbeat that is still running in this LocalGPT process.">
                <span>Running Council session</span>
                <DxComboBox Data="@RunningCouncilSessionOptions"
                            Value="@SelectedCouncilRunValue"
                            ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                            TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                            ValueChanged="@((string value) => OnActiveCouncilRunChanged(new ChangeEventArgs { Value = value }))"
                            CssClass="localgpt-dx-combo"
                            NullText="No Council heartbeat is running"
                            Enabled="@(RunningLiveCouncilSessions.Count > 0)" />
            </label>
            <details class="component-actions-menu live-session-actions-menu">
                <summary class="btn btn-outline-secondary">Session actions</summary>
                <div class="component-actions-menu-items" role="menu">
                    <DxButton role="menuitem" Click="RefreshHumanCollaborationAsync">Refresh running sessions</DxButton>
                    @if (ActiveCouncilRun is not null)
                    {
                        <DxButton role="menuitem" Click="SkipCurrentCouncilRoundAsync">Skip current round</DxButton>
                    }
                    @if (!collaborationSnapshot.Profile.IsEnabled)
                    {
                        <DxButton role="menuitem" Click="EnableHumanParticipationAsync">Enable human participation</DxButton>
                    }
                </div>
            </details>
            @if (CanJoinSelectedCouncilRun)
            {
                <DxButton CssClass="localgpt-rounded-action localgpt-action-primary" Text="Join selected transcript"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="RejoinSelectedCouncilSessionAsync" />
            }
            @if (IsLiveCouncilInteractionAvailable)
            {
                <DxButton CssClass="localgpt-rounded-action localgpt-action-danger" Text="Stop active Council"
                          RenderStyle="ButtonRenderStyle.Danger"
                          RenderStyleMode="ButtonRenderStyleMode.Outline"
                          Click="StopSelectedCouncilSessionAsync" />
            }
            @if (collaborationSnapshot.Profile.IsEnabled)
            {
                <span class="badge text-bg-success">Human Council member enabled</span>
            }
            <label class="live-contribution-editor" title="This does not cancel the current model. It enters at the next council heartbeat as a human peer contribution.">
                <span>Ask AI Assistant / Council correction</span>
                <DxTextBox @bind-Text="RunningCouncilContribution" CssClass="localgpt-editor" Enabled="@(!(!IsLiveCouncilInteractionAvailable))" NullText="Add a correction or new information. Without a member/topic target it is shared with all Council members at the next heartbeat." />
            </label>
            @if (collaborationSnapshot.Profile.IsEnabled && IsLiveCouncilInteractionAvailable && !string.IsNullOrWhiteSpace(RunningCouncilContribution))
            {
                <DxButton CssClass="localgpt-rounded-action localgpt-action-primary" Text="Share without stopping generation"
                          RenderStyle="ButtonRenderStyle.Primary"
                          RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="QueueRunningCouncilContributionAsync" />
            }
            @if (ActiveCouncilRun is not null)
            {
                <span class="memory-status">Joined run @ActiveCouncilRunShortId · round @ActiveCouncilRun.CurrentRound · @ActiveCouncilRun.Phase</span>
            }
            else if (ActiveLiveCouncilSession is not null)
            {
                <span class="memory-status">Joined live run @ActiveCouncilRunShortId. Stop and direct-message controls remain connected to the running Council.</span>
            }
            else
            {
                <span class="memory-status">Select a running Council and join its transcript without interrupting it.</span>
            }
        </div>
        @if (FeedbackTargets.Count > 0)
        {
            <div class="memory-toolbar" aria-label="Assistant response feedback" data-testid="chat-feedback-controls">
                <label title="Choose the assistant response you want to rate.">
                    <span>Response</span>
                    <DxComboBox Data="@FeedbackTargetOptions"
                                Value="@SelectedFeedbackSortOrderValue"
                                ValueFieldName="@nameof(LocalGptSelectionOption<string>.Value)"
                                TextFieldName="@nameof(LocalGptSelectionOption<string>.Label)"
                                ValueChanged="@((string value) => OnFeedbackTargetChanged(new ChangeEventArgs { Value = value }))" />
                </label>
                <label title="Optional local note stored with the selected assistant message.">
                    <span>Comment</span>
                    <DxTextBox @bind-Text="FeedbackComment" MaxLength="4000" NullText="What was useful or wrong?" />
                </label>
                <div class="chat-feedback-actions">
                    <DxButton CssClass="localgpt-rounded-action localgpt-action-success" Text="Helpful"
                              RenderStyle="ButtonRenderStyle.Success"
                              RenderStyleMode="ButtonRenderStyleMode.Contained"
                              Click="@(() => RecordSelectedFeedbackAsync(true))" />
                    <DxButton CssClass="localgpt-rounded-action localgpt-action-danger" Text="Not helpful"
                              RenderStyle="ButtonRenderStyle.Danger"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Click="@(() => RecordSelectedFeedbackAsync(false))" />
                    <DxButton CssClass="localgpt-rounded-action localgpt-action-neutral" Text="Clear rating"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                              Click="ClearSelectedFeedbackAsync" />
                    @if (!string.IsNullOrWhiteSpace(feedbackStatus))
                    {
                        <span class="memory-status">@feedbackStatus</span>
                    }
                </div>
            </div>
        }
            </div>
        </details>
    }
    else
    {
        <div class="title-header-text">No ChatClient Initialized</div>
        <div class="title-content-text">@L("Home.LocalChat.SetupHelp", "Welcome to your Local Chat, go to the Setup Page to Setup the AI Chat Clients")</div>
    }
</div>
