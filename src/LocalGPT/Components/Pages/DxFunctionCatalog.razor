@rendermode InteractiveServer
@page "/dx-functions"
@inject IDxAiFunctionCatalogService Catalog
@inject ILocalGptVocabularyService Vocabulary
@inject ILogger<DxFunctionCatalog> Logger
@inject IComponentActivityService ComponentActivity
@inject INotificationService Notifier
@inject CouncilTextService CouncilText

<PageTitle>DX Functions &amp; 1-Wire</PageTitle>

<main class="dx-catalog-page localgpt-surface">
    <header class="dx-catalog-header">
        <div>
            <h1>DX Functions &amp; 1-Wire exposure</h1>
            <p>The person using this offline frontend decides what AI chat and linked applications may see and invoke. Consequential calls return here for confirmation or requested input before execution.</p>
        </div>
        <div class="dx-catalog-actions">
            <button type="button" class="btn btn-secondary" @onclick="ReloadAsync" disabled="@_busy">Reload</button>
            <button type="button" class="btn btn-primary" @onclick="SynchronizeAsync" disabled="@_busy">Synchronize runtime catalog</button>
            <button type="button" class="btn btn-outline-primary" @onclick="CreateUserFunction" disabled="@_busy">New user DXFunction</button>
            @if (_viewMode == "Grid")
            {
                <button type="button" class="btn btn-outline-primary" @onclick="SaveVisibleAsync" disabled="@_busy">Save visible/edited grid policies</button>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert @(_hasError ? "alert-danger" : "alert-info")" role="status">@_status</div>
    }

    @if (_showUserEditor)
    {
        <UserDxFunctionEditor FunctionName="@_userEditorFunctionName" Changed="HandleUserFunctionsChangedAsync" Closed="CloseUserEditorAsync" />
    }

    <section class="dx-catalog-toolbar">
        <label>
            <span>Search</span>
            <input class="form-control" placeholder="Function, service, route or purpose" @bind="_filter" @bind:event="oninput" />
        </label>
        <label>
            <span>Kind</span>
            <select class="form-select" @bind="_kindFilter">
                <option value="">All</option>
                <option value="@Vocabulary.Get().CatalogDxFunction">DX functions</option>
                <option value="@Vocabulary.Get().CatalogPublicServiceMethod">Public service methods</option>
            </select>
        </label>
        <label class="form-check dx-inline-check">
            <input class="form-check-input" type="checkbox" @bind="_onlyExposed" />
            <span>Only exposed to 1-Wire</span>
        </label>
        <label>
            <span>View</span>
            <select class="form-select" @bind="_viewMode">
                <option value="Cards">Cards</option>
                <option value="Grid">Mass-edit DXGrid</option>
            </select>
        </label>
        <label class="form-check dx-inline-check">
            <input class="form-check-input" type="checkbox" @bind="_groupCardsByNamespace" disabled="@(_viewMode != "Cards")" />
            <span>Group cards by namespace</span>
        </label>
    </section>

    @if (_viewMode == "Grid")
    {
        <section class="dx-catalog-mass-grid" aria-busy="@_busy">
            <DxGrid Data="@FilteredEntriesList"
                    KeyFieldName="@nameof(DxAiFunctionCatalogEntry.CatalogKey)"
                    PageSize="25"
                    ShowFilterRow="true"
                    HighlightRowOnHover="true"
                    CssClass="dx-function-grid">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(DxAiFunctionCatalogEntry.DisplayName)" Caption="Function" MinWidth="220" />
                    <DxGridDataColumn FieldName="@nameof(DxAiFunctionCatalogEntry.FunctionName)" Caption="Runtime name" MinWidth="220" />
                    <DxGridDataColumn FieldName="@nameof(DxAiFunctionCatalogEntry.Kind)" Caption="Kind" Width="150px" />
                    <DxGridDataColumn FieldName="@nameof(DxAiFunctionCatalogEntry.Purpose)" Caption="Purpose" MinWidth="300" />
                    <DxGridDataColumn Caption="Enabled" Width="95px">
                        <CellDisplayTemplate Context="cell">
                            @{ var entry = (DxAiFunctionCatalogEntry)cell.DataItem; }
                            <input class="form-check-input" type="checkbox" @bind="entry.IsEnabled" @bind:after="() => MarkGridEntryDirty(entry)" @onclick:stopPropagation="true" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="AI chat" Width="95px">
                        <CellDisplayTemplate Context="cell">
                            @{ var entry = (DxAiFunctionCatalogEntry)cell.DataItem; }
                            <input class="form-check-input" type="checkbox" @bind="entry.ExposeToAiChat" @bind:after="() => MarkGridEntryDirty(entry)" @onclick:stopPropagation="true" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="1-Wire" Width="95px">
                        <CellDisplayTemplate Context="cell">
                            @{ var entry = (DxAiFunctionCatalogEntry)cell.DataItem; }
                            <input class="form-check-input" type="checkbox" @bind="entry.ExposeToOneWire" @bind:after="() => MarkGridEntryDirty(entry)" @onclick:stopPropagation="true" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Remote" Width="95px">
                        <CellDisplayTemplate Context="cell">
                            @{ var entry = (DxAiFunctionCatalogEntry)cell.DataItem; }
                            <input class="form-check-input" type="checkbox" @bind="entry.AllowRemoteInvocation" @bind:after="() => MarkGridEntryDirty(entry)" @onclick:stopPropagation="true" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Frontend" Width="105px">
                        <CellDisplayTemplate Context="cell">
                            @{ var entry = (DxAiFunctionCatalogEntry)cell.DataItem; }
                            <input class="form-check-input" type="checkbox" @bind="entry.RequiresFrontendConfirmation" @bind:after="() => MarkGridEntryDirty(entry)" @onclick:stopPropagation="true" />
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="Action" Width="105px">
                        <CellDisplayTemplate Context="cell">
                            @{ var entry = (DxAiFunctionCatalogEntry)cell.DataItem; }
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SaveAsync(entry)" @onclick:stopPropagation="true" disabled="@_busy">Save</button>
                            @if (entry.Source == "UserDxFunction")
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => EditUserFunction(entry.FunctionName)" @onclick:stopPropagation="true" disabled="@_busy">Edit</button>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGrid>
        </section>
    }
    else
    {
        @foreach (var group in CardGroups)
        {
            <section class="dx-catalog-namespace-group">
                @if (_groupCardsByNamespace)
                {
                    <h2>@group.Key</h2>
                }
                <div class="dx-catalog-grid" aria-busy="@_busy">
                    @foreach (var entry in group)
                    {
                        <article class="dx-catalog-card @(entry.ExposeToOneWire ? "is-exposed" : string.Empty)">
                            <header>
                                <div>
                                    <strong>@entry.DisplayName</strong>
                                    <small>@entry.Kind · @entry.FunctionName</small>
                                </div>
                                <span class="badge @(entry.IsAvailable ? "text-bg-success" : "text-bg-secondary")">@(entry.IsAvailable ? "available" : "missing")</span>
                            </header>
                            <p>@entry.Purpose</p>
                            <details>
                                <summary>Runtime contract</summary>
                                <dl>
                                    <dt>Namespace</dt><dd>@FunctionNamespace(entry)</dd>
                                    <dt>Route</dt><dd>@entry.Method @entry.Route</dd>
                                    <dt>Source</dt><dd>@entry.Source</dd>
                                    <dt>Catalog key</dt><dd><code>@entry.CatalogKey</code></dd>
                                    <dt>Parameters</dt><dd><pre>@entry.ParameterSchemaJson</pre></dd>
                                </dl>
                            </details>
                            <div class="dx-policy-grid">
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="entry.IsEnabled" /><span>Enabled</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="entry.ExposeToAiChat" /><span>Reveal to AI chat</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="entry.ExposeToOneWire" /><span>Reveal to linked app</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="entry.AllowRemoteInvocation" /><span>Allow linked invocation</span></label>
                                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="entry.RequiresFrontendConfirmation" /><span>Require this frontend</span></label>
                                <label>
                                    <span>Frontend editor</span>
                                    <select class="form-select" @bind="entry.InteractionEditor">
                                        @foreach (var editor in Enum.GetValues<OneWireInteractionEditor>())
                                        {
                                            <option value="@editor">@editor</option>
                                        }
                                    </select>
                                </label>
                                <label class="wide">
                                    <span>Allowed peer IDs JSON (empty array = any explicitly connected peer)</span>
                                    <input class="form-control" @bind="entry.AllowedPeerIdsJson" />
                                </label>
                            </div>
                            <footer>
                                <span>@(entry.RequiresFrontendConfirmation ? "Receiving frontend is authoritative" : "May run under saved user policy")</span>
                                <div class="d-flex gap-2">
                                    @if (entry.Source == "UserDxFunction")
                                    {
                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => EditUserFunction(entry.FunctionName)" disabled="@_busy">Edit function</button>
                                    }
                                    <button type="button" class="btn btn-outline-primary" @onclick="() => SaveAsync(entry)" disabled="@_busy">Save policy</button>
                                </div>
                            </footer>
                        </article>
                    }
                </div>
            </section>
        }
    }
</main>

@code {
    /// <summary>
    /// Stores the in-memory entries collection maintained internally by <see cref="DxFunctionCatalog"/> for its current workflow state.
    /// </summary>
    private List<DxAiFunctionCatalogEntry> _entries = [];
    /// <summary>
    /// Stores the in-memory dirty grid catalog keys collection maintained internally by <see cref="DxFunctionCatalog"/> for its current workflow state.
    /// </summary>
    private readonly HashSet<string> _dirtyGridCatalogKeys = new(StringComparer.OrdinalIgnoreCase);
    /// <summary>
    /// Stores the internal filter state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private string _filter = string.Empty;
    /// <summary>
    /// Stores the internal kind filter state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private string _kindFilter = string.Empty;
    /// <summary>
    /// Stores the internal status state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private string _status = string.Empty;
    /// <summary>
    /// Stores the internal only exposed state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private bool _onlyExposed;
    /// <summary>
    /// Stores the internal group cards by namespace state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private bool _groupCardsByNamespace = true;
    /// <summary>
    /// Stores the internal view mode state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private string _viewMode = "Cards";
    /// <summary>
    /// Stores the internal busy state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private bool _busy;
    /// <summary>
    /// Stores the internal has error state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private bool _hasError;
    /// <summary>
    /// Stores the internal show user editor state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private bool _showUserEditor;
    /// <summary>
    /// Stores the internal user editor function name state used by <see cref="DxFunctionCatalog"/> while executing its surrounding workflow.
    /// </summary>
    private string _userEditorFunctionName = string.Empty;

    /// <summary>
    /// Gets the filtered entries collection maintained or exposed by this DevExpress function instance for downstream processing.
    /// </summary>
    /// <value>The filtered entries value exposed by <see cref="DxFunctionCatalog"/>.</value>
    private IEnumerable<DxAiFunctionCatalogEntry> FilteredEntries => _entries
        .Where(entry => string.IsNullOrWhiteSpace(_kindFilter) || entry.Kind == _kindFilter)
        .Where(entry => !_onlyExposed || entry.ExposeToOneWire)
        .Where(entry => string.IsNullOrWhiteSpace(_filter) ||
            CouncilText.ContainsText(entry.DisplayName, _filter) ||
            CouncilText.ContainsText(entry.FunctionName, _filter) ||
            CouncilText.ContainsText(entry.Purpose, _filter) ||
            CouncilText.ContainsText(entry.Route, _filter))
        .OrderBy(entry => FunctionNamespace(entry), StringComparer.OrdinalIgnoreCase)
        .ThenBy(entry => entry.Kind)
        .ThenBy(entry => entry.DisplayName, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Gets the filtered entries list collection maintained or exposed by this DevExpress function instance for downstream processing.
    /// </summary>
    /// <value>The filtered entries list value exposed by <see cref="DxFunctionCatalog"/>.</value>
    private IReadOnlyList<DxAiFunctionCatalogEntry> FilteredEntriesList => FilteredEntries.ToList();

    /// <summary>
    /// Gets the card groups collection maintained or exposed by this DevExpress function instance for downstream processing.
    /// </summary>
    /// <value>The card groups value exposed by <see cref="DxFunctionCatalog"/>.</value>
    private IEnumerable<IGrouping<string, DxAiFunctionCatalogEntry>> CardGroups =>
        FilteredEntries.GroupBy(
            entry => _groupCardsByNamespace ? FunctionNamespace(entry) : "All functions",
            StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Handles the initialized async lifecycle or event notification for <see cref="DxFunctionCatalog"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>
    /// Performs reload in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            _entries = (await Catalog.GetEntriesAsync().ConfigureAwait(false)).Select(Clone).ToList();
            _dirtyGridCatalogKeys.Clear();
            _status = $"Loaded {_entries.Count} database-backed function and service policies.";
            _hasError = false;
            Notifier.ShowInfo(nameof(DxFunctionCatalog), _status, "DX function catalog");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load the DX function catalog.");
            _status = ex.Message;
            _hasError = true;
            Notifier.ShowError(nameof(DxFunctionCatalog), ex.Message, "DX function catalog");
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// Performs synchronize in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SynchronizeAsync()
    {
        _busy = true;
        try
        {
            _entries = (await Catalog.SynchronizeAsync().ConfigureAwait(false)).Select(Clone).ToList();
            _dirtyGridCatalogKeys.Clear();
            _status = $"Synchronized {_entries.Count} runtime descriptors. Existing user exposure and confirmation choices were preserved.";
            _hasError = false;
            Notifier.ShowSuccess(nameof(DxFunctionCatalog), _status, "Catalog synchronized");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not synchronize the DX function catalog.");
            _status = ex.Message;
            _hasError = true;
            Notifier.ShowError(nameof(DxFunctionCatalog), ex.Message, "DX function catalog");
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// Performs save in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <param name="entry">Entry value supplied to the DevExpress function operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SaveAsync(DxAiFunctionCatalogEntry entry)
    {
        _busy = true;
        try
        {
            var saved = await Catalog.SavePolicyAsync(new DxAiFunctionCatalogSaveRequest
            {
                CatalogKey = entry.CatalogKey,
                IsEnabled = entry.IsEnabled,
                ExposeToAiChat = entry.ExposeToAiChat,
                ExposeToOneWire = entry.ExposeToOneWire,
                AllowRemoteInvocation = entry.AllowRemoteInvocation,
                RequiresFrontendConfirmation = entry.RequiresFrontendConfirmation,
                InteractionEditor = entry.InteractionEditor,
                AllowedPeerIdsJson = entry.AllowedPeerIdsJson,
                UpdatedBy = "LocalGPT frontend user"
            }).ConfigureAwait(false);
            var index = _entries.FindIndex(item => item.CatalogKey == saved.CatalogKey);
            if (index >= 0) _entries[index] = Clone(saved);
            _dirtyGridCatalogKeys.Remove(saved.CatalogKey);
            _status = $"Saved policy for {saved.DisplayName}.";
            _hasError = false;
            Notifier.ShowSuccess(nameof(DxFunctionCatalog), _status, "Policy saved");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save DX function policy {CatalogKey}.", entry.CatalogKey);
            _status = ex.Message;
            _hasError = true;
            Notifier.ShowError(nameof(DxFunctionCatalog), ex.Message, "DX function catalog");
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// Persists visible in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task SaveVisibleAsync()
    {
        var visible = FilteredEntriesList
            .Concat(_entries.Where(entry => _dirtyGridCatalogKeys.Contains(entry.CatalogKey)))
            .GroupBy(entry => entry.CatalogKey, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();
        if (visible.Count == 0)
        {
            _status = "No visible policies to save.";
            _hasError = false;
            return;
        }

        _busy = true;
        try
        {
            for (var index = 0; index < visible.Count; index++)
            {
                var entry = visible[index];
                var saved = await Catalog.SavePolicyAsync(new DxAiFunctionCatalogSaveRequest
                {
                    CatalogKey = entry.CatalogKey,
                    IsEnabled = entry.IsEnabled,
                    ExposeToAiChat = entry.ExposeToAiChat,
                    ExposeToOneWire = entry.ExposeToOneWire,
                    AllowRemoteInvocation = entry.AllowRemoteInvocation,
                    RequiresFrontendConfirmation = entry.RequiresFrontendConfirmation,
                    InteractionEditor = entry.InteractionEditor,
                    AllowedPeerIdsJson = entry.AllowedPeerIdsJson,
                    UpdatedBy = "LocalGPT frontend mass edit"
                }).ConfigureAwait(false);
                var sourceIndex = _entries.FindIndex(item => item.CatalogKey == saved.CatalogKey);
                if (sourceIndex >= 0)
                    _entries[sourceIndex] = Clone(saved);
            }
            foreach (var entry in visible)
                _dirtyGridCatalogKeys.Remove(entry.CatalogKey);
            _status = $"Saved {visible.Count} visible or edited function policies from the DXGrid.";
            _hasError = false;
            Notifier.ShowSuccess(nameof(DxFunctionCatalog), _status, "DXGrid policies saved");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save the visible DX function policies as a mass edit.");
            _status = ex.Message;
            _hasError = true;
            Notifier.ShowError(nameof(DxFunctionCatalog), ex.Message, "DXGrid save failed");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Creates user function in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    private void CreateUserFunction()
    {
        _userEditorFunctionName = string.Empty;
        _showUserEditor = true;
    }

    /// <summary>
    /// Performs edit user function in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <param name="functionName">Function name value supplied to the DevExpress function operation and used when producing its result.</param>
    private void EditUserFunction(string functionName)
    {
        _userEditorFunctionName = functionName;
        _showUserEditor = true;
    }

    /// <summary>
    /// Handles user functions changed in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private async Task HandleUserFunctionsChangedAsync()
    {
        await ReloadAsync().ConfigureAwait(true);
    }

    /// <summary>
    /// Closes user editor in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <returns>A task that completes when the operation has finished.</returns>
    private Task CloseUserEditorAsync()
    {
        _showUserEditor = false;
        _userEditorFunctionName = string.Empty;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Performs mark grid entry dirty in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <param name="entry">Entry value supplied to the DevExpress function operation and used when producing its result.</param>
    private void MarkGridEntryDirty(DxAiFunctionCatalogEntry entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.CatalogKey))
            _dirtyGridCatalogKeys.Add(entry.CatalogKey);
    }

    /// <summary>
    /// Performs function namespace in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <param name="entry">Entry value supplied to the DevExpress function operation and used when producing its result.</param>
    /// <returns>The string produced by the operation.</returns>
    private string FunctionNamespace(DxAiFunctionCatalogEntry entry)
    {
        var name = entry.FunctionName?.Trim() ?? string.Empty;
        var separator = name.LastIndexOf('.');
        return separator > 0 ? name[..separator] : entry.Kind;
    }

    /// <summary>
    /// Performs clone in the DevExpress function directory so callers observe a consistent, authoritative runtime view.
    /// </summary>
    /// <param name="entry">Entry value supplied to the DevExpress function operation and used when producing its result.</param>
    /// <returns>The DevExpress AI function catalog entry produced by the operation.</returns>
    private DxAiFunctionCatalogEntry Clone(DxAiFunctionCatalogEntry entry) => new()
    {
        CatalogKey = entry.CatalogKey,
        Kind = entry.Kind,
        FunctionName = entry.FunctionName,
        DisplayName = entry.DisplayName,
        Purpose = entry.Purpose,
        Method = entry.Method,
        Route = entry.Route,
        ParameterSchemaJson = entry.ParameterSchemaJson,
        Source = entry.Source,
        ServiceContractTypeName = entry.ServiceContractTypeName,
        ImplementationTypeName = entry.ImplementationTypeName,
        ServiceMethodName = entry.ServiceMethodName,
        ParameterTypeNamesJson = entry.ParameterTypeNamesJson,
        IsReadOnly = entry.IsReadOnly,
        IsAvailable = entry.IsAvailable,
        IsEnabled = entry.IsEnabled,
        ExposeToAiChat = entry.ExposeToAiChat,
        ExposeToOneWire = entry.ExposeToOneWire,
        AllowRemoteInvocation = entry.AllowRemoteInvocation,
        RequiresFrontendConfirmation = entry.RequiresFrontendConfirmation,
        InteractionEditor = entry.InteractionEditor,
        AllowedPeerIdsJson = entry.AllowedPeerIdsJson,
        DescriptorHash = entry.DescriptorHash,
        IsSystemSeed = entry.IsSystemSeed,
        CreatedAtUtc = entry.CreatedAtUtc,
        UpdatedAtUtc = entry.UpdatedAtUtc,
        UpdatedBy = entry.UpdatedBy
    };
}
