@rendermode InteractiveServer
@page "/remote-control"
@namespace LocalGPT.Components.Pages
@inject IRemoteControlConnectorService Connectors
@inject IRemoteControlPipelineService Pipelines
@inject IRemoteControlTemplateService Templates
@inject IJsonTextService JsonText
@inject INotificationService Notifier
@inject ILogger<RemoteControl> Logger
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization

<PageTitle>@T("RemoteControl.Title", "Remote Control Integration Fabric")</PageTitle>
<ToastWrapper Name="RemoteControlToasts" />

<div class="remote-control-page">
    <WorkbenchHeader Eyebrow='@T("RemoteControl.Kicker", "User-owned integrations")'
                     Title='@T("RemoteControl.Title", "Remote Control Integration Fabric")'
                     Subtitle='@T("RemoteControl.Intro", "Build local-first REST, OData and webhook connectors, then route their payloads through existing DXFunctions and public service actions. Nothing online is enabled by default.")'>
        <Actions>
            <DxButton Text='@T("Common.Refresh", "Refresh")'
                      RenderStyle="ButtonRenderStyle.Secondary"
                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                      Click="ReloadAsync" />
        </Actions>
    </WorkbenchHeader>

    <div class="remote-control-safety">
        <strong>@T("RemoteControl.OfflineDefault", "Offline by default")</strong>
        <span>@T("RemoteControl.OfflineDefault.Help", "Each outbound connector needs explicit enablement and a host allowlist. Nested write actions keep their own approval policy.")</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Status))
    {
        <div class="remote-control-status">@Status</div>
    }

    <div class="remote-control-workbench-layout">
        <ConfigurationWorkbenchNav Items="@RemoteControlSections"
                                   ActiveKey="@ActiveRemoteControlSection"
                                   ActiveKeyChanged="OnRemoteControlSectionChanged"
                                   AriaLabel="Remote Control sections" />
        <div class="remote-control-workbench-stage">
            <ConfigurationWorkbenchPanel SectionKey="connectors" ActiveKey="@ActiveRemoteControlSection" AriaLabel="Remote Control connectors">
        <article class="remote-control-panel">
            <div class="remote-control-panel-heading">
                <div>
                    <h2>@T("RemoteControl.Connectors", "Connectors")</h2>
                    <small>@T("RemoteControl.Connectors.Help", "REST/OData pulls or token-protected inbound webhooks.")</small>
                </div>
                <DxButton CssClass="localgpt-native-button" Click="NewConnector">@T("Common.New", "New")</DxButton>
            </div>

            <div class="remote-control-list">
                @foreach (var connector in ConnectorRows)
                {
                    <DxButton CssClass="@(ConnectorEdit.Key == connector.Key ? "remote-control-list-item selected" : "remote-control-list-item")" Click="() => SelectConnectorAsync(connector.Key)">
                        <strong>@connector.DisplayName</strong>
                        <span>@connector.Key · @connector.Transport</span>
                        <small>@(connector.IsEnabled ? T("Common.Enabled", "Enabled") : T("Common.Disabled", "Disabled")) · @(connector.NetworkEnabled ? T("RemoteControl.NetworkOn", "network on") : T("RemoteControl.NetworkOff", "network off"))</small>
                    </DxButton>
                }
            </div>

            <div class="remote-control-form">
                <label>@T("RemoteControl.Key", "Key")<DxTextBox @bind-Text="ConnectorEdit.Key" /></label>
                <label>@T("Common.Name", "Name")<DxTextBox @bind-Text="ConnectorEdit.DisplayName" /></label>
                <label class="wide">@T("RemoteControl.Description", "Description")<DxMemo @bind-Text="ConnectorEdit.Description" Rows="2" /></label>
                <label>@T("RemoteControl.Transport", "Transport")
                    <DxComboBox Data="@TransportKinds" @bind-Value="ConnectorEdit.Transport" />
                </label>
                <label>@T("RemoteControl.Method", "HTTP method")
                    <DxComboBox Data="@HttpMethods" @bind-Value="ConnectorEdit.Method" />
                </label>
                <label class="check"><DxCheckBox @bind-Checked="ConnectorEdit.IsEnabled" /> @T("RemoteControl.CapabilityEnabled", "Connector enabled")</label>
                @if (ConnectorEdit.Transport != RemoteControlTransportKind.Webhook)
                {
                    <label class="check"><DxCheckBox @bind-Checked="ConnectorEdit.NetworkEnabled" /> @T("RemoteControl.NetworkEnabled", "Allow outbound network access")</label>
                    <label class="wide">@T("RemoteControl.UrlTemplate", "URL template")<DxTextBox @bind-Text="ConnectorEdit.UrlTemplate" NullText="https://example.org/api?city={{var:CITY}}" /></label>

                    <section class="wide remote-control-guided" aria-label='@T("RemoteControl.AllowedHosts", "Allowed hosts")'>
                        <div class="remote-control-guided-heading">
                            <div>
                                <strong>@T("RemoteControl.AllowedHosts", "Allowed hosts")</strong>
                                <small>@T("RemoteControl.AllowedHosts.Help", "Add the host names this connector may contact. LocalGPT stores the same JSON array format behind this guided editor.")</small>
                            </div>
                            <div class="remote-control-guided-actions">
                                <DxButton CssClass="localgpt-native-button" Click="AddAllowedHost">@T("RemoteControl.AddHost", "Add host")</DxButton>
                                <DxButton CssClass="localgpt-native-button" Click="UseUrlHost">@T("RemoteControl.UseUrlHost", "Use URL host")</DxButton>
                            </div>
                        </div>
                        @if (AllowedHostRows.Count == 0)
                        {
                            <small class="remote-control-empty-row">@T("RemoteControl.NoAllowedHosts", "No allowed hosts yet. Add one or use the host from the URL template.")</small>
                        }
                        @for (var index = 0; index < AllowedHostRows.Count; index++)
                        {
                            var rowIndex = index;
                            <div class="remote-control-guided-row">
                                <DxTextBox @bind-Text="AllowedHostRows[rowIndex]" NullText="api.example.org" />
                                <DxButton CssClass="localgpt-native-button danger compact" Click="() => RemoveAllowedHost(rowIndex)">@T("RemoteControl.RemoveHost", "Remove")</DxButton>
                            </div>
                        }
                    </section>

                    <section class="wide remote-control-guided" aria-label='@T("RemoteControl.Headers", "Request headers")'>
                        <div class="remote-control-guided-heading">
                            <div>
                                <strong>@T("RemoteControl.Headers", "Request headers")</strong>
                                <small>@T("RemoteControl.Headers.Help", "Add headers one at a time. Template variables stay supported and LocalGPT serializes these rows to the existing JSON object format when you save.")</small>
                            </div>
                            <DxButton CssClass="localgpt-native-button" Click="AddHeader">@T("RemoteControl.AddHeader", "Add header")</DxButton>
                        </div>
                        <div class="remote-control-preset-row" aria-label='@T("RemoteControl.HeaderPresets", "Header presets")'>
                            <span>@T("RemoteControl.HeaderPresets", "Presets")</span>
                            <DxButton CssClass="localgpt-native-button compact" Click="AddAcceptJsonHeader">@T("RemoteControl.PresetAcceptJson", "Accept JSON")</DxButton>
                            <DxButton CssClass="localgpt-native-button compact" Click="AddBearerHeader">@T("RemoteControl.PresetBearer", "Bearer token")</DxButton>
                            <DxButton CssClass="localgpt-native-button compact" Click="AddApiKeyHeader">@T("RemoteControl.PresetApiKey", "API key")</DxButton>
                        </div>
                        @if (HeaderRows.Count == 0)
                        {
                            <small class="remote-control-empty-row">@T("RemoteControl.NoHeaders", "No custom request headers configured.")</small>
                        }
                        @for (var index = 0; index < HeaderRows.Count; index++)
                        {
                            var rowIndex = index;
                            <div class="remote-control-header-row">
                                <label>
                                    <span>@T("RemoteControl.HeaderName", "Header name")</span>
                                    <DxTextBox @bind-Text="HeaderRows[rowIndex].Name" NullText="X-API-Key" />
                                </label>
                                <label>
                                    <span>@T("RemoteControl.HeaderValue", "Header value")</span>
                                    <DxTextBox @bind-Text="HeaderRows[rowIndex].Value" NullText="{{var:API_KEY}}" />
                                </label>
                                <DxButton CssClass="localgpt-native-button danger compact" Click="() => RemoveHeader(rowIndex)">@T("RemoteControl.RemoveHeader", "Remove")</DxButton>
                            </div>
                        }
                    </section>

                    <label class="wide">@T("RemoteControl.RequestBody", "Request body template")<DxMemo @bind-Text="ConnectorEdit.RequestBodyTemplate" Rows="3" /></label>
                    <label>@T("RemoteControl.RequestContentType", "Request content type")<DxTextBox @bind-Text="ConnectorEdit.RequestContentType" /></label>
                    <label class="check"><DxCheckBox @bind-Checked="ConnectorEdit.AllowInsecureHttp" /> @T("RemoteControl.AllowHttp", "Explicitly allow plain HTTP")</label>
                }
                else
                {
                    <div class="wide remote-control-webhook-box">
                        <strong>@T("RemoteControl.WebhookRoute", "Webhook route")</strong>
                        <code>/api/remote-control/webhook/@ConnectorEdit.Key</code>
                        <small>@T("RemoteControl.WebhookHeader", "Send the secret in the X-LocalGPT-Webhook-Token header. Rotate/copy the token locally below.")</small>
                    </div>
                }
                <label>@T("RemoteControl.ResponseFormat", "Response format")
                    <DxComboBox Data="@ResponseFormats" @bind-Value="ConnectorEdit.ResponseFormat" />
                </label>
                <label>@T("RemoteControl.ResponseSelector", "JSON selector")<DxTextBox @bind-Text="ConnectorEdit.ResponseSelector" NullText="current.weather[0]" /></label>
                <label>@T("RemoteControl.PollSeconds", "Poll seconds (0 = off)")<DxSpinEdit @bind-Value="ConnectorEdit.PollIntervalSeconds" MinValue="0" /></label>
                <label>@T("RemoteControl.TimeoutSeconds", "Timeout seconds")<DxSpinEdit @bind-Value="ConnectorEdit.TimeoutSeconds" MinValue="0" /></label>
                <label>@T("RemoteControl.MaxPayload", "Max payload bytes")<DxSpinEdit @bind-Value="ConnectorEdit.MaxPayloadBytes" MinValue="1" /></label>
            </div>

            <div class="remote-control-actions">
                <DxButton CssClass="localgpt-native-button" Click="SaveConnectorAsync">@T("Common.Save", "Save")</DxButton>
                @if (ConnectorEdit.Transport != RemoteControlTransportKind.Webhook)
                {
                    <DxButton CssClass="localgpt-native-button" Click="PullConnectorAsync">@T("RemoteControl.PullNow", "Pull now")</DxButton>
                }
                else
                {
                    <DxButton CssClass="localgpt-native-button" Click="RotateWebhookTokenAsync">@T("RemoteControl.RotateToken", "Rotate token")</DxButton>
                }
                <DxButton CssClass="localgpt-native-button danger" Click="DeleteConnectorAsync">@T("Common.Delete", "Delete")</DxButton>
            </div>
            @if (!string.IsNullOrWhiteSpace(LastWebhookToken))
            {
                <div class="remote-control-secret">
                    <strong>@T("RemoteControl.NewWebhookToken", "New webhook token — copy it now")</strong>
                    <code>@LastWebhookToken</code>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(LastPayloadPreview))
            {
                <details><summary>@T("RemoteControl.LastPayload", "Latest pull payload")</summary><pre>@LastPayloadPreview</pre></details>
            }
        </article>
            </ConfigurationWorkbenchPanel>

            <ConfigurationWorkbenchPanel SectionKey="pipelines" ActiveKey="@ActiveRemoteControlSection" AriaLabel="Remote Control action pipelines">
        <article class="remote-control-panel">
            <div class="remote-control-panel-heading">
                <div>
                    <h2>@T("RemoteControl.Pipelines", "Action pipelines")</h2>
                    <small>@T("RemoteControl.Pipelines.Help", "Compose existing DXFunctions or published public service methods; no raw reflection path is used.")</small>
                </div>
                <DxButton CssClass="localgpt-native-button" Click="NewPipeline">@T("Common.New", "New")</DxButton>
            </div>

            <div class="remote-control-list compact">
                @foreach (var pipeline in PipelineRows)
                {
                    <DxButton CssClass="@(PipelineEdit.Key == pipeline.Key ? "remote-control-list-item selected" : "remote-control-list-item")" Click="() => SelectPipelineAsync(pipeline.Key)">
                        <strong>@pipeline.DisplayName</strong>
                        <span>@pipeline.Key · @pipeline.Triggers</span>
                        <small>@(pipeline.IsEnabled ? T("Common.Enabled", "Enabled") : T("Common.Disabled", "Disabled"))</small>
                    </DxButton>
                }
            </div>

            <div class="remote-control-form">
                <label>@T("RemoteControl.Key", "Key")<DxTextBox @bind-Text="PipelineEdit.Key" /></label>
                <label>@T("Common.Name", "Name")<DxTextBox @bind-Text="PipelineEdit.DisplayName" /></label>
                <label class="wide">@T("RemoteControl.Description", "Description")<DxMemo @bind-Text="PipelineEdit.Description" Rows="2" /></label>
                <label>@T("RemoteControl.Connector", "Connector")
                    <DxComboBox Data="@ConnectorRows"
                                @bind-Value="PipelineEdit.ConnectorKey"
                                ValueFieldName="Key"
                                TextFieldName="DisplayName"
                                NullText='@T("RemoteControl.ManualOnly", "Manual payload only")'
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </label>
                <label class="check"><DxCheckBox @bind-Checked="PipelineEdit.IsEnabled" /> @T("RemoteControl.PipelineEnabled", "Pipeline enabled")</label>
                <div class="wide remote-control-trigger-row">
                    <label class="check"><DxCheckBox @bind-Checked="TriggerManual" /> @T("RemoteControl.Trigger.Manual", "Manual")</label>
                    <label class="check"><DxCheckBox @bind-Checked="TriggerPull" /> @T("RemoteControl.Trigger.Pull", "Pull")</label>
                    <label class="check"><DxCheckBox @bind-Checked="TriggerWebhook" /> @T("RemoteControl.Trigger.Webhook", "Webhook")</label>
                </div>
            </div>

            <div class="remote-control-steps">
                <div class="remote-control-subheading">
                    <strong>@T("RemoteControl.Steps", "Steps")</strong>
                    <DxButton CssClass="localgpt-native-button" Click="AddStep">@T("RemoteControl.AddStep", "Add step")</DxButton>
                </div>
                @for (var index = 0; index < EditingSteps.Count; index++)
                {
                    var step = EditingSteps[index];
                    var stepIndex = index;
                    <div class="remote-control-step">
                        <div class="remote-control-step-head"><strong>@(index + 1). @step.DisplayName</strong><DxButton CssClass="localgpt-native-button danger" Click="() => RemoveStep(stepIndex)">@T("Common.Remove", "Remove")</DxButton></div>
                        <label>@T("RemoteControl.StepKey", "Step key")<DxTextBox @bind-Text="step.Key" /></label>
                        <label>@T("RemoteControl.StepName", "Step name")<DxTextBox @bind-Text="step.DisplayName" /></label>
                        <label class="wide">@T("RemoteControl.Target", "DXFunction / public service target")
                            <DxComboBox Data="@TargetEntries"
                                    @bind-Value="step.TargetCatalogKey"
                                    ValueFieldName="CatalogKey"
                                    TextFieldName="DisplayName"
                                    NullText='@T("RemoteControl.SelectTarget", "Select a catalog target…")'
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </label>
                        <label class="wide">@T("RemoteControl.ArgumentsTemplate", "Arguments JSON template")<DxMemo @bind-Text="step.ArgumentsTemplateJson" Rows="5" /></label>
                        <label class="check"><DxCheckBox @bind-Checked="step.ContinueOnFailure" /> @T("RemoteControl.ContinueOnFailure", "Continue when this step fails")</label>
                    </div>
                }
            </div>

            <div class="remote-control-actions">
                <DxButton CssClass="localgpt-native-button" Click="SavePipelineAsync">@T("Common.Save", "Save")</DxButton>
                <DxButton CssClass="localgpt-native-button" Click="ExecutePipelineAsync">@T("RemoteControl.Execute", "Execute")</DxButton>
                <DxButton CssClass="localgpt-native-button danger" Click="DeletePipelineAsync">@T("Common.Delete", "Delete")</DxButton>
            </div>
            <label class="remote-control-manual-payload">@T("RemoteControl.ManualPayload", "Manual execution payload")<DxMemo @bind-Text="ManualPayload" Rows="6" /></label>
        </article>
            </ConfigurationWorkbenchPanel>

            <ConfigurationWorkbenchPanel SectionKey="history" ActiveKey="@ActiveRemoteControlSection" AriaLabel="Remote Control execution history">
    <section class="remote-control-panel remote-control-history">
        <div class="remote-control-panel-heading">
            <div><h2>@T("RemoteControl.History", "Execution history")</h2><small>@T("RemoteControl.History.Help", "Bounded audit metadata only; full remote payloads are not persisted here.")</small></div>
            <DxButton CssClass="localgpt-native-button" Click="ReloadAsync">@T("Common.Refresh", "Refresh")</DxButton>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>@T("RemoteControl.Time", "Time")</th><th>@T("RemoteControl.Connector", "Connector")</th><th>@T("RemoteControl.Pipeline", "Pipeline")</th><th>@T("RemoteControl.Trigger", "Trigger")</th><th>@T("RemoteControl.Status", "Status")</th><th>@T("RemoteControl.Summary", "Summary")</th></tr></thead>
                <tbody>
                    @foreach (var row in HistoryRows)
                    {
                        <tr><td>@row.StartedAtUtc.ToLocalTime()</td><td>@row.ConnectorKey</td><td>@row.PipelineKey</td><td>@row.Trigger</td><td>@(row.Succeeded ? T("Common.Completed", "Completed") : row.CompletedAtUtc.HasValue ? T("Common.Error", "Error") : T("RemoteControl.Running", "Running"))</td><td>@row.Summary @row.Error</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
            </ConfigurationWorkbenchPanel>

            <ConfigurationWorkbenchPanel SectionKey="templates" ActiveKey="@ActiveRemoteControlSection" AriaLabel="Remote Control template language">
    <section class="remote-control-panel remote-control-help">
        <h2>@T("RemoteControl.TemplateLanguage", "Template language")</h2>
        <code>{{payload}}</code>
        <code>{{payload.current.temperature}}</code>
        <code>{{step:normalize}}</code>
        <code>{{step:normalize.value}}</code>
        <code>{{var:MY_API_KEY}}</code>
        <code>{{text:payload.description}}</code>
        <p>@T("RemoteControl.TemplateLanguage.Help", "Use payload values, previous step results and LocalGPT system variables. Prefix a token with text: when it must be JSON-string escaped inside an argument template.")</p>
    </section>
            </ConfigurationWorkbenchPanel>
        </div>
    </div>
</div>

