@implements IDisposable
@inject NavigationManager NavigationManager
@inject ILogger<Routes> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

<SafeErrorBoundary @key="NavigationManager.Uri" Area="Application routing" ToastName="ComponentSafetyToasts">
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</SafeErrorBoundary>

@code {
    private bool isDisposed;

    protected override void OnInitialized()
    {
        try
        {
            NavigationManager.LocationChanged += HandleLocationChanged;
            RecordNavigation(NavigationManager.Uri, "initialized");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not initialize LocalGPT navigation tracking.");
            ComponentActivity.RecordFailure(nameof(Routes), nameof(OnInitialized), ex);
            Notifier.ShowError("ComponentSafetyToasts", "Navigation tracking could not initialize. Core routing remains available.", "Navigation warning");
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (isDisposed)
            return;

        try
        {
            RecordNavigation(args.Location, args.IsNavigationIntercepted ? "intercepted" : "programmatic");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not record the LocalGPT route change to {Location}.", args.Location);
            ComponentActivity.RecordFailure(nameof(Routes), nameof(HandleLocationChanged), ex);
            Notifier.ShowWarning("ComponentSafetyToasts", "The route changed, but its diagnostic state could not be recorded.", "Navigation diagnostics warning");
        }
    }

    private void RecordNavigation(string location, string navigationKind)
    {
        var route = new Uri(location).AbsolutePath;
        ComponentActivity.RecordNavigation(location);
        Logger.LogInformation(
            "LocalGPT navigated to {Route} through {NavigationKind} navigation.",
            route,
            navigationKind);
    }

    public void Dispose()
    {
        if (isDisposed)
            return;

        isDisposed = true;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
