@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IFileVersionProvider FileVersionProvider
@inject ThemeService Themes
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@namespace LocalGPT.Components
@inject ILogger<App> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity
@inject LocalGPT.Services.Localization.ILocalGptLocalizationService Localization

@{
    var cookies = HttpContextAccessor.HttpContext?.Request.Cookies;
    string? legacyThemeName = cookies?[ThemeService.LegacyThemeCookieName];
    string? initialShellThemeName = cookies?[ThemeService.ShellThemeCookieName] ?? legacyThemeName;
    string? initialComponentThemeName = cookies?[ThemeService.ComponentThemeCookieName] ?? legacyThemeName;
    Themes.InitializeThemes(initialShellThemeName, initialComponentThemeName);
    var hlTheme = Themes.GetHighlightJSThemeCssUrl(Themes.ActiveShellTheme);
    ComponentActivity.RecordInformation(nameof(App), "RenderShell", "The LocalGPT application shell selected its persisted shell and component themes.");
    Logger.LogInformation(
        "LocalGPT application shell rendered with shell theme {ShellTheme} and component theme {ComponentTheme}.",
        Themes.ActiveShellTheme.Name,
        Themes.ActiveComponentTheme.Name);

    string AppendVersion(string path) => FileVersionProvider.AddFileVersionToPath("/", path);
    var themeControllerModulePath = AppendVersion("switcher-resources/theme-controller.js");
    var localizationScriptPath = AppendVersion("js/localgpt-localization.js");
    // var isE2E = string.Equals(
    //     Environment.GetEnvironmentVariable("LOCALGPT_E2E"),
    //     "1",
    //     StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name"
      data-bs-theme="@Themes.ActiveShellTheme.BootstrapThemeMode"
      data-localgpt-theme="@Themes.ActiveShellTheme.Name"
      data-localgpt-shell-theme="@Themes.ActiveShellTheme.Name"
      data-localgpt-component-theme="@Themes.ActiveComponentTheme.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>LocalGPT</title>
    @DxResourceManager.RegisterTheme(Themes.ActiveComponentTheme.DevExpressTheme)
    @if (!string.IsNullOrEmpty(hlTheme))
    {
        <link rel="stylesheet" href="@hlTheme" hl-theme-link />
    }

    <script src="js/javascript-diagnostics.js"></script>
    @DxResourceManager.RegisterScripts()
    <link href=@AppendVersion("css/site.css") rel="stylesheet" />
    <link href=@AppendVersion("switcher-resources/css/theme-switcher.css") rel="stylesheet" />
    <link href=@AppendVersion("switcher-resources/css/themes.css") rel="stylesheet" />
    <link href=@AppendVersion("LocalGPT.styles.css") rel="stylesheet" />
    <link href="manifest.json" rel="manifest" />
    <link rel="apple-touch-icon" sizes="512x512" href="android-chrome-512x512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="android-chrome-192x192.png" />
    <link rel="icon" type="image/png" href="favicon-32x32" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <HeadOutlet />
</head>
<body data-enhance-nav="false">
    <div id="switcher-container" data-permanent></div>
    <div id="interactive-startup-overlay" class="interactive-startup-overlay" data-permanent>
        <strong>@Localization.Get("Startup.Connecting", fallback: "LocalGPT UI is connecting")</strong>
        <span>@Localization.Get("Startup.Attaching", fallback: "Controls become active after Blazor finishes attaching.")</span>
    </div>
    <div id="components-reconnect-modal" class="localgpt-reconnect-modal components-reconnect-hide" data-permanent role="alertdialog" aria-modal="true" aria-live="assertive" aria-labelledby="localgpt-reconnect-title">
        <section class="localgpt-reconnect-card">
            <div>
                <strong id="localgpt-reconnect-title">@Localization.Get("Startup.ReconnectTitle", fallback: "LocalGPT UI connection interrupted")</strong>
                <span data-localgpt-reconnect-status>@Localization.Get("Startup.Reconnecting", fallback: "The interactive circuit is reconnecting. Running Council work may continue in the server spooler.")</span>
            </div>
            <div class="localgpt-reconnect-actions">
                <button type="button" data-localgpt-reconnect>@Localization.Get("Startup.ReconnectNow", fallback: "Reconnect now")</button>
                <button type="button" data-localgpt-reload>@Localization.Get("Startup.ReloadRejoin", fallback: "Reload & rejoin")</button>
            </div>
        </section>
    </div>
    <ToastWrapper Name="ComponentSafetyToasts" />
    <Routes></Routes>
    <InteractiveStartupMarker />
    @*     <script src="js/devextreme-license.js" type="module"></script> *@
    <script type="module" src="js/push.js"></script>
    <script type="module" src="js/loginToSetCookie.js"></script>
    <script type="module" src="js/logoutToDeleteCookies.js"></script>
    <script type="module" src="js/page-helper.js"></script>
    <script type="module" src="js/page-nav.js"></script>
    <script type="module" src="js/page-section-helper.js"></script>
    <script type="module" src="js/scrollable.js"></script>
    <script type="module" src="js/getCookie.js"></script>
    <script type="module" src="js/getScreenWidth.js"></script>
    <script type="module" src="js/scrollChatToBottom.js"></script>
    <script type="module" src="js/scrollWindowToBottom.js"></script>
    <script src="js/vendor/qrcode-generator.js"></script>
    <script src="js/oneWireSecurityQr.js"></script>
    <script src="js/localgpt-context-menu.js"></script>
    <script src="js/localgpt-bounded-number-editor.js?v=20260813-1"></script>
    <script src="js/localgpt-game-console.js?v=20260802-1"></script>
    <script src="js/localgpt-chat-ui.js?v=3.3.9"></script>
    <script src="@localizationScriptPath"></script>
    <script type="module" src="js/chat-details-state.js"></script>
    <script type="module" src="js/webApiCallsInBrowser.js"></script>
  @*   @if (isE2E)
    {
        <script type="module" src="@AppendVersion("js/localgpt-e2e.js")"></script>
    } *@
    <script type="module" src="@themeControllerModulePath"></script>
    <script src="js/localgpt-reconnect.js?v=20260817-1"></script>

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        window.localGptReady = window.localGptJavaScriptDiagnostics.guardObject('localGptReady', {
            markInteractive: () => document.documentElement.classList.add('localgpt-interactive-ready')
        });

        Blazor.start({
            // Preserve the server-rendered shell until InteractiveServer attaches. If a renderer/GPU tab
            // recovers slowly after media capture pressure, the user keeps a usable shell instead of a
            // destructive empty replacement while reconnect diagnostics decide what to do.
            ssr: { disableDomPreservation: false }
        })
            .then(() => Promise.resolve(window.localGptLocalization?.refresh?.())
                .catch(error => window.localGptJavaScriptDiagnostics.report('localGptLocalization.refresh', error)))
            .then(() => window.localGptReady.markInteractive())
            .catch(error => {
                window.localGptJavaScriptDiagnostics.report('Blazor.start', error);
                document.documentElement.classList.add('localgpt-interactive-error');
                const reconnectModal = document.getElementById('components-reconnect-modal');
                reconnectModal?.classList.remove('components-reconnect-hide');
                reconnectModal?.classList.add('components-reconnect-failed');
            });
    </script>
</body>

</html>
