@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject IJSRuntime JS
@inject ILogger<InteractiveStartupMarker> Logger
@inject INotificationService Notifier
@inject IComponentActivityService ComponentActivity

@code {
    /// <summary>
    /// Stores the internal diagnostics reference state used by <see cref="InteractiveStartupMarker"/> while executing its surrounding workflow.
    /// </summary>
    private DotNetObjectReference<InteractiveStartupMarker>? _diagnosticsReference;
    /// <summary>
    /// Stores the internal disposed state used by <see cref="InteractiveStartupMarker"/> while executing its surrounding workflow.
    /// </summary>
    private bool _disposed;

    /// <summary>
    /// Handles the after render async lifecycle or event notification for <see cref="InteractiveStartupMarker"/>, updating the state required by the surrounding workflow.
    /// </summary>
    /// <param name="firstRender">Value indicating whether first render should apply to this operation.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender || _disposed)
                return;

            _diagnosticsReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("localGptJavaScriptDiagnostics.bindDotNet", _diagnosticsReference).ConfigureAwait(true) /* renderer-affine lifecycle continuation */;
            await JS.InvokeVoidAsync("localGptReady.markInteractive").ConfigureAwait(true) /* renderer-affine lifecycle continuation */;
            ComponentActivity.RecordInformation(nameof(InteractiveStartupMarker), "InteractiveReady", "The Blazor interactive circuit attached successfully and browser diagnostics are connected.");
            Logger.LogInformation($"LocalGPT interactive UI attached successfully; JavaScript errors will be mirrored to the application logger.");
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(exception, $"The interactive-ready marker ended because the browser circuit disconnected.");
        }
        catch (OperationCanceledException exception)
        {
            Logger.LogDebug(exception, $"The interactive-ready marker was cancelled during circuit shutdown.");
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, $"The interactive-ready marker or JavaScript diagnostics bridge could not be initialized.");
            ComponentActivity.RecordWarning(nameof(InteractiveStartupMarker), "InteractiveReady", "The optional interactive-ready marker or browser diagnostics bridge could not be published.");
            Notifier.ShowWarning("ComponentSafetyToasts", "Browser diagnostics could not attach. LocalGPT remains usable; review the application log for details.", "Browser diagnostics warning");
        }
    }

    /// <summary>
    /// Performs report java script error for <see cref="InteractiveStartupMarker"/>, keeping the operation consistent with the state and invariants of the surrounding interactive startup marker workflow.
    /// </summary>
    /// <param name="context">Context value supplied to the interactive startup marker operation and used when producing its result.</param>
    /// <param name="message">Message value supplied to the interactive startup marker operation and used when producing its result.</param>
    /// <param name="stack">Stack value supplied to the interactive startup marker operation and used when producing its result.</param>
    /// <returns>A task that completes when the operation has finished.</returns>
    [JSInvokable]
    public Task ReportJavaScriptErrorAsync(string context, string message, string stack)
    {
        try
        {
            Logger.LogError($"Browser JavaScript failure in {context}: {message}{Environment.NewLine}{stack}");
            ComponentActivity.RecordWarning(nameof(InteractiveStartupMarker), "JavaScriptError", $"Browser JavaScript failed in {context}: {message}");
            return Task.CompletedTask;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, $"LocalGPT could not record a browser JavaScript failure from {context}.");
            return Task.CompletedTask;
        }
    }

    /// <summary>
    /// Releases resources owned by <see cref="InteractiveStartupMarker"/> and leaves the interactive startup marker workflow in a safely disposed state.
    /// </summary>
    public void Dispose()
    {
        try
        {
            if (_disposed)
                return;

            _disposed = true;
            _diagnosticsReference?.Dispose();
            _diagnosticsReference = null;
            Logger.LogDebug($"The LocalGPT JavaScript diagnostics bridge was disposed.");
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, $"The LocalGPT JavaScript diagnostics bridge could not be disposed cleanly.");
        }
    }
}
