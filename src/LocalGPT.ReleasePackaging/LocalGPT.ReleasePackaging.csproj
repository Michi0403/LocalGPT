<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>localgpt-release-packaging</ToolCommandName>
    <PackageId>LocalGPT.ReleasePackaging</PackageId>
    <Version>1.1.0</Version>
    <Authors>Michi0403</Authors>
    <Description>Repository-owned deterministic release packaging primitives shared by LocalGPT and PublisherStudio.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="licenses/THIRD-PARTY-NOTICES.txt" />
    <None Include="..\..\third_party\PDFsharp\LICENSE" Pack="true" PackagePath="licenses/PDFsharp-6.2.4-MIT-LICENSE.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep the .NET 10 security-serviced PKCS version pinned. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third_party\PDFsharp\src\foundation\src\PDFsharp\src\PdfSharp\PdfSharp.csproj" GlobalPropertiesToRemove="Platform;PlatformTarget;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun;PublishAot" />
  </ItemGroup>
</Project>
