+using LocalGPT.BusinessObjects;
+using System.Globalization;
+using System.Text.RegularExpressions;
+
+namespace LocalGPT.Services;
+
+/// <summary>
+/// Goal-owned continuation for deterministic model-context preflight failures.
+/// Extends the durable GoalExecutionService rather than creating a competing
+/// coordinator or allowing the provider client to decide goal completion.
+/// </summary>
+public sealed partial class GoalExecutionService
+{
+    private const string ContextFitStepPrefix = "context-fit-";
+    private const string ContextFitDiagnostic = "OllamaContextBudgetExceeded;";
+
+    /// <summary>
+    /// Only a failure before a usable model request, with no recorded tool call,
+    /// approval or artifact, may be retried without separate human authorization.
+    /// Missing receipts on other kinds of failure are NOT proof of no side effects.
+    /// </summary>
+    private static bool IsGoalContextPreflightFailureWithoutEffects(
+        MultiModelCouncilResult result, GoalExecutionStepReceipt receipt)
+    {
+        if (result.Artifacts.Count > 0 || result.Steps.Count == 0 ||
+            receipt.Evidence.Any(item =>
+                item.Kind is "ApprovalGatedRequest" or "CouncilArtifact" or "VerifiedWorkspaceRead"))
+            return false;
+
+        var errors = result.Steps
+            .Where(step => !string.IsNullOrWhiteSpace(step.Error))
+            .Select(step => step.Error!)
+            .ToArray();
+        if (errors.Length == 0 || errors.Any(error => !IsGoalContextBudgetError(error)))
+            return false;
+
+        // Council may already have processed an allowed tool or issued a review
+        // before a later participant hit the context limit. Its result must then
+        // go through the existing approval/verification gate, never replay.
+        return !result.Steps.Any(step =>
+        {
+            var output = (step.VisibleContent ?? string.Empty) + "\n" + (step.Content ?? string.Empty);
+            return output.Contains("Function call ·", StringComparison.OrdinalIgnoreCase) ||
+                   output.Contains("Function result ·", StringComparison.OrdinalIgnoreCase) ||
+                   output.Contains("<localgpt-dx-call>", StringComparison.OrdinalIgnoreCase) ||
+                   output.Contains("codegen.review.execute", StringComparison.OrdinalIgnoreCase);
+        });
+    }
+
+    private static bool IsGoalContextBudgetError(string? error) =>
+        !string.IsNullOrWhiteSpace(error) &&
+        (error.Contains(ContextFitDiagnostic, StringComparison.OrdinalIgnoreCase) ||
+         (error.Contains("needs about", StringComparison.OrdinalIgnoreCase) &&
+          error.Contains("context tokens", StringComparison.OrdinalIgnoreCase)));
+
+    /// <summary>
+    /// Preserve current team, assigned providers, original goal and all prior receipts.
+    /// First reuse the current semantic replanner: it may select a registered
+    /// subagent-capable team, subject to the original team-selection policy.
+    /// If no valid decomposition is proposed, run one bounded, focused step in
+    /// the original team. Replan count, not an unbounded loop, owns retries.
+    /// </summary>
+    private async Task<bool> TryRecoverGoalContextFailureAsync(
+        GoalExecutionRequest request, GoalExecutionCheckpoint checkpoint,
+        int failedIndex, HashSet<string> liveTeams, CancellationToken cancellationToken)
+    {
+        var limit = Math.Max(0, runtimePolicy.GetInt("GoalMaximumReplans"));
+        if (checkpoint.ReplanCount >= limit)
+            return false;
+
+        // Existing model-assisted decomposition is already responsible for
+        // selecting real configured teams, tools and subagents. Do not duplicate
+        // its catalog, hard-code a model or override PreserveSelectedTeam.
+        if (await TryReplanRemainingAsync(request, checkpoint, failedIndex,
+                liveTeams, cancellationToken).ConfigureAwait(false))
+        {
+            logger.LogInformation(
+                "Goal {GoalId} delegated a context-bound step through the existing semantic goal planner; replan {Replan}.",
+                checkpoint.GoalId, checkpoint.ReplanCount);
+            return true;
+        }
+
+        if (checkpoint.ReplanCount >= limit)
+            return false;
+        var previous = checkpoint.Steps[failedIndex];
+        if (!liveTeams.Contains(previous.TeamKey))
+            return false;
+        var nextReplan = checkpoint.ReplanCount + 1;
+        var replacement = new GoalExecutionPlanStep
+        {
+            Key = ContextFitStepPrefix + nextReplan.ToString(CultureInfo.InvariantCulture),
+            TeamKey = previous.TeamKey,
+            Objective = previous.Objective
+        };
+        // Preserve all completed subgoals. The failed Council run remains an
+        // immutable receipt; this replacement gets a fresh Council run ID.
+        checkpoint.ReplanCount = nextReplan;
+        checkpoint.Steps = checkpoint.Steps.Take(failedIndex).Append(replacement).ToList();
+        await ledger.SaveAsync(checkpoint, cancellationToken).ConfigureAwait(false);
+        logger.LogWarning(
+            "Goal {GoalId} rescheduled context-bound step {Step} in the existing team {Team} (replan {Replan}/{Limit}); " +
+            "next request contains the original goal but omits recursive chat history.",
+            checkpoint.GoalId, previous.Key, previous.TeamKey, nextReplan, limit);
+        return true;
+    }
+
+    private static bool IsGoalContextRecoveryStep(GoalExecutionCheckpoint checkpoint, GoalExecutionPlanStep step)
+    {
+        if (step.Key.StartsWith(ContextFitStepPrefix, StringComparison.OrdinalIgnoreCase))
+            return true;
+        return step.Key.StartsWith("replan-", StringComparison.OrdinalIgnoreCase) &&
+               checkpoint.Receipts.Any(receipt => IsGoalContextBudgetError(receipt.FailureSummary));
+    }
+
+    /// <summary>
+    /// Use the original exact goal and the database-managed substep template,
+    /// not an oversized recap of previous Council attempts. Full transcripts,
+    /// files and receipts remain in the durable goal journal.
+    /// </summary>
+    private string RenderGoalContextRecoveryPrompt(
+        GoalExecutionCheckpoint checkpoint, GoalExecutionPlanStep step, int stepIndex)
+    {
+        var previous = string.Join("\n", checkpoint.Receipts
+            .Where(receipt => receipt.State == GoalExecutionState.Completed)
+            .Select(receipt => receipt.StepKey + ": " + receipt.Answer));
+        var evidenceLimit = Math.Max(0, runtimePolicy.GetInt("CouncilFinalRecoveryTaskExcerptCharacters"));
+        if (previous.Length > evidenceLimit)
+            previous = "[Earlier verified results remain in the durable goal journal.]\n" +
+                       previous[^evidenceLimit..];
+        var objective = string.Equals(step.Objective.Trim(), checkpoint.GoalText.Trim(),
+            StringComparison.Ordinal) ? "Complete the original goal above using the relevant registered functions." : step.Objective;
+        var prompt = runtimePolicy.GetString("GoalCouncilSubstepPromptTemplate")
+            .Replace("{{OriginalGoal}}", checkpoint.GoalText, StringComparison.Ordinal)
+            .Replace("{{ConversationContext}}", "[Earlier unsuccessful Council transcripts are persisted but not replayed.]", StringComparison.Ordinal)
+            .Replace("{{StepNumber}}", (stepIndex + 1).ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)
+            .Replace("{{StepCount}}", checkpoint.Steps.Count.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)
+            .Replace("{{StepObjective}}", objective, StringComparison.Ordinal)
+            .Replace("{{PreviousOutputs}}", previous, StringComparison.Ordinal);
+        return prompt + "\n\nGoal-level recovery: this is a NEW attempt following an Ollama context-fit preflight failure. " +
+            "Use only the functions necessary for this step. Preserve human approvals and report only actual " +
+            "code-generation, build, test and artifact receipts. Do not repeat the failed transcript.";
+    }
+
+    /// <summary>
+    /// Reduce this Council invocation's output reserve by the *observed*
+    /// overflow amount, using the operator-owned Ollama budget policy. Never
+    /// silently overwrite the saved user output preference or model route.
+    /// A compact prompt is still used when older errors have no numeric detail.
+    /// </summary>
+    private int FitGoalRecoveryOutputBudget(GoalExecutionCheckpoint checkpoint)
+    {
+        var originalBudget = Math.Max(1, checkpoint.MaxOutputTokens);
+        var failure = checkpoint.Receipts.LastOrDefault(receipt =>
+            IsGoalContextBudgetError(receipt.FailureSummary))?.FailureSummary;
+        if (string.IsNullOrWhiteSpace(failure))
+            return originalBudget;
+        var result = Regex.Match(failure,
+            @"OllamaContextBudgetExceeded;required=(?<required>\d+);allowed=(?<allowed>\d+);output=(?<output>\d+);",
+            RegexOptions.CultureInvariant | RegexOptions.IgnoreCase,
+            TimeSpan.FromSeconds(1));
+        if (!result.Success ||
+            !long.TryParse(result.Groups["required"].Value, NumberStyles.None,
+                CultureInfo.InvariantCulture, out var required) ||
+            !long.TryParse(result.Groups["allowed"].Value, NumberStyles.None,
+                CultureInfo.InvariantCulture, out var allowed) ||
+            !long.TryParse(result.Groups["output"].Value, NumberStyles.None,
+                CultureInfo.InvariantCulture, out var predictedOutput) ||
+            allowed <= 0 || required <= allowed)
+            return originalBudget;
+        var policy = runtimePolicy.GetJson<OllamaRequestBudgetPolicy>("OllamaRequestBudgetPolicyJson");
+        var minimum = Math.Min(originalBudget, Math.Max(1, policy.MinimumFittedOutputTokens));
+        var fitted = predictedOutput - (required - allowed) -
+                     Math.Max(0, policy.ContextSafetyMarginTokens) -
+                     Math.Max(0, policy.ThinkingReserveTokens);
+        var adapted = (int)Math.Clamp(fitted, minimum, originalBudget);
+        logger.LogInformation(
+            "Goal {GoalId} adapted output reserve for context recovery: configured {Original}, next attempt {Adapted}, " +
+            "observed required context {Required}, allowed {Allowed}; user setting remains unchanged.",
+            checkpoint.GoalId, originalBudget, adapted, required, allowed);
+        return adapted;
+    }
+}
