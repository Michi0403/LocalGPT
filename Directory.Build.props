<Project>
  <PropertyGroup>
    <Authors>Michael Fleischer (Michi0403)</Authors>
    <Copyright>Copyright © Michael Fleischer</Copyright>
    <RepositoryUrl>https://github.com/Michi0403/LocalGPT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <!-- The protocol is RID-neutral. Local source builds use the project; release builds may switch to the NuGet package. -->
    <LocalGptWireProtocolVersion>2.1.1</LocalGptWireProtocolVersion>
    <UseLocalWireProtocolProject Condition="'$(UseLocalWireProtocolProject)' == ''">true</UseLocalWireProtocolProject>
    <LocalGptWireProtocolPackageDirectory Condition="'$(LocalGptWireProtocolPackageDirectory)' == ''">$(MSBuildThisFileDirectory)packages</LocalGptWireProtocolPackageDirectory>

    <!-- Audit direct and transitive NuGet dependencies during restore. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- High and critical advisories block owner-side builds; lower severities remain visible. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
