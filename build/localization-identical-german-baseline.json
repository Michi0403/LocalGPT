  "Text.When\u2420the\u2420AI\u2420Council\u2420session\u2420is\u2420selected,\u2420it\u2420can\u2420generate\u2420downloadable\u2420code,\u2420DLL,\u2420solution,\u2420or\u2420datapack\u2420artifacts\u2420for\u2420implementation\u2420requests.",
  "Text.Who\u2420or\u2420what\u2420detected\u2420the\u2420stale\u2420state.\u2420Examples:\u2420user,\u2420LocalGPT\u2420importer,\u2420DXAiChat\u2420parser,\u2420diagnostic\u2420route.",
