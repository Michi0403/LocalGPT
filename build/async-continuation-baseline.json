{
  "schemaVersion": 5,
  "sourceRoot": "LocalGPTWebviewWrapper/LocalGPT",
  "policy": "Every ordinary await expression is explicitly configured. ConfigureAwait(false) is the mandatory default for services, controllers, persistence, diagnostics, networking, background workflows and component work that does not require renderer affinity. ConfigureAwait(true) is limited to Blazor lifecycle methods and the exact renderer-affine loading helpers listed below.",
  "requiredDefault": "ConfigureAwait(false)",
  "rendererAffineLifecycleMethods": [
    "OnInitializedAsync",
    "OnParametersSetAsync",
    "OnAfterRenderAsync"
  ],
  "maxUnconfiguredAwaitExpressionCount": 0,
  "maxConfigureAwaitTrueOutsideComponents": 0,
  "awaitForeachRequirement": "ConfigureAwait(false)",
  "awaitUsingPolicy": "Language-level asynchronous disposal is reviewed separately; awaited resource initializers remain explicitly configured.",
  "rendererAffineHelperMethods": {
    "Components/Layout/HumanCollaborationInbox.razor": [
      "RefreshAsync",
      "RunHumanUiOperationAsync"
    ],
    "Components/Pages/ProjectMaintenance.razor": [
      "LoadAsync",
      "RefreshTrackedFilesAsync",
      "RunAsync"
    ],
    "Components/Pages/Database.razor": [
      "LoadSelectedTableAsync",
      "LoadTableAsync",
      "RefreshAllAsync",
      "RefreshTablesOnlyAsync",
      "RunUiActionAsync"
    ],
    "Components/Pages/ModelCouncil.razor": [
      "LoadCandidatesAsync",
      "LoadProjectsAsync",
      "LoadSavedCouncilConversationsAsync",
      "RunUiActionAsync"
    ],
    "Components/Pages/DxFunctionCatalog.razor": [
      "ReloadAsync"
    ],
    "Components/Pages/Projects.razor": [
      "LoadProjectsAsync",
      "RefreshSelectedProjectAsync",
      "RunUiActionAsync"
    ],
    "Components/Pages/CouncilTeams.razor": [
      "ReloadAsync"
    ],
    "Components/Pages/Chat.razor": [
      "AttachToLiveCouncilSessionAsync",
      "LoadChatProjectsAsync",
      "LoadCouncilTeamsAsync",
      "LoadDatabaseBackedDefaultsAsync",
      "LoadLatestConversationIntoSessionAsync",
      "LoadModelPresetsAsync",
      "LoadSavedConversationAsync",
      "LoadSelectedChatProjectDetailsAsync",
      "MigrateCouncilDefaultsAsync",
      "RefreshHumanCollaborationAsync",
      "RefreshMemoryAsync",
