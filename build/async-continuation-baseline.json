    ],
    "Components/Pages/Install.razor": [
      "RefreshOllamaProcessStatusAsync",
      "RefreshConnectivityStatusAsync"
    ],
    "Components/Pages/TestLab.razor": [
      "LoadArtifactWorkspacesAsync",
