################################################################################
# LocalGPT repository ignore rules
################################################################################

# IDE/build output
.vs/
**/.vs/
**/.cr/
**/bin/
**/obj/
**/*.csproj.user
**/*.pubxml.user
**/*.wapproj.user
artifacts/

# WebView/MSIX packaging output
src/LocalGPTWebviewWrapper/**/AppPackages/
src/LocalGPTWebviewWrapper/**/BundleArtifacts/
src/LocalGPTWebviewWrapper/**/*.msix
src/LocalGPTWebviewWrapper/**/*.msixbundle
src/LocalGPTWebviewWrapper/**/*.appx
src/LocalGPTWebviewWrapper/**/*.appxbundle
src/LocalGPTWebviewWrapper/**/*.appxsym
src/LocalGPTWebviewWrapper/**/*.cer
src/LocalGPTWebviewWrapper/**/*.pfx
src/LocalGPTWebviewWrapper/**/*.assets.cache
src/LocalGPTWebviewWrapper/**/*.local.props

# Local release/smoke output
build/LocalGPTByMichi0403.zip
build/LocalGPTByMichi0403/
build/publish-output/
build/Michi0403_LocalGPT
build/TelegramBots_Telegram.Bot
images/

# Local runtime state and diagnostics
*.db
*.db-shm
*.db-wal
*.log
*.tmp
*.bak
CorruptDatabaseBackups/

# AI/tool scratch clones and generated repository snapshots
build/[A-Za-z0-9]????????/
build/*_repo_to_text*.txt
build/*_repo_snapshot*/
/localgpt/

# Generated DevExpress/DevExtreme licensed material. Keep the example/template source.
src/LocalGPT/wwwroot/js/devextreme-license.js
**/DevExpress_License*
**/*devexpress*license*.key

# Generated authoritative protocol package cache
packages/*.nupkg
packages/*.snupkg
packages/*.download

# Build gates, tests and localization are repository source.
!Directory.Build.targets
!Build-LocalDevelopment.ps1
!Build-Release.ps1
!build/
!build/**
!tests/
!tests/**
tests/__pycache__/
!src/LocalGPT/Localization/
!src/LocalGPT/Localization/**

# Keep the authored DocFX/Kawaii documentation source in Git. The generated help-docs
# application copy is not source; these inputs recreate it with the same Kawaii theme.
!docs/
!docs/**/*.md
!docs/**/*.yml
!docs/**/*.yaml
!docs/**/*.json
!docs/**/*.css
!docs/**/*.js
!docs/**/*.html
!docs/**/*.svg
!docs/**/*.ico
!docs/**/*.sql
!docs/templates/
!docs/templates/**
!docs/styles/
!docs/styles/**
!docs/guide/
!docs/guide/**
!docs/architecture/
!docs/architecture/**
!docs/engineering/
!docs/engineering/**
!docs/reference/
!docs/reference/**
!docs/pdf/
!docs/pdf/**
!docs/docfx.json
!docs/filterConfig.yml
!docs/toc.yml
!docs/pdf-cover.html
!.config/dotnet-tools.json

# GitHub Pages intentionally publishes the tracked, version-matched Kawaii snapshot.
!.github/pages/
!.github/pages/**
!.github/scripts/
!.github/scripts/**
!.github/workflows/
!.github/workflows/**

# Generated documentation products. Build-Documentation.ps1 recreates these from the
# tracked docs source, compiler XML and application assembly.
docs/input/
docs/api/
docs/_site/
docs/.tools/
docs/.print-book/
docs/LocalGPT-*.pdf
src/LocalGPT/wwwroot/help-docs/
